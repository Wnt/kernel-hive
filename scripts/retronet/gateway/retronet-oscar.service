[Unit]
# Installed INSIDE the gateway CT by
# scripts/retronet/gateway/provision-gateway-ct.sh. Named for the lab, not for
# upstream's `ras.service`, so `systemctl status retronet-oscar` answers the
# question a lab operator actually asks.
Description=Open OSCAR Server — retronet ICQ/AIM gateway
Documentation=https://github.com/mk6i/open-oscar-server
# The CT has no route off its own /24, so network-online.target here means
# "eth0 is configured", which is all the bind addresses need. It must not wait
# for anything routable: there is nothing routable, by design.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ras
Group=ras
WorkingDirectory=/opt/ras
ExecStart=/opt/ras/open_oscar_server -config /etc/ras/settings.env
Restart=on-failure
RestartSec=3s

# Every listener is above 1024 (5190/5191/9898/4000/8080), so the server never
# needs CAP_NET_BIND_SERVICE and runs as a plain unprivileged user.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
StateDirectory=ras
ReadWritePaths=/var/lib/ras

[Install]
WantedBy=multi-user.target
