# Open OSCAR Server — retronet gateway config.
#
# RENDERED, NOT EDITED. scripts/retronet/gateway/provision-gateway-ct.sh
# substitutes the @NAME@ placeholders and installs the result in the gateway CT
# as /etc/ras/settings.env. Hand-edit it there and the next provisioning run
# overwrites you. Every value below is explained in docs/lab/retronet/GATEWAY.md.
#
# THE ONE THING TO UNDERSTAND: OSCAR is a two-hop protocol. The client
# authenticates against the listener it dialled, and the server answers with the
# address of the BOS server to connect to next. That address is the
# ADVERTISED listener, and it is the address as the CLIENT sees it — which is a
# different address for a station behind slirp than for a process on labhost.
# Hence two listeners for one server: same accounts, same database, two doors.

# Door 1 (RN) — labhost-side clients: the greeter bot, `nc`, any lab tooling.
#   They reach the CT directly over the retronet bridge.
# Door 2 (GUEST) — stations behind QEMU slirp. The station never sees the CT's
#   real address; it sees the slirp-local @RN_GUEST_ADDR@ that the launcher's
#   `guestfwd` maps onto door 2. So door 2 must advertise ITSELF as
#   @RN_GUEST_ADDR@:@RN_GUEST_ADVERTISED_PORT@ or the BOS redirect sends the
#   station somewhere it cannot route.
export OSCAR_LISTENERS=RN://0.0.0.0:@RN_OSCAR_PORT@,GUEST://0.0.0.0:@RN_GUEST_PORT@
export OSCAR_ADVERTISED_LISTENERS_PLAIN=RN://@RN_CT_IP@:@RN_OSCAR_PORT@,GUEST://@RN_GUEST_ADDR@:@RN_GUEST_ADVERTISED_PORT@

# TOC (the line-oriented protocol used by TiK/Java-era clients). Kept on for the
# fleet's unix guests; costs nothing while unused.
export TOC_LISTENERS=0.0.0.0:@RN_TOC_PORT@

# Management API — accounts are created through this. Loopback INSIDE the CT
# only: it has no authentication of its own, so it must never be a retronet
# address. Reach it with `pct exec`.
export API_LISTENER=127.0.0.1:@RN_API_PORT@

export DB_PATH=@RN_DB_PATH@

# Real accounts with real passwords. The upstream default is `true`, which
# auto-creates any account that logs in and checks no password — convenient for
# a laptop demo, wrong for an exhibit whose personas must be stable identities.
export DISABLE_AUTH=false

# A restored checkpoint reconnects while the server may still believe the old
# session is live; the "signed in elsewhere" popup would land on the visitor's
# screen as the first thing the exhibit ever said to them.
export DISABLE_MULTI_LOGIN_NOTIF=true

export LOG_LEVEL=@RN_LOG_LEVEL@

# --- Legacy ICQ (pre-OSCAR: 98a/99a/99b) -----------------------------------
# UDP, and therefore NOT reachable through a slirp `guestfwd`, which is TCP
# only. Left enabled because a Lane-B (bridged) station could use it, but the
# win98se persona must run an OSCAR-era client (2000b or later) for exactly
# this reason. See docs/lab/retronet/GATEWAY.md §Which ICQ client.
export ICQ_LEGACY_ENABLED=true
export ICQ_LEGACY_UDP_LISTENER=0.0.0.0:@RN_ICQ_LEGACY_PORT@
export ICQ_LEGACY_VERSIONS=2,3,4,5
export ICQ_LEGACY_AUTO_REGISTRATION=false
export ICQ_LEGACY_SESSION_TIMEOUT=120s
export ICQ_LEGACY_KEEPALIVE_INTERVAL=120s
export ICQ_LEGACY_DEPARTMENTS_ENABLED=false
export ICQ_LEGACY_BROADCAST_ENABLED=true
export ICQ_LEGACY_WWP_ENABLED=true

# Peer-to-peer (direct chat, file transfer) publishes each client's real IP and
# port to the other. Behind slirp that is 10.0.2.15 — an address nobody else on
# the retronet can reach — so every direct connection would be an offer that
# times out, and upstream warns some clients crash on the request. Empty =
# no version gets connection info, which is the honest description of this
# topology.
export ICQ_LEGACY_DIRECT_CONNECTIONS=
