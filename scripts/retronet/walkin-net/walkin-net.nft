#!/usr/sbin/nft -f
# walkin-net.nft — the gateway CT's half of the walk-in containment.
#
# Installed INSIDE CT 951 as /etc/nftables.d/walkin-net.nft by
# scripts/retronet/walkin-net/provision-walkin-net.sh, loaded at boot by
# walkin-net.service. RENDERED FROM THE REPO, NOT EDITED IN PLACE.
#
# CT 951 is single-homed on vmbr-rn (eth0, 10.99.0.2) and dual-homed from the
# walk-in build onward: eth1, 10.98.0.2 on vmbr-wi. A dual-homed box IS a
# router unless something stops it, and the thing it would route is a walk-in
# clone straight onto 10.99.0.0/24 — every ICQ station, the crawl spool, the
# management API. That is the single failure this plane exists to prevent, so
# it is closed twice:
#
#   net.ipv4.ip_forward=0   (/etc/sysctl.d/90-walkin-no-transit.conf)
#   the forward chain below (this file)
#
# Neither is a comment on the other's competence. ip_forward is one sysctl away
# from a helpful future agent; an nft ruleset is one `nft flush ruleset` away
# from a debugging session. Both have to be undone to open the transit.
#
# The input chain is scoped to eth1 and leaves eth0 completely alone — the live
# retronet must not notice this file exists. On eth1 the only reachable
# services are the corpus web:
#
#     udp/67   DHCP        the walk-in scope (walkin-dhcp.service)
#     udp/53   DNS         wildcard resolver, every A -> 10.98.0.2
#     tcp/53   DNS         same, for a stub that falls back to TCP
#     tcp/80   origin      the seamless no-proxy corpus door
#     tcp/3128 proxy       the forward proxy an era browser is told to use
#
# and NOT, deliberately:
#
#     tcp/5190 tcp/5191 tcp/9898 udp/4000   OSCAR. The chat relay binds 0.0.0.0,
#         so without this chain a walk-in clone would land in the fleet's ICQ
#         roster. Anonymous walk-ins in the museum's chat is out of scope for
#         this epic (contract ledger 6), and "we didn't wire it up" is not a
#         control — the listener is already there.
#     tcp/22   sshd, and anything else that ever binds 0.0.0.0 in this CT.
#
# The chain hooks at priority filter - 10 and returns early for every interface
# that is not eth1, so it can only ever subtract from what eth1 reaches.

# Idempotent load: create the table if it is absent, delete it, then define it
# fresh. `nft -f` on this file any number of times leaves exactly one copy.
table inet walkin
delete table inet walkin

table inet walkin {
  chain input {
    type filter hook input priority filter - 10; policy accept;

    # Everything that is not the walk-in leg is none of this table's business.
    iifname != "eth1" accept

    ct state established,related accept
    ct state invalid drop

    # A clone must be able to ping the gateway — it is the one liveness check a
    # 1990s guest and an operator both have.
    icmp type { echo-request, destination-unreachable, time-exceeded } accept

    udp dport 67 accept     comment "DHCP: the walk-in scope"
    udp dport 53 accept     comment "DNS: wildcard resolver"
    tcp dport 53 accept     comment "DNS over TCP"
    tcp dport 80 accept     comment "corpus origin (seamless, no proxy)"
    tcp dport 3128 accept   comment "corpus forward proxy"

    # Everything else on eth1 — OSCAR 5190/5191/9898/4000, sshd, whatever binds
    # 0.0.0.0 next — is refused.
    drop
  }

  chain forward {
    type filter hook forward priority filter - 10; policy accept;

    # The two rules the contract names, spelled out so that reading the ruleset
    # answers the question without knowing what the blanket drop below implies.
    iifname "eth1" oifname "eth0" drop  comment "NO TRANSIT: walk-in -> retronet"
    iifname "eth0" oifname "eth1" drop  comment "NO TRANSIT: retronet -> walk-in"
    iifname "eth1" oifname "eth1" drop  comment "NO TRANSIT: clone -> clone via the gateway"

    # This CT is not a router on any leg and never has been. Anything that
    # reaches the forward hook at all is already a bug.
    drop
  }
}
