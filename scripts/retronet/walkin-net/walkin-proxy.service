[Unit]
# Installed INSIDE the gateway CT (951) by
# scripts/retronet/walkin-net/provision-walkin-net.sh. The walk-in leg's corpus
# web: same program as retronet-proxy.service, bound to 10.98.0.2 — the :3128
# forward proxy and the :80 seamless origin. See docs/lab/walkin/NETWORK-PLANE.md.
Description=walk-in web proxy + origin — corpus-only, read-only, no miss journal
Documentation=file:///data/kernel-hive/docs/lab/walkin/NETWORK-PLANE.md
After=network-online.target walkin-net.service
Wants=network-online.target
Requires=walkin-net.service

[Service]
Type=simple
User=rnproxy
Group=rnproxy
EnvironmentFile=/etc/retronet/walkin-proxy.env
ExecStart=/usr/bin/python3 /opt/retronet-proxy/proxy.py
Restart=on-failure
RestartSec=3s

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
# Read-only everywhere. Note what is ABSENT compared with retronet-proxy.service:
# no ReadWritePaths=/var/spool/retronet. The walk-in instance journals no misses
# (RN_PROXY_REQUESTS is blank) and is given no write path to the shared crawl
# spool, so an anonymous visitor cannot steer what the museum fetches next even
# if the config were changed under it.
ReadOnlyPaths=/data/retronet/corpus /opt/retronet-proxy

Nice=5
MemoryMax=192M
TasksMax=64

[Install]
WantedBy=multi-user.target
