# walk-in wildcard DNS — config.
#
# RENDERED, NOT EDITED by provision-walkin-net.sh; installed in CT 951 as
# /etc/retronet/walkin-dns.env. As-built: docs/lab/walkin/NETWORK-PLANE.md.
#
# The same resolver program as the retronet's (/opt/retronet-dns/dns.py), run as
# a second unit bound to the walk-in leg's own address. Two instances coexist
# because each binds a SPECIFIC address, never 0.0.0.0.

# The walk-in leg's address, port 53 (UDP + TCP).
RN_DNS_LISTEN=@RN_DNS_LISTEN@

# Every A query is answered with this one constant — the walk-in gateway
# address, so any name a clone types lands on the walk-in :80 origin. The
# resolver looks nothing up and opens no outbound socket, so no name can ever
# resolve to a real external address, and none can resolve onto the retronet.
RN_DNS_ANSWER=@RN_DNS_ANSWER@

# Short TTL: a clone's whole life is minutes.
RN_DNS_TTL=@RN_DNS_TTL@
