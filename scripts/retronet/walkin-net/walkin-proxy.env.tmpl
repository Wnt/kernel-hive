# walk-in web proxy + :80 origin — config.
#
# RENDERED, NOT EDITED by provision-walkin-net.sh; installed in CT 951 as
# /etc/retronet/walkin-proxy.env. As-built: docs/lab/walkin/NETWORK-PLANE.md.
#
# The same program as the retronet's (/opt/retronet-proxy/proxy.py), run as a
# second unit on the walk-in leg's address. Same corpus, served read-only to
# both planes.

RN_PROXY_LISTEN=@RN_PROXY_LISTEN@
RN_PROXY_ORIGIN_LISTEN=@RN_PROXY_ORIGIN_LISTEN@

# The corpus, mounted into the CT from the host (mp0) and READ-ONLY to the
# proxy. Both planes serve the same museum.
RN_PROXY_CORPUS=@RN_PROXY_CORPUS@

RN_PROXY_SEARCH_HOSTS=@RN_PROXY_SEARCH_HOSTS@

# The CT-local search service — the ONLY host:port this program will ever open
# an outbound socket to, and a fixed loopback address rather than a name taken
# from a request. Shared with the retronet instance; it is read-only too.
RN_PROXY_SEARCH_BACKEND=@RN_PROXY_SEARCH_BACKEND@

# MISS JOURNALLING IS OFF on the walk-in plane, deliberately. On the retronet a
# miss becomes a line in the crawl's request queue — "a station asked and we had
# nothing" — which is how the corpus grows. A walk-in visitor is anonymous and
# unaccountable, so letting one steer what the museum fetches next is a hole
# nobody asked for. Blank disables it, and the unit grants no write path.
RN_PROXY_REQUESTS=
