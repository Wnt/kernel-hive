# retronet web proxy — config.
#
# RENDERED, NOT EDITED. scripts/retronet/web/install-proxy.sh substitutes the
# @NAME@ placeholders and installs the result in the gateway CT as
# /etc/retronet/proxy.env. Hand-edit it there and the next install overwrites
# you. Every value is explained in docs/lab/retronet/WEB-PROXY.md.

# Where the FORWARD proxy listens. The CT's own bridge address; port 3128 is the
# conventional proxy port an era browser expects to be told to use.
RN_PROXY_LISTEN=@RN_PROXY_LISTEN@

# Where the :80 ORIGIN (vhost) door listens — the seamless, no-proxy web: a guest
# with DNS=10.99.0.2 resolves every name to the gateway and lands here, served by
# Host. Same corpus, same handler as the proxy. Blank disables the origin door.
RN_PROXY_ORIGIN_LISTEN=@RN_PROXY_ORIGIN_LISTEN@

# The corpus root inside the CT: static files mirroring each site at
# <host>/<path>, a directory falling through to index.html. era-press (W2)
# pushes here; the proxy only reads. An empty or absent corpus is valid — every
# request then gets the period "not in the museum's internet" 404.
RN_PROXY_CORPUS=@RN_PROXY_CORPUS@

# Reserved hostname(s) the proxy routes to the search service instead of the
# corpus. Comma- or space-separated; default is the one name search.retronet.
RN_PROXY_SEARCH_HOSTS=@RN_PROXY_SEARCH_HOSTS@

# The search service (W3), CT-local. This is the ONLY host:port the proxy will
# ever open an outbound socket to. It is a fixed loopback address, never a name
# taken from a request — that is the whole no-upstream property.
RN_PROXY_SEARCH_BACKEND=@RN_PROXY_SEARCH_BACKEND@
