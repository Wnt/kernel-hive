# retronet DHCP — config.
#
# RENDERED, NOT EDITED. scripts/retronet/web/install-dhcp.sh substitutes the
# @NAME@ placeholders and installs the result in the gateway CT as
# /etc/retronet/dhcp.env. Hand-edit it there and the next install overwrites
# you. Every value is explained in docs/lab/retronet/WEB-PROXY.md.

# Where the server listens. 0.0.0.0:67 so it receives the limited-broadcast
# DISCOVER (destined 255.255.255.255) that a client with no address sends.
RN_DHCP_LISTEN=@RN_DHCP_LISTEN@

# Pin this scope to the retronet leg. A DHCP DISCOVER is a limited broadcast and
# the kernel delivers a broadcast to EVERY matching socket, so once the gateway
# grew a second leg (eth1, the walk-in plane — docs/lab/walkin/NETWORK-PLANE.md)
# an unpinned retronet scope would also answer walk-in clones, leasing them
# 10.99.0.0/24 addresses and exhausting this pool one clone at a time. Blank
# would mean "every leg"; on a dual-homed gateway that is a bug, not a default.
RN_DHCP_BIND_DEVICE=@RN_DHCP_BIND_DEVICE@

# This server's own address (DHCP Server Identifier) — the gateway.
RN_DHCP_SERVER_ID=@RN_DHCP_SERVER_ID@

# Handed to every client.
RN_DHCP_SUBNET_MASK=@RN_DHCP_SUBNET_MASK@

# DNS server(s) handed to clients — the gateway's wildcard resolver. This is the
# seam that makes proxy-less browsing work: the guest resolves every name here.
RN_DHCP_DNS=@RN_DHCP_DNS@

# DNS domain suffix (option 15). Blank disables it.
RN_DHCP_DOMAIN=@RN_DHCP_DOMAIN@

# The general pool for any (unreserved) station: lo-hi, inclusive.
RN_DHCP_POOL=@RN_DHCP_POOL@

# Lease time, seconds.
RN_DHCP_LEASE=@RN_DHCP_LEASE@

# Per-station reservations: space/comma-separated mac=ip, so a known station
# always gets the SAME IP (exec-over-bridge targets a stable <ip>:7788). REAL
# MACs are box-local — install-dhcp.sh renders them here from
# registry/local.env (RETRONET_DHCP_RESERVATIONS); this committed template ships
# a placeholder. NOTE: every reservation needs a UNIQUE guest MAC; the Windows
# fleet currently shares QEMU's default MAC (see WEB-PROXY.md, "Fleet MACs").
RN_DHCP_RESERVATIONS=@RN_DHCP_RESERVATIONS@
