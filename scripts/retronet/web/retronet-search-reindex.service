[Unit]
# Installed in the gateway CT by scripts/retronet/web/install-search.sh, driven
# by retronet-search-reindex.timer (every 15 min). CONDITIONAL: it rebuilds the
# search index + refreshes the Yahoo directory only when the corpus fingerprint
# changed, so a corpus write by era-press (stream W2) is picked up within a cycle
# WITHOUT churning once the crawl is idle. See docs/lab/retronet/WEB-SEARCH.md.
Description=retronet-search: conditional corpus reindex (only if changed)
Documentation=file:///data/kernel-hive/docs/lab/retronet/WEB-SEARCH.md

[Service]
Type=oneshot
# search.py reindex fingerprints the corpus (files+bytes+newest mtime, stored in
# StateDirectory), and only then `systemctl try-reload-or-restart`s the service
# (SIGHUP = rebuild in place; a no-op, not an error, when it is stopped, so the
# timer never spams failures on a paused CT). Unchanged corpus => it just skips.
EnvironmentFile=/etc/retronet/search.env
StateDirectory=retronet-search
ExecStart=/usr/bin/python3 /opt/retronet-search/search.py reindex
