[Unit]
# Installed INSIDE the dev container CT 950 (which has internet — labhost and the
# gateway CT 951 do not) by scripts/retronet/web/install-crawl.sh. Drives era-press
# breadth-first over era-sites.json toward the ~25 GB corpus budget as a GENTLE
# SLOW-DRIP: a few concurrent fetches paced by a min-interval floor to stay UNDER
# archive.org's per-IP rate limit — a burst gets tarpitted (~9s/req, ~0 progress),
# a steady trickle does not — sharing a global 429/503 backoff, resumable,
# per-site byte-capped. Runs unattended for days; the corpus grows in the
# background and CT 951's proxy reads it live. Writes
# straight into the shared corpus volume (/data/vms/retronet-corpus) that CT 951's
# proxy reads live. See docs/lab/retronet/ERA-PRESS.md.
Description=retronet corpus crawl — era-press breadth-first, gentle slow-drip, toward the ~25 GB budget (paced under archive's per-IP throttle, resumable)
Documentation=file:///data/kernel-hive/docs/lab/retronet/ERA-PRESS.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wnt
Group=wnt
# One long resumable process: it stops ITSELF at the budget or when the site list
# is exhausted (clean exit 0 -> stays stopped). Restart=on-failure only covers a
# crash, and resume picks up from the on-disk corpus + state.json. It runs from a
# DEPLOYED copy under the volume, so a worktree GC never pulls the code out from
# under a multi-hour run. Runs from the deployed venv (httpx[http2]) that install-crawl.sh
# builds next to the code -- the fetch layer speaks HTTP/2 over a tiny reused connection pool.
ExecStart=/data/vms/retronet-crawl/venv/bin/python /data/vms/retronet-crawl/era-press.py crawl \
    --sites /data/vms/retronet-crawl/era-sites.json \
    --staging /data/vms/retronet-corpus \
    --budget-gb 25 --concurrency 4 --min-interval 0.5 \
    --state /data/vms/retronet-crawl/state.json \
    --log /data/vms/retronet-crawl/progress.log
Restart=on-failure
RestartSec=30s
# Be a polite background citizen on the shared box.
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
