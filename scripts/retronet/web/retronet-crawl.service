[Unit]
# Installed INSIDE the dev container CT 950 (which has internet — labhost and the
# gateway CT 951 do not) by scripts/retronet/web/install-crawl.sh. Drives era-press
# breadth-first over era-sites.json toward the ~25 GB corpus budget with the BROWSER
# fetch strategy: NO per-resource CDX (archive's throttled endpoint, gone), one
# rewritten-page discovery + raw id_ pulls per page. Pacing is ADAPTIVE, not hand-set:
# the worker pool is wide and an AIMD in-flight limiter in era_press_core finds
# archive.org's current knee by itself (+1 permit per 25 clean responses, halved on a
# 429/502/503 or a refused connection). A hand-tuned --min-interval is therefore no
# longer set here: it was always either under the ceiling or into the tarpit.
# Resumable, per-site byte-capped. Runs unattended for days; the corpus grows in the
# background and CT 951's proxy reads the shared corpus volume
# (/data/vms/retronet-corpus) live. See docs/lab/retronet/ERA-PRESS.md.
Description=retronet corpus crawl — era-press breadth-first (browser fetch strategy, no CDX), gentle slow-drip toward the ~25 GB budget, resumable
Documentation=file:///data/kernel-hive/docs/lab/retronet/ERA-PRESS.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wnt
Group=wnt
# One long resumable process: it stops ITSELF at the budget or when the site list
# is exhausted (clean exit 0 -> stays stopped). Restart=on-failure only covers a
# crash, and resume picks up from the on-disk corpus + state.json. It runs from a
# DEPLOYED copy under the volume, so a worktree GC never pulls the code out from
# under a multi-hour run. Runs from the deployed venv (httpx[http2]) that install-crawl.sh
# builds next to the code -- the fetch layer speaks HTTP/2 over a tiny reused connection pool.
ExecStart=/data/vms/retronet-crawl/venv/bin/python /data/vms/retronet-crawl/era-press.py crawl \
    --sites /data/vms/retronet-crawl/era-sites.json \
    --staging /data/vms/retronet-corpus \
    --budget-gb 25 --concurrency 12 \
    --state /data/vms/retronet-crawl/state.json \
    --log /data/vms/retronet-crawl/progress.log
Restart=on-failure
RestartSec=30s
# Be a polite background citizen on the shared box.
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
