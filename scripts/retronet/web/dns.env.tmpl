# retronet wildcard DNS — config.
#
# RENDERED, NOT EDITED. scripts/retronet/web/install-dns.sh substitutes the
# @NAME@ placeholders and installs the result in the gateway CT as
# /etc/retronet/dns.env. Hand-edit it there and the next install overwrites you.
# Every value is explained in docs/lab/retronet/WEB-PROXY.md.

# Where the resolver listens (UDP + TCP). The CT's own bridge address, port 53.
RN_DNS_LISTEN=@RN_DNS_LISTEN@

# The address EVERY A query is answered with. The gateway itself, so any name a
# guest types resolves to the :80 origin (proxy.py) that serves the corpus. It
# is a constant — the resolver never looks anything up, so no name can ever
# resolve to a real external IP (containment, reinforced).
RN_DNS_ANSWER=@RN_DNS_ANSWER@

# Answer TTL in seconds. Short, so a corpus/addressing change is picked up fast;
# era stub resolvers cache briefly anyway.
RN_DNS_TTL=@RN_DNS_TTL@
