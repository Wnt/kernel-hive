 void CMouseInterface::SetPosition(int xvalue, int xrange, int yvalue, int yrange) {
+  // Host-window pointer position (from SDL_MOUSEMOTION).
+  //
+  // GEOS's mouse driver is DELTA-based: every poll it READs the card,
+  // interprets (pos - centre) as a movement delta, then re-homes the card
+  // to the clamp centre with a MOUSE_POS write. Feeding absolute positions
+  // therefore makes its arrow race off to a corner. Feed 1:1 scaled DELTAS
+  // instead: the arrow mirrors the absolute host pointer trajectory, and
+  // clamping at the screen edges keeps the two in sync long-term.
   m_iRangeX = (unsigned int) xrange;
   m_iRangeY = (unsigned int) yrange;
+  if (xrange == 0 || yrange == 0) {
+    return;
+  }
 
-  SetPosition(xvalue, yvalue);
+  // GEOS consumes (READ value - clamp centre) as a movement delta in raw
+  // Apple-screen pixels (560x192 DHGR space; measured: delta 204 moved the
+  // arrow 204 DHGR px), then re-homes the card. To give ABSOLUTE tracking
+  // over that delta channel, mirror GEOS's own arrow arithmetic: keep an
+  // estimate of the arrow position and feed the exact delta that brings it
+  // to the host pointer's position. On the first event, feed a huge
+  // negative delta to pin the arrow (and the estimate) at the top-left
+  // corner - from then on estimate == arrow, and any screen-edge clamp
+  // re-syncs the two for free.
+  int tx = (int) ((int64_t) xvalue * 560 / xrange);
+  int ty = (int) ((int64_t) yvalue * 192 / yrange);
+  if (tx > 559) tx = 559;
+  if (ty > 191) ty = 191;
+  if (tx < 0) tx = 0;
+  if (ty < 0) ty = 0;
+  if (s_sync == A2_SYNC_NEED_PIN) {
+    SetPosition((int) m_iX - 32767, (int) m_iY - 32767); // pin arrow at 0,0
+    s_sync = A2_SYNC_WAIT_HOME;
+  } else if (s_sync == A2_SYNC_SYNCED) {
+    SetPosition((int) m_iX + (tx - s_estX), (int) m_iY + (ty - s_estY));
+    s_estX = tx;
+    s_estY = ty;
+  } // WAIT_HOME: drop motions until GEOS consumed the pin (absolute feed,
+    // nothing is lost - the next synced motion goes straight to the target).
   OnMouseEvent();
 }
 
