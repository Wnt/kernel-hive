+  // Kiosk fix: xvalue/yvalue are ABSOLUTE positions in the card's own
+  // clamp space (MOUSE_POS / MOUSE_HOME / MOUSE_INIT / Reset callers).
+  // The stock code re-scaled them by clampmax/hostrange, so e.g. GEOS
+  // homing the cursor to (16384,16384) inside its 0..32767 clamps set
+  // m_iX to 16384*32767/1007 = 533122 - far outside the clamp range -
+  // and the GEOS arrow stayed pinned at the corner. Just clamp.
+  if (xvalue < (int) m_iMinX) xvalue = m_iMinX;
+  else if (xvalue > (int) m_iMaxX) xvalue = m_iMaxX;
+  if (yvalue < (int) m_iMinY) yvalue = m_iMinY;
+  else if (yvalue > (int) m_iMaxY) yvalue = m_iMaxY;
+  m_iX = (unsigned int) xvalue;
+  m_iY = (unsigned int) yvalue;
