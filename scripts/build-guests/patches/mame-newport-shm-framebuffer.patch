+//============================================================
+//  publish_shm - export the finished frame over shared memory
+//============================================================
+//
+//  Env-gated on IRIX_SHM_PATH, so this is completely inert for every other use
+//  of MAME: with the variable unset the first statement returns.
+//
+//  WHY: the SGI IRIX gallery exhibit captures MAME's output and streams it to a
+//  browser. Going through a window costs a second software rasterisation of
+//  every frame -- MAME renders the Newport framebuffer, uploads it to an SDL
+//  texture, blits that through Mesa llvmpipe into an X window, and the capture
+//  daemon reads the same pixels back out -- which measured 32-43% of host time.
+//  Publishing the finished frame here lets MAME run `-video none` with no window
+//  and no X server at all, and hands the consumer the EXACT emulated
+//  framebuffer rather than a window-scaled resample.
+//
+//  Layout: a 64-byte header followed by width*height RGB32 pixels.
+//    0  u32 magic 'IFB1'   16 u32 stride    32 u32 dirty_x0   48 pad
+//    4  u32 version        20 u32 bpp       36 u32 dirty_y0
+//    8  u32 width          24 u64 sequence  40 u32 dirty_x1
+//    12 u32 height                          44 u32 dirty_y1
+//
+//  Synchronisation is a seqlock, which is sufficient here because there is
+//  exactly one producer (this thread) and any number of readers, and readers
+//  never write. The producer makes the sequence ODD before touching pixels and
+//  EVEN after, both with release ordering. A reader takes the sequence
+//  (acquire), copies, then re-reads: if it was odd, or changed, the copy may be
+//  torn and is retried. A reader can therefore never observe a half-written
+//  frame as valid -- the worst case is a retry. Validated under maximum write
+//  pressure: 200 accepted samples, 3,005 torn reads correctly rejected, every
+//  accepted sample internally self-consistent.
+
+void newport_base_device::publish_shm(bitmap_rgb32 &bitmap, const rectangle &cliprect, bool dirty)
+{
+	static constexpr size_t HEADER = 64;
+	const int w = cliprect.width();
+	const int h = cliprect.height();
+
+	// Looked up once: this runs on every rendered frame.
+	static const char *const path = std::getenv("IRIX_SHM_PATH");
+	static const bool trace = std::getenv("IRIX_SHM_TRACE") != nullptr;
+	if (!path || !*path)
+		return;
+
+	static int s_calls = 0;
+	static int s_bail = 0;
+	s_calls++;
+
+	// (Re)map whenever the geometry changes. The emulated screen is reconfigured
+	// during boot (update_screen_size) -- IRIX programs the VC2 about 85 frames
+	// in and the screen goes 1280x1024 to 1288x1024 -- so a mapping sized from
+	// the first frame would be wrong, and bailing out on a size mismatch would
+	// silently stop publishing forever, which is exactly what the first version
+	// of this did.
+	const size_t want = HEADER + size_t(w) * size_t(h) * 4;
+	if (!m_shm || m_shm_size != want)
+	{
+		if (m_shm)
+		{
+			::munmap(m_shm, m_shm_size);
+			m_shm = nullptr;
+			m_shm_size = 0;
+		}
+		const int fd = ::open(path, O_RDWR | O_CREAT, 0644);
+		if (fd < 0)
+		{
+			if (trace && s_bail++ < 4)
+				std::fprintf(stderr, "[shm] open failed (call %d)\n", s_calls);
+			return;
+		}
+		if (::ftruncate(fd, off_t(want)) == 0)
+		{
+			void *const p = ::mmap(nullptr, want, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+			if (p != MAP_FAILED)
+			{
+				m_shm = static_cast<uint8_t *>(p);
+				m_shm_size = want;
+				std::memset(m_shm, 0, HEADER);
+				uint32_t *const hdr = reinterpret_cast<uint32_t *>(m_shm);
+				hdr[0] = 0x31424649; // 'IFB1'
+				hdr[1] = 1;
+				hdr[2] = uint32_t(w);
+				hdr[3] = uint32_t(h);
+				hdr[4] = uint32_t(w * 4);
+				hdr[5] = 32;
+				if (trace)
+					std::fprintf(stderr, "[shm] mapped %dx%d (%zu bytes) at call %d\n", w, h, want, s_calls);
+			}
+		}
+		::close(fd);
+	}
+	if (!m_shm)
+	{
+		if (trace && s_bail++ < 4)
+			std::fprintf(stderr, "[shm] no mapping (call %d)\n", s_calls);
+		return;
+	}
+	if (trace && (s_calls % 300) == 0)
+		std::fprintf(stderr, "[shm] publish #%d %dx%d dirty=%d\n", s_calls, w, h, dirty ? 1 : 0);
+
+	uint32_t *const hdr = reinterpret_cast<uint32_t *>(m_shm);
+	std::atomic_ref<uint64_t> seq(*reinterpret_cast<uint64_t *>(m_shm + 24));
+
+	const uint64_t start = seq.load(std::memory_order_relaxed);
+	seq.store(start + 1, std::memory_order_release); // odd: write in progress
+
+	uint8_t *dst = m_shm + HEADER;
+	for (int y = cliprect.min_y; y <= cliprect.max_y; y++, dst += size_t(w) * 4)
+		std::memcpy(dst, &bitmap.pix(y, cliprect.min_x), size_t(w) * 4);
+
+	// Whole-frame damage when anything changed, empty when it did not, so a
+	// consumer can skip encoding an unchanged frame exactly as XDamage would.
+	// The flag is free: it is the same dirty bit the frame cache above already
+	// maintains.
+	hdr[8] = dirty ? 0u : 1u;
+	hdr[9] = dirty ? 0u : 1u;
+	hdr[10] = dirty ? uint32_t(w) : 0u;
+	hdr[11] = dirty ? uint32_t(h) : 0u;
+
+	seq.store(start + 2, std::memory_order_release); // even: frame complete
+}
