+// split3 -- "a,b,c" into three pieces, missing pieces left empty. Used only
+// for the pointer BINDING knobs, where an absent component (the Atari ST has
+// no middle button) must be distinguishable from a present empty one.
+void split3(std::string const &s, std::string &a, std::string &b, std::string &c)
+{
+	a.clear();
+	b.clear();
+	c.clear();
+	size_t const c1 = s.find(',');
+	if (c1 == std::string::npos)
+	{
+		a = s;
+		return;
+	}
+	a = s.substr(0, c1);
+	size_t const c2 = s.find(',', c1 + 1);
+	if (c2 == std::string::npos)
+	{
+		b = s.substr(c1 + 1);
+		return;
+	}
+	b = s.substr(c1 + 1, c2 - c1 - 1);
+	c = s.substr(c2 + 1);
+}
