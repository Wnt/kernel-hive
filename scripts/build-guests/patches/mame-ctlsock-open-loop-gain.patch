+	// Open-loop MOVEA speaks PIXELS on the wire and COUNTS to the device.
+	// The closed loop converts through step_counts(); open loop had no
+	// converter at all and issued Delta-px as counts, which is only correct
+	// on a guest whose ratio happens to be 1.0. MAME_CTL_GAIN_X/Y supplies
+	// the ratio; the belief integrates counts * gain in move_rel(), so both
+	// sides stay in px and a restated target re-derives what is left.
+	static long px_to_counts(long dpx, double g)
+	{
+		if (dpx == 0)
+			return 0;
+		long c = long(std::llround(double(dpx) / g));
+		if (c == 0)
+			c = (dpx > 0) ? 1 : -1;  // sub-gain residue: one count is the
+			                         // smallest motion the wire can express
+		return c;
+	}
+
+	// px delta -> paced travel, per axis gain.
+	void move_paced_travel_px(long dpx, long dpy)
+	{
+		move_paced_travel(px_to_counts(dpx, m_gx), px_to_counts(dpy, m_gy));
+	}
