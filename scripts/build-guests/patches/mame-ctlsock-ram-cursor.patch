+	// A cursor-item SPEC: `suffix` (an ordinary save item, historical) or
+	// `suffix@offset[:width]` -- a little-endian integer of `width` bytes
+	// (default 2) at byte `offset` inside a byte-sized save item. The offset
+	// accepts 0x hex, because a guest-RAM address is always written that way:
+	//   m_megaii_ram@0x100E9:2   == $E1/00E9, the Apple IIGS cursor X
+	// The '@' is unambiguous: every save-item path is built from device tags
+	// and member names, neither of which can contain one.
+	save_item_handle find_item_spec(std::string const &spec) const
+	{
+		size_t const at = spec.find('@');
+		if (at == std::string::npos)
+			return find_item(spec);
+		std::string const suffix = spec.substr(0, at);
+		std::string rest = spec.substr(at + 1);
+		u32 width = 2;
+		size_t const colon = rest.find(':');
+		if (colon != std::string::npos)
+		{
+			width = u32(std::strtoul(rest.c_str() + colon + 1, nullptr, 0));
+			rest = rest.substr(0, colon);
+		}
+		u32 const off = u32(std::strtoul(rest.c_str(), nullptr, 0));
+		save_item_handle h = find_item(suffix);
+		if (!h.ok())
+			return h;
+		if (h.size != 1 || width == 0 || width > 8
+				|| u64(off) + u64(width) > u64(h.count))
+		{
+			// a window that cannot be read is NOT a silent zero sensor: drop
+			// the handle so MOVEA announces its open-loop degradation the
+			// same way an unresolved suffix does.
+			std::fprintf(stderr,
+					"ctlsock: cursor window %s unusable (item size=%u count=%u, off=%u w=%u)\n",
+					spec.c_str(), h.size, h.count, off, width);
+			std::fflush(stderr);
+			return save_item_handle();
+		}
+		h.win_off = off;
+		h.win_w = width;
+		std::fprintf(stderr, "ctlsock: cursor window %s -> item count=%u off=%u w=%u\n",
+				spec.c_str(), h.count, off, width);
+		std::fflush(stderr);
+		return h;
+	}
+
 	save_item_handle find_item(std::string const &suffix) const
 	{
 		save_item_handle h;
