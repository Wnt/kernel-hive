+	// Little-endian assemble out of a byte-element item. Anything else -- a
+	// wider element type, a window that runs off the end -- reads 0, which
+	// the caller sees as a cursor parked at the origin rather than as a
+	// pointer into whatever follows the item in memory.
+	s64 read_le(u32 off, u32 w) const
+	{
+		if (!base || size != 1 || w == 0 || w > 8)
+			return 0;
+		if (u64(off) + u64(w) > u64(count))
+			return 0;
+		u8 const *const p = reinterpret_cast<u8 const *>(base) + off;
+		u64 v = 0;
+		for (u32 k = 0; k < w; k++)
+			v |= u64(p[k]) << (8 * k);
+		return s64(v);
+	}
 
