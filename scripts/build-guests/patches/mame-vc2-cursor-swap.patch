diff -ruN mame-src-pristine/src/devices/bus/gio64/newport.h mame-src/src/devices/bus/gio64/newport.h
--- a/src/devices/bus/gio64/newport.h
+++ b/src/devices/bus/gio64/newport.h
@@ -176,6 +176,29 @@
 	uint16_t m_cursor_entry;
 	uint16_t m_cursor_x;
 	uint16_t m_cursor_y;
+
+	// CURSOR-SWAP ACCOUNTING (mamectl, issue #45). X programs the cursor
+	// register as pointer + 31 - hotspot, so swapping the cursor GLYPH forces
+	// a compensating write to that register with the pointer standing still.
+	// The hotspot itself is X server software state and appears in no
+	// register, but that compensating write IS the hotspot delta, exactly.
+	// Recording it here -- at the write, where motion cannot be interleaved
+	// with it -- turns a statistical inference at sample rate into a reading.
+	// m_cs_dx/dy accumulate the delta over the session and m_cs_seq counts
+	// the swaps, so a sampler at any rate reads what happened since it last
+	// looked without having to catch it in the act.
+	uint32_t m_cs_seq;
+	int32_t m_cs_dx;
+	int32_t m_cs_dy;
+	bool m_cs_dirty;      // sprite written, compensating write not seen yet
+	uint16_t m_cs_x0;     // cursor register when the sprite was written
+	uint16_t m_cs_y0;
+	attotime m_cs_t0;     // and WHEN, so a later write is not mistaken for it
+	// diagnostics: which writes X actually makes when it swaps a cursor
+	uint32_t m_cs_n_sprite;
+	uint32_t m_cs_n_entry;
+	uint32_t m_cs_n_pos;
+	uint32_t m_cs_n_late;
 	uint16_t m_cur_cursor_x;
 	uint16_t m_did_entry;
 	uint16_t m_scanline_len;
