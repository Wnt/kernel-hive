ContrAlto 2: make KioskMode survive startup, and place its window without a WM.

Two edits, both required before the Xerox Alto tile can be captured. Applied by
scripts/build-guests/tiles/alto.sh to a clean checkout of
jdersch/Contralto2 @ e3681fbc30d129172b4c306aaee8c4e71ae1a458.

1. KioskMode = True CRASHES upstream, on every platform, before the first frame:

     Unhandled exception. System.InvalidOperationException: No parent window found.
        at ContraltoUI.ViewModels.ViewModelBase.FindWindowByViewModel(...)
        at ContraltoUI.ViewModels.AltoUIViewModel.set_FullScreenDisplay(Boolean)
        at ContraltoUI.ViewModels.AltoUIViewModel..ctor(...)

   The AltoUIViewModel constructor sets FullScreenDisplay = true when the config
   asks for kiosk mode, and the setter measures the screen through the window
   that the view model is not yet attached to. Guarding the lookup is enough:
   with no window there is no screen to measure, and the fallback scale of 1:1
   is exactly right for this exhibit, whose X root is the Alto's own bitmap.

   KioskMode is what hides the Avalonia menu bar and the Fields/Sec status bar
   (both bind to !FullScreenDisplay), so nothing else can keep emulator chrome
   out of the captured framebuffer.

2. The gallery kiosk runs a bare X server with NO window manager. Nothing places
   the window: Avalonia leaves it at its default +10+10, which paints a black L
   down the left and top of the captured root and pushes 10 rows of the Alto's
   808-line portrait picture off the bottom. Measured on the box, before this
   edit: "Contralto" 608x816+10+10 on a 608x816 root. After: 608x808+0+0 on a
   608x808 root, with no border, no menu and no letterbox. The window still asks
   for no decorations a WM would have to honour, so this is inert anywhere a WM
   does exist.

--- a/ContraltoUI/ViewModels/AltoUIViewModel.cs
+++ b/ContraltoUI/ViewModels/AltoUIViewModel.cs
@@ -181,23 +181,38 @@
 
             if (_fullScreenDisplay)
             {
-                // In fullscreen mode we will attempt to fit the display as well as possible within the
-                // available screen real-estate:
-                PixelRect displayRect = FindWindowByViewModel(this).Screens.Primary.Bounds;
-
-                // Select scale based on aspect ratio of screen.
+                // In fullscreen mode we will attempt to fit the display as well as possible
+                // within the available screen real-estate.
+                //
+                // GALLERY PATCH: KioskMode assigns this property from the AltoUIViewModel
+                // CONSTRUCTOR, i.e. before any Window has been bound to the view model, and
+                // the unguarded lookup below then threw
+                // InvalidOperationException("No parent window found") and took the process
+                // down before it drew a single frame.  There is no screen to measure that
+                // early, so fall back to 1:1 -- the correct answer for a kiosk root sized to
+                // the Alto's own 608x808 bitmap.
                 double displayScale = 1.0;
-                if (displayRect.Width < displayRect.Height)
+                try
                 {
-                    displayScale = (double)displayRect.Width / (double)ALTO_DISPLAY_WIDTH;
+                    PixelRect displayRect = FindWindowByViewModel(this).Screens.Primary!.Bounds;
+
+                    // Select scale based on aspect ratio of screen.
+                    if (displayRect.Width < displayRect.Height)
+                    {
+                        displayScale = (double)displayRect.Width / (double)ALTO_DISPLAY_WIDTH;
+                    }
+                    else
+                    {
+                        displayScale = (double)displayRect.Height / (double)ALTO_DISPLAY_HEIGHT;
+                    }
                 }
-                else
+                catch (InvalidOperationException)
                 {
-                    displayScale = (double)displayRect.Height / (double)ALTO_DISPLAY_HEIGHT;
+                    // No window yet: kiosk startup.  1:1.
                 }
 
-                // For now, integer-only scaling:
-                _fullScreenScaleFactor = (int)displayScale;
+                // For now, integer-only scaling, and never below 1:1.
+                _fullScreenScaleFactor = Math.Max(1, (int)displayScale);
             }
 
             OnPropertyChanged(nameof(FullScreenDisplay));
--- a/ContraltoUI/Views/MainWindow.axaml.cs
+++ b/ContraltoUI/Views/MainWindow.axaml.cs
@@ -20,6 +20,8 @@
 
 */
 
+using System;
+using Avalonia;
 using Avalonia.Controls;
 using Avalonia.Input;
 using Avalonia.Interactivity;
@@ -40,6 +42,24 @@
         {
             // Pass along the scale factor to the viewmodel so we can compensate.
             vm.HostDesktopDisplayScale = DesktopScaling;
+
+            // GALLERY PATCH: the exhibit kiosk runs a bare X server with NO window manager,
+            // so nothing decorates or places this window.  Avalonia leaves it at its default
+            // +10+10, which puts a black L down two edges of the captured root and pushes the
+            // bottom of the Alto's portrait bitmap off-screen.  Place it ourselves, centred
+            // on the primary screen, and drop the decorations a WM would otherwise own.
+            if (vm.KioskMode)
+            {
+                SystemDecorations = SystemDecorations.None;
+                var screen = Screens.Primary;
+                if (screen is not null)
+                {
+                    PixelRect r = screen.Bounds;
+                    Position = new PixelPoint(
+                        r.X + Math.Max(0, (r.Width - (int)Math.Round(Bounds.Width)) / 2),
+                        r.Y + Math.Max(0, (r.Height - (int)Math.Round(Bounds.Height)) / 2));
+                }
+            }
         }
 
         base.OnLoaded(e);
