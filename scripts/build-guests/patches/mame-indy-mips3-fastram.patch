--- a/src/mame/sgi/mc.cpp
+++ b/src/mame/sgi/mc.cpp
@@ -25,6 +25,10 @@
 #define VERBOSE         (0)
 #include "logmacro.h"
 
+#include "cpu/mips/mips3.h"
+
+#include <vector>
+
 DEFINE_DEVICE_TYPE(SGI_MC, sgi_mc_device, "sgi_mc", "SGI Memory Controller")
 
 sgi_mc_device::sgi_mc_device(const machine_config &mconfig, const char *tag, device_t *owner, uint32_t clock)
@@ -817,6 +821,81 @@ void sgi_mc_device::memcfg_w(offs_t offset, u32 data)
 		if (conf_base == 0x0800'0000U)
 			m_space->install_ram(0x0000'0000, 0x0007'ffff, &m_ram[offset * 2 + bank][0]);
 	}
+
+	remap_fastram();
+}
+
+/*
+ * Republish the whole current RAM map to the MIPS3 DRC as fastram. Rebuilt from
+ * scratch on EVERY memcfg write (not incrementally) because a stale host
+ * pointer left behind by an unmap would be a use-after-free, and because
+ * clear_fastram() has no per-entry granularity.
+ *
+ * Only ranges where the installed size fills the configured size are eligible:
+ * install_ram() MIRRORS a short bank across its configured range and fastram
+ * has no mirror support, so a mirrored bank must keep falling through to the
+ * memory system. The 0x00000000-0x0007ffff low alias is likewise left alone --
+ * it is 512 KiB of PROM-era aliasing of memory that is already registered.
+ */
+void sgi_mc_device::remap_fastram()
+{
+	mips3_device *const cpu = dynamic_cast<mips3_device *>(m_maincpu.target());
+	if (!cpu)
+		return;
+
+	cpu->clear_fastram(0);
+
+	struct range { u32 start; u32 end; u8 *host; };
+	std::vector<range> ranges;
+
+	u16 const simms = m_simms->read();
+
+	for (unsigned reg = 0; reg < 2; reg++)
+	{
+		for (unsigned bank = 0; bank < 2; bank++)
+		{
+			if (!BIT(m_memcfg[reg], 29 - bank * 16))
+				continue;
+			if (!BIT(simms, (reg * 2 + bank) * 4, 3))
+				continue;
+
+			u32 const conf_base = BIT(m_memcfg[reg], 16 - bank * 16, 8) << 22;
+			unsigned const conf_rank = BIT(m_memcfg[reg], 30 - bank * 16);
+			u32 const conf_size = (BIT(m_memcfg[reg], 24 - bank * 16, 5) + 1) << (22 - conf_rank);
+
+			unsigned const inst_rank = BIT(simms, (reg * 2 + bank) * 4 + 3);
+			u32 const inst_size = 1U << (BIT(simms, (reg * 2 + bank) * 4, 3) + 21 - inst_rank);
+
+			unsigned const ranks = std::min(conf_rank, inst_rank) + 1;
+			u32 const size = std::min(conf_size, inst_size);
+
+			if (size != conf_size)
+				continue;
+
+			for (unsigned rank = 0; rank < ranks; rank++)
+			{
+				u32 const start = conf_base + conf_size * rank;
+				u8 *const host = &m_ram[reg * 2 + bank][size * rank];
+
+				// Coalesce: consecutive ranks of a bank are contiguous in BOTH
+				// the guest map and the host buffer, so 256 MB of RAM becomes
+				// two fastram entries rather than four. Entries are not free --
+				// every one of them adds a cmp/jcc pair to EVERY accessor stub,
+				// and MIPS3_MAX_FASTRAM is small.
+				if (!ranges.empty() && ranges.back().end + 1 == start
+					&& ranges.back().host + (ranges.back().end - ranges.back().start + 1) == host)
+					ranges.back().end = start + size - 1;
+				else
+					ranges.push_back({ start, start + size - 1, host });
+			}
+		}
+	}
+
+	for (range const &r : ranges)
+	{
+		LOGMASKED(LOG_MEMCFG, "fastram 0x%08x-0x%08x -> %p\n", r.start, r.end, (void *)r.host);
+		cpu->add_fastram(r.start, r.end, false, r.host);
+	}
 }
 
