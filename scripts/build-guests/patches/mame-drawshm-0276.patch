+namespace osd {
+
+namespace {
+
+//============================================================
+//  CONSTANTS
+//============================================================
+
+// Fixed header size in bytes; pixels start here.
+constexpr size_t SHM_HEADER = 64;
+constexpr uint32_t SHM_MAGIC = 0x31424649U; // 'IFB1'
+constexpr uint32_t SHM_VERSION = 1U;
+
+
+//============================================================
+//  renderer_shm
+//============================================================
+
+class renderer_shm : public osd_renderer
+{
+public:
+	renderer_shm(osd_window &window, std::string path, int forced_w, int forced_h, bool trace)
+		: osd_renderer(window)
+		, m_path(std::move(path))
+		, m_forced_w(forced_w)
+		, m_forced_h(forced_h)
+		, m_trace(trace)
+	{
+	}
+
+	virtual ~renderer_shm() { unmap(); }
+
+	virtual int create() override { return 0; }
+	virtual render_primitive_list *get_primitives() override;
+	virtual int draw(int update) override;
+
+private:
+	bool ensure_mapped(int w, int h);
+	void unmap();
+
+	std::string const   m_path;
+	int const           m_forced_w;
+	int const           m_forced_h;
+	bool const          m_trace;
+
+	uint8_t             *m_shm = nullptr;
+	size_t              m_shm_size = 0;
+	int                 m_shm_w = 0;
+	int                 m_shm_h = 0;
+	int                 m_w = 0;
+	int                 m_h = 0;
+	uint64_t            m_frames = 0;
+};
+
+
+//============================================================
+//  renderer_shm::get_primitives
+//============================================================
+//
+//  The output surface size, and therefore the render target bounds. An
+//  explicit MAME_SHM_SIZE wins; otherwise the window's size does, which is
+//  MAME's own -resolution when one was given and the machine's minimum bounds
+//  when it was not. Either way this function never asks WHICH machine.
+
+render_primitive_list *renderer_shm::get_primitives()
+{
+	int w = m_forced_w;
+	int h = m_forced_h;
+	if ((w <= 0) || (h <= 0))
+	{
+		osd_dim const dimensions = window().get_size();
+		w = dimensions.width();
+		h = dimensions.height();
+	}
+	if ((w <= 0) || (h <= 0))
+		return nullptr;
+
+	m_w = w;
+	m_h = h;
+
+	// Pixel aspect 1.0: this surface is consumed by a video encoder, not shown
+	// on a monitor, so its pixels ARE square. MAME's own aspect handling then
+	// letterboxes a non-4:3 machine inside the surface instead of stretching
+	// it, which is what makes a 256x192 raster and an 800x600 kiosk root
+	// comparable frame for frame.
+	window().target()->set_bounds(w, h, 1.0f);
+	return &window().target()->get_primitives();
+}
+
+
+//============================================================
+//  renderer_shm::draw
+//============================================================
+
+int renderer_shm::draw(int update)
+{
+	// One publisher per mapping (see the header comment): with -numscreens > 1
+	// the other windows render nothing, exactly like -video none.
+	if (m_path.empty())
+		return 0;
+	if ((m_w <= 0) || (m_h <= 0) || (window().m_primlist == nullptr))
+		return 0;
+	if (!ensure_mapped(m_w, m_h))
+		return 0;
+
+	uint32_t *const hdr = reinterpret_cast<uint32_t *>(m_shm);
+	uint64_t *const seqp = reinterpret_cast<uint64_t *>(m_shm + 24); // C++17 port: GCC atomics instead of std::atomic_ref
+
+	uint64_t const start = __atomic_load_n(seqp, __ATOMIC_RELAXED);
+	__atomic_store_n(seqp, start + 1, __ATOMIC_RELEASE); // odd: write in progress
+
+	window().m_primlist->acquire_lock();
+	software_renderer<uint32_t, 0, 0, 0, 16, 8, 0>::draw_primitives(
+			*window().m_primlist,
+			m_shm + SHM_HEADER,
+			uint32_t(m_w),
+			uint32_t(m_h),
+			uint32_t(m_w)); // pitch is in PIXELS, and the surface is tightly packed
+	window().m_primlist->release_lock();
+
+	// Whole-frame damage on every published frame. A render-layer module has no
+	// damage information -- the primitive list carries none -- so the honest
+	// answer is "all of it", and the consumer's frame diff derives the real box
+	// on its own core.
+	hdr[8] = 0;
+	hdr[9] = 0;
+	hdr[10] = uint32_t(m_w);
+	hdr[11] = uint32_t(m_h);
+
+	__atomic_store_n(seqp, start + 2, __ATOMIC_RELEASE); // even: frame complete
+
+	if (m_trace && ((++m_frames % 300) == 0))
+		std::fprintf(stderr, "[drawshm] published %llu frames %dx%d\n", (unsigned long long)m_frames, m_w, m_h);
+	return 0;
+}
+
+
+//============================================================
+//  renderer_shm::ensure_mapped
+//============================================================
+//
+//  (Re)map whenever the output geometry changes. The keyed comparison is
+//  (w, h) and NOT the byte size: 800x600 and 600x800 need the same number of
+//  bytes and a size-keyed test would keep publishing a transposed frame under
+//  a stale header forever.
+//
+//  The order below is the one the consumer's validation expects: grow the file
+//  first, then zero the header (which makes the magic invalid, so a reader that
+//  looks mid-resize sees "not initialised yet" rather than a lie), then write
+//  the new geometry.
+
+bool renderer_shm::ensure_mapped(int w, int h)
+{
+	if (m_shm && (m_shm_w == w) && (m_shm_h == h))
+		return true;
+
+	unmap();
+
+	size_t const want = SHM_HEADER + (size_t(w) * size_t(h) * 4);
+	int const fd = ::open(m_path.c_str(), O_RDWR | O_CREAT, 0644);
+	if (fd < 0)
+	{
+		osd_printf_error("drawshm: cannot open %s: %s\n", m_path, std::strerror(errno));
+		return false;
+	}
+	void *p = MAP_FAILED;
+	if (::ftruncate(fd, off_t(want)) == 0)
+		p = ::mmap(nullptr, want, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+	::close(fd);
+	if (p == MAP_FAILED)
+	{
+		osd_printf_error("drawshm: cannot map %zu bytes of %s: %s\n", want, m_path, std::strerror(errno));
+		return false;
+	}
+
+	m_shm = static_cast<uint8_t *>(p);
+	m_shm_size = want;
+	m_shm_w = w;
+	m_shm_h = h;
+
+	std::memset(m_shm, 0, SHM_HEADER);
+	uint32_t *const hdr = reinterpret_cast<uint32_t *>(m_shm);
+	hdr[0] = SHM_MAGIC;
+	hdr[1] = SHM_VERSION;
+	hdr[2] = uint32_t(w);
+	hdr[3] = uint32_t(h);
+	hdr[4] = uint32_t(w) * 4;
+	hdr[5] = 32;
+	if (m_trace)
+		std::fprintf(stderr, "[drawshm] mapped %dx%d (%zu bytes) at %s\n", w, h, want, m_path.c_str());
+	return true;
+}
+
+
+void renderer_shm::unmap()
+{
+	if (m_shm)
+		::munmap(m_shm, m_shm_size);
+	m_shm = nullptr;
+	m_shm_size = 0;
+	m_shm_w = 0;
+	m_shm_h = 0;
+}
+
+
+//============================================================
+//  video_shm - the module
+//============================================================
+
+class video_shm : public osd_module, public render_module
+{
+public:
+	video_shm() : osd_module(OSD_RENDERER_PROVIDER, "shm") { }
+
+	virtual int init(osd_interface &osd, osd_options const &options) override;
+	virtual void exit() override { }
+
+	virtual std::unique_ptr<osd_renderer> create(osd_window &window) override;
+
+protected:
+	virtual unsigned flags() const override { return 0; }
+
+private:
+	std::string m_path;
+	int         m_w = 0;
+	int         m_h = 0;
+	bool        m_trace = false;
+};
+
+int video_shm::init(osd_interface &osd, osd_options const &options)
+{
+	char const *const path = std::getenv("MAME_SHM_PATH");
+	if (!path || !*path)
+	{
+		// Fail loudly rather than render into the void: `-video shm` with no
+		// destination is a mistake, and a silently blank exhibit is the one
+		// failure mode this whole capture path exists to make impossible.
+		osd_printf_error("-video shm needs MAME_SHM_PATH set to the file to publish frames into\n");
+		return -1;
+	}
+	m_path = path;
+
+	m_trace = (std::getenv("MAME_SHM_TRACE") != nullptr);
+
+	char const *const size = std::getenv("MAME_SHM_SIZE");
+	if (size && *size)
+	{
+		int w = 0, h = 0;
+		if ((std::sscanf(size, "%dx%d", &w, &h) != 2) || (w <= 0) || (h <= 0) || (w > 8192) || (h > 8192))
+		{
+			osd_printf_error("MAME_SHM_SIZE must be WxH within 8192x8192, not '%s'\n", size);
+			return -1;
+		}
+		m_w = w;
+		m_h = h;
+	}
+
+	if (m_w)
+		osd_printf_verbose("drawshm: publishing to %s at %dx%d\n", m_path, m_w, m_h);
+	else
+		osd_printf_verbose("drawshm: publishing to %s at the window size\n", m_path);
+	return 0;
+}
+
+std::unique_ptr<osd_renderer> video_shm::create(osd_window &window)
+{
+	// Only window 0 owns the mapping; the rest get an inert renderer.
+	return std::make_unique<renderer_shm>(
+			window,
+			(window.index() == 0) ? m_path : std::string(),
+			m_w,
+			m_h,
+			m_trace);
+}
+
+} // anonymous namespace
+
+} // namespace osd
+
+#else // !defined(_WIN32)
+
+namespace osd { namespace { MODULE_NOT_SUPPORTED(video_shm, OSD_RENDERER_PROVIDER, "shm") } }
+
+#endif // !defined(_WIN32)
+
+
+MODULE_DEFINITION(RENDERER_SHM, osd::video_shm)
