+	// Resolve the CPU's program space once, lazily: the device tree only
+	// exists after the machine reaches RUNNING, which is after setup().
+	address_space *absram_space()
+	{
+		if (!m_absram_tried)
+		{
+			m_absram_tried = true;
+			device_t *dev = m_machine.root_device().subdevice(m_absram_cpu.c_str());
+			device_memory_interface *mem = nullptr;
+			if (dev && dev->interface(mem) && mem->has_space(AS_PROGRAM))
+				m_absram_space = &mem->space(AS_PROGRAM);
+			else
+				std::fprintf(stderr, "ctlsock: ABS_RAM cpu '%s' has no program space;"
+						" falling back to the open loop\n", m_absram_cpu.c_str());
+		}
+		return m_absram_space;
+	}
+
+	// Map a PUBLISHED surface pixel to the guest pixel drawn there. The
+	// letterbox rect and the raster geometry are the whole transform: an
+	// integer-scaled raster means a visitor pixel and a guest pixel are the
+	// same thing, and the residual is the scale factor's own rounding.
+	void absram_map(long sx, long sy, long &gx, long &gy) const
+	{
+		long const rw = m_absram_rw > 0 ? m_absram_rw : m_surf_w;
+		long const rh = m_absram_rh > 0 ? m_absram_rh : m_surf_h;
+		long const gw = m_absram_gw > 0 ? m_absram_gw : rw;
+		long const gh = m_absram_gh > 0 ? m_absram_gh : rh;
+		gx = ((sx - m_absram_rx) * gw) / rw;
+		gy = ((sy - m_absram_ry) * gh) / rh;
+		gx = std::max(0L, std::min(gw - 1, gx));
+		gy = std::max(0L, std::min(gh - 1, gy));
+	}
+
+	// State the point in every configured Point global, then poke the
+	// republish flag. On a Macintosh that is MTemp/RawMouse/Mouse plus
+	// CrsrNew := CrsrCouple, which is the documented way to move the arrow
+	// from outside the mouse interrupt: the VBL cursor task picks it up on
+	// the next tick and redraws, and the quadrature accumulator is never
+	// touched, so nothing can drift and nothing can accelerate.
+	bool absram_move(long sx, long sy)
+	{
+		address_space *sp = absram_space();
+		if (!sp)
+			return false;
+		long gx = 0, gy = 0;
+		absram_map(sx, sy, gx, gy);
+		uint16_t const a = uint16_t(m_absram_vfirst ? gy : gx);
+		uint16_t const b = uint16_t(m_absram_vfirst ? gx : gy);
+		for (long addr : m_absram_pts)
+		{
+			sp->write_word(offs_t(addr), a);
+			sp->write_word(offs_t(addr + 2), b);
+		}
+		if (m_absram_flag >= 0)
+		{
+			uint8_t v = 0xff;
+			if (m_absram_flagsrc >= 0)
+				v = sp->read_byte(offs_t(m_absram_flagsrc));
+			sp->write_byte(offs_t(m_absram_flag), v);
+		}
+		++m_c_absram;
+		trace("absram tgt=%d,%d guest=%d,%d", int(sx), int(sy), int(gx), int(gy));
+		return true;
+	}
