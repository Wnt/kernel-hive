+void seeq8003_device::device_pre_save()
+{
+	// Non-destructive drain+re-enqueue: logical fifo content is unchanged.
+	m_rx_fifo_length = 0;
+	while (!m_rx_fifo.empty())
+		m_rx_fifo_data[m_rx_fifo_length++] = m_rx_fifo.dequeue();
+	for (u16 i = 0; i < m_rx_fifo_length; i++)
+		m_rx_fifo.enqueue(m_rx_fifo_data[i]);
+
+	m_tx_fifo_length = 0;
+	while (!m_tx_fifo.empty())
+		m_tx_fifo_data[m_tx_fifo_length++] = m_tx_fifo.dequeue();
+	for (u16 i = 0; i < m_tx_fifo_length; i++)
+		m_tx_fifo.enqueue(m_tx_fifo_data[i]);
+}
+
+void seeq8003_device::device_post_load()
+{
+	// clear() first is load-bearing: it purges stale live-session bytes that
+	// a plain rebuild would otherwise leave enqueued ahead of restored data.
+	m_rx_fifo.clear();
+	for (u16 i = 0; i < m_rx_fifo_length; i++)
+		m_rx_fifo.enqueue(m_rx_fifo_data[i]);
+
+	m_tx_fifo.clear();
+	for (u16 i = 0; i < m_tx_fifo_length; i++)
+		m_tx_fifo.enqueue(m_tx_fifo_data[i]);
+}
