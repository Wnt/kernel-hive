+	// post-load already equals the restored value; unmapping a not-yet-mapped
+	// range is harmless.
+	// Side benefit: install_ram invalidates the address-space direct-access
+	// caches, flushing mips3 DRC cached RAM pointers for these regions.
+	for (offs_t offset = 0; offset < 2; offset++)
+		memcfg_w(offset, m_memcfg[offset]);
