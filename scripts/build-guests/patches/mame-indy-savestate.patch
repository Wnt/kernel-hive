+void sgi_mc_device::device_post_load()
+{
+	// Replay the PROM's memcfg mapping from the restored m_memcfg values:
+	// reinstalls every bank/rank window (install_ram with mirror masks,
+	// cf. memcfg_w below) and the low-512KiB alias of the 0x08000000 segment.
