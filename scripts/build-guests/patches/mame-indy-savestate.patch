+void mips3_device::device_post_load()
+{
+	// Belt-and-braces: recompute mode from the restored Status register per
+	// generate_update_mode semantics, in addition to the saved copy. mode
+	// selects the DRC hash bucket, the memory accessor privilege set, and
+	// FPR pairing (FR bit) — device_reset forced kernel mode, which is
+	// wrong for a state saved at the IRIX user-mode desktop.
+	uint32_t const sr = m_core->cpr[0][COP0_Status];
+	m_core->mode = ((sr & (SR_EXL | SR_ERL)) ? 0 : ((sr >> 2) & 0x06)) | ((sr >> 26) & 1);
+
+	// All translated code + hash table were compiled against PRE-load RAM and
+	// mode; with block validation only checking the first opcode of each
+	// sequence, stale tails would execute. The flag is checked at execute_run
+	// entry — safe context, one-time recompile warm-up after load.
+	m_drc_cache_dirty = true;
+
+	// Re-derive compare-interrupt timer arming coherently from restored
+	// count_zero_time / Compare / SR / compare_armed. Protects IRQ5 (the IRIX
+	// scheduler clock) from a stale-flag disarm on the first SR/Compare write.
+	mips3com_update_cycle_counting();
+}
