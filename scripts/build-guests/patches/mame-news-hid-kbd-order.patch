+// The Shift/Control/Alt keys are LEVELS the guest tracks from make/break
+// scancodes; every other key is a CHARACTER. Ordering the two correctly
+// within a scan sweep (flush_keys) needs to tell them apart by matrix cell.
+bool news_hid_hle_device::key_is_modifier(u8 row, u8 column)
+{
+	return (row == 2 && column == 8)                      // Control (ROW2 bit8)
+		|| (row == 3 && column == 6)                      // L Shift (ROW3 bit6)
+		|| (row == 4 && (column == 2 || column == 3));    // R Shift / Alternate (ROW4 bit2/bit3)
+}
+
 void news_hid_hle_device::key_make(u8 row, u8 column)
 {
 	LOG("key_make row %d col %d\n", row, column);
 
-	push_key((row << 4) | column);
+	// Buffer, don't push yet: flush_keys() at scan_complete() emits the
+	// sweep's edges in a shift-correct order.
+	m_key_pending.emplace_back(u8((row << 4) | column), key_is_modifier(row, column));
 }
 
 void news_hid_hle_device::key_break(u8 row, u8 column)
 {
 	LOG("key_break row %d col %d\n", row, column);
 
-	push_key(0x80 | (row << 4) | column);
+	m_key_pending.emplace_back(u8(0x80 | (row << 4) | column), key_is_modifier(row, column));
+}
+
+// Emit one scan sweep's buffered key edges into the host FIFO in an order the
+// guest can always read correctly.
+//
+// The base matrix scanner (device_matrix_keyboard_interface) samples the 8
+// ioport rows round-robin, one row per 1200 Hz tick, and reports a changed
+// cell the instant it reaches that row -- i.e. in ROW order, not the order the
+// keys were actually applied. The ctlsock input module (and a real browser
+// typing through it) applies a Shift press and the character press within the
+// same ~6.7 ms full sweep; because L Shift sits on ROW3 while most letters and
+// digits sit on ROW0..ROW2, the character's row is scanned first and the guest
+// receives the character MAKE before the Shift MAKE -- so it registers at the
+// wrong shift level (`The`->`the`, `#`->`3`, `JUMPED`->`JUMpeD`, measured on
+// the newsos station 2026-08-18). It is intermittent because it depends on
+// where the round-robin pointer happens to sit when the two edges land.
+//
+// The sender always applies the modifier press before the character press
+// (and the character release before the modifier release), so it is enough to
+// stabilise the ordering WITHIN a sweep. Emit in four passes:
+//   0: modifier makes   (Shift/Ctrl/Alt down -- level goes up first)
+//   1: character makes   (the shifted keys are now at the right level)
+//   2: character breaks  (release the character while the level still holds)
+//   3: modifier breaks   (level comes down last)
+// Insertion order is preserved within each pass, so independent characters in
+// the same sweep keep their relative order.
+void news_hid_hle_device::flush_keys()
+{
+	if (m_key_pending.empty())
+		return;
+
+	for (int pass = 0; pass < 4; pass++)
+	{
+		for (auto const &e : m_key_pending)
+		{
+			bool const is_break = (e.first & 0x80) != 0;
+			bool const is_mod = e.second;
+			int const cls = is_break ? (is_mod ? 3 : 2) : (is_mod ? 0 : 1);
+			if (cls == pass)
+				push_key(e.first);
+		}
+	}
+
+	m_key_pending.clear();
 }
 
 void news_hid_hle_device::push_key(u8 code)
@@ -168,6 +226,9 @@
