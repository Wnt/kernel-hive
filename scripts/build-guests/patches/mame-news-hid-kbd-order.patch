+}
+
+// A make/break code is a modifier iff its (row, column) is one of the
+// Shift / Control / Alternate matrix positions (see INPUT_PORTS below):
+//   L Shift  ROW3 col6   R Shift ROW4 col2
+//   Control  ROW2 col8   Alternate ROW4 col3
+// Caps Lock is a lock, not a per-character qualifier, so it is NOT treated
+// as a modifier here.
+bool news_hid_hle_device::code_is_modifier(u8 code)
+{
+	u8 const rc = code & 0x7f;
+	return rc == ((3 << 4) | 6) || rc == ((4 << 4) | 2)
+		|| rc == ((2 << 4) | 8) || rc == ((4 << 4) | 3);
 }
 
-void news_hid_hle_device::push_key(u8 code)
+// Flush this scan cycle's key edges in an order the guest can always latch:
+//   1. non-modifier releases   2. modifier releases
+//   3. modifier presses        4. non-modifier presses
+// so a modifier press is delivered before every character press this cycle,
+// and a modifier release after every character release. Same-class edges keep
+// their (row-scan) arrival order — plain typing is paced far wider than a
+// scan cycle, so two ordinary characters never share one flush.
+void news_hid_hle_device::flush_pending_keys()
 {
-	m_fifo[KEYBOARD].enqueue(code);
+	if (m_key_pending.empty())
+		return;
 
-	out_irq<KEYBOARD>(true);
+	bool queued = false;
+	auto const emit = [this, &queued] (bool want_break, bool want_mod)
+	{
+		for (u8 const code : m_key_pending)
+		{
+			bool const is_break = bool(code & 0x80);
+			if (is_break != want_break)
+				continue;
+			if (code_is_modifier(code) != want_mod)
+				continue;
+			m_fifo[KEYBOARD].enqueue(code);
+			queued = true;
+		}
+	};
+
+	emit(true, false);   // non-modifier releases
+	emit(true, true);    // modifier releases
+	emit(false, true);   // modifier presses
+	emit(false, false);  // non-modifier presses
+
+	m_key_pending.clear();
+
+	if (queued)
+		out_irq<KEYBOARD>(true);
 }
 
