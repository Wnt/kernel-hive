 			}
 		}
-		m_movea_ok = m_cur_x.ok() && m_cur_y.ok();
+		// Opt-in SymbOS observer: sprite 0 is the V9938 hardware cursor.
+		std::string const msx_tag = env_str("MAME_CTL_MSX_CURSOR");
+		if (!msx_tag.empty())
+		{
+			device_t *const vdp = m_machine.root_device().subdevice(msx_tag.c_str());
+			device_memory_interface *memory = nullptr;
+			if (vdp && vdp->interface(memory))
+				m_msx_vram = &memory->space(AS_DATA);
+			m_msx_regs = find_item(msx_tag + "/0/m_cont_reg");
+			m_msx_mode = find_item(msx_tag + "/0/m_mode");
+		}
+		m_movea_ok = (m_cur_x.ok() && m_cur_y.ok()) ||
