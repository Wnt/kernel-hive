 		swap_rebase();
 		if (m_movea_ok)
 		{
@@ -2041,8 +2053,32 @@
 
 	// pixel-space reading; trusted only while the cursor is displayed (a
 	// hidden cursor's registers do not track the pointer)
+	bool msx_cursor_available() const
+	{ return m_msx_vram && m_msx_regs.ok() && m_msx_mode.ok(); }
+
 	bool reading_now(long &rpx, long &rpy, bool &trusted) const
 	{
+		if (msx_cursor_available())
+		{
+			// Match v99x8_device::sprite_mode2/vram_read, including the
+			// interleaved VRAM banks in GRAPHIC6/7 (MAME mode values 7/8).
+			long const mode = long(m_msx_mode.read());
+			auto const reg = [this](u32 n) { return u32(m_msx_regs.read_at(n)); };
+			auto const vr = [this, mode](u32 address) {
+				if (mode == 7 || mode == 8)
+					address = ((address & 1) << 16) | (address >> 1);
+				return m_msx_vram->read_byte(address);
+			};
+			u32 const attr = ((reg(5) & 0xfc) << 7) + (reg(11) << 15);
+			u32 const colour = ((reg(5) & 0xf8) << 7) + (reg(11) << 15);
+			int x = vr(attr + 1);
+			if (vr(colour) & 0x80) x -= 32;
+			int const y = (int(vr(attr)) + 1 - int(reg(23))) & 255;
+			rpx = m_surf_x + long(std::llround(double(x) * m_surf_w / 256.0)) + m_cal_x;
+			rpy = m_surf_y + long(std::llround(double(y) * m_surf_h / 212.0)) + m_cal_y;
+			trusted = mode >= 5 && mode <= 8 && !(reg(8) & 2) && vr(attr) != 216;
+			return true;
+		}
 		if (!m_cur_x.ok() || !m_cur_y.ok())
 			return false;
 		rpx = long(m_cur_x.read()) + m_cal_x;
