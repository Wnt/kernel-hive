 //-------------------------------------------------
+//  postload - force a repaint after a state load
+//-------------------------------------------------
+
+void apollo_graphics_15i::postload()
+{
+	// CHECKPOINT (docs/lab/DOMAINOS-WAVE.md, checkpoint stream): m_image_
+	// memory IS correctly restored by save_pointer() above — VERIFIED by a
+	// checksum logged here during debugging: identical between a cold
+	// "-state golden" load and a dirty+LOADST cycle. screen_update() only
+	// copies image memory into the published bitmap when m_update_flag is
+	// set (and m_update_pending is NOT), and m_update_flag sits at 0 in
+	// steady state, so a LOADST restores it as 0 and no repaint is queued.
+	// This sets the flag so the next screen_update() call repaints from
+	// the now-correct image memory.
+	//
+	// KNOWN GAP (2026-09-09, not yet resolved): setting the flag makes
+	// screen_update()/screen_update1() run again — confirmed via a
+	// postload checksum log, both m_screen->update_now() and
+	// machine().video().frame_update() were tried immediately after this
+	// to force the repaint synchronously inside postload() — but the
+	// PUBLISHED drawshm frame still does not show the reverted picture in
+	// either case, even after an unrelated 12s real-time wait. The
+	// frame_update() variant additionally froze the published frame
+	// entirely (no further updates even for fresh post-restore guest
+	// activity) and was reverted — calling it from inside a postload
+	// appears to disrupt MAME's own frame-pacing state and should not be
+	// reattempted without checking screen.cpp's throttle/next-update
+	// bookkeeping first. The remaining bug is therefore NOT in save-state
+	// registration (image memory + registers restore is byte-correct) but
+	// somewhere between screen_update1()'s bitmap write and drawshm's
+	// publish of that bitmap — worth checking whether drawshm
+	// (mame-drawshm-0276.patch) reads a bitmap/texture reference that
+	// needs its own invalidation independent of the screen device's
+	// m_changed/UPDATE_HAS_NOT_CHANGED bookkeeping.
+	m_update_flag = 1;
+	m_update_pending = 0;
+}
