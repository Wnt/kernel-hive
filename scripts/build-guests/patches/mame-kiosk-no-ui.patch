 #include "util/path.h"
 #include "util/xmlfile.h"
 
+#include <cstdlib>
+
 #include "corestr.h"
 
 #include <algorithm>
 #include <limits>
 
 
@@ -1727,14 +1729,23 @@ render_primitive_list &render_target::get_primitives()
 			prim->texture.base = nullptr;
 			prim->flags = PRIMFLAG_BLENDMODE(BLENDMODE_ALPHA);
 			list.append(*prim);
 		}
 	}
 
+	// KERNEL HIVE (MAME_NO_UI): a station streams the guest's framebuffer and
+	// nothing else -- no popmessage, no FPS overlay, no menu, no paused banner.
+	// Read once; this runs per composed frame.
+	static int const kh_no_ui = []
+			{
+				char const *const e = std::getenv("MAME_NO_UI");
+				return (e && *e && *e != '0') ? 1 : 0;
+			}();
+
 	// process UI elements if applicable
-	if (m_ui_container)
+	if (m_ui_container && !kh_no_ui)
