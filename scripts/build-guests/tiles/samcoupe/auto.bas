10 CLS : PRINT AT 1,7;"KERNEL HIVE - SAM COUPE"
20 PRINT AT 4,6;"1   MANIC MINER"
30 PRINT AT 6,6;"2   MR PAC"
40 PRINT AT 8,6;"3   SPLAT!"
50 PRINT AT 10,6;"4   THE SECRETARY"
60 PRINT AT 12,6;"B   SAM BASIC"
70 PRINT AT 16,5;"PRESS 1-4 OR B"
80 LET k$=INKEY$ : IF k$="" THEN GOTO 80
90 IF k$="1" THEN LOAD "MANIC M"
100 IF k$="2" THEN LOAD "MR PAC"
110 IF k$="3" THEN LOAD "SPLATRUN"
120 IF k$="4" THEN LOAD "SECRUN"
130 IF k$="b" OR k$="B" THEN CLS : STOP
140 GOTO 80
