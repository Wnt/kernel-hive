@@ -817,6 +837,33 @@
 {
 	if (state)
 	{
+		// The real VC2 re-reads its video-timing table out of its own RAM on
+		// every frame; this emulation decoded it once, and only when register
+		// 0x00 (video entry pointer) was written. IRIX does NOT rewrite that
+		// register after it reprograms the table: instrumenting a boot shows
+		// the last 0x00 write at emulated t=57.8 s followed by ~4,500 further
+		// timing-RAM words and no further 0x00 write ever. The decode is
+		// therefore permanently stale, and when the table happened to be
+		// incomplete at the moment 0x00 was written, update_screen_size()
+		// derived a degenerate rectangle, set_size() blanked the screen and
+		// nothing could ever un-blank it -- the intermittent black-screen boot
+		// hang on the SGI Indy.
+		//
+		// So re-derive when the table has been written. Throttled to one
+		// re-decode per DIRTY_VBLANKS frames because decode_vt_table() clears a
+		// 16 MB scratch table; the flag is only set while software is actually
+		// programming the timing RAM, so the steady-state cost is zero.
+		if (m_vt_dirty)
