[Unit]
Description=osgallery single-origin HTTPS SPA + signaling server (:8443)
After=network-online.target
Wants=network-online.target
# The server code, webroot, certs, tiles.json and golden-manifest all live on
# the /data/vms ZFS pool — wait for it to be imported + mounted before starting,
# or a boot-race leaves python unable to find its own script.
RequiresMountsFor=/data/vms/streamhost/serve

[Service]
Type=simple
# Fixed defaults mirror scripts/serve/restart-https.sh. The runtime
# EnvironmentFile is loaded LAST so it wins; restart-https.sh writes the
# per-restart overrides there.
#
# OSG_ADMIN_EVAL is now ON by default and is an explicit DISABLE switch (=0).
# It used to be default-off because the enqueue endpoint was reachable from a
# browser; it no longer is — issuing a command requires a loopback peer and the
# operator token, and the public listener 404s the path outright. The old
# default only meant that inspecting a live broken session started with a
# server restart, which is the opposite of what remote debugging is for.
Environment=WEBROOT=/data/vms/streamhost/serve/webroot
Environment=SIGNAL_CONFIG=/data/vms/streamhost/serve/tiles.json
Environment=CERT=/data/vms/streamhost/serve/pki/leaf.crt
Environment=KEY=/data/vms/streamhost/serve/pki/leaf.key
Environment=SIGNAL_HOST=192.0.2.10
Environment=BIND_IP=0.0.0.0
Environment=PORT=8443
Environment=OSG_ADMIN_EVAL=1
Environment=RESET_SCRIPT=/data/vms/streamhost/serve/reset-tile.sh
Environment=GOLDEN_MANIFEST=/data/vms/streamhost/serve/golden-manifest.json
# The public gallery. PUBLIC_PORT brings up a SECOND, plaintext listener on
# loopback that the forwarder-agent proxies gallery.example.com to; every
# request on it is session-gated (scripts/serve/auth/gate.py) and its signaling
# advertises the relay host. Unset PUBLIC_PORT and none of it exists — the LAN
# listener on :8443 is unaffected either way.
Environment=PUBLIC_PORT=8081
Environment=PUBLIC_BIND=127.0.0.1
Environment=PUBLIC_HOST=gallery.example.com
Environment=AUTH_STATE=/data/vms/streamhost/serve/auth-state.json
Environment=STREAM_KEY_FILE=/data/vms/streamhost/serve/pki/stream-ticket.key
# The walk-in plane's env floor (ledger §4.2): it can only LOWER the /admin
# switch, never raise it. `1` imposes no ceiling — the switch (walkin.access,
# default closed) is what actually gates access. Unset/0 would floor it
# closed and make the admin toggle decorative.
# kh-claim REFUSES to allocate without a session name, and the broker's slot
# loop reads every refusal as "that slot is taken" — so an unset KH_SESSION
# exhausts 152-200 and reports a full pool on an empty claim class.
# NOT `walkin-broker`: that is what `wt.sh new walkin-broker` names a dev
# sandbox of this lane, and two things answering to one session name means
# each side's `kh-claim ls --mine` lists the other's live claims.
Environment=KH_SESSION=osgallery-walkin
Environment=WALKIN_OPEN=1
# NO WALKIN_ARP_PRIME OVERRIDE HERE, DELIBERATELY. The walk-in plane's
# ARP-priming command lives with the code that runs it —
# `scripts/serve/walkin/clone.py::ARP_PRIME_CMD`, which is `wi-clonecell prime`
# — and an override here can only be a second copy to get wrong. It was one:
# this unit pinned `wi-warm-arp` (the FLAT-plane ancestor) from 2026-08-25,
# when per-clone L2 cells landed the same evening and the unit was not swept.
# `wi-warm-arp` asks CT 952 to ping the clone across `vmbr-wi`, and a clone in
# a cell is not on `vmbr-wi` at all — the NAT namespace terminates L2 — so it
# broadcast into the dark for 20 s, five times, and every clone was handed to a
# visitor unprimed with a dead first page load (ledger §6). Measured
# 2026-09-11: `wi-warm-arp` rc=1 after 24.1 s and 19 unanswered ARP requests;
# `wi-clonecell prime` rc=0 in 0.1 s on the same guest, and 128-133 s of every
# clone build was being burned in the doomed one.
# Set this ONLY to override the default for a bring-up, and delete it after.
EnvironmentFile=-/run/osgallery-https.env
# The project's own virtualenv, NOT /usr/bin/python3: the WebAuthn library is
# pinned by scripts/serve/requirements.txt and installed by sync-venv.sh, so the
# box tracks upstream security fixes instead of Debian's backport schedule.
# ExecStartPre keeps the venv in step with the lock on every (re)start, which is
# also what makes a Dependabot bump land by restarting the unit.
ExecStartPre=/data/vms/streamhost/serve/sync-venv.sh
ExecStart=/data/vms/streamhost/serve/.venv/bin/python /data/vms/streamhost/serve/osgallery-https-server.py
# Preserve the log path existing tooling/docs tail; append keeps crash history
# across Restart=on-failure loops (journald also captures via the file).
StandardOutput=append:/data/vms/streamhost/serve/https-server.log
StandardError=append:/data/vms/streamhost/serve/https-server.log
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
