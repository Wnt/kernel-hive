#!/usr/bin/env python3
# labctl — unified single-box lab CLI for the streamhost gallery tiles.
#
# SOURCE OF TRUTH: scripts/labctl (osgallery repo)
# LIVE COPY:       /usr/local/bin/labctl (on the lab box)
# These two files MUST stay byte-identical. Edit the repo copy, then sync to the
# box (scp / pipe over ssh) — same SESSION-STATE reproducibility rule as the tile
# launchers. labctl runs ON THE BOX (it shells out to /root/cdrv.py and
# /root/qmp_hmp.py and reads /data/vms/streamhost/stations.json).
#
# Capability matrix: /data/vms/streamhost/stations.json (one entry per tile:
#   {dir,qmp,pointer_mode,warpd_port,warpd_addr,ssh_port,exec_port,exec_kind,
#    exec_user,exec_key,console,udp_port,golden_snapshot,ctl,notes}). exec_kind
#   routes 'labctl exec': "ssh" (per-tile user + gallery key) | "warpd_e" (solaris
#    E verb via /root/gexec.py) | "serial_e" (irix: irixser/2 over MAME's emulated
#    serial line, via /root/irixexec.py — no port, the pty is discovered from the
#    tile dir) | "telnet_e" (w2kalpha: the guest W2K Telnet Server on a host-only
#    veth, via /root/w2ktelnetexec.py — exec_user login, blank password, fixed
#    guest IP) | null (no channel). ctl (present only when station.env sets
#   SH_MAMECTL_SOCK; irix) is the mamectl/1 unix socket of the compiled-in MAME
#   ctlsock module (issue #45): 'labctl mctl' passes raw verbs through
#   /root/mctl.py, and type/sh/reset route over it instead of the legacy Lua
#   cmd file (which the module does not tail). Regenerate with:  labctl gen
#
# GUARDRAILS (hard-coded, non-negotiable):
#   * Never drives CT112 (labctl only ever touches tiles listed in tiles.json).
#     riscos and
#     windows11 are ordinary gallery tiles (policy 2026-07-08) but are not
#     streamhost tiles (no tile dir / QMP socket), so they never appear in the
#     matrix — there is no hard-block anymore.
#   * Kills VMs only by pidfile (labctl never kills; clone/reset go through the
#     existing tooling which is pidfile-based).
#
# IDLE AUTO-PAUSE (streamhost, 2026-07-12): with zero browser sessions the
# daemon freezes its guest's vCPUs (QMP stop) after a grace period
# (SH_IDLE_PAUSE_SECS, default 60 s). Every driving verb below (shot / type /
# key / sh / exec / reset) therefore issues an idempotent HMP `cont` first —
# screendumps, console typing and in-guest ssh would otherwise hang on frozen
# vCPUs. The daemon re-freezes an idle guest within <= grace + 60 s, so no
# cleanup is needed after driving.
#
# Subcommands:
#   labctl ls                     tiles + capability summary + service state
#   labctl facts <tile> [--json]  EVERYTHING about one tile in one call: SPA id
#                                 vs SH_STATION, unit + state, kind, suite
#                                 (declared vs actual), disk + backing +
#                                 snapshots, builder + whether it bakes, exec
#                                 channel, resettability. Accepts either id.
#   labctl health [tile]           read-only live-plane health (or one detail)
#   labctl assert <tile> --text S  OCR-assert a live framebuffer screendump
#   labctl assert <tile> --template PNG | --settle
#   labctl shot  <tile> [out.png] screendump -> PNG (default /tmp/<tile>.png)
#   labctl type  <tile> "<text>"  type text into the guest (no Enter; --verify
#                                 also screendumps afterwards)
#   labctl key   <tile> <qcode..> send one key chord (e.g. ctrl c ; or: ret)
#   labctl sh    <tile> "<cmd>"   type a shell line + Enter (BLIND — no capture)
#   labctl exec  <tile> "<cmd>"   REAL exec w/ captured stdout+exit (ssh tiles);
#                                 errors with alternatives where unavailable
#   labctl mctl  <tile> "<verb>"  raw mamectl/1 verb passthrough (ctl tiles only)
#   labctl reset <tile>           loadvm golden (restore tile to golden snapshot)
#   labctl clone <tile> <N>       wrap existing clone tooling (solaris) else recipe
#   labctl gen                    regenerate tiles.json from station.env + launchers
#   labctl who                    claims + sandbox processes grouped by session
#   labctl claims <verb> …        kh-claim passthrough (take/release/ls/who/gc)
#   labctl wait-for …             block on the box until a unit/file/port/cmd condition
#
# KEYSTROKE PACING: type/key/sh honour the tile's own SH_KEY_MIN_HOLD_MS /
# SH_KEY_MIN_GAP_MS (station.env, the same knobs the daemon applies to the browser
# stream path) — emulators sample their keyboard once per emulated frame, so an
# unpaced burst is silently swallowed. See the block above cmd_type.
import json, os, shutil, socket, subprocess, sys, time

# labctl.d/ carries the pure-function modules split out under the
# size-exclusions.json plan for this file: prefer the deployed tree
# (/usr/local/lib/labctl, the box-sync pair added alongside scripts/labctl)
# and fall back to the sibling repo checkout so `scripts/labctl` keeps working
# from a bare clone. Those modules must never import from labctl — only from
# each other's labctl.d/common.
_LABCTL_D_DEPLOYED = "/usr/local/lib/labctl"
_LABCTL_D_REPO = os.path.join(os.path.dirname(os.path.abspath(__file__)), "labctl.d")
sys.path.insert(0, _LABCTL_D_DEPLOYED if os.path.isdir(_LABCTL_D_DEPLOYED) else _LABCTL_D_REPO)

from common import GuestPaused, die, load_matrix, svc_state, tile_conf  # noqa: E402
from capture import capture_png_any  # noqa: E402
from facts import print_facts, registry_entry, tile_facts  # noqa: E402
from health import cmd_health  # noqa: E402
from vision import cmd_assert  # noqa: E402
from guest import (  # noqa: E402
    cmd_clone,
    cmd_exec,
    cmd_key,
    cmd_mctl,
    cmd_reset,
    cmd_sh,
    cmd_type,
)


# ---- subcommands -----------------------------------------------------------
def cmd_ls(argv):
    m = load_matrix()
    tiles = m.get("tiles", {})
    hdr = "%-13s %-6s %-6s %-6s %-6s %-4s %-7s %-9s %s" % (
        "TILE",
        "PTR",
        "WARPD",
        "SSH",
        "EXEC",
        "CON",
        "GOLDEN",
        "SERVICE",
        "NOTES",
    )
    print(hdr)
    print("-" * len(hdr))
    for name in sorted(tiles):
        c = tiles[name]
        g = (
            "cold"
            if c.get("reset_mode") == "restart"
            else {True: "yes", False: "NO", None: "?"}.get(c.get("golden_snapshot"))
        )
        note = c.get("notes", "")
        if len(note) > 46:
            note = note[:43] + "..."
        print(
            "%-13s %-6s %-6s %-6s %-6s %-4s %-7s %-9s %s"
            % (
                name,
                c.get("pointer_mode", "?"),
                c.get("warpd_port") or "-",
                c.get("ssh_port") or "-",
                c.get("exec_port")
                or ("serial" if c.get("exec_kind") in ("serial_e", "serialcon_e", "serial_getty", "serial_shell") else "-"),
                c.get("console", "?"),
                g,
                svc_state(name),
                note,
            )
        )


def cmd_shot(argv):
    if not argv:
        die("usage: labctl shot <tile> [out.png]")
    name = argv[0]
    c = tile_conf(name)
    out = argv[1] if len(argv) > 1 else "/tmp/%s.png" % name
    if not out.endswith(".png"):
        out += ".png"
    try:
        capture_png_any(name, c, out, resume=True)
    except (RuntimeError, subprocess.TimeoutExpired) as exc:
        die(str(exc))
    print(out)


def cmd_facts(argv):
    names = [a for a in argv if not a.startswith("-")]
    unknown = [a for a in argv if a.startswith("-") and a != "--json"]
    if len(names) != 1 or unknown:
        die("usage: labctl facts <tile> [--json]")
    name = names[0]
    matrix = load_matrix().get("tiles", {})
    sh_tile = name
    if name not in matrix:
        # A tile whose runtime dir is not the name given: the registry entry
        # resolves it. id == stationDir for every tile today, so this is the
        # schema-general path rather than a lookup that has to succeed.
        entry = registry_entry(name, lambda _m: None)
        sh_tile = entry.get("stationDir") or ""
        if sh_tile not in matrix:
            tile_conf(name)  # emits the canonical unknown-tile error and exits
    warnings = []
    facts = tile_facts(sh_tile, matrix[sh_tile], warnings.append)
    facts["warnings"] = warnings
    if "--json" in argv:
        print(json.dumps(facts, indent=2, sort_keys=True))
    else:
        print_facts(facts)


def cmd_gen(argv):
    gen = "/root/gen_tiles_json.py"
    if not os.path.exists(gen):
        die("generator %s not found on box" % gen)
    r = subprocess.run(["python3", gen], capture_output=True, text=True)
    sys.stdout.write(r.stdout)
    if r.returncode != 0:
        die(r.stderr.strip())


# ---- who / claims / wait-for ------------------------------------------------
# Session identity + the claim registry (kh-claim, scripts/lib/kh-claim.sh)
# and a wait primitive that runs ON the box so a session does not burn a turn
# on `sleep 1500`. See docs/lab/research/workflow-friction-2026-08.md.
SANDBOX_ROOT = os.environ.get("KH_SANDBOX_ROOT", "/data/vms/sandbox")


def _sandbox_procs():
    """pid -> (exe, sandbox top-level dir) for processes living in a sandbox."""
    out = {}
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            cwd = os.readlink("/proc/%s/cwd" % pid)
        except OSError:
            continue
        if cwd == SANDBOX_ROOT or cwd.startswith(SANDBOX_ROOT + "/"):
            rel = cwd[len(SANDBOX_ROOT) + 1 :].split("/", 1)[0] or "."
            try:
                exe = os.readlink("/proc/%s/exe" % pid)
            except OSError:
                exe = "?"
            out[int(pid)] = (exe, rel)
    return out


def cmd_who(argv):
    """claims + sandbox processes, grouped by session — 'whose is this?' in one call."""
    if not shutil.which("kh-claim"):
        die("kh-claim not installed on box (box-sync pair kh-claim)")
    r = subprocess.run(["kh-claim", "ls", "--json"], capture_output=True, text=True)
    claims = json.loads(r.stdout or "[]")
    procs = _sandbox_procs()
    if "--json" in argv:
        sp = {str(k): {"exe": v[0], "sandbox": v[1]} for k, v in procs.items()}
        print(json.dumps({"claims": claims, "sandbox_procs": sp}, indent=2))
        return
    if claims:
        print("claims (kh-claim ls):")
        for c in claims:
            row = (c["state"], c["class"], c["name"], c["session"], c["pid"] or "-", c["purpose"])
            print("  %-6s %-9s %-26s %-20s pid=%-8s %s" % row)
    else:
        print("claims: none")
    by = {}
    for pid, (exe, top) in procs.items():
        by.setdefault(top, []).append((pid, exe))
    if by:
        print("sandbox processes (cwd under %s):" % SANDBOX_ROOT)
        claimed = {c["name"]: c["session"] for c in claims if c["class"] == "sandbox"}
        for top in sorted(by):
            owner = claimed.get(top, "UNCLAIMED")
            procs_s = " ".join("%d:%s" % (p, os.path.basename(e)) for p, e in sorted(by[top])[:6])
            print("  %-28s %-16s %s" % (top, owner, procs_s))
    else:
        print("sandbox processes: none")


def cmd_claims(argv):
    """passthrough: labctl claims take|release|ls|who|gc ..."""
    if not shutil.which("kh-claim"):
        die("kh-claim not installed on box")
    os.execvp("kh-claim", ["kh-claim", *argv])


def cmd_wait_for(argv):
    """block ON THE BOX until a condition holds; exit 0 met, 3 timeout.
    labctl wait-for [--timeout S] [--interval S] --unit NAME [--state active]
                                                  | --file PATH | --gone PATH
                                                  | --port N | --cmd 'shell'"""
    timeout, interval = 600.0, 2.0
    cond = None
    i = 0
    while i < len(argv):
        a = argv[i]
        nxt = argv[i + 1] if i + 1 < len(argv) else None
        if a == "--timeout":
            timeout, i = float(nxt), i + 1
        elif a == "--interval":
            interval, i = float(nxt), i + 1
        elif a == "--unit":
            state = "active"
            if i + 2 < len(argv) and argv[i + 2] == "--state":
                state = argv[i + 3]
                i += 2
            cond = ("unit", nxt, state)
            i += 1
        elif a in ("--file", "--gone", "--port", "--cmd"):
            cond = (a[2:], nxt)
            i += 1
        else:
            die("wait-for: unknown argument %s" % a)
        i += 1
    if not cond:
        die(cmd_wait_for.__doc__)

    def met():
        k = cond[0]
        if k == "unit":
            r = subprocess.run(["systemctl", "is-active", cond[1]], capture_output=True, text=True)
            return r.stdout.strip() == cond[2]
        if k == "file":
            return os.path.exists(cond[1])
        if k == "gone":
            return not os.path.exists(cond[1])
        if k == "port":
            with socket.socket() as s:
                s.settimeout(1)
                return s.connect_ex(("127.0.0.1", int(cond[1]))) == 0
        if k == "cmd":
            return subprocess.run(cond[1], shell=True, capture_output=True).returncode == 0
        return False

    t0 = time.time()
    while True:
        if met():
            print("wait-for: met after %.0fs (%s)" % (time.time() - t0, " ".join(map(str, cond))))
            return
        if time.time() - t0 > timeout:
            print("wait-for: TIMEOUT after %.0fs (%s)" % (timeout, " ".join(map(str, cond))), file=sys.stderr)
            sys.exit(3)
        time.sleep(interval)


USAGE = """usage: labctl <command> [args]

Read-only inspection:
  labctl ls
  labctl facts <tile> [--json]
  labctl health [<tile>] [--json]
  labctl assert <tile> --text <s> | --template <png> | --settle

Framebuffer and guest operations:
  labctl shot <tile> [out.png]
  labctl type <tile> <text> [--verify]
  labctl key <tile> <qcode> [qcode ...]
  labctl sh <tile> <cmd>
  labctl exec <tile> <cmd>
  labctl mctl <tile> "<verb line>" [--timeout S]
  labctl reset <tile>
  labctl clone <tile> <N>
  labctl gen

Sessions and shared things:
  labctl who [--json]                 claims + sandbox processes by session
  labctl claims take|release|ls|who|gc ...   (kh-claim passthrough)
  labctl wait-for [--timeout S] --unit U [--state S] | --file P | --gone P | --port N | --cmd C
"""


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(USAGE)
        return
    cmd = sys.argv[1]
    rest = sys.argv[2:]
    table = {
        "ls": cmd_ls,
        "facts": cmd_facts,
        "health": cmd_health,
        "assert": cmd_assert,
        "shot": cmd_shot,
        "type": cmd_type,
        "key": cmd_key,
        "sh": cmd_sh,
        "exec": cmd_exec,
        "mctl": cmd_mctl,
        "reset": cmd_reset,
        "clone": cmd_clone,
        "gen": cmd_gen,
        "who": cmd_who,
        "claims": cmd_claims,
        "wait-for": cmd_wait_for,
    }
    fn = table.get(cmd)
    if not fn:
        die("unknown subcommand '%s'. try: %s" % (cmd, ", ".join(table)))
    try:
        fn(rest)
    except GuestPaused as exc:
        # A frozen guest is a specific, nameable state, not an unhandled
        # traceback and definitely not a silent success. Exit 4 so a script can
        # tell "the guest was asleep" from "the command failed".
        die(str(exc), 4)


if __name__ == "__main__":
    main()
