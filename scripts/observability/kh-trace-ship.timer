[Unit]
Description=kernel-hive: periodic daemon span spool ship (every 2 min)
Documentation=file:///data/kernel-hive/docs/ANALYTICS.md

[Timer]
# The period bounds how long a daemon span or log record waits in its station
# spool before /admin/observability can show it. Shortening it is free: an
# empty spool is a directory listing and nothing else. Correctness never
# depends on it — a batch is deleted only after the store took it, and both
# stores are idempotent on a re-ship (see trace-ship.py).
OnBootSec=90s
OnUnitActiveSec=2min
AccuracySec=15s

[Install]
WantedBy=timers.target
