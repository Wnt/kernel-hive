# /etc/osgallery-webrtc/bridge.env — box-side, NEVER committed (AGENTS.md rule 1).
# Written by streamhost/webrtc-bridge/deploy/install-bridge.sh, which resolves
# SH_GALLERY_HOST from registry/local.env; edit by hand only if that fails.
#
# The public IPv4 the edge VPS forwards UDP 54200 to the box from. The bridge
# ADDS it as a second host candidate on 54200 (keeps the LAN one), so a remote
# browser can reach the ICE socket through the edge's DNAT hole.
WEBRTC_PUBLIC_IP=203.0.113.10
