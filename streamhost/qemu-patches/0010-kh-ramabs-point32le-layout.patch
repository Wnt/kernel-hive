+        s->layout_id = KH_LAYOUT_POINT16LE;
+    } else if (strcmp(s->layout, "point32le") == 0) {
+        s->layout_id = KH_LAYOUT_POINT32LE;
+    } else {
+        error_setg(errp,
+                   "kh-ramabs: unknown layout=%s (have: point16le, point32le)",
                    s->layout);
         return;
     }
