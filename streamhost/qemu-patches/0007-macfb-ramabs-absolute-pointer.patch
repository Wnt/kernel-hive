diff --git a/include/hw/display/macfb-ptr.h b/include/hw/display/macfb-ptr.h
new file mode 100644
index 0000000..1e85d6b
--- /dev/null
+++ b/include/hw/display/macfb-ptr.h
@@ -0,0 +1,54 @@
+/*
+ * Absolute pointer engine for classic Mac OS guests (macfb / Quadra 800).
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or later.
+ * See the COPYING file in the top-level directory.
+ */
+
+#ifndef MACFB_PTR_H
+#define MACFB_PTR_H
+
+#include "chardev/char-fe.h"
+#include "qemu/timer.h"
+
+struct MacfbState;
+
+/*
+ * State for the `ramabs/1` control socket. NONE OF THIS IS MIGRATED: every
+ * field is either derived from guest RAM on demand or belongs to the live
+ * connection, so the vmstate signature -- and therefore the station's baked
+ * checkpoint -- is untouched by this engine. Do not add it to vmstate_macfb.
+ */
+typedef struct MacfbPtr {
+    CharFrontend chr;
+    struct MacfbState *fb;
+    bool trace;
+    /* Guest-physical base of low memory; 0 on q800. See macfb-ptr.c. */
+    uint64_t ram_base;
+
+    /* Line assembly for the command stream. */
+    char inbuf[512];
+    unsigned inlen;
+    bool overlong;
+
+    /* Commands are executed strictly in order; MOVEA blocks on read-back. */
+    GQueue *pending;
+
+    /* The one MOVEA awaiting read-back confirmation, if any. */
+    bool verify_active;
+    uint64_t verify_seq;
+    int verify_x, verify_y;
+    int64_t verify_deadline_ns;
+    QEMUTimer *verify_timer;
+
+    /* Telemetry -- what STAT reports, and the basis for "I do not know". */
+    uint64_t n_movea, n_verified, n_unverified;
+    uint64_t n_rejected, n_paused, n_btn;
+    int last_x, last_y;
+    bool last_valid;
+} MacfbPtr;
+
+void macfb_ptr_realize(MacfbPtr *p, struct MacfbState *fb);
+void macfb_ptr_unrealize(MacfbPtr *p);
+
+#endif
