From: Kernel Hive lab <lab@localhost>
Subject: [PATCH diagnostic] cirrus: add opt-in classified BLT diagnostics

Keep the existing tracepoint's raw registers and add one human-readable record
after the BLT path and copy direction have been decoded.  This is deliberately
gated by QEMU_CIRRUS_BLT_TRACE so normal tile processes remain silent.

This diagnostic patch is for the NT 3.51 Cirrus root-cause experiment.  It is
not intended for production installation.
---
 hw/display/cirrus_vga.c | 36 ++++++++++++++++++++++++++++++++++++
 1 file changed, 36 insertions(+)

diff --git a/hw/display/cirrus_vga.c b/hw/display/cirrus_vga.c
index 093a001d25..7ad8421d30 100644
--- a/hw/display/cirrus_vga.c
+++ b/hw/display/cirrus_vga.c
@@ -931,10 +931,40 @@ static int cirrus_bitblt_videotovideo(CirrusVGAState * s)
         cirrus_bitblt_reset(s);
     return ret;
 }
+
+static void cirrus_trace_bitblt(CirrusVGAState *s, uint8_t blt_rop,
+                                uint8_t raw_mode, const char *operation)
+{
+    const char *transfer;
+
+    if (!getenv("QEMU_CIRRUS_BLT_TRACE")) {
+        return;
+    }
+
+    if (raw_mode & CIRRUS_BLTMODE_MEMSYSSRC) {
+        transfer = "cpu-to-video";
+    } else if (raw_mode & CIRRUS_BLTMODE_MEMSYSDEST) {
+        transfer = "video-to-cpu";
+    } else {
+        transfer = "video-to-video";
+    }
+
+    fprintf(stderr,
+            "cirrus-blt: src=0x%08x dst=0x%08x w=%d h=%d "
+            "spitch=%d dpitch=%d rop=0x%02x bpp=%d mode=0x%02x "
+            "dir=%s transfer=%s op=%s\n",
+            s->cirrus_blt_srcaddr, s->cirrus_blt_dstaddr,
+            s->cirrus_blt_width, s->cirrus_blt_height,
+            s->cirrus_blt_srcpitch, s->cirrus_blt_dstpitch, blt_rop,
+            s->cirrus_blt_pixelwidth * 8, raw_mode,
+            raw_mode & CIRRUS_BLTMODE_BACKWARDS ? "backward" : "forward",
+            transfer, operation);
+}

 static void cirrus_bitblt_start(CirrusVGAState * s)
 {
     uint8_t blt_rop;
+    uint8_t raw_mode;

     if (!s->enable_blitter) {
         goto bitblt_ignore;
@@ -953,6 +983,7 @@ static void cirrus_bitblt_start(CirrusVGAState * s)
     s->cirrus_blt_mode = s->vga.gr[0x30];
     s->cirrus_blt_modeext = s->vga.gr[0x33];
     blt_rop = s->vga.gr[0x32];
+    raw_mode = s->cirrus_blt_mode;

     s->cirrus_blt_dstaddr &= s->cirrus_addr_mask;
     s->cirrus_blt_srcaddr &= s->cirrus_addr_mask;
@@ -1005,5 +1036,6 @@ static void cirrus_bitblt_start(CirrusVGAState * s)
          (CIRRUS_BLTMODE_PATTERNCOPY | CIRRUS_BLTMODE_COLOREXPAND)) {
         cirrus_bitblt_fgcol(s);
+        cirrus_trace_bitblt(s, blt_rop, raw_mode, "solid-fill");
         cirrus_bitblt_solidfill(s, blt_rop);
     } else {
         if ((s->cirrus_blt_mode & (CIRRUS_BLTMODE_COLOREXPAND |
@@ -1062,6 +1094,14 @@ static void cirrus_bitblt_start(CirrusVGAState * s)
                 }
             }
         }
+        cirrus_trace_bitblt(
+            s, blt_rop, raw_mode,
+            s->cirrus_blt_mode & CIRRUS_BLTMODE_COLOREXPAND ?
+                "color-expand" :
+            s->cirrus_blt_mode & CIRRUS_BLTMODE_PATTERNCOPY ?
+                "pattern-copy" :
+            s->cirrus_blt_mode & CIRRUS_BLTMODE_TRANSPARENTCOMP ?
+                "transparent-copy" : "copy");
         // setup bitblt engine.
         if (s->cirrus_blt_mode & CIRRUS_BLTMODE_MEMSYSSRC) {
             if (!cirrus_bitblt_cputovideo(s))
--
