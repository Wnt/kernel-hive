# ---- GOLDEN FIXTURE (bridge tile) ----
# resetMode=loadvm -> restore the INTERNAL 'golden' snapshot (X started with
# -nocursor + MAME already at the MPF-II BASIC prompt), then reset-tile.sh sends
# the registry-declared postRestoreKeys so the emulated MPF-II re-runs its own
# ROM power-on (banner + speaker beep). No Linux console ever becomes visible.
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_FIXTURE_DESC=Multitech Microprofessor II Applesoft BASIC 560x192 @ 60 Hz composite (6-colour artifact) drawn fullscreen with aspect correction on a 1024x768 X root in MAME mpf2; golden snapshot restores X (-nocursor) + MAME at the BASIC prompt and a MAME soft reset re-runs the ROM power-on beep; keyboard-only exhibit; no pointer device.

# ---- KEYBOARD QUIRKS (the exhibit's only input surface) ----
# No Backspace exists in this machine's 8x8 matrix: MAME's tk2000.cpp, which the
# mpf2 driver clones, declares only KEYCODE_LEFT/KEYCODE_RIGHT of the whole edit
# cluster. As on the Apple II it clones, LEFT ARROW *is* the rubout key, so the
# browser's Backspace (XT set1 0x0e) is delivered as Left (0xe04b). Applies to
# both the physical keyboard and the SPA on-screen keyboard — they share one
# wire record.
SH_KEY_REMAP=0x0e:0xe04b
# MAME samples its input ports once per emulated frame (~16.7 ms at 60 Hz), so a
# press+release pair completing inside one frame is never observed and the
# keystroke is lost — which is exactly what fast typing produces. Hold every key
# for at least 2 frames; key events serialize while this is on, so out-typing the
# hold queues rather than drops.
# The MPF-II's matrix is not laid out like a PC's: '=' is Shift+O, '-' is
# Shift+I, and its shifted number row is offset by one, so ( ) * each land a key
# over. Derived from the MAME driver by scripts/dev/mame-keymap.py and declared
# once in the registry `keyboard` block; CI pins this copy to it.
SH_KEY_MAP==:O,-:I,+:P,(:*,):(,*:)
SH_KEY_MIN_HOLD_MS=32
# ...and the SPACE between two keys must be visible too. Measured on this live
# tile: with a 130 ms hold, a release-to-press gap of 2 ms (what browser typing
# leaves) turns "abcd" into "AAD" — the machine reads one long chord — while
# >= 8 ms is flawless. 32 ms = 2 frames of margin.
SH_KEY_MIN_GAP_MS=32
