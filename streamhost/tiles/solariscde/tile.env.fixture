
# --- GOLDEN TEST FIXTURE (added by golden-fixture bake) ---
# resetMode=loadvm : single standalone qcow2, snapshot "golden" holds live RAM+device+disk.
# Reset a test to the fixture with:  bash tiles/solariscde/golden-reset.sh
#   (or: python3 tiles/solariscde/drive.py tiles/solariscde/qmp.sock loadvm golden)
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_GOLDEN_DISK=solariscde-golden.qcow2
SH_GOLDEN_MANIFEST=tiles/solariscde/golden.json
# Fixture: Solaris 10 CDE desktop, dtterm GOLDEN-FIXTURE-TERMINAL open + keyboard-focused
# (keyboard-reactive: typed chars + solid non-blinking cursor; dtterm menus + front panel
# workspace One/Two/Three/Four + clear Corrugated backdrop = mouse targets). Screen never
# blanks (X screensaver 0 + DPMS disabled + dtsession saver/lock/cycle 0). No idle animation
# (front-panel Clock removed, perf-meter killed/frozen). Baseline framebuffer md5 872a0cfc...
# See golden.env / golden.json.
SH_WARPD_ADDR=127.0.0.1:57790
# Native hardware-input socket. The manifest emits the unified
# SH_INPUT_BACKEND=gallery-hid selection; the warpd agent is rollback/exec only.
SH_GHID_SOCKET=/data/vms/streamhost/tiles/solariscde/gallery-hid.sock
