
# ---- GOLDEN FIXTURE (bridge tile) ----
# resetMode=loadvm -> QMP human-monitor-command "loadvm golden" (live, no reboot).
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
# The CPC's keyboard matrix is scanned by the PSG once per 50 Hz frame (20 ms).
# Browser typing leaves ~2 ms between one key's release and the next key's press,
# so the machine never samples the all-keys-up state and reads a typed line as
# one long chord -- most of the characters are lost. Hold and gap are 2 frames,
# the same 2x margin measured on mpf2 (its knee sat exactly at 1 frame).
SH_KEY_MIN_HOLD_MS=40
SH_KEY_MIN_GAP_MS=40
SH_FIXTURE_DESC=Amstrad CPC 6128 Locomotive BASIC yellow-on-blue Ready prompt in Caprice32 (cap32); explicit key down/up keyboard path certified with PRINT, RETURN, and RUN; keyboard-only exhibit; AY-3-8912->ALSA->AC97. Keyboard pacing: SH_KEY_MIN_HOLD_MS=40 and SH_KEY_MIN_GAP_MS=40 hold each key and space successive keys by 2 emulated frames (the CPC's matrix is scanned by the PSG once per 50 Hz frame = 20 ms); without the gap, back-to-back typing never lets the machine sample the all-keys-up state and it reads one long chord, losing most of a typed line.
