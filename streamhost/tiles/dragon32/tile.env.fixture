# ---- GOLDEN FIXTURE (bridge tile) ----
# resetMode=loadvm -> restore the INTERNAL 'golden' snapshot: X (-nocursor) +
# MAME 0.289 `dragon32 -ext ""` at the Dragon's own untouched power-on screen.
# Nothing is curated into the fixture and nothing is typed after the restore;
# the Plus/4's rejected in-application golden is the reason (see plus4.sh).
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_FIXTURE_DESC=Dragon 32 (PAL) at its own untouched power-on screen: "(C) 1982 DRAGON DATA LTD / 16K BASIC INTERPRETER 1.0 / (C) 1982 BY MICROSOFT / OK", dark green on the MC6847's bright green page, drawn fullscreen with aspect correction by MAME 0.289's dragon32 driver on a 1024x768 X root (the dark surround is the Dragon's own border, not letterboxing). The launcher empties the driver's `ext` slot with -ext "": with the default dragon_fdc cartridge the machine boots DRAGONDOS 1.0 instead, and -verifyroms actively demands the FDC ROM that produces that wrong screen. Nothing is curated and nothing is typed. Keyboard-only exhibit; no pointer device; 6-bit DAC sound -> ALSA -> AC97.

# ---- KEYBOARD PACING (the exhibit's only input surface) ----
# The Dragon's MC6847 frame is 49.97 Hz, so one emulated frame is 20.01 ms and
# the frame-derived two-frame floor is 40/40. That floor is NOT the answer: the
# residual loss this box shows is a host SCHEDULING stall, not frame
# quantisation, and it does not scale with the frame period. Bisected on a
# clone of this tile with scripts/dev/emu-key-pacing-bisect.py (2026-08-09,
# 10 trials of a 40-character line at each pacing) — see docs/guests/dragon32.md
# for the table. 80/80 is what shipped, matching vic20/plus4/c128.
SH_KEY_MIN_HOLD_MS=80
SH_KEY_MIN_GAP_MS=80
# The Dragon's matrix does NOT agree with a US PC keyboard, and untranslated the
# disagreement reads as dropped keystrokes rather than as a layout fault.
# Derived from the driver's own PORT_CHAR pairs with scripts/dev/mame-keymap.py
# (src/mame/trs/dragon.cpp, INPUT_PORTS dragon_keyboard): '"' is SHIFT+2 where a
# PC has '@', the shifted number row is offset by one from '&' upward, ':' and
# '*' live on the key a PC labels '-', ';' and '+' on ';', '-' and '=' on '=',
# and '@' is on '['. Letters are UNSHIFTED capitals (keyboard.letterCase =
# upper-only in the registry), because SHIFT+letter is the Dragon's lower case.
# ':' has no literal spelling in this comma/colon wire format — it would render
# as "::-", whose split(':', 1) yields an empty guest and drops the pair — so it
# is percent-encoded as %3A on both sides (keymap_escape in
# scripts/tiles-registry.py, keymap_unescape in scripts/labctl).
SH_KEY_MAP=@:[,":@,&:^,':&,(:*,):(,%3A:-,*:_,+:%3A,-:=,=:+
