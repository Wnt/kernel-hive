
# ---- GOLDEN FIXTURE (bridge tile) ----
# resetMode=loadvm -> QMP human-monitor-command "loadvm golden" (live, no reboot).
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_FIXTURE_DESC=SGI Indy (MIPS R4400) IRIX 6.5.22 Indigo Magic graphical login in Iris; 1280x1024 X root, 1:1 capture, no audio.

# Iris samples its input once per emulated frame and the whole keyboard is
# synthetic here, so pace press/release like every other bridge exhibit
# (playbook 5.1). Derived from the emulated 60 Hz refresh, then measured.
SH_KEY_MIN_HOLD_MS=40
SH_KEY_MIN_GAP_MS=40

# NOTE: deliberately NO SH_IDLE_PAUSE_SECS override. Iris is the most expensive
# emulator in the lineup (~3-4 cores while running), so this tile MUST take the
# fleet default idle pause and stop burning host CPU when nobody is watching.
