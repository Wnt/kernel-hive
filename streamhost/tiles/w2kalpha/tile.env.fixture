# ---- GOLDEN FIXTURE (x11 runtime tile) ----
# resetMode=relaunch -> kill-by-pidfile + fresh es40; the launcher reflink-
# copies the golden nt.img on EVERY launch, so each boot is pristine. es40's
# savestate restore (ES40_RESTORE) is deliberately NOT used: a restored guest
# partial-paints new dialogs (post-restore repaint fragility — see
# docs/lab/research/w2kalpha-HANDOFF.md); a cold boot (~80 s) renders
# everything.
SH_RESET_MODE=relaunch
SH_FIXTURE_DESC=Windows 2000 RC2 (build 2128, Alpha AXP) 1280x1024 desktop in es40 (AlphaServer ES40, EV68); SH_CAPTURE=shm (headless SDL dummy, no X server) + mamesock ctlsock input; cold boot ~80 s per relaunch.

# ---- POINTER/KEY INPUT (SH_* read by the daemon; the socket served by es40) --
# mamesock = the daemon speaks mamectl/1 straight to the ctlsock the es40 fork
# serves (src/gui/ctlsock.h, armed by the launcher via ES40_CTL_SOCK). Keyboard
# is verified end to end (framebuffer proof: Start menu opened headless).
# Pointer is open-loop absolute: the guest still runs default Windows pointer
# acceleration, so clicks are NOT yet pixel-exact — the golden-polish pass
# (guest Mouse control panel -> acceleration None, then re-capture the golden)
# is what makes MOVEA land 1:1. Until then reset.mouse stays UNVERIFIED.
SH_INPUT_BACKEND=mamesock
SH_MAMECTL_SOCK=/data/vms/streamhost/tiles/w2kalpha/ctl.sock

# ---- IDLE AUTO-PAUSE: OFF (deliberate, not an omission) ----
# es40 anchors the guest's cycle counter (RPCC) and interval timer to WALL
# CLOCK; SIGSTOP/SIGCONT freezing (irix's SH_IDLE_PAUSE_PIDFILE arm) would hand
# the guest a large clock discontinuity on resume — the same fault class as the
# post-restore-under-load wedge (w2kalpha-HANDOFF.md). Keep the exhibit
# always-running until the RPCC re-anchor fix lands in the fork; then copy
# irix's SH_IDLE_PAUSE_* stanza (pidfile mame.pid, proc match es40).
SH_IDLE_PAUSE_SECS=0
