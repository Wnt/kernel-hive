# ---- GOLDEN FIXTURE (bridge tile) ----
# resetMode=loadvm -> restore the INTERNAL 'golden' snapshot: X (-nocursor) +
# VICE xplus4 at the Plus/4's own untouched power-on screen, whose second line
# ("3-PLUS-1 ON KEY F1") is the exhibit's launcher. Nothing is curated into the
# fixture and nothing is typed after the restore. An earlier golden rested
# INSIDE the suite and was replaced: it dropped visitors into the middle of an
# application with no way to tell what it was or how to leave.
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_FIXTURE_DESC=Commodore Plus/4 (PAL) at its own untouched power-on screen: "COMMODORE BASIC V3.5 / 60671 BYTES FREE / 3-PLUS-1 ON KEY F1 / READY." in black on a white page inside a lavender border, drawn double-size (-TEDdsize) by VICE xplus4 on an 800x600 X root. Nothing is curated and nothing is typed: the ROM's own message is the exhibit's launcher, and F1+RETURN enters the built-in 3-plus-1 office suite. Module switching inside the suite needs C= + C (Tab under VICE's symbolic keymap) followed by tw/tc/tf, which the SPA's plus4 on-screen keyboard sends from one labelled button each. Keyboard-only exhibit; no pointer device; TED sound -> ALSA -> AC97.

# ---- KEYBOARD PACING (the exhibit's only input surface) ----
# Same emulator, same 50 Hz PAL frame and the same host as vic20, so the same
# four frames each way. Those numbers were BISECTED on the VIC-20
# (scripts/dev/emu-key-pacing-bisect.py: 40/40 corrupted 1 line in 22, 80/80
# none in 22) and are carried over here rather than re-measured; the failure
# they guard against is a host scheduling stall, which is a property of this
# box rather than of the emulated machine. Re-bisect this tile if it ever
# shows dropped characters.
SH_KEY_MIN_HOLD_MS=80
SH_KEY_MIN_GAP_MS=80
# No SH_KEY_MAP: VICE's default SDL symbolic keymap already maps host ASCII
# onto the Commodore matrix. The one key that matters here and has no PC
# equivalent is the Commodore key itself, which is Tab — the SPA's plus4
# keyboard profile labels it, and its Word/Calc/File buttons mean a visitor
# never has to know that.
