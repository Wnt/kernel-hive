$ SET NOON
$! Snapshot execution resumes here only after the bridge X listener is ready.
$ WAIT 00:00:12
$ SET DISPLAY/CREATE/NODE=10.0.2.2/TRANSPORT=TCPIP/SERVER=610/SCREEN=0
$ display = F$TRNLNM("DECW$DISPLAY")
$ RUN/DETACHED/OUTPUT='display' SYS$SYSTEM:DECW$MWM
$ WAIT 00:00:02
$ SPAWN/NOWAIT/INPUT=NL:/OUTPUT=NL: RUN SYS$SYSTEM:VUE$MASTER
$ SPAWN/NOWAIT/INPUT=NL:/OUTPUT=NL: RUN SYS$SYSTEM:DECW$CALC
$ SPAWN/NOWAIT/INPUT=NL:/OUTPUT=NL: RUN SYS$SYSTEM:DECW$CLOCK
$ WAIT 00:00:03
$ CREATE/TERMINAL=DECTERM -
 /WINDOW_ATTRIBUTES=(ROWS=10,COLUMNS=68,X_POSITION=190,Y_POSITION=430, -
 TITLE="DECterm 1",ICON_NAME="DECterm 1")
$ EXIT
