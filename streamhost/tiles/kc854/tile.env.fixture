# ---- GOLDEN FIXTURE (bridge tile) ----
# resetMode=loadvm -> restore the INTERNAL 'golden' snapshot: X (-nocursor) +
# MAME 0.289 kc85_4 at the KC 85/4's own untouched CAOS 4.2 power-on screen.
# Nothing is curated into the fixture and nothing is typed after the restore.
# CAOS prints its own command menu at power-on, so the machine's honest idle
# state is also its launcher — the same argument the Plus/4's re-baked golden
# settled, and the reason no application is baked in here either.
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_FIXTURE_DESC=KC 85/4 (VEB Mikroelektronik "Wilhelm Pieck" Mühlhausen, 1988) at its own untouched power-on screen: CAOS 4.2's command menu and prompt, drawn by MAME 0.289 kc85_4 (-bios caos42) fullscreen with aspect correction on a 1024x768 X root. Nothing is curated and nothing is typed — the operating system prints the list of things a visitor can type, which makes the machine's honest idle screen its own launcher. BASIC starts HC-BASIC from the second ROM; MENU brings the list back. Keyboard-only exhibit; no pointer device; KC speaker -> ALSA -> AC97. THE DRIVER IS `preliminary`, so a stock MAME would open it with a full-screen red "THIS SYSTEM DOESN'T WORK" panel that -skip_gameinfo does not suppress: the shipped binary carries mame-irix-skip-warnings.patch and /opt/kc854/ui.ini sets skip_warnings 1. If red ever appears in this fixture, the deployment has regressed.

# ---- KEYBOARD PACING (the exhibit's only input surface) ----
# MAME samples the emulated matrix once per emulated frame. The KC 85/4's frame
# is 50.080411 Hz = 19.97 ms, so the frame-derived floor is 40/40. That floor is
# NOT what ships. MEASURED on a namespaced clone of this tile (2026-08-09,
# scripts/dev/emu-key-pacing-bisect.py, a 32-character line typed at the CAOS
# prompt, 12 trials per pacing, each frame compared against the consensus frame
# whose 32 characters were read off the framebuffer one by one):
#
#     hold/gap   lines corrupted
#      40/40       1 of 12   (K and O dropped out of KLMNOPQRST)
#      60/60       1 of 12
#      80/80       0 of 12
#     250/250      1 of 1    -- see below
#
# 250/250 IS NOT A SAFE UPPER BOUND ON THIS MACHINE, which is the surprise:
# emu-key-pacing-bisect.py captures its reference there on the assumption that a
# long hold cannot lose anything, and on the KC it lost SEVEN of 32 characters
# (the line stopped at "...KL"). Every fast trial agreed with every other and
# the slow reference was the outlier, so the tool's own pass/fail output reads
# 12/12 corrupt at all three pacings and must be re-scored against the
# consensus frame. A long hold is a DIFFERENT failure here, not a conservative
# one: the KC 85 keyboard is a separate serial device with its own repeat
# timing rather than a matrix the CPU scans, so holding a key is not free.
SH_KEY_MIN_HOLD_MS=80
SH_KEY_MIN_GAP_MS=80

# ---- KEYBOARD LAYOUT: a German matrix, derived from the driver ----
# SH_KEY_MAP is generated from registry/tiles/kc854.json's keyboard.charMap,
# which scripts/dev/mame-keymap.py derived MECHANICALLY from MAME's
# src/mame/ddr/kc_keyb.cpp — the same tool and method the MPF-II remaps came
# from. Two things it encodes:
#   * the letter row is INVERTED. Every letter is declared PORT_CHAR('B')
#     PORT_CHAR('b'), in that order, so the KC's plain keys are CAPITALS and
#     shift gives lower case. Unshifted `basic` produces BASIC.
#   * the punctuation is German: ':' is on the host '-' key, '+' on ';', '-' on
#     '=', '^' on '[', and the shifted number row is Continental (Shift+2 is
#     '"', Shift+6 '&', Shift+7 '\'', Shift+0 '@').
# %3A is an escaped ':'. The wire format joins `guest:host` pairs with commas,
# so a guest character that IS a colon used to render as `::-` and be silently
# DROPPED by labctl's split(':', 1) — this tile is the first to need it, and
# the encode/decode pair lives in scripts/stations-registry.py (render_key_map)
# and scripts/labctl (keymap_unescape).
SH_KEY_MAP=W:w,w:W,A:a,a:A,":@,-:=,=:+,Y:y,y:Y,E:e,e:E,S:s,s:S,^:[,%3A:-,*:_,X:x,x:X,T:t,t:T,F:f,f:F,P:p,p:P,@:),V:v,v:V,U:u,u:U,H:h,h:H,':&,O:o,o:O,):(,N:n,n:N,I:i,i:I,J:j,j:J,(:*,K:k,k:K,M:m,m:M,Z:z,z:Z,G:g,g:G,&:^,L:l,l:L,B:b,b:B,R:r,r:R,D:d,d:D,|:",+:;,;:%3A,C:c,c:C,Q:q,q:Q
