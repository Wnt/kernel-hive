
# ---- GOLDEN FIXTURE (see GOLDEN.md for the machine-readable manifest) ----
# resetMode=loadvm : disk is a standalone qcow2, snapshot "golden" holds live RAM+disk.
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_GOLDEN_DISKS=nt4-golden.qcow2
# Fixture: Windows NT 4.0 Workstation SP6a Explorer desktop at
# 1024x768x65536 colors (16bpp), accelerated by the SP6a Cirrus driver.
# Administrator auto-logon, pointer parked lower-right, screensaver off. The
# crashing VMwareService/Tray/User programs and unused failing archive drivers
# are disabled, but vmmouse.sys is preserved for true absolute input.
