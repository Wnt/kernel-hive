# ---- GOLDEN FIXTURE (bridge tile) ----
# resetMode=loadvm -> restore the INTERNAL 'golden' snapshot: X (-nocursor) +
# VICE xcbm2 at the CBM 610's own untouched power-on screen. Nothing is curated
# into the fixture and nothing is typed after the restore — the machine's cold
# screen is the exhibit, exactly as the plus4 tile learned to do it.
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_FIXTURE_DESC=Commodore CBM 610 (PAL, 1982) at its own untouched power-on screen: "*** commodore basic 128, v4.0 ***" and "ready." with the block cursor beneath it, green on black at 80 columns, drawn by VICE xcbm2 -model 610 at NATIVE size (704x528 window, no -CRTCdsize) and centred by SDL on an 800x600 X root. This is the CBM-II / B-series business machine — a MOS 6509 bank-switching a megabyte, not the Commodore 128 of 1985, which merely took the same number. Nothing is typed: BASIC 128 v4.0 is the whole machine as sold with no disk attached, and the visitor types at the prompt through the SPA's on-screen keyboard. Keyboard-only exhibit; no pointer device; SID audio -> ALSA -> AC97.

# ---- KEYBOARD PACING (the exhibit's only input surface) ----
# Same emulator, same 50 Hz PAL frame and the same host as vic20/plus4, so the
# same four frames each way. Those numbers were BISECTED on the VIC-20
# (scripts/dev/emu-key-pacing-bisect.py: 40/40 corrupted 1 line in 22, 80/80
# none in 22) and are carried over here rather than re-measured; the failure
# they guard against is a host scheduling stall, which is a property of this
# box rather than of the emulated machine. Two frames is a floor, not an
# answer. Re-bisect this tile if it ever shows dropped characters.
SH_KEY_MIN_HOLD_MS=80
SH_KEY_MIN_GAP_MS=80
# No SH_KEY_MAP: VICE's default SDL symbolic keymap already maps host ASCII
# onto the CBM-II matrix, and this machine's business keyboard has no key
# without a PC equivalent that the exhibit needs (there is no Commodore key on
# a CBM-II; RUN/STOP is Esc and the numeric keypad is ordinary digits).
