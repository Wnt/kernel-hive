# ---- GOLDEN FIXTURE (bridge tile) ----
# resetMode=loadvm -> restore the INTERNAL 'golden' snapshot (X started with
# -nocursor + VICE xvic already at the VIC-20 BASIC READY prompt). Nothing is
# typed after the restore: the mpf2 add proved that post-restore key injection
# races the restore and can leave the exhibit scrolled.
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_FIXTURE_DESC=Commodore VIC-20 (PAL) ROM BASIC power-on screen — "**** CBM BASIC V2 **** / 3583 BYTES FREE / READY." in blue on white paper inside a cyan border, drawn double-size (-VICdsize) by VICE xvic on an 800x600 X root; golden snapshot restores X (-nocursor) + xvic at the READY prompt exactly as baked from an untouched cold boot; keyboard-only exhibit; no pointer device; VIC-I sound -> ALSA -> AC97.

# ---- KEYBOARD PACING (the exhibit's only input surface) ----
# VICE samples the emulated VIC-20 keyboard matrix once per emulated PAL frame
# (50 Hz, 20 ms), so a press+release pair that completes inside one frame is
# never observed and the keystroke is simply lost — which is what unpaced
# browser typing produces (it leaves ~2 ms between keys). Playbook §5.1: derive
# the values from the machine's frame period and ship two frames of margin.
# 2 x 20 ms = 40 ms hold, 40 ms release->press gap. Same numbers as amstradcpc,
# and for the same 50 Hz reason.
SH_KEY_MIN_HOLD_MS=40
SH_KEY_MIN_GAP_MS=40
# No SH_KEY_MAP: unlike the MPF-II, this machine's matrix does not have to be
# re-derived. VICE's default SDL SYMBOLIC keymap (sdl_sym.vkm) already maps host
# ASCII to the Commodore key that produces that character, including the shifted
# punctuation the VIC-20 places differently from a PC. What the SPA does have to
# know is that the machine is upper-case-only — a SHIFTED letter on a VIC-20 is a
# graphics glyph, not a capital — which the registry `keyboard.letterCase` field
# declares and the SPA typist honours by sending letters unshifted.
