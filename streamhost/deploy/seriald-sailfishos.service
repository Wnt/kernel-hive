[Unit]
Description=sailfishos serial console daemon (seriald, reconnecting) — idle-CPU fix
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /data/vms/streamhost/stations/sailfishos/seriald.py /data/vms/streamhost/stations/sailfishos/serial.sock /data/vms/streamhost/stations/sailfishos
Restart=on-failure
RestartSec=2
Nice=5

[Install]
WantedBy=multi-user.target
