[Unit]
Description=warpd to gallery-hid pointer bridge (%i)
PartOf=streamhost@%i.service

[Service]
Type=simple
EnvironmentFile=/data/vms/streamhost/stations/%i/station.env
ExecStart=/usr/bin/python3 /data/vms/streamhost/build/streamhost/guest-agents/solaris-galleryhid/warpd-to-ghid-bridge.py --listen ${SH_WARPD_ADDR} --socket ${SH_GHID_SOCKET}
Restart=on-failure
RestartSec=1
Nice=5

[Install]
WantedBy=multi-user.target
