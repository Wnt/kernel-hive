+InputEventGenerator::HiveMouseCmd::HiveMouseCmd(CommandController& controller)
+    : Command(controller, "hive_mouse") {}
+std::string InputEventGenerator::HiveMouseCmd::help(std::span<const TclObject>) const
+{ return "hive_mouse dx dy buttons (bounded relative pointer; buttons 0..3)"; }
+void InputEventGenerator::HiveMouseCmd::execute(std::span<const TclObject> tokens, TclObject& result)
+{
+    result = int(Mouse::hiveSamples & 0x7fffffff);
+    if (tokens.size() == 1) return;
+    if (tokens.size() != 4) throw CommandException("Expected dx dy buttons");
+    int dx = tokens[1].getInt(getInterpreter());
+    int dy = tokens[2].getInt(getInterpreter());
+    int next = tokens[3].getInt(getInterpreter());
+    if (dx < -1024 || dx > 1024 || dy < -1024 || dy > 1024 || next < 0 || next > 3)
+        throw CommandException("Pointer range exceeded");
+    auto& input = OUTER(InputEventGenerator, hiveMouseCmd);
+    SDL_Event evt{};
+    evt.motion.type = SDL_MOUSEMOTION;
+    evt.motion.timestamp = SDL_GetTicks();
+    evt.motion.xrel = dx; evt.motion.yrel = dy;
+    input.eventDistributor.distributeEvent(MouseMotionEvent(evt));
+    for (unsigned bit = 0; bit < 2; ++bit) {
+        unsigned mask = 1u << bit;
+        if ((buttons ^ unsigned(next)) & mask) {
+            SDL_Event edge{};
+            bool down = (unsigned(next) & mask) != 0;
+            edge.button.type = down ? SDL_MOUSEBUTTONDOWN : SDL_MOUSEBUTTONUP;
+            edge.button.timestamp = SDL_GetTicks();
+            edge.button.button = bit == 0 ? SDL_BUTTON_LEFT : SDL_BUTTON_RIGHT;
+            edge.button.state = down ? SDL_PRESSED : SDL_RELEASED;
+            if (down) input.eventDistributor.distributeEvent(MouseButtonDownEvent(edge));
+            else input.eventDistributor.distributeEvent(MouseButtonUpEvent(edge));
+        }
+    }
+    buttons = unsigned(next);
+}
+
 } // namespace openmsx
