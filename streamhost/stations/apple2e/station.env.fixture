# ---- HOST-NATIVE STATION (de-bridged from day one — apple2e wave, native
# stream, 2026-09-08) ----
# MAME 0.289's apple2ee runs ON THE HOST — same engine as mpf2 (apple/
# family, sibling driver apple2e.cpp), drawshm frames, ctlsock keys through
# the generated keymap, sound -> SDL disk -> FIFO with the daemon as clock.
# Launcher: shared stations/mame-native/x11-runtime.sh; reset = relaunch
# restoring the golden savestate (apple2ee has MACHINE_SUPPORTS_SAVE).
SH_RESET_MODE=relaunch
SH_FIXTURE_DESC=Apple //e (enhanced) boot menu -- ProDOS 8 + BASIC.SYSTEM auto-runs a STARTUP Applesoft program on the /HIVE volume (CFFA 2.0 in slot 7) offering ProDOS, AppleWorks and Dazzle Draw -- drawn at 560x192 with aspect correction on the published 1024x768 surface by MAME 0.289's apple2ee running HOST-NATIVE (drawshm); the golden savestate restores the menu and a relaunch re-runs it instantly. Apple II Mouse Card in slot 4 (Dazzle Draw uses it), Disk II NG controller in slot 6 (default, unused by the menu). Keyboard is the //e's own hardware encoder, not a CPU-scanned matrix like mpf2's.
MAME_NATIVE_BIN=/data/vms/streamhost/assets/apple2e/mame-native/apple2e
MAME_NATIVE_DRIVER=apple2ee
MAME_NATIVE_ROMS=/data/vms/streamhost/assets/apple2e/mame-native/roms
MAME_NATIVE_GEOM=1024x768
MAME_NATIVE_SKIP_WARNINGS=0
MAME_NATIVE_ARGS=-sl4 mouse -sl6 diskiing -sl7 cffa2 -hard1 /data/vms/streamhost/assets/apple2e/media/hive.hdv
SH_MAMECTL_SOCK=/data/vms/streamhost/stations/apple2e/ctl.sock
SH_MAMESOCK_KEYMAP=/data/vms/streamhost/stations/apple2e/apple2e.keymap
SH_AUDIO_SOURCE=fifo
SH_AUDIO_FIFO=/data/vms/streamhost/stations/apple2e/audio.fifo

# ---- STANDBY (instant-ready: an emulator nobody watches costs ~0 CPU) ----
# Same contract as every converted station: launcher freezes the emulator
# once the scene has painted, daemon SIGSTOP after idle grace, unconditional
# SIGCONT on the first session. SH_IDLE_PAUSE_PROC_MATCH is scoped to this
# station's own asset path so a deploy never signals the wrong MAME.
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/apple2e/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/apple2e/mame-native
MAME_NATIVE_STANDBY_DELAY_S=8

# ---- KEYBOARD (menu selector + AppleWorks/Dazzle Draw typing) ----
# UNVERIFIED pending the native stream's live-rig typing proof: the //e's
# keyboard is scanned by its own hardware encoder chip (not a CPU-polled
# matrix like mpf2's), so MAME_CTL_KEY_EXCL is NOT expected to be required
# here -- ship without it unless the typing proof shows dropped/duplicated
# characters. Pacing starts at the fleet default 40/40ms (not mpf2's
# bisected 32/32) until a rig proves otherwise.
SH_KEY_MIN_HOLD_MS=40
SH_KEY_MIN_GAP_MS=40

# ---- POINTER (Apple II Mouse Card, slot 4 -- Dazzle Draw's double hi-res
# paint is the only in-menu consumer) ----
# UNVERIFIED pending the native stream's live-rig PROBE/STAT proof. Tags are
# the mouse card's own ioport names at its slot-4 device tag (bus/a2bus/
# mouse.cpp: PORT_START("a2mse_button"/"a2mse_x"/"a2mse_y")); MEASURED via
# KEYDUMP on the live rig (2026-09-08): the full tag is ":sl4:mouse:a2mse_*"
# (the "-sl4 mouse" SLOT OPTION NAME "mouse" is its own path segment, not
# just the slot tag "sl4" as the ledger's from-source guess had it).
# PORT_NAME("Mouse Button") -- one button, so right/middle are empty on
# purpose (mirrors the ST's shape, docs/lab/DEBRIDGE-HANDOVER.md). MOD=256
# because a2mse_x/_y are 8-bit fields (0xff mask, sensitivity 40), NOT the
# module's 65536 SGI default -- an unset MOD here would saturate the axis on
# the first slam exactly like the ST's uncorrected case.
MAME_CTL_PTR_TAGS=:sl4:mouse:a2mse_button,:sl4:mouse:a2mse_x,:sl4:mouse:a2mse_y
MAME_CTL_BTN_NAMES=Mouse Button,,
MAME_CTL_PTR_MOD=256
