# ---- HOST-NATIVE STATION (de-bridged from day one — apple2e wave, native
# stream, 2026-09-08) ----
# MAME 0.289's apple2ee runs ON THE HOST — same engine as mpf2 (apple/
# family, sibling driver apple2e.cpp), drawshm frames, ctlsock keys through
# the generated keymap, sound -> SDL disk -> FIFO with the daemon as clock.
# Launcher: shared stations/mame-native/x11-runtime.sh; reset = relaunch
# restoring the golden savestate (apple2ee has MACHINE_SUPPORTS_SAVE).
SH_RESET_MODE=relaunch
SH_FIXTURE_DESC=Apple //e (enhanced) boot menu -- ProDOS 8 + BASIC.SYSTEM auto-runs a tokenized Applesoft STARTUP program on the /HIVE volume (CFFA 2.0 in slot 7): [1] AppleWorks 3.0, [2] Dazzle Draw 1.2, [B] BASIC -- drawn at 560x192 with aspect correction on the published 1024x768 surface by MAME 0.289's apple2ee running HOST-NATIVE (drawshm). MEASURED 2026-09-08: cold boot reaches the menu in 2.6 s, the golden savestate restores it in 0.5 s, and the keyboard drives the whole path -- AppleWorks asks its GETTING STARTED date once (Return accepts the ProDOS clock's value) and Dazzle Draw needs Space past the title then Return at its launcher panel, which already reads "Input Device: Mouse". Apple II Mouse Card in slot 4; MOVEA now tracks at the right scale, from the right origin and with an exactly-integrated belief, landing a first lap of five targets within 6 px and opening the Tools menu with a click; the arrow still walks off toward the bottom-left over a second and third lap (worst 39 px) because the guest LOSES counts the module cannot see, so the pointer stays an open item and the station ships keyboard-only. Keyboard is the //e's own hardware encoder, not a CPU-scanned matrix like mpf2's.
MAME_NATIVE_BIN=/data/vms/streamhost/assets/apple2e/mame-native/apple2e
MAME_NATIVE_DRIVER=apple2ee
MAME_NATIVE_ROMS=/data/vms/streamhost/assets/apple2e/mame-native/roms
MAME_NATIVE_GEOM=1024x768
MAME_NATIVE_SKIP_WARNINGS=0
# CHECKPOINT KEPT (=1, the launcher default, stated here because it was a
# decision): apple2ee has MACHINE_SUPPORTS_SAVE and the restore is PROVEN
# frame-identical to the cold-boot menu, in-process (LOADST after dirtying
# the screen with [B]) and via a relaunch with -state golden -- 0.5 s to the
# scene against 2.6 s cold. The cold boot is fast enough that a future
# MAME_NATIVE_CHECKPOINT=0 would also be acceptable; nothing forces it.
MAME_NATIVE_CHECKPOINT=1
MAME_NATIVE_ARGS=-sl4 mouse -sl6 diskiing -sl7 cffa2 -hard1 /data/vms/streamhost/assets/apple2e/media/hive.hdv
SH_MAMECTL_SOCK=/data/vms/streamhost/stations/apple2e/ctl.sock
SH_MAMESOCK_KEYMAP=/data/vms/streamhost/stations/apple2e/apple2e.keymap
SH_AUDIO_SOURCE=fifo
SH_AUDIO_FIFO=/data/vms/streamhost/stations/apple2e/audio.fifo

# ---- STANDBY (instant-ready: an emulator nobody watches costs ~0 CPU) ----
# Same contract as every converted station: launcher freezes the emulator
# once the scene has painted, daemon SIGSTOP after idle grace, unconditional
# SIGCONT on the first session. SH_IDLE_PAUSE_PROC_MATCH is scoped to this
# station's own asset path so a deploy never signals the wrong MAME.
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/apple2e/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/apple2e/mame-native
MAME_NATIVE_STANDBY_DELAY_S=8

# ---- KEYBOARD (menu selector + AppleWorks/Dazzle Draw typing) ----
# VERIFIED on a live rig 2026-09-08 (golden stream): 40/40 ms with no
# MAME_CTL_KEY_EXCL drives the menu, AppleWorks' date prompt and Dazzle
# Draw's launcher without a dropped or duplicated character. The //e's
# keyboard is scanned by its own hardware encoder chip (not a CPU-polled
# matrix like mpf2's), so MAME_CTL_KEY_EXCL is NOT expected to be required
# here, and the proof agrees. Pacing is the fleet default 40/40 ms (not
# mpf2's bisected 32/32). Rollover/overlap is not stress-tested.
SH_KEY_MIN_HOLD_MS=40
SH_KEY_MIN_GAP_MS=40

# ---- POINTER (Apple II Mouse Card, slot 4 -- Dazzle Draw's double hi-res
# paint is the only in-menu consumer) ----
# PARTLY FIXED, still an OPEN item -- the station ships keyboard-only
# (stream.pointer.transport stays "none"). MEASURED on a live rig 2026-09-08
# (pointer stream). Two real mechanisms were found and fixed in the binary (scripts/build-guests/patches/mame-ctlsock-move-step-cap.patch and
# mame-ctlsock-open-loop-gain.patch, both in native.d/apple2e.sh):
#
#  1. A DIFFERENCING WINDOW, not a lost write. a2bus/mouse.cpp update_axis()
#     folds `new - last` into +-0x80, so ONE field write over 127 counts is
#     read as motion the OTHER WAY. Measured: MOVE 127 -> +197 px, MOVE 130 /
#     160 / 200 / 255 -> the arrow ran LEFT into the clamp. The module now
#     caps its pacing budget at m_ptr_mod/2 - 1 whenever the accumulator is
#     narrow and routes an oversized MOVE through the paced queue; paced
#     writes <= 127 track linearly with no loss.
#  2. AN OPEN LOOP CANNOT LEARN A GAIN. This machine has no readable cursor
#     register (no MAME_CTL_CURSOR_ITEMS), so MOVEA runs open-loop and the
#     module's gain learner -- which only runs from the closed loop's
#     observe() -- never fires: the gain stayed at its 1.0 default and MOVEA
#     issued Delta-px as counts, under-issuing ~40%. MEASURED counts->px on
#     the Dazzle Draw canvas: 1.547 px per count on X, 1.674 on Y. Seeded
#     below, open-loop MOVEA issues Delta-px / gain and the belief integrates
#     counts * gain, so both live in published pixels.
#
# WHAT IS AND IS NOT PROVEN. The SCALE is right: two interior targets 600 px
# apart land at 0.988x (X) and 0.940x (Y) of what was commanded. The ORIGIN
# now is too, and that took a third fix (mame-ctlsock-home-drain.patch).
#
#  3. THE HOMING SLAM DOES NOT DIE AT THE GUEST'S CLAMP. The clamp that stops
#     the arrow lives in the mouse card's firmware, downstream of an
#     accumulator that NETS our counts (a2bus/mouse.cpp update_axis():
#     m_count += diff, drained one unit per MCU port-B read). The open-loop
#     branch's 2160-count homing slam therefore parks that accumulator near
#     -2000, and the first target's travel, enqueued microseconds later, is
#     spent unwinding the slam instead of moving the arrow -- so the arrow
#     stayed in the corner while the belief moved on, and an open loop's only
#     origin is its belief, so every later target inherited the deficit
#     exactly. The patch sizes the slam through the gain (ceil(surface/gain) +
#     one window) and HOLDS the first target's travel until the move queue is
#     empty and the guest has had MAME_CTL_HOME_SETTLE ms of quiet -- paid
#     once per session and once per state load, on the first MOVEA only.
#
# MEASURED 2026-09-08 with the fix, five targets from a fresh homed session:
# (300,200) +2,-4 | (700,500) +6,-4 | (150,600) 0,0 | (850,150) +2,-2 |
# (300,200) -7,0. Pre-fix the same five landed 150-290 px short, two of them
# off the canvas. A click works: MOVEA onto the Tools menu + DOWN1 drops the
# menu open. A mid-session LOADST re-homes correctly (bel=0,0, the next MOVEA
# re-issues the full slam and lands +5,+4).
#
#  4. THE BELIEF ROUNDED EVERY PACER CHUNK. move_rel() booked
#     llround(counts * gain) per issued chunk, and the pacer hands out chunks
#     of a FIXED size (120 counts), so the SAME residue was dropped every
#     window -- 120 * 1.547 = 185.64 px booked as 186, +0.36 px of phantom
#     travel per window. Rounding is a wash only when the operands vary.
#     mame-ctlsock-count-carry.patch keeps the sub-pixel remainder instead
#     and re-anchors it at every home and every restore.
#
# MEASURED 2026-09-08 with all four fixes, three laps of five targets in ONE
# session from a golden copy: LAP 1 is the best this station has measured --
# (300,200) +2,0 | (700,500) +6,0 | (150,600) 0,+4 | (850,150) +2,+2 |
# (300,200) -6,0, worst 6 px, inside the bar. LAP 2 degrades from its third
# target (-7,+12 | -16,+14 | -24,+12) and LAP 3 walks off (-23,+16 | -33,+20 |
# -31,+14 | -39,+8). A return to (300,200) after a 30-move random walk landed
# -17,+12. The click still works at the end of all that (MOVEA 293 22 + DOWN1
# drops the Tools menu open).
#
# STILL OPEN, so stream.pointer stays transport=none -- but the open item has
# CHANGED HANDS. The residual drift is not arithmetic: the belief now
# integrates exactly, STAT still reads bel=300,200 at the end, and the drift
# has a FIXED DIRECTION (bottom-left) rather than a fixed sign per direction
# of travel, so it survives a closed loop of targets whose net displacement is
# zero -- which no gain error and no rounding residue can do. The guest is
# LOSING COUNTS, and the suspect is the same 8-bit differencing window: the
# step cap guarantees one WRITE never exceeds 127 counts, but two paced writes
# landing between the same pair of MCU port-B reads sum at the device, and 240
# counts folded into +-0x80 reads as -16. The old rounding bias was a positive
# error partly cancelling this negative one, which is why lap 2 looked better
# (worst 14, all positive) before the carry landed. NEXT: account for merges
# at the device (pace against the card's read rate, not a fixed window), or
# re-anchor periodically -- MAME_CTL_REHOME_PX, shipped with the carry patch
# and OFF by default, re-homes before the next MOVEA once the pointer has
# travelled N px since the last home. Neither is measured yet.
#
# MAME_CTL_CAL_X/Y is NOT set and would do nothing here: it calibrates a
# cursor-REGISTER reading, and there is no register to read.
#
# Tags are the mouse card's own ioport names at its slot-4 device tag
# (bus/a2bus/mouse.cpp: PORT_START("a2mse_button"/"a2mse_x"/"a2mse_y"));
# MEASURED via KEYDUMP on the live rig (2026-09-08): the full tag is
# ":sl4:mouse:a2mse_*" (the "-sl4 mouse" SLOT OPTION NAME "mouse" is its own
# path segment, not just the slot tag "sl4" as the ledger's from-source guess
# had it). PORT_NAME("Mouse Button") -- one button, so right/middle are empty
# on purpose (mirrors the ST's shape, docs/lab/DEBRIDGE-HANDOVER.md). MOD=256
# because a2mse_x/_y are 8-bit fields (0xff mask, sensitivity 40), NOT the
# module's 65536 SGI default -- an unset MOD here would saturate the axis on
# the first slam exactly like the ST's uncorrected case.
# MAME_CTL_SCREEN must match the published surface (SH_GEOM / MAME_SHM_SIZE):
# unset, the belief and every MOVEA target clamp against the module's 1288x1024
# SGI default instead of this station's 1024x768.
MAME_CTL_PTR_TAGS=:sl4:mouse:a2mse_button,:sl4:mouse:a2mse_x,:sl4:mouse:a2mse_y
MAME_CTL_BTN_NAMES=Mouse Button,,
MAME_CTL_PTR_MOD=256
MAME_CTL_SCREEN=1024x768
MAME_CTL_GAIN_X=1.547
MAME_CTL_GAIN_Y=1.674
# Quiet the homing slam gets to drain out of the GUEST's own accumulator
# before the first target's travel is issued (EMULATED ms, like
# MAME_CTL_MOVE_WINDOW). 0 restores the pre-fix slam-and-travel-together
# behaviour, which cost this station its entire first target.
MAME_CTL_HOME_SETTLE=750
