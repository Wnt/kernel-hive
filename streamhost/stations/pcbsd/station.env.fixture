
# --- golden fixture reset metadata (pcbsd) ---
# Fixture: PC-BSD 1.5.1 KDE 3.5.8 desktop, user `visitor` autologged in, one
# focused editor/terminal window (caret = keyboard surface), pointer on clear
# desktop, screensaver/DPMS off. Checkpoint facts (VM_SIZE, VM_CLOCK, pointer
# transport) are recorded by the golden stream in docs/lab/PCBSD-WAVE.md.
GOLDEN_RESET_MODE=loadvm
GOLDEN_SNAPSHOT=golden
GOLDEN_SNAPSHOT_STORE=/data/vms/streamhost/stations/pcbsd/disk.qcow2
