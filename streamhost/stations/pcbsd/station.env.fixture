
# --- golden fixture reset metadata (pcbsd) ---
# Fixture: PC-BSD 1.5.1 KDE 3.5.8 desktop, user `visitor` autologged in, one
# focused editor/terminal window (caret = keyboard surface), pointer on clear
# desktop, screensaver/DPMS off. Checkpoint facts are in docs/lab/PCBSD-WAVE.md.
# Pointer MOTION is absolute through the guest X server (x11warp): the launcher
# forwards 127.0.0.1:6079 -> guest :6000, the golden carries `xhost +10.0.2.2`
# and KDM starts X listening on TCP. Buttons and keys ride the PS/2 path.
GOLDEN_RESET_MODE=loadvm
GOLDEN_SNAPSHOT=golden
GOLDEN_SNAPSHOT_STORE=/data/vms/streamhost/stations/pcbsd/disk.qcow2
# Reset live (no restart): QMP human-monitor-command 'loadvm golden' on $SH_QMP
SH_INPUT_BACKEND=x11warp
SH_X11WARP_DISPLAY=127.0.0.1:79
SH_X11WARP_TRACE=off
SH_CURSOR_SCALE=1.0
