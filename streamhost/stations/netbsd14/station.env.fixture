# netbsd14 — NetBSD 1.4.1 i386 (1999). Reset = loadvm golden on disk.qcow2, the
# only block device (rule 6: golden + /opt/qemu-beos binary + device set are one).
# Checkpoint: golden baked 2026-09-03 02:54:27 under /opt/qemu-beos, VM_SIZE 38.6 MiB,
# VM_CLOCK 0000:01:01.205; restore proven (desktop 3.2 s after cont, X handshake 0.5 s).
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_GOLDEN_STATE_DISK=/data/vms/streamhost/stations/netbsd14/disk.qcow2
SH_FIXTURE_DESC=NetBSD 1.4.1 twm desktop (XFree86 3.3.3.1 SVGA on Cirrus, 1024x768x8, KHMIN kernel): xterm 'NetBSD 1.4.1' with a root prompt over the origin, Calculator, xclock. Pointer motion absolute through the guest X server (x11warp), buttons + keys over PS/2.
# Fleet floor for QEMU keyboard stations; measure only if characters drop.
SH_KEY_MIN_HOLD_MS=40
SH_KEY_MIN_GAP_MS=40
NETBSD14_QEMU=/opt/qemu-beos/bin/qemu-system-x86_64
# Pointer: motion via XWarpPointer + XQueryPointer readback on the guest's X
# server, reached through the launcher's loopback SLIRP forward (6076 -> 6000).
# The golden carries `xhost +10.0.2.2`. Buttons/keys: D-Bus PS/2 (default path).
SH_INPUT_BACKEND=x11warp
SH_X11WARP_DISPLAY=127.0.0.1:76
SH_X11WARP_TRACE=off
SH_CURSOR_SCALE=1.0
