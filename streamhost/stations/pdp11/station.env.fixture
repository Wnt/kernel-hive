# ---- GOLDEN FIXTURE (bridge tile) ----
# resetMode=loadvm -> restore the INTERNAL 'golden' snapshot: X (-nocursor) +
# a fixed 80x24 xterm + Open SIMH's PDP-11/70 resting at 2.11BSD's own
# multiuser `login:` prompt, exactly where an unattended cold boot stops.
# Nothing is curated into the fixture and nothing is typed after the restore.
# The alternative — baking a logged-in root shell — was rejected: it is a state
# a human typed into, it hides that this is a multiuser timesharing system, and
# it would hand each visitor whatever the last one left running.
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_FIXTURE_DESC=DEC PDP-11/70 (4 MB core, FP11) under Open SIMH, resting at 2.11BSD's own multiuser login prompt: the tail of the boot — "Fast boot ... skipping disk checks", "Assuming non-networking system ...", "standard daemons: update cron accounting.", the date, then "2.11 BSD UNIX (pdp11) (console)" and "login:" — in green phosphor on black, 80x24 at DejaVu Sans Mono 15 pt on a 1024x768 X root. LOG IN AS `root`, WITH NO PASSWORD: that is the one thing the screen cannot tell a visitor, so the placard and the SPA hint carry it. Then `uname -a` prints "BSD pdp11 2.11 ... #19 ... /usr/src/sys/ZEKE" and /usr/src holds the entire 2.11BSD kernel and userland source tree. Keyboard-only exhibit; no pointer device; silent (a console terminal has no audio).

# ---- KEYBOARD PACING ----
# HALF the vic20/plus4 value, and measured rather than inherited. Playbook
# 5.1's frame-sampling trap is about emulators that scan a keyboard matrix once
# per emulated frame; SIMH has no such matrix — its console is a byte stream on
# a pty. A 69-character line written to that pty at a 0 ms inter-character gap
# echoed and executed intact 5 times out of 5. What remains is the ordinary
# bridge path (browser -> streamhost -> QEMU PS/2 -> X -> xterm -> pty), and
# 40 ms hold / 40 ms gap through QMP delivered `root`, `uname -a` and
# `ls /usr/src` with nothing lost — which is the build's keyboard proof, run
# after the bake against the restored fixture.
# Consequence: this tile does NOT need the vic20/plus4 canary streamhost build,
# because 40/40 is comfortably above what the shared fleet binary already does.
SH_KEY_MIN_HOLD_MS=40
SH_KEY_MIN_GAP_MS=40
# No SH_KEY_MAP: the guest is an ordinary Debian X kiosk with a us pc105
# keymap, and xterm turns keysyms into the 7-bit ASCII that 2.11BSD's DL11
# console expects. The keys a visitor needs that a modern keyboard hides are
# 2.11BSD's own line-editing controls, printed by the machine itself on every
# login: "erase, kill ^U, intr ^C" (and ^D to log out).
