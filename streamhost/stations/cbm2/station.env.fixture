# ---- HOST-NATIVE STATION (de-bridged 2026-08-16, VICE wave) ----
# VICE 3.10.0's xcbm2 runs ON THE HOST, headless: no QEMU, no guest Debian, no
# X server, no kiosk. Frames VICE_SHM_PATH -> SH_CAPTURE=shm; keys the vicectl
# socket + the ONE shared keysym table (VICE resolves keysym -> matrix through
# CBM-II/gtk3_sym.vkm, the same file the bridged kiosk used); audio
# -sounddev wav -> named FIFO with the daemon as clock. Launcher: the shared
# stations/vice-native/x11-runtime.sh, VICE_NATIVE_* knobs.
# Build: scripts/build-guests/emulators/build-vice-native.sh cbm2.
SH_RESET_MODE=relaunch
SH_FIXTURE_DESC=Commodore CBM 610 (PAL) power-on screen — "*** commodore basic 128, v4.0 ***" and "ready." in green on black at 80 columns, drawn by host-native VICE 3.10.0 xcbm2 -model 610. PUBLISHED SURFACE 704x532, MEASURED off the shm mapping (1 498 176 B = 64 + 704*532*4) — VICE has no MAME_SHM_SIZE equivalent, the surface IS the emulated screen, so this geometry follows from VICE_NATIVE_ARGS and nothing else. NATIVE SIZE, no -CRTCdsize: the bridged kiosk dropped doubling because 1408x1056 did not fit its 800x600 X root, and host-native there is no root at all, so the emulated screen simply IS the stream — the same glyph size the visitor has always seen, with the black margin gone. The scene is the machine's own untouched cold boot; nothing is curated and nothing is typed. Keyboard-only exhibit; no pointer device; SID sound -> FIFO.
VICE_NATIVE_BIN=/data/vms/streamhost/assets/cbm2/vice-native/bin/xcbm2
VICE_NATIVE_DATA=/data/vms/streamhost/assets/cbm2/vice-native/share/vice
# The ONLY thing that decides the published geometry (see SH_FIXTURE_DESC).
VICE_NATIVE_ARGS=-model 610 -pal
SH_VICECTL_SOCK=/data/vms/streamhost/stations/cbm2/ctl.sock
SH_VICESOCK_KEYMAP=/data/vms/streamhost/stations/cbm2/us-layout.keysyms
SH_AUDIO_SOURCE=fifo
SH_AUDIO_FIFO=/data/vms/streamhost/stations/cbm2/audio.fifo

# ---- CHECKPOINT: RESTORED, 2026-08-17 ----
# This station shipped VICE_NATIVE_CHECKPOINT=0 on 2026-08-16 because its
# restore moved the published surface from 704x532 to 704x658. That was an
# UPSTREAM bug, fixed at fork pin c2287e1137:
# crtc_snapshot_read_module() sized the canvas from the SAVED framelines, which
# is the runtime whole-frame line count (313 on this 50 Hz machine) and not the
# nominal 250 every other caller passes — and crtc_update_window() only ever
# grows, so 266 + 63 = 329 native lines stuck, doubled by the CRTC's 1x2 render
# mode into the 658 that was measured. It also resized the viewport only when
# it moved the height itself, while a restore arrives with the height right and
# the viewport wrong.
# Re-measured on the rebuilt binary: restore lands 704x532 with 1649 lit and
# 3031 non-dominant pixels — the cold-boot gate's own numbers, to the pixel —
# and the machine is alive at 120 M cycles. golden.vsf rebaked 2026-08-17
# against this binary; a checkpoint belongs to ONE machine type and ONE VICE
# build, so a rebuild rebakes.

# ---- STANDBY (instant-ready: an emulator nobody watches costs ~0 CPU) ----
# The launcher freezes the emulator once the scene has painted; the daemon owns
# it after that (SIGSTOP after the idle grace with zero sessions, unconditional
# SIGCONT the moment a visitor connects). WITHOUT THESE TWO LINES A DE-BRIDGED
# STATION BURNS A FULL CORE AROUND THE CLOCK. _PROC_MATCH is the anti-footgun:
# the signal only ever reaches a pid whose cmdline carries THIS station's own
# asset path. Rollback is one line: SH_IDLE_PAUSE_SECS=0.
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/cbm2/vice.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/cbm2/vice-native
VICE_NATIVE_STANDBY_DELAY_S=8

# ---- KEYBOARD PACING ----
# 60/60, the VICE wave's floor, applied fleet-wide on 2026-08-17 — the curve is
# a property of the guest's SCANNED KEYBOARD MATRIX, which every machine in this
# family has, not of the machine's ROM, so the wave moves as one. The wave
# shipped on 80/80 from the vic20 bisect against THIS engine; that bisect fired
# CLEAN press/release sequences, the one shape that reproduces neither of the
# two live key-order defects, and it was RE-RUN with realistic OVERLAPPING
# bursts once the exclusive-scan deadlock was fixed, same framebuffer judge:
# 60/60 clean 12 of 12 at 7.8 keys/s, 40/40 corrupt 6 of 12, 20/20 not applied
# at all. 60/60 is still one clear step above the last pacing OBSERVED to fail
# — the margin that covers a host stall rather than just a frame period — and
# it is 28 % more throughput than 80/80. Verified on this station through the
# REAL SPA in a real browser, not just the control socket.
# The launcher hands these to the module as VICE_CTL_KEY_HOLD/_GAP.
SH_KEY_MIN_HOLD_MS=60
SH_KEY_MIN_GAP_MS=60
# No SH_KEY_MAP and no per-station keymap file: VICE's own symbolic keymap does
# that job.
