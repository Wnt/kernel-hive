# nokia9300rom station.env fixture — appended to the emitted station.env.
#
# THE ROM WINDOW-SERVER COMPARISON SIBLING of nokia9300 (agent D5, 2026-09-25):
# the SAME launcher, inner script and keymap (emitted from
# streamhost/stations/nokia9300/), its own assets/golden/claims, and EKA2L1
# built from fork branch s80-rom-station, run with EKA2L1_ROM_WSERV=1 so the
# firmware's own ewsrv.exe paints the screen. Everything below that is not
# marked ROM is nokia9300's text, kept so the two fixtures diff cleanly.
#
# Nokia 9300 Communicator (RAE-6) running its REAL firmware — Symbian OS 7.0s
# with the Series 80 v2 interface, fw 5.22 of 2005-11-16 — in EKA2L1, our fork
# github.com/Wnt/EKA2L1 branch s80-epoc7-tables (GPL-3), host-native: a stock
# Qt 6 + OpenGL application under a pinned Xvfb, captured with SH_CAPTURE=x11
# and typed into over XTEST. No QEMU, no MAME, no save state: the "golden" is
# the device data dir (ROM + Z: tree + C: drive + config) and reset = relaunch.
#
# CONTAINED (2026-09-09 host-application rule; the lisa/perq/its shape):
# EKA2L1 AND its Xvfb run inside a systemd-nspawn container — own PID/mount/
# net/user namespaces, root inside = host uid NOKIA_UID_BASE, the rootfs
# mounted --volatile=overlay, the EKA2L1 build and the golden bound READ-ONLY,
# work/ the only writable bind, capabilities dropped, mount syscalls filtered.
# The host sees the display through a symlink /tmp/.X11-unix/X119 ->
# NOKIA_X11_SOCKDIR/X119. mame.pid is EKA2L1's HOST pid (the idle freezer;
# the launcher follows the inner loop's relaunches); nspawn.pid is the
# supervisor.

# ---- GOLDEN FIXTURE --------------------------------------------------------
# resetMode=relaunch, IN-PROCESS: reset-tile.sh sends `quit` on the emulator's
# ekactl/1 control socket (SH_RESET_CTL_*); EKA2L1 exits 0 and the container's
# inner loop copies the golden data dir fresh and cold-starts Desk (~2 s to the
# relaunched socket, Desk paints ~1-3 s later). The daemon, the X display and
# the visitor's stream stay up — a `systemctl restart streamhost@nokia9300`
# (re-runs x11-runtime.sh, kills the container) would drop the stream, so it is
# only the fallback when the socket does not answer. The golden lives at
# $BASE/golden (EKA2L1/…; 3256 files, 68 635 694 B, the RAE-6 SYM.ROM
# 17 825 792 B sha256 ca4b0bc9…3596, hash-gated by tiles/nokia9300.sh --golden
# — docs/guests/nokia9300.md).
SH_RESET_MODE=relaunch
SH_RESET_CTL_SOCK=work/run/ekactl.sock
SH_RESET_CTL_VERB=quit
SH_RESET_CTL_MARK=work/reset-requested
# AUTO-RESET (streamhost auto_reset.rs): the same reset, run by the daemon 30 s
# after the last visitor left (before the 60 s idle pause freezes the picture)
# or after 10 min with no input — only if the guest saw input since the last
# reset. Agent U1 measured why: in one 23-minute session twelve apps piled up,
# RSS went 309 -> 565 MB and a dozen app switches later EKA2L1 segfaulted.
SH_AUTO_RESET_CMD=/bin/bash /data/vms/streamhost/serve/reset-tile.sh nokia9300rom
SH_AUTO_RESET_AFTER_SESSION_SECS=30
SH_AUTO_RESET_INPUT_IDLE_SECS=600
SH_FIXTURE_DESC=ROM window-server comparison track (EKA2L1 s80-rom-station, EKA2L1_ROM_WSERV=1: the firmware's own ewsrv.exe paints the screen) of the Nokia 9300 Communicator (RAE-6: TI OMAP1510, ARM925T at 150 MHz, 64 MB, 640x200 inner display) running its own firmware 5.22 (2005-11-16) — Symbian OS 7.0s with the Series 80 v2 interface — in EKA2L1 (fork s80-rom-station), host-native under a pinned 1280x400 Xvfb whose root IS the inner screen at exactly 2x (the kiosk window). At rest: Desk, the Series 80 shell — the date header, the Personal / Office / Media / Tools groups, Clock and Nokia.com, command-button labels Open / Write note / Note list down the right edge. Keyboard only: the 9300 has no pointer and no touchscreen; the eight application keys (F5-F12) switch apps.

# ---- ROM window server (ROM) ------------------------------------------------
# Fork s80-rom-station = s80-rom-boot (Z4 A: the ROM's own ewsrv.exe owns the
# screen, HLE FBS stays; the wsini.ini STARTUP overlay starts the resident
# C:\System\Programs\SysState.exe in this station's golden) + s80-rom-input
# (Z4 B: raw keys into ROM wserv) + s80-rom-apps (Z4 D: the kiosk's `list`/
# `focus`/`switch` read the ROM window server through the SysState helper's
# snapshots). Passed to the emulator by the launcher (NOKIA_EMU_ENV, one
# --setenv per word). The kiosk flags stay; Restore = `quit` + relaunch.
NOKIA_EMU_ENV=EKA2L1_ROM_WSERV=1

# ---- EMULATOR (read by x11-runtime.sh, not by the daemon) ------------------
NOKIA_ASSETS=/data/vms/streamhost/assets/nokia9300rom
NOKIA_GEOM=1280x400
NOKIA_DEVICE=RAE-6
# 0x101f8e4f = Desk (Z:\System\Apps\desk), the Communicator's shell.
NOKIA_APP=0x101f8e4f
# Agent B2's museum frontend (fork s80-integration): kiosk window at exact 2x
# on the 1280x400 root, Desk relaunched by the emulator itself when the last
# app exits, the ekactl/1 control socket at work/run/ekactl.sock (host side:
# $BASE/work/run/ekactl.sock), log to work/eka2l1.log at warnings only.
# EKA2L1_ROM_EIKSRV stays unset: the ROM shell is not proven (B5/B7).
NOKIA_EMU_ARGS=--kiosk --kiosk-scale 2 --kiosk-geometry 1280x400+0+0 --kiosk-background 000000 --kiosk-home 0x101f8e4f --control-socket /work/run/ekactl.sock --log-file /work/eka2l1.log --log-filter *:warn --no-console-log
# The container's time zone. EKA2L1 seeds the kernel's UTC offset from it; the
# guest's world server then follows its home city, which golden v3's
# Wldsvr.dat pins to Helsinki (docs/guests/nokia9300.md, Golden > Time zone).
NOKIA_TZ=Europe/Helsinki
# The golden's own config logs at *:trace (the bring-up setting); a station
# that runs for days keeps warnings only. Empty keeps the golden's filter.
NOKIA_LOG_FILTER=*:warn
# ---- container (systemd-nspawn) --------------------------------------------
# rootfs: a trixie tree with the Qt 6 / Mesa runtime EKA2L1 links against plus
# Xvfb, xdotool, x11-utils and x11-xserver-utils, uid-shifted ONCE by
# tiles/nokia9300.sh --rootfs. NOKIA_UID_BASE is a multiple of 65536, clear
# of the CT subuid range and of every other contained station; claimed as
# `kh-claim uidbase 2621440` (40 x 65536); nokia9300rom: 2686976 (41 x 65536).
NOKIA_UID_BASE=2686976
NOKIA_X11_SOCKDIR=/run/streamhost/x11/nokia9300rom

# ---- network: the retronet web plane (ROM: own claims) ------------------------
# nokia9300's netns cage (rn-netns.sh, the shared emit aux file) with this
# station's OWN claims: netns rn-nokia9300rom, veth nokia9300romrn0 on vmbr-rn,
# static reserved 10.99.0.44, no default route, the fail-closed
# NOKIA9300ROMRN-IN guard, and the gateway's wildcard DNS bound over the
# container's /etc/resolv.conf. MAC = RN_NOKIA9300ROM_MAC in local.env.
# off = --private-network (lo only). docs/lab/retronet/WEB-STATION-nokia9300rom.md
NOKIA_NET=retronet
NOKIA_RN_IP=10.99.0.44

# ---- input: keyboard only, over XTEST ----------------------------------------
# Keysyms per agent K1's keymap contract v1 (provisional until framebuffer
# proof): F1..F4 = the four command buttons, F5..F12 = the eight application
# keys, Menu, F13..F17 = the joystick, ISO_Level3_Shift = Chr. The station's
# own scancode table adds the joystick and Chr rows to the fleet's US table.
SH_X11TEST_KEYS=1
SH_X11TEST_KEYMAP=/data/vms/streamhost/stations/nokia9300rom/x11test.keysyms
# NO PACING (agent K3, 2026-09-25): the x11test pacer orders edges per keycode
# only, so ANY nonzero hold/gap lets the next letter's press overtake a
# dwelling Shift release (measured: "HElol WOrld", "=A1+a2" at 40/40 and at
# 150/150). 0/0 makes drain() send edges in strict arrival order; the fork's
# fixed event FIFO (s80-typing) takes a visitor's 30 ms/key exactly. K1's old
# 150 ms rule is obsolete.
SH_KEY_MIN_HOLD_MS=0
SH_KEY_MIN_GAP_MS=0

# ---- standby ------------------------------------------------------------------
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/nokia9300rom/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=eka2l1_qt
SH_IDLE_PAUSE_WARMUP_SECS=30
