# ---- HOST-NATIVE STATION (native from day one — domainos wave, 2026-09-09) ----
# Apollo DN3500 (MC68030) running Domain/OS SR10.4.1 — the Display Manager
# desktop. MAME 0.289's dn3500 driver runs ON THE HOST (src/mame/apollo/
# apollo.cpp, DN_FLAGS=0 so no nag panel; the driver registers state, so the
# shared launcher's SAVEST/LOADST checkpoint applies). drawshm frames, ctlsock
# keys through the generated keymap, no audio plane (the DM is silent).
# Launcher: shared stations/mame-native/x11-runtime.sh.
SH_RESET_MODE=relaunch
SH_FIXTURE_DESC=Apollo DN3500 Domain/OS SR10.4.1 Display Manager desktop (host-native MAME dn3500). GOLDEN NOT YET BAKED — see docs/lab/DOMAINOS-WAVE.md OPEN items: the disk halts at the boot ROM's "more than 14 days since last shutdown -> run CALENDAR" check, and the Apollo serial keyboard does not accept programmatic input reliably at the MD prompt, so CALENDAR could not be run to clear it in this wave. Everything below the halt is proven: self-test + kernel banner reached, keyboard echoes on the framebuffer via Lua set_value, the field-token patch resolves Return.
MAME_NATIVE_BIN=/data/vms/streamhost/assets/domainos/mame-native/domainos
MAME_NATIVE_DRIVER=dn3500
MAME_NATIVE_ROMS=/data/vms/streamhost/assets/domainos/mame-native/roms
MAME_NATIVE_GEOM=1024x768
# dn3500's default view paints a 1024x844 surface (raster + a function-key
# legend strip); the "XGA Screen (1024x768)" view is the bare raster at the
# fleet geometry. -disk1 is the Domain/OS winchester image. skip_warnings is
# on because the 3C505 card's 3c505-nw.bin has no good dump and its startup
# warning PAUSES the machine until a keypress a kiosk never sends.
MAME_NATIVE_SKIP_WARNINGS=1
# CHECKPOINT stays 0 until a Display-Manager golden is baked (no golden.sta
# exists yet); flip to 1 in the same commit that stages sta/dn3500/golden.sta.
MAME_NATIVE_CHECKPOINT=0
MAME_NATIVE_ARGS=-isa1 wdc -isa2 ctape -isa3 3c505 -view "XGA Screen (1024x768)" -disk1 /data/vms/streamhost/assets/domainos/media/domainos.awd
SH_MAMECTL_SOCK=/data/vms/streamhost/stations/domainos/ctl.sock
SH_MAMESOCK_KEYMAP=/data/vms/streamhost/stations/domainos/domainos.keymap
# Apollo 3-button mouse on the keyboard port (:kbd:mouse1 buttons, :kbd:mouse2/3
# = 8-bit relative X/Y the keyboard device differences per sample). Same open-
# loop shape as apple2e's mouse card; the pointer stack is compiled in
# (ptr-tags/move-step-cap/open-loop-gain/home-drain/count-carry) but UNPROVEN
# until the DM is reachable. Pointer transport stays "none" until then.
MAME_CTL_PTR_TAGS=:kbd:mouse1,:kbd:mouse2,:kbd:mouse3
MAME_CTL_BTN_NAMES=Left mouse button,Right mouse button,Center mouse button
MAME_CTL_PTR_MOD=256
MAME_CTL_SCREEN=1024x768
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/domainos/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/domainos/mame-native
MAME_NATIVE_STANDBY_DELAY_S=8
# The Apollo keyboard is a 1200-baud serial device, not a CPU-scanned matrix,
# so MAME_CTL_KEY_EXCL does NOT apply. Pacing at the fleet floor pending a
# real typing measurement at the DM (the MD prompt is not a valid test point).
SH_KEY_MIN_HOLD_MS=80
SH_KEY_MIN_GAP_MS=80
