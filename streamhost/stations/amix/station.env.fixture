# amix station.env fixture — appended to the emitted station.env.
# Host-native FS-UAE 3.2.35 (its OWN copy under assets/amix — golden +
# binary + device set are ONE combination) on an Amiga 3000, with NO Xvfb:
# shm frame capture at 1024x768x32 (SH_CAPTURE=shm, registry-side). The
# pointer stays exactly as it was — motion via XWarpPointer into the
# GUEST's own X -tiga server over a loopback slirp redirect, buttons/keys
# over XTEST — because that channel never depended on the host Xvfb; only
# capture/audio/keys changed with this conversion (2026-09-09). The daemon
# has one input backend per station, so SH_INPUT_BACKEND / SH_X11TEST_* /
# SH_X11WARP_DISPLAY are unchanged in registry/stations/amix.json.
# SH_MAMECTL_SOCK is deliberately UNSET: this station's keys/buttons still
# ride XTEST into the guest's X server, not a ctlsock.

# --- emulator ---------------------------------------------------------------
FSUAE_NATIVE_BIN=/data/vms/streamhost/assets/amix/fsuae-native/bin/fs-uae
FSUAE_NATIVE_KICK=/data/vms/streamhost/assets/amix/kick37175.A3000.rom
FSUAE_NATIVE_MODEL=A3000
FSUAE_NATIVE_HDF=amix-system.hdf
# Board + net flags the shared launcher has no dedicated knob for (A2410
# TIGA gfxcard, RDB hardfile on scsi6, the loopback-only slirp redirect for
# the guest's own X server — 127.0.0.1:6072 -> 10.0.2.15:6000, the same
# static port SH_X11WARP_DISPLAY names, fail-closed: no default route in
# the guest, redirect bound to 127.0.0.1 only, never a retronet join).
FSUAE_NATIVE_EXTRA_ARGS=--motherboard_ram=16384 --hard_drive_0_type=rdb --hard_drive_0_controller=scsi6 --uae_gfxcard_type=A2410 --uae_gfxcard_size=2 --zoom=640x512 --uae_a2065=slirp --uae_slirp_redir=tcp:6072:6000:10.0.2.15

# --- input: motion through the GUEST's X server, buttons/keys over XTEST ---
# Unchanged by this conversion — see registry/stations/amix.json stream and
# stationEnv for SH_INPUT_BACKEND/SH_X11TEST_*/SH_X11WARP_DISPLAY.
SH_X11TEST_MOTION=warp
SH_X11WARP_DISPLAY=127.0.0.1:72
SH_X11TEST_ABS=0
SH_X11TEST_BUTTONS=xtest
SH_X11TEST_KEYS=1
SH_BTN_MIN_HOLD_MS=60
SH_KEY_MIN_HOLD_MS=40
SH_KEY_MIN_GAP_MS=40

# --- reset / standby --------------------------------------------------------
# Cold boot from the golden: ~2 min to the OPEN LOOK desktop on a cleanly
# halted golden. The standby freeze keeps visits instant; only a reset pays it.
SH_RESET_MODE=relaunch
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/amix/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/amix/fsuae-native
SH_IDLE_PAUSE_WARMUP_SECS=200
FSUAE_NATIVE_STANDBY_DELAY_S=150
