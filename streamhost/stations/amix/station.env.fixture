# amix station.env fixture — appended to the emitted station.env.
# Host-native FS-UAE 3.2.35 (its OWN copy under assets/amix — golden + binary
# + device set are ONE combination) on an Amiga 3000, under a pinned Xvfb,
# captured with SH_CAPTURE=x11 and driven over XTEST.

# --- emulator ---------------------------------------------------------------
FSUAE_NATIVE_BIN=/data/vms/streamhost/assets/amix/fsuae-native/bin/fs-uae
FSUAE_NATIVE_KICK=/data/vms/streamhost/assets/amix/kick37175.A3000.rom
FSUAE_NATIVE_GEOM=640x512
# 640x512 is the AMIX X server's whole world: the Amiga-chipset X server is
# fixed at 640x512, depth 1 (StaticGray). Colour X on AMIX exists only for an
# add-on board (A2410/Resolver/1600GX) and FS-UAE 3.2.35 cannot drive one —
# see docs/guests/amix.md "The A2410 dead end".

# --- input: XTEST, RELATIVE pointer -----------------------------------------
# NOT absolute: the UAE mousehack that gives amigaos35 a 1:1 pointer is an
# AmigaOS trap. AMIX talks to the mouse hardware, so motion is relative and
# accelerated; the daemon's rel path owns the closed loop.
SH_X11TEST_ABS=0
SH_X11TEST_BUTTONS=xtest
SH_X11TEST_KEYS=1
SH_BTN_MIN_HOLD_MS=60
SH_KEY_MIN_HOLD_MS=40
SH_KEY_MIN_GAP_MS=40

# --- reset / standby --------------------------------------------------------
# Cold boot from the golden: ~2 min to the OPEN LOOK desktop on a cleanly
# halted golden. The standby freeze keeps visits instant; only a reset pays it.
SH_RESET_MODE=relaunch
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/amix/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/amix/fsuae-native
SH_IDLE_PAUSE_WARMUP_SECS=200
FSUAE_NATIVE_STANDBY_DELAY_S=150
