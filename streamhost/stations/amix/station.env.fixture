# amix station.env fixture — appended to the emitted station.env.
# Host-native FS-UAE 3.2.35 (its OWN copy under assets/amix — golden + binary
# + device set are ONE combination) on an Amiga 3000, under a pinned Xvfb,
# captured with SH_CAPTURE=x11 and driven over XTEST.

# --- emulator ---------------------------------------------------------------
FSUAE_NATIVE_BIN=/data/vms/streamhost/assets/amix/fsuae-native/bin/fs-uae
FSUAE_NATIVE_KICK=/data/vms/streamhost/assets/amix/kick37175.A3000.rom
FSUAE_NATIVE_GEOM=1024x768
# 1024x768 is the A2410 (TIGA) board surface the guest's `X -tiga` server
# programs: OPEN LOOK in 256 colours (docs/guests/amix.md "Colour"). The
# Xvfb, the FS-UAE window and the guest X root are all this size, and the
# pointer sweep measured the capture identity-mapped at it.

# --- input: motion through the GUEST's X server, buttons/keys over XTEST ---
# The UAE mousehack that gives amigaos35 a 1:1 pointer is an AmigaOS trap;
# AMIX drives the mouse hardware itself, so any XTEST motion (abs or rel) is
# accelerated and relative in the guest. Motion therefore goes to the guest's
# own X11R4 server over the launcher's loopback slirp redirect (WarpPointer +
# QueryPointer readback, x11_warp.rs); buttons and keys stay on XTEST, and a
# button edge is held until the guest confirmed the warp. Single injector:
# nothing else may send this guest pointer motion.
SH_X11TEST_MOTION=warp
SH_X11WARP_DISPLAY=127.0.0.1:72
SH_X11TEST_ABS=0
SH_X11TEST_BUTTONS=xtest
SH_X11TEST_KEYS=1
SH_BTN_MIN_HOLD_MS=60
SH_KEY_MIN_HOLD_MS=40
SH_KEY_MIN_GAP_MS=40

# --- reset / standby --------------------------------------------------------
# Cold boot from the golden: ~2 min to the OPEN LOOK desktop on a cleanly
# halted golden. The standby freeze keeps visits instant; only a reset pays it.
SH_RESET_MODE=relaunch
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/amix/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/amix/fsuae-native
SH_IDLE_PAUSE_WARMUP_SECS=200
FSUAE_NATIVE_STANDBY_DELAY_S=150
