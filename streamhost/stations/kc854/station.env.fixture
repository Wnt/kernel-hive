# ---- HOST-NATIVE STATION (de-bridged 2026-08-12, conversion campaign) ----
# MAME 0.289's kc85_4 runs ON THE HOST — the bookworm-suite rollback story
# dissolves with the kiosk, exactly like mpf2's. drawshm frames, ctlsock
# keys through the generated keymap, KC speaker -> SDL disk -> FIFO with the
# daemon as clock. Launcher: shared stations/mame-native/x11-runtime.sh;
# reset = relaunch (cold boot; see MAME_NATIVE_CHECKPOINT below).
SH_RESET_MODE=relaunch
SH_FIXTURE_DESC=KC 85/4 (VEB Mikroelektronik "Wilhelm Pieck" Mühlhausen, 1988) at its own untouched power-on screen: CAOS 4.2's command menu and prompt, drawn by MAME 0.289's kc85_4 (-bios caos42) running HOST-NATIVE (drawshm) with aspect correction on the published 1024x768 surface. Nothing is curated and nothing is typed — the operating system prints the list of things a visitor can type, which makes the machine's honest idle screen its own launcher. BASIC starts HC-BASIC from the second ROM; MENU brings the list back. Keyboard-only exhibit; no pointer device; KC speaker -> FIFO. THE DRIVER IS `preliminary`, so a stock MAME would open it with a full-screen red "THIS SYSTEM DOESN'T WORK" panel that -skip_gameinfo does not suppress: the host-native binary carries mame-irix-skip-warnings.patch and the launcher writes ui.ini skip_warnings 1 (MAME_NATIVE_SKIP_WARNINGS). If red ever appears in this fixture, the deployment has regressed.
MAME_NATIVE_BIN=/data/vms/streamhost/assets/kc854/mame-native/kc85
MAME_NATIVE_DRIVER=kc85_4
MAME_NATIVE_ROMS=/data/vms/streamhost/assets/kc854/mame-native/roms
MAME_NATIVE_GEOM=1024x768
MAME_NATIVE_ARGS=-bios caos42
MAME_NATIVE_SKIP_WARNINGS=1
# The bbcb/zx81/kc85_4/spectrum drivers have NO MACHINE_SUPPORTS_SAVE, so
# checkpoint restore is OFF (it restored garbage — 2026-08-12); reset is
# the cold boot, which reaches this scene in seconds.
MAME_NATIVE_CHECKPOINT=0
SH_MAMECTL_SOCK=/data/vms/streamhost/stations/kc854/ctl.sock
SH_MAMESOCK_KEYMAP=/data/vms/streamhost/stations/kc854/kc854.keymap
SH_AUDIO_SOURCE=fifo
SH_AUDIO_FIFO=/data/vms/streamhost/stations/kc854/audio.fifo

# ---- STANDBY (instant-ready: an emulator nobody watches costs ~0 CPU) ----
# The launcher freezes the emulator once the scene has painted, and the
# daemon owns it from there: SIGSTOP after the idle grace with zero
# sessions, unconditional SIGCONT the moment a visitor connects. Without
# this a de-bridged station burns a full core around the clock.
# SH_IDLE_PAUSE_PROC_MATCH is the anti-footgun: the signal is only ever
# sent to a pid whose cmdline still carries this station's own asset path
# (bbcmicro and armeval run identically-named `bbcb` binaries).
# Rollback is one line: SH_IDLE_PAUSE_SECS=0 restores an always-running
# exhibit.
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/kc854/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/kc854/mame-native
MAME_NATIVE_STANDBY_DELAY_S=8

# ---- KEYBOARD (the exhibit's only input surface) ----
SH_KEY_MIN_HOLD_MS=80
SH_KEY_MIN_GAP_MS=80
# The KC keyboard chip RETRANSMITS the held key's word every ~19 ms and the
# CAOS ROM detects "same keypress" by CONSECUTIVE IDENTICAL words — two keys
# down at once interleave their words and the ROM reads the first key again
# as a new press ("hello" -> "HEHLLO"; the operator saw the same doubling on
# the bridge kiosk, which also overlapped occasionally). Exclusive-scan on
# the matrix rows only; the separate :keyboard:SHIFT port flows freely.
MAME_CTL_KEY_EXCL=:keyboard:KEY
SH_KEY_MAP=W:w,w:W,A:a,a:A,":@,-:=,=:+,Y:y,y:Y,E:e,e:E,S:s,s:S,^:[,%3A:-,*:_,X:x,x:X,T:t,t:T,F:f,f:F,P:p,p:P,@:),V:v,v:V,U:u,u:U,H:h,h:H,':&,O:o,o:O,):(,N:n,n:N,I:i,i:I,J:j,j:J,(:*,K:k,k:K,M:m,m:M,Z:z,z:Z,G:g,g:G,&:^,L:l,l:L,B:b,b:B,R:r,r:R,D:d,d:D,|:",+:;,;:%3A,C:c,c:C,Q:q,q:Q
