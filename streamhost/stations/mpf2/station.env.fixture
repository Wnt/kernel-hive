# ---- HOST-NATIVE STATION (de-bridged 2026-08-12, conversion campaign) ----
# MAME 0.289's mpf2 runs ON THE HOST — the definitive fix for this station's
# trixie rollback (a second-cold-boot kiosk/getty failure: no kiosk, no
# getty, no guest any more). drawshm frames, ctlsock keys through the
# generated keymap, sound -> SDL disk -> FIFO with the daemon as clock.
# Launcher: shared stations/mame-native/x11-runtime.sh; reset = relaunch
# restoring the golden savestate.
SH_RESET_MODE=relaunch
SH_FIXTURE_DESC=Multitech Microprofessor II Applesoft BASIC 560x192 @ 60 Hz composite (6-colour artifact) drawn with aspect correction on the published 1024x768 surface by MAME 0.289's mpf2 running HOST-NATIVE (drawshm); the golden savestate restores the BASIC prompt and a relaunch re-runs it instantly. Keyboard-only exhibit; no pointer device. Keyboard quirks: SH_KEY_REMAP delivers Backspace as Left (the machine's matrix has no Backspace; Left is its rubout key), SH_KEY_MIN_HOLD_MS=32 holds every key for 2 emulated frames, and SH_KEY_MIN_GAP_MS=32 keeps 2 frames of gap between one key's release and the next key's press — measured, a release-to-press gap under ~8 ms makes the machine read two keystrokes as one held chord.
MAME_NATIVE_BIN=/data/vms/streamhost/assets/mpf2/mame-native/mpf2
MAME_NATIVE_DRIVER=mpf2
MAME_NATIVE_ROMS=/data/vms/streamhost/assets/mpf2/mame-native/roms
MAME_NATIVE_GEOM=1024x768
MAME_NATIVE_SKIP_WARNINGS=1
SH_MAMECTL_SOCK=/data/vms/streamhost/stations/mpf2/ctl.sock
SH_MAMESOCK_KEYMAP=/data/vms/streamhost/stations/mpf2/mpf2.keymap
SH_AUDIO_SOURCE=fifo
SH_AUDIO_FIFO=/data/vms/streamhost/stations/mpf2/audio.fifo

# ---- KEYBOARD (the exhibit's only input surface) ----
SH_KEY_REMAP=0x0e:0xe04b
SH_KEY_MAP==:O,-:I,+:P,(:*,):(,*:)
SH_KEY_MIN_HOLD_MS=32
SH_KEY_MIN_GAP_MS=32
