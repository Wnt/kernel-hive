# ---- HOST-NATIVE STATION (de-bridged 2026-08-12, conversion campaign #1) ----
# MAME 0.289's dragon32 runs ON THE HOST: no QEMU, no guest Debian, no X.
# Frames: drawshm -> SH_CAPTURE=shm. Keys: ctlsock + the GENERATED keymap
# (PORT_CODE tokens; scripts/dev/mame-keymap.py). Audio: MAME's 6-bit DAC ->
# SDL disk driver -> named FIFO, the daemon is the clock (irix contract).
# Launcher: the shared stations/mame-native/x11-runtime.sh; MAME_NATIVE_* are
# its knobs. Reset = relaunch, restoring the golden savestate in $BASE/sta.
SH_RESET_MODE=relaunch
SH_FIXTURE_DESC=Dragon 32 (PAL) at its own untouched power-on screen: "(C) 1982 DRAGON DATA LTD / 16K BASIC INTERPRETER 1.0 / (C) 1982 BY MICROSOFT / OK", dark green on the MC6847's bright green page, drawn with aspect correction on the published 1024x768 surface by MAME 0.289's dragon32 driver running HOST-NATIVE (drawshm). The launcher empties the driver's `ext` slot with -ext "": with the default dragon_fdc cartridge the machine boots DRAGONDOS 1.0 instead. Nothing is curated and nothing is typed. Keyboard-only exhibit; 6-bit DAC sound -> FIFO.
MAME_NATIVE_BIN=/data/vms/streamhost/assets/dragon32/mame-native/dragon
MAME_NATIVE_DRIVER=dragon32
MAME_NATIVE_ROMS=/data/vms/streamhost/assets/dragon32/mame-native/roms
MAME_NATIVE_GEOM=1024x768
# THE flag: without -ext "" the machine boots DRAGONDOS, not BASIC (see
# scripts/build-guests/emulators/native.d/dragon32.sh).
MAME_NATIVE_ARGS=-ext ""
SH_MAMECTL_SOCK=/data/vms/streamhost/stations/dragon32/ctl.sock
SH_MAMESOCK_KEYMAP=/data/vms/streamhost/stations/dragon32/dragon32.keymap
SH_AUDIO_SOURCE=fifo
SH_AUDIO_FIFO=/data/vms/streamhost/stations/dragon32/audio.fifo

# ---- KEYBOARD PACING (the exhibit's only input surface) ----
# 80/80 shipped on the bridge tile after a host-scheduling bisect
# (docs/guests/dragon32.md); the ctlsock path applies keys at emulated-frame
# boundaries, so the same floor is safe here. Revisit only on operator report.
SH_KEY_MIN_HOLD_MS=80
SH_KEY_MIN_GAP_MS=80
# The Dragon's matrix does NOT agree with a US PC keyboard; the browser-side
# translation below is unchanged from the bridge tile (the generated keymap
# reproduces the same PORT_CODE-positional bindings the kiosk chain had, so
# the charMap's calibration carries over). ':' is percent-encoded as %3A
# (keymap_escape in scripts/stations-registry.py, keymap_unescape in labctl).
SH_KEY_MAP=@:[,":@,&:^,':&,(:*,):(,%3A:-,*:_,+:%3A,-:=,=:+
