# Stock Spectravideo, host-native MAME 0.289; keyboard-only, no network.
SH_RESET_MODE=relaunch
MAME_NATIVE_BIN=/data/vms/streamhost/assets/svi738/mame-native/svi738
MAME_NATIVE_DRIVER=svi738sw
MAME_NATIVE_ROMS=/data/vms/streamhost/assets/svi738/mame-native/roms
MAME_NATIVE_GEOM=1024x768
MAME_NATIVE_SKIP_WARNINGS=0
MAME_NATIVE_CHECKPOINT=0
SH_MAMECTL_SOCK=/data/vms/streamhost/stations/svi738/ctl.sock
SH_MAMESOCK_KEYMAP=/data/vms/streamhost/stations/svi738/svi738.keymap
SH_AUDIO_SOURCE=fifo
SH_AUDIO_FIFO=/data/vms/streamhost/stations/svi738/audio.fifo
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/svi738/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/svi738/mame-native
SH_KEY_MIN_HOLD_MS=150
SH_KEY_MIN_GAP_MS=100
MAME_CTL_KEY_EXCL=:KEY
SH_FIXTURE_DESC=SVI-738 Finland/Sweden hardware, CP/M-80 2.28 release 2.1 International keyboard at A>.
MAME_NATIVE_DISK_TEMPLATE=/data/vms/streamhost/assets/svi738/media/hive-cpm.dsk:session.dsk
MAME_NATIVE_ARGS=-flop1 /data/vms/streamhost/stations/svi738/session.dsk -view "Screen 0 Standard (4:3)"
# ---- STANDBY ON THE FINISHED SCENE (2026-10-04) ----
# The cold boot shows the MSX banner, a quiet floppy boot, then the CP/M banner
# and A> at 20.7 EMULATED seconds in three of three boots. 23 emulated seconds
# freezes the settled A> whatever the host load (MAME_NATIVE_STANDBY_CLOCK,
# stations/mame-native/x11-runtime.sh); the old 25 wall seconds left 4 s of
# margin to a loaded box. A Restore reports done only then (reset-tile.sh
# scene_wait): before, the demo typed `MBASIC` into the MSX banner.
MAME_NATIVE_STANDBY_DELAY_S=23
MAME_NATIVE_STANDBY_CLOCK=emulated
# ---- MODIFIER LEAD (2026-10-04) ----
# typeText() and a visitor's browser send Shift and the key back to back, and
# the ctlsock module used to apply both in ONE drain pass, so a keyboard scan
# that straddles that instant can read the key without its Shift (sinclairql
# lost every shifted character, oricatmos about one in 300). The launcher
# hands this to the module as MAME_CTL_KEY_MOD_LEAD: a non-modifier press waits
# this many EMULATED ms after the last Shift/Ctrl edge. This machine lost no
# shifted character on the old engine (2026-10-04).
# 10 ms is five times the largest threshold measured on a MAME machine (between
# 1 and 2 ms on both the QL and the Oric), at most 10 ms more per shifted
# character; the demo's perCharMs 260 covers it
# exactly (HOLD 150 + max(GAP 100, LEAD) + LEAD). Needs a binary built with the knob (an older one ignores it).
# docs/TYPE-IN-EDITOR.md "Shifted characters".
SH_KEY_MOD_LEAD_MS=10
