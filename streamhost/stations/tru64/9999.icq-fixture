#!/bin/sh
# retronet ICQ exhibit: launch the Gaim OSCAR client on the CDE desktop.
#
# Reference copy. The live fixture is baked onto the checkpoint DISK at
# /etc/dt/config/Xsession.d/9999.icq-fixture inside the guest; CDE's Xsession
# sources it at session start. This is the COLD-BOOT fallback path only: on the
# normal checkpoint-restore path Gaim is already running in the baked RAM
# snapshot and Xsession.d does not run, so this cannot double-launch it. The
# guest network (tu0 = 10.99.0.15) is up from rc.config before CDE starts, so
# Gaim can reach the gateway (10.99.0.2:5190) the moment this runs.
#
# Gaim is linked against the GTK+ 1.2.8 / glib 1.2.8 shared libraries under
# /usr/local/lib (Tru64 Open Source Collection Disc 5). Tru64's loader will not
# find them without _RLD_ROOT-style help, so the path is exported here rather
# than relied on from the user's profile — a CDE Xsession.d script inherits
# almost nothing.
#
# Sign-in is silent: the account (UIN 64000) is stored in /home/guest/.gaimrc
# with OPT_USR_AUTO|OPT_USR_REM_PASS, so gaim's own auto_login() connects at
# startup with no login window, no wizard and no keystroke. The buddy list
# window's geometry is pinned in the same file (blist_pos), so the exhibit
# opens composed instead of wherever dtwm would drop it.
#
# CHROME COLOUR: this is an 8-bit PseudoColor desktop (256-cell colormap). Gaim
# leaks ~a full widget style's worth of colormap cells on every wake reconnect,
# so after ~8 cycles the map is exhausted and GTK's widget-background grey can no
# longer be allocated — the window chrome (menubars/toolbars/tabs) renders BLACK.
# Two things fix that, both baked onto the disk:
#   * /home/guest/.gtkrc pins Gaim's palette to fixed CDE/Motif greys, and
#   * /usr/local/bin/cmaphold (cmaphold.c) pre-allocates and PERMANENTLY holds
#     those exact greys (+ derived shades and chat primaries) so Gaim's later
#     re-allocations share the held cells and can never fall back to black.
# cmaphold must start BEFORE gaim so the anchor cells exist first.
LD_LIBRARY_PATH=/usr/local/lib
export LD_LIBRARY_PATH
/usr/local/bin/cmaphold >/dev/null 2>&1 &
sleep 1
/usr/local/bin/gaim &
