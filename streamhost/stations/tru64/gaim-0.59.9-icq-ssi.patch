diff -Naur orig/src/protocols/oscar/ssi.c gaim-0.59.9/src/protocols/oscar/ssi.c
--- orig/src/protocols/oscar/ssi.c	2002-06-22 11:57:57.000000000 +0000
+++ gaim-0.59.9/src/protocols/oscar/ssi.c	2026-08-22 11:13:05.864348581 +0000
@@ -351,6 +351,21 @@
  * @param conn The bos connection for this session.
  * @return Return 0 if no errors, otherwise return the error number.
  */
+/**
+ * Return a buddy item's server-stored display name, or NULL.
+ *
+ * The feedbag buddy item carries the name the roster owner sees in TLV 0x0131
+ * ("local alias"); the item's own name is the bare screen name / UIN. Stock
+ * 0.59.9 parses the TLV chain into item->data but never reads this one, so an
+ * SSI-synced list renders as bare UINs. Caller frees the returned string.
+ */
+faim_export char *aim_ssi_getalias(struct aim_ssi_item *item)
+{
+	if (!item || !item->data || (item->type != AIM_SSI_TYPE_BUDDY))
+		return NULL;
+	return aim_gettlv_str((aim_tlvlist_t *)item->data, AIM_SSI_TLV_ALIAS, 1);
+}
