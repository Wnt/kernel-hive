+/* ---------------------------------------------------------------------------
+ * Retronet: auto-reconnect, in the core rather than as a plugin.
+ *
+ * Stock 0.59.9 ships this behaviour only as plugins/autorecon.c, a dlopen'd
+ * GModule. This station builds --disable-plugins (no module loader to trust on
+ * Tru64/Alpha, and one static binary is a smaller thing to keep working), so
+ * the same logic lives here instead. It is what makes the exhibit self-healing:
+ * a restored checkpoint wakes onto a stale BOS socket, OSCAR's keepalive draws
+ * an RST, and this signs the persona straight back on with no operator input.
+ *
+ * Two deliberate differences from the plugin it is ported from:
+ *   - GPOINTER_TO_INT / GINT_TO_POINTER instead of the plugin's (int) casts.
+ *     This is an LP64 machine; casting a gpointer through int truncates.
+ *   - MIN, not the plugin's MAX, when doubling the delay. The plugin's
+ *     MAX(2*del, MAXTIME) jumps to the ceiling on the first retry, which is
+ *     the opposite of a backoff.
+ * ------------------------------------------------------------------------- */
+#define RN_RECONNECT_INITIAL   2000	/* ms before the first retry */
+#define RN_RECONNECT_MAX      60000	/* ceiling on the backoff */
+
+static GHashTable *rn_reconnect_delay = NULL;
+
+static gboolean rn_reconnect_signon(gpointer data)
+{
+	struct aim_user *u = data;
+
+	/* The account may have been deleted while the timer was pending. */
+	if (g_slist_index(aim_users, u) < 0)
+		return FALSE;
+
+	serv_login(u);
+	return FALSE;
+}
+
+/* Schedule a re-signon for a connection that dropped without being asked to. */
+static void rn_reconnect_schedule(struct gaim_connection *gc)
+{
+	int del;
+
+	if (!gc || gc->wants_to_die || !gc->user)
+		return;
+
+	if (!rn_reconnect_delay)
+		rn_reconnect_delay = g_hash_table_new(g_direct_hash, g_direct_equal);
+
+	del = GPOINTER_TO_INT(g_hash_table_lookup(rn_reconnect_delay, gc->user));
+	del = del ? MIN(2 * del, RN_RECONNECT_MAX) : RN_RECONNECT_INITIAL;
+	g_hash_table_insert(rn_reconnect_delay, gc->user, GINT_TO_POINTER(del));
+
+	debug_printf("reconnect: %s dropped, retrying in %d ms\n", gc->username, del);
+	g_timeout_add(del, rn_reconnect_signon, gc->user);
+}
+
+/* Clear the backoff once an account is actually online again. */
+static void rn_reconnect_clear(struct gaim_connection *gc)
+{
+	if (rn_reconnect_delay && gc && gc->user)
+		g_hash_table_remove(rn_reconnect_delay, gc->user);
+}
+
 void account_online(struct gaim_connection *gc)
 {
+	rn_reconnect_clear(gc);
 	int i;
 	struct signon_meter *meter = find_signon_meter(gc);
 
@@ -1438,6 +1499,7 @@
 {
 	/* core stuff */
 	debug_printf("date: %s\n", full_date());
+	rn_reconnect_schedule(gc);
 	plugin_event(event_signoff, gc, 0, 0, 0);
 	system_log(log_signoff, gc, NULL, OPT_LOG_BUDDY_SIGNON | OPT_LOG_MY_SIGNON);
 
