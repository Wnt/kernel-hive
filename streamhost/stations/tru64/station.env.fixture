# ---- INSTALL-PHASE FIXTURE (x11 runtime tile, DARK LAUNCH) ----
# There is NO golden yet: the Tru64 UNIX 5.1B install is performed live on
# this tile (listing=hidden — the deep link /os/tru64 streams, the grid and
# museum hall do not show it). The guest disk assets/tru64/img/tru64.img is
# the live install target, mutated in place. resetMode=relaunch REBOOTS the
# machine (SRM console; the disk persists), it does not restore a fixture.
# After the install: capture the golden, switch the launcher to the w2kalpha
# reflink shape, rewrite this stanza, re-emit.
SH_RESET_MODE=relaunch
SH_FIXTURE_DESC=INSTALL PHASE — Tru64 UNIX 5.1B installer (X11, 1024x768) running from the OS CD in es40 (AlphaServer ES40, EV68); SH_CAPTURE=shm (headless SDL dummy, no X server) + mamesock ctlsock input. The install disk is mutated in place; relaunch REBOOTS the installer, it does not restore a golden (none exists yet).

# ---- POINTER/KEY INPUT (SH_* read by the daemon; the socket served by es40) --
# mamesock = the daemon speaks mamectl/1 straight to the ctlsock the es40 fork
# serves (src/gui/ctlsock.h, armed by the launcher via ES40_CTL_SOCK). This
# tile's es40 build is MULTI-CLIENT: the daemon stays attached while operator
# tooling (ctltest.py) injects install keystrokes beside it. Keyboard verified
# end to end at the SRM console (typed command echoed, framebuffer proof
# 2026-08-11). Pointer is open-loop absolute like w2kalpha; the X11 installer
# has not had a pointer calibration pass — keyboard is the drive channel.
SH_INPUT_BACKEND=mamesock
SH_MAMECTL_SOCK=/data/vms/streamhost/stations/tru64/ctl.sock

# ---- IDLE AUTO-PAUSE: ON since 2026-08-16 (the w2kalpha stanza) ----
# The install phase kept this OFF (a SIGSTOP'd installer makes no progress and
# a mid-setld freeze risks corruption on resume). The seed exists now, so this
# station behaves like its sibling: the guest stays POWERED ON and is
# SIGSTOPped at ~0 CPU once no visitor has been connected for
# SH_IDLE_PAUSE_SECS, then resumed sub-second on the next visit. That — not a
# savestate — is what "instant" means on the es40 stations; the fork carries
# fc82f05 host_freeze_reanchor so guest clocks resume where they stopped.
# SH_IDLE_PAUSE_PROC_MATCH is the anti-footgun: the signal only ever goes to a
# pid whose cmdline is this station's own es40. Rollback is one line:
# SH_IDLE_PAUSE_SECS=0.
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/tru64/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/tru64/es40
# Warmup withholds the FIRST freeze. w2kalpha uses 120 s because it reaches its
# desktop in ~80 s; Tru64's SRM + rc + CDE autologin cold boot takes ~400-450 s,
# and freezing mid-boot would strand an unvisited station part-booted (the next
# visitor would then watch the rest of the boot). 540 s clears the whole boot,
# so an unvisited station pauses AT the finished CDE desktop.
SH_IDLE_PAUSE_WARMUP_SECS=540
