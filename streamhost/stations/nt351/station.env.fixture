# --- GOLDEN TEST FIXTURE (baked and verified 2026-07-28) ---
# resetMode=loadvm : disk is a standalone qcow2, snapshot "golden" holds live RAM+disk.
# Reset a test to the fixture with:
#   python3 /data/vms/streamhost/stations/nt351/drive.py \
#           /data/vms/streamhost/stations/nt351/qmp.sock loadvm golden
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_GOLDEN_DISKS=nt351-golden.qcow2
# PS/2 relative pointer -> 1:1 via the manifest's abs/cursor_scale settings;
# see docs/guests/nt351.md and docs/guests/tinycore.md.
# Fixture: Windows NT 3.51 Cirrus 1024x768x16bpp Program Manager with the Main
# group maximized and focused, screensaver OFF, cursor blink and mouse tracking
# at their slowest settings, pointer parked at the lower-right edge. Two
# no-input frames are byte-identical. Requires /opt/qemu-cirrusfix; see
# docs/guests/nt351.md.
