# --- GOLDEN TEST FIXTURE ---
# resetMode=loadvm : disk is a standalone qcow2, snapshot "golden" holds live RAM+disk.
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_GOLDEN_DISKS=beos-golden.qcow2
# Fixture: BeOS R5 1024x768x16 desktop, Deskbar top-right, Tracker, the
# UserBootscript Terminal, NetPositive on the museum corpus page, and ICBM
# signed on as UIN 50000. See docs/guests/beos.md and SH_FIXTURE_DESC in the
# registry for the scene in full.

# ---- WHICH QEMU BINARY THIS STATION EXECS ----
# The launcher execs "${BEOS_QEMU:-/opt/qemu-beos/bin/qemu-system-x86_64}", and
# this line now names that same build explicitly rather than relying on the
# default -- so the binary in force is readable here, next to the address and
# the backend that depend on it.
#
# BINARY AND GOLDEN MOVE TOGETHER. NEITHER HALF IS INDEPENDENTLY REVERTIBLE.
# The station's previous golden was baked under the host pve-qemu-kvm package
# and carries a Proxmox-only `pbs-state` vmstate section, which a standalone
# build refuses outright with
#   "Unknown section or instance 'pbs-state' 0"
# and the NEW golden, cold re-baked under /opt/qemu-beos on 2026-08-31, is not
# restorable by the host binary either. So rolling back means putting BOTH this
# line and the golden file back, together:
#   BEOS_QEMU=/usr/bin/qemu-system-x86_64
#   restore beos-golden.qcow2 from beos-golden.qcow2.cpg-bak-20260831T083703Z
#     (sha256 12300e30486c5c2f792d0fe60e5a075718e19de23bc95b391e3cf5ce25109660)
# That backup is the whole rollback story for this cutover, and it is not merely
# argued: it was RESTORED under /usr/bin/qemu-system-x86_64 on 2026-08-31, on an
# isolated tap, and came back to the fixture scene. The rollback path has been
# run, not just asserted.
BEOS_QEMU=/opt/qemu-beos/bin/qemu-system-x86_64

# ---- POINTER: ABSOLUTE BY WRITING THE GUEST'S OWN COORDINATE ----
# Not a closed loop, and not an absolute device -- R5 has neither a usable
# absolute tablet nor a hardware cursor (it drives std VGA as its "stub"
# driver; see docs/lab/BEOS-ABSOLUTE-POINTER.md for the disproof of the two
# adapter routes). What it does have is its own pointer coordinate in RAM:
# app_server keeps it as two little-endian int32 (layout `point32le`). The
# launcher's `-device kh-ramabs` writes the commanded pixel there and injects
# ONE 1-unit relative PS/2 nudge, because a write alone repaints nothing --
# app_server redraws on an event, not on a memory change. R5's PS/2 path moves
# 1 px per unit at nudge speed, so nudge-units=1/nudge-px=1; the device reads
# the coordinate back after every write and re-issues any miss. The hotspot --
# (1,0), measured on BOTH the arrow and the hand across the whole sweep -- is
# never in the control path.
#
# SH_POINTER=rel IS GONE, RETIRED IN THE SAME COMMIT THAT ADDED THIS BACKEND.
# It was the legacy relative knob and it survived in the generated env after
# SH_INPUT_BACKEND arrived. Leaving both would be two sources of truth for one
# property with the older one still live, and the coupled-set discipline that
# held for the other four stations would have had nothing to couple on here.
SH_INPUT_BACKEND=ramabs
SH_RAMABS_SOCK=/data/vms/streamhost/stations/beos/ptr.sock

# THE ADDRESS IS BOUND TO THE GOLDEN. `loadvm golden` restores RAM verbatim, so
# it is fixed for the life of THAT checkpoint and no longer; re-baking REQUIRES
# re-deriving it. Derived against the 2026-08-31 12:12:00 bake
# (VM_CLOCK 0000:26:11.140).
#
# THE SEARCH ALONE CANNOT PICK IT. This bake returned 16 addresses that track
# the pointer, four of them in the same (1,0) bias family as this one. They are
# derived copies; they track perfectly and they are not inputs. Only a WRITE
# TEST separates them, and kh-ramabs' own connect-time probe is that test.
#
# FAIL CLOSED: unset it and the launcher adds no device at all and the station
# keeps its relative pointer. Set but STALE, and kh-ramabs still refuses every
# write after verification fails -- so the failure mode is a worse pointer, not
# corrupted guest memory.
KH_RAMABS_ADDR=0x03a5fae4

# SINGLE INJECTOR (binding): while SH_RAMABS_SOCK is connected the device owns
# the guest pointer. No abs->rel bridge, no QMP input-send-event, no labctl
# pointer helper may push motion or a button edge at this mouse.

# ---- TELEMETRY (off; arm the pair together when debugging) ----
SH_RAMABS_TRACE=off
PTR_TRACE=off

# ---- INERT UNDER THIS BACKEND ----
# SH_CURSOR_SCALE / SH_CURSOR_OFF_* only ever fed the abs->rel dead-reckoning
# bridge. Absolute targets are written verbatim, so these stay identity and
# change nothing; they are kept so a rollback to the relative pointer is a
# one-line edit (SH_INPUT_BACKEND=dbus-rel, and unset KH_RAMABS_ADDR) -- but see
# the binary note above: a full rollback also moves the golden.
SH_CURSOR_SCALE=1.0
