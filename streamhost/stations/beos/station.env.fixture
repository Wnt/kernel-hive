# --- GOLDEN TEST FIXTURE ---
# resetMode=loadvm : disk is a standalone qcow2, snapshot "golden" holds live RAM+disk.
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_GOLDEN_DISKS=beos-golden.qcow2
# PS/2 relative pointer driven 1:1 through browser pointer-lock (pointerRel,
# the qnx pattern); BeOS's own mouse acceleration applies inside the guest. Fixture: BeOS R5 1024x768x16 desktop, Deskbar top-right, Tracker, one
# Terminal window opened by UserBootscript. See docs/guests/beos.md.

# ---- POINTER: HELD AT THE RELATIVE BACKEND UNTIL beos's OWN CUTOVER ----
# SH_INPUT_BACKEND is deliberately dbus-rel, NOT ramabs. Everything below
# describes the absolute pointer that is READY but NOT CUT OVER: beos still
# runs the host qemu-system-x86_64, which has no kh-ramabs device at all, and
# /opt/qemu-beos has not been built. Setting ramabs here would configure the
# daemon for a device that cannot exist on this station's binary.
# TO COMPLETE THE CUTOVER, together and in this order: build /opt/qemu-beos,
# cold re-bake the golden, re-derive KH_RAMABS_ADDR, then flip
# SH_INPUT_BACKEND=ramabs here AND the registry's stream.pointer /
# spa.pointerRel / operator.labctl.pointer_mode / reset.pointer.
#
# ---- POINTER: ABSOLUTE BY WRITING THE GUEST'S OWN COORDINATE ----
# Not a closed loop, and not an absolute device -- R5 has neither a usable
# absolute tablet nor a hardware cursor (it drives std VGA as its "stub"
# driver, and its own accelerated drivers do not claim anything QEMU emulates;
# see docs/lab/BEOS-ABSOLUTE-POINTER.md for that disproof). What it does have
# is its own pointer coordinate in RAM: app_server keeps it as two
# little-endian int32 (layout `point32le`). The launcher's `-device kh-ramabs`
# writes the commanded pixel there and injects ONE 1-unit relative PS/2 nudge,
# because a write alone repaints nothing -- app_server redraws on an event, not
# on a memory change. R5's PS/2 path moves 1 px per unit at nudge speed, so
# nudge-units=1/nudge-px=1; the device reads the coordinate back after every
# write and re-issues any miss. The hotspot -- (1,0) on R5's arrow, measured
# across five positions, never guessed -- is never in the control path.
#
# THE ADDRESS IS BOUND TO THE GOLDEN and is passed by KH_RAMABS_ADDR, not
# hard-coded here: `loadvm golden` restores RAM verbatim, so it is fixed for the
# life of THAT checkpoint and no longer. Unset it and the launcher adds no
# device and the station keeps its relative pointer. Set but stale, and
# kh-ramabs still refuses every write after its connect-time verification
# fails, so the failure is a worse pointer rather than corrupted guest memory.
#
# SINGLE INJECTOR (binding): while SH_RAMABS_SOCK is connected the device owns
# the guest pointer. No abs->rel bridge, no QMP input-send-event, no labctl
# pointer helper may push motion or a button edge at this mouse.
SH_INPUT_BACKEND=dbus-rel
SH_RAMABS_SOCK=/data/vms/streamhost/stations/beos/ptr.sock
# KH_RAMABS_ADDR is DELIBERATELY UNSET here. It is filled in only once a golden
# exists that it was derived against -- see the registry's
# runtime.qemu.pointerRamAddress and docs/lab/BEOS-ABSOLUTE-POINTER.md.
# KH_RAMABS_ADDR=0x...

# ---- TELEMETRY (off; arm the pair together when debugging) ----
SH_RAMABS_TRACE=off
PTR_TRACE=off

# ---- INERT UNDER THIS BACKEND ----
# SH_CURSOR_SCALE / SH_CURSOR_OFF_* only ever fed the abs->rel dead-reckoning
# bridge. Absolute targets are written verbatim, so these stay identity and
# change nothing; they are kept so a rollback to the relative pointer is a
# one-line edit (SH_INPUT_BACKEND=dbus-rel, and unset KH_RAMABS_ADDR).
SH_CURSOR_SCALE=1.0
