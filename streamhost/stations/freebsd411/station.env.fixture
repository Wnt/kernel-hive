# freebsd411 — FreeBSD 4.11 i386 (2005), KDE 3.3.2. Reset = loadvm golden on disk.qcow2, the
# only block device (rule 6: golden + /opt/qemu-beos binary + device set are one).
# Checkpoint facts (golden stream, measured): VM_SIZE 113 MiB, VM_CLOCK 0003:07:42.509, baked 2026-09-03 06:28:53 UTC
# on the shipping set (-vga std, SCSI disk on lsi53c895a; install ran under TCG, see the launcher header).
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_GOLDEN_STATE_DISK=/data/vms/streamhost/stations/freebsd411/disk.qcow2
SH_FIXTURE_DESC=FreeBSD 4.11 KDE 3.3.2 desktop (XFree86 4.4.0 vesa on -vga std, 1024x768x16): Kicker panel with the K menu, a Konsole holding a root shell. Pointer motion absolute through the guest X server (x11warp), buttons + keys over PS/2.
# Fleet floor for QEMU keyboard stations; measure only if characters drop.
SH_KEY_MIN_HOLD_MS=40
SH_KEY_MIN_GAP_MS=40
FREEBSD411_QEMU=/opt/qemu-beos/bin/qemu-system-x86_64
# Pointer: motion via XWarpPointer + XQueryPointer readback on the guest's X
# server, reached through the launcher's loopback SLIRP forward (6078 -> 6000).
# The golden carries `xhost +10.0.2.2`. Buttons/keys: D-Bus PS/2 (default path).
SH_INPUT_BACKEND=x11warp
SH_X11WARP_DISPLAY=127.0.0.1:78
SH_X11WARP_TRACE=off
SH_CURSOR_SCALE=1.0
