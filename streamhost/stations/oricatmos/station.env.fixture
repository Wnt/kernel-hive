# ---- HOST-NATIVE STATION (de-bridged 2026-08-12, conversion campaign) ----
# MAME 0.289's orica runs ON THE HOST: drawshm frames, ctlsock keys through
# the generated keymap, AY-3-8912 sound -> SDL disk -> FIFO with the daemon
# as clock. Launcher: shared stations/mame-native/x11-runtime.sh; reset =
# relaunch restoring the golden savestate.
SH_RESET_MODE=relaunch
SH_FIXTURE_DESC=Oric Atmos (1984) at its own untouched power-on screen: "ORIC EXTENDED BASIC V1.1 / (c) 1983 TANGERINE / 37631 BYTES FREE / Ready" in black on a white page, with the machine's own CAPS marker in the top-right corner, drawn with aspect correction by MAME 0.289's `orica` driver running HOST-NATIVE (drawshm) on the published 800x600 surface — 4:3, the shape the Atmos drew on a television. Nothing is curated and nothing is typed. Keyboard-only exhibit; no pointer device; AY-3-8912 sound -> FIFO. The interaction is the registry demoProgram, a colour-and-sound listing in Oric Extended BASIC that the UI types and the visitor runs.
MAME_NATIVE_BIN=/data/vms/streamhost/assets/oricatmos/mame-native/oricatmos
MAME_NATIVE_DRIVER=orica
MAME_NATIVE_ROMS=/data/vms/streamhost/assets/oricatmos/mame-native/roms
MAME_NATIVE_GEOM=800x600
MAME_NATIVE_ARGS=-bios ver11
SH_MAMECTL_SOCK=/data/vms/streamhost/stations/oricatmos/ctl.sock
SH_MAMESOCK_KEYMAP=/data/vms/streamhost/stations/oricatmos/oricatmos.keymap
SH_AUDIO_SOURCE=fifo
SH_AUDIO_FIFO=/data/vms/streamhost/stations/oricatmos/audio.fifo

# ---- KEYBOARD PACING (the exhibit's only input surface) ----
SH_KEY_MIN_HOLD_MS=80
SH_KEY_MIN_GAP_MS=80
