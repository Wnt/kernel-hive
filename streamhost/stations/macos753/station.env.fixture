# ---- CHECKPOINT FIXTURE (QEMU station, resetMode=loadvm) ----
# The scene is a quiet Mac OS 7.5.3 Finder desktop at 1152x870x8 — the
# authentic Apple 21-inch mode, and one of only TWO modes this machine can
# actually reach: macfb lists 640x480 and 800x600 for its VGA display type and
# 1152x870 for the Apple 21-inch type, but the VGA type always comes up 640x480
# no matter what -g says or how fresh the PRAM is, and Mac OS offers no
# resolution list at all (the declaration ROM exposes a single mode). So the
# geometry is a launcher decision, not a guest one, and changing it means
# re-baking the checkpoint.
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_FIXTURE_DESC=Quiet Mac OS 7.5.3 Finder desktop at 1152x870x8 (Quadra 800, 68040 under TCG): Macintosh HD top-right, empty Trash bottom-right, no window open, nothing selected. loadvm restores in 0.32 s, framebuffer-identical to the baked scene.

# ---- POINTER: RELATIVE ADB, and why the scale is not 1.0 ----
# This machine has no absolute pointer path of any kind — no USB bus, no
# tablet, no vmmouse — so the daemon runs its abs->rel bridge and the guest
# sees deltas only. Mac OS then applies its OWN units-to-pixels factor, and
# every tracking setting except the slowest is an ACCELERATION CURVE under
# which 1:1 is unreachable by construction. The checkpoint therefore pins the
# Mouse control panel to "Very Slow", which is dead linear at a measured
# 0.36 px per unit (1000 units -> 360 px, 1500 -> 540, 3000 -> 1079, and
# identical at every send chunk size from 1 to 32). SH_CURSOR_SCALE is that
# factor's reciprocal.
#
# Re-measure with:
#   scripts/install-vision/adb_pointer.py --qmp <CLONE>/qmp.sock gain
# against a CLONE. If the checkpoint is ever re-baked with a different tracking
# setting, this number is wrong and the pointer will drift proportionally.
# ---- ABSOLUTE POINTER (ramabs); the block above is now HISTORY ----
# Everything the comment above describes about tracking curves and the 0.36
# px/unit factor is still TRUE of the relative path, and still the rollback
# target — but it is INERT while SH_INPUT_BACKEND=ramabs, because writing the
# position into Mac OS's own globals bypasses the tracking curve entirely.
# SH_CURSOR_SCALE and the checkpoint's "Very Slow" Mouse control panel setting
# are deliberately LEFT IN PLACE rather than retired here: retiring them changes
# what the golden means, and belongs in its own commit so that rolling back one
# does not strand the other.
#
# SINGLE INJECTOR (binding): while SH_RAMABS_SOCK is connected the kh-ramabs
# device OWNS the guest pointer. No rel bridge, no QMP input-send-event, no
# labctl pointer helper may write it at the same time.
SH_INPUT_BACKEND=ramabs
SH_RAMABS_SOCK=/data/vms/streamhost/stations/macos753/ptr.sock
# SH_RAMABS_TRACE traces the daemon's side of the wire; PTR_TRACE (read by the
# launcher) traces the device's side. Arm them together or neither.
SH_RAMABS_TRACE=off

# ---- SH_CURSOR_SCALE: INERT NOW, LOAD-BEARING ON ROLLBACK ----
# The 2.7778 below DELIBERATELY OVERRIDES the 1.0 the emitter writes earlier in
# the generated station.env. BOTH lines are present in that file; systemd's
# EnvironmentFile takes the LAST assignment, so this one is operative. Do NOT
# "fix" the disagreement by harmonising them to 1.0 -- the reason is below, and
# it is the whole point of this comment.
#
# INERT UNDER ramabs, and that is PROVED FROM THE CODE, not measured. Measuring
# it would only ever show it did not matter in the cases tried; the claim needed
# is that it cannot be read at all. `cursor_scale` has exactly three reachable
# uses, every one behind `is_dbus()`:
#   * set_abs()                     -- DbusAbs only
#   * calibrated_abs() / home_pin() -- DbusRel only
#   * the rel_bridge uses           -- reached from the DbusRel branch, and
#     run_pacer is spawned under
#     `if cfg.rel_paced && cfg.input_backend == DbusRel`
# input.rs::apply_move_abs does `router.try_move(x, y, width, height); return;`
# BEFORE all three, with `debug_assert!(cfg.input_backend.is_dbus())` on the very
# next line -- the code itself asserting that the routed backends have already
# left. Buttons are unscaled too: the type-2 record's own coordinates go straight
# to try_button_at(). And the value never escapes the daemon -- it is not in
# signaling.json and the SPA never sees it. Under ramabs there is NO REACHABLE
# CALL SITE.
#
# LOAD-BEARING THE MOMENT THIS STATION ROLLS BACK. The rollback documented in
# qemu-streamhost.sh is two lines: drop the -chardev/-device pair and set
# SH_INPUT_BACKEND=dbus-rel. That makes cursor_scale live again, and 2.7778 is
# exactly what the relative path needs -- Mac OS at "Very Slow" moves 0.36 px per
# delta unit and this is its reciprocal. Harmonising both lines to 1.0 would
# leave the rollback moving the pointer at 0.36x WITH NOTHING FAILING.
#
# So this is a dormant value that wakes only on the RECOVERY path, which is
# strictly more dangerous than one that is wrong all the time: the recovery path
# is taken under pressure, by someone who did not write it, at the moment they
# least want a second fault. The disagreement is therefore DOCUMENTED rather than
# removed -- removing it is the mistake, not the fix.
SH_CURSOR_SCALE=2.7778
# ---- RE-HOME BRIDGE (rel_bridge.rs; docs/lab/research/rel-pointer-rehome-and-rate-cap.md) ----
# macos753's ADB mouse QUEUES every count (nothing is ever lost), so the bridge
# NEVER DRIFTS once homed — measured 2026-08-18. It therefore needs re-homing on
# exactly one event: a `loadvm golden` restore, which teleports the guest cursor
# to the checkpoint position behind the model's back (reset-tile.sh -> SIGUSR2).
# The focus/idle/edge triggers and SH_REL_PACED are for the PS/2 *drift* stations;
# on this queuing ADB guest they only throw the cursor into the corner for the
# ~1 s an oversized pin (2048 px x 2.78 = 5688 units at 63/report) takes to drain.
SH_REL_HOME_ON=reset
# The guest cursor's baked position in the golden checkpoint (arrow-tip hotspot,
# measured from a screendump 2026-08-18: dead-centre of the 1152x870 desktop).
# On a reset the bridge seeds the model straight here — no corner pin, so the
# guest snaps under the visitor's pointer on their first move.
SH_REL_HOME_TO=599,500
# Raw sends — the QEMU adb-mouse button-barrier FIFO orders motion→button.

# ---- IDLE AUTO-PAUSE: ON from day one ----
# m68k runs under TCG — there is no KVM path for this architecture — so an idle
# station burns a real host core for nobody. It is a plain QEMU station, so the
# daemon's default QMP stop/cont path applies and needs no pidfile guard; the
# launcher additionally starts it PAUSED at the checkpoint (-loadvm golden -S),
# so a station nobody has visited has never run a single guest instruction.
# Warmup is 0 deliberately: there is no boot to protect, because the station
# never cold-boots in normal operation — it resumes an already-finished desktop.
# Rollback is one line: SH_IDLE_PAUSE_SECS=0.
SH_IDLE_PAUSE_SECS=60
