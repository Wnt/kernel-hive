# ---- HOST-NATIVE STATION (de-bridged 2026-08-12, conversion campaign) ----
# MAME 0.289's spectrum runs ON THE HOST — the apt-0.251 pin that had no
# trixie successor dissolves with the kiosk. drawshm frames, ctlsock keys
# through the generated keymap, beeper -> SDL disk -> FIFO with the daemon
# as clock. Launcher: shared stations/mame-native/x11-runtime.sh; reset = relaunch
# (cold boot; see MAME_NATIVE_CHECKPOINT below).
SH_RESET_MODE=relaunch
SH_FIXTURE_DESC=Sinclair ZX Spectrum 48K power-on screen — the machine's own white paper across the whole raster with "© 1982 Sinclair Research Ltd" in black along the bottom — drawn by MAME 0.289's `spectrum` (-bios en) running HOST-NATIVE (drawshm) with aspect correction on the published 1024x768 surface. Deliberately NOT curated inside a program (the Plus/4 lesson: a visitor arriving mid-application cannot tell what it is). Keyboard-only exhibit; no pointer device; beeper -> FIFO.
MAME_NATIVE_BIN=/data/vms/streamhost/assets/zxspectrum/mame-native/spectrum
MAME_NATIVE_DRIVER=spectrum
MAME_NATIVE_ROMS=/data/vms/streamhost/assets/zxspectrum/mame-native/roms
MAME_NATIVE_GEOM=1024x768
MAME_NATIVE_ARGS=-bios en
# The bbcb/zx81/kc85_4/spectrum drivers have NO MACHINE_SUPPORTS_SAVE, so
# checkpoint restore is OFF (it restored garbage — 2026-08-12); reset is
# the cold boot, which reaches this scene in seconds.
MAME_NATIVE_CHECKPOINT=0
# SCANNED-MATRIX KEYBOARD: the guest's own ROM scans this matrix, so two
# keys down at once are ambiguous (ghosting/interleave) and the browser
# sends a typed line as ONE BURST — the daemon's SH_KEY_MIN_* gate paces
# only the QEMU/dbus path, never this one. Exclusive-scan restores the
# serialized delivery every station's pacing was bisected under (the same
# contract typeDemoProgram and validate_demo_pacing assume). Modifier
# fields (Shift/Ctrl) are exempt by name, so chords still work.
MAME_CTL_KEY_EXCL=:LINE
SH_MAMECTL_SOCK=/data/vms/streamhost/stations/zxspectrum/ctl.sock
SH_MAMESOCK_KEYMAP=/data/vms/streamhost/stations/zxspectrum/zxspectrum.keymap
SH_AUDIO_SOURCE=fifo
SH_AUDIO_FIFO=/data/vms/streamhost/stations/zxspectrum/audio.fifo

# ---- STANDBY (instant-ready: an emulator nobody watches costs ~0 CPU) ----
# The launcher freezes the emulator once the scene has painted, and the
# daemon owns it from there: SIGSTOP after the idle grace with zero
# sessions, unconditional SIGCONT the moment a visitor connects. Without
# this a de-bridged station burns a full core around the clock.
# SH_IDLE_PAUSE_PROC_MATCH is the anti-footgun: the signal is only ever
# sent to a pid whose cmdline still carries this station's own asset path
# (bbcmicro and armeval run identically-named `bbcb` binaries).
# Rollback is one line: SH_IDLE_PAUSE_SECS=0 restores an always-running
# exhibit.
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/zxspectrum/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/zxspectrum/mame-native
MAME_NATIVE_STANDBY_DELAY_S=8

# ---- KEYBOARD PACING (the exhibit's only input surface) ----
# 200/200 shipped on the bridge tile: the Spectrum's KEY-WORD entry needs
# the slowest pacing in the fleet.
SH_KEY_MIN_HOLD_MS=200
SH_KEY_MIN_GAP_MS=200
