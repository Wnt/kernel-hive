# ---- HOST-NATIVE STATION (de-bridged 2026-08-12, conversion campaign) ----
# MAME 0.289's spectrum runs ON THE HOST — the apt-0.251 pin that had no
# trixie successor dissolves with the kiosk. drawshm frames, ctlsock keys
# through the generated keymap, beeper -> SDL disk -> FIFO with the daemon
# as clock. Launcher: shared stations/mame-native/x11-runtime.sh; reset =
# relaunch restoring the golden savestate.
SH_RESET_MODE=relaunch
SH_FIXTURE_DESC=Sinclair ZX Spectrum 48K power-on screen — the machine's own white paper across the whole raster with "© 1982 Sinclair Research Ltd" in black along the bottom — drawn by MAME 0.289's `spectrum` (-bios en) running HOST-NATIVE (drawshm) with aspect correction on the published 1024x768 surface. Deliberately NOT curated inside a program (the Plus/4 lesson: a visitor arriving mid-application cannot tell what it is). Keyboard-only exhibit; no pointer device; beeper -> FIFO.
MAME_NATIVE_BIN=/data/vms/streamhost/assets/zxspectrum/mame-native/spectrum
MAME_NATIVE_DRIVER=spectrum
MAME_NATIVE_ROMS=/data/vms/streamhost/assets/zxspectrum/mame-native/roms
MAME_NATIVE_GEOM=1024x768
MAME_NATIVE_ARGS=-bios en
SH_MAMECTL_SOCK=/data/vms/streamhost/stations/zxspectrum/ctl.sock
SH_MAMESOCK_KEYMAP=/data/vms/streamhost/stations/zxspectrum/zxspectrum.keymap
SH_AUDIO_SOURCE=fifo
SH_AUDIO_FIFO=/data/vms/streamhost/stations/zxspectrum/audio.fifo

# ---- KEYBOARD PACING (the exhibit's only input surface) ----
# 200/200 shipped on the bridge tile: the Spectrum's KEY-WORD entry needs
# the slowest pacing in the fleet.
SH_KEY_MIN_HOLD_MS=200
SH_KEY_MIN_GAP_MS=200
