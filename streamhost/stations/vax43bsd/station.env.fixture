# vax43bsd station.env fixture — appended to the emitted station.env.
#
# 4.3BSD (Berkeley, June 1986) on an emulated DEC VAX-11/780 under Open SIMH,
# staged by scripts/build-guests/tiles/vax43bsd.sh from the TUHS distribution
# tapes. No QEMU, no MAME, no checkpoint: the exhibit is a simulator process
# plus one terminal, and reset = relaunch from the pristine seed RA81.
#
# CONTAINED (docs/lab/record-wave/HOST-APP-CONTAINER-CONTRACT.md): SIMH, Xvfb
# and the visitor's xterm all run inside a systemd-nspawn container — own
# PID/mount/net/IPC/UTS/user namespaces, root inside = host uid
# VAX43BSD_UIDBASE, volatile overlay root, bin/ and media/ bound READ-ONLY,
# work/ the only writable bind, CAP_SYS_ADMIN dropped, mount syscalls filtered.
# The host sees the display through a symlink /tmp/.X11-unix/X115 ->
# VAX43BSD_X11_SOCKDIR/X115, so capture, XTEST and labctl are unchanged.
# mame.pid is the SIMH vax780 HOST pid (idle freezer + reap-by-exe);
# nspawn.pid is the supervisor.
#
# The inner script is only a prologue: it stages work/, writes the SIMH ini and
# execs the lane's shared engine, docs/lab/record-wave/shared-terminal-runtime.sh
# (vax43bsd is the station that proved it).

# --- the emulated machine ---------------------------------------------------
VAX43BSD_ASSETS=/data/vms/streamhost/assets/vax43bsd
VAX43BSD_GEOM=1024x768
# DZ11 line 0 — the visitor terminal, tty00. Container-private
# (--private-network), so it needs no host port claim and is unreachable from
# labhost. tty01..tty07 exist in /etc/ttys but only line 0 is published.
VAX43BSD_PORT=10023
# 80x24 is not a taste call: 4.3BSD's termcap `vt100` is a fixed 24x80 and
# telnet to a DZ line carries no window-size negotiation, so any other row
# count makes vi and more draw wrong.
VAX43BSD_COLS=80
VAX43BSD_ROWS=24
# MEASURED from the real framebuffer (docs/lab/VAX43BSD-WAVE.md): DejaVu Sans
# Mono at 21 px gives a 1011x590 xterm, so +6+88 centres it on the 1024x768
# root with the rest of the root window black.
VAX43BSD_FONTSIZE=14
VAX43BSD_XOFF=+32+96
# --- container (systemd-nspawn) --------------------------------------------
# rootfs: debootstrap minbase trixie + xvfb/xterm/telnet/netcat, uid-shifted by
# tiles/vax43bsd.sh; VAX43BSD_UIDBASE must be a multiple of 65536 and clear of
# the CT subuid range (100000+) and of the other contained stations
# (medley 1966080, indyr4400 2031616, mvs38 2031616, its 2424832).
VAX43BSD_ROOTFS=/data/vms/streamhost/assets/vax43bsd/rootfs
VAX43BSD_UIDBASE=2490368
VAX43BSD_X11_SOCKDIR=/run/streamhost/x11/vax43bsd
VAX43BSD_READY_TIMEOUT_S=300

# --- input: keyboard only. This is a terminal exhibit; there is no pointer,
# and 4.3BSD's console has no mouse to give one to. The keys a 1986 shell
# actually needs — ^C interrupt, ^D end-of-file/logout, ^U kill line, ^Z stop,
# ^S/^Q flow control, ESC for vi — must reach the guest through the SPA's
# on-screen keyboard, never a host shortcut.
SH_X11TEST_KEYS=1
SH_KEY_MIN_HOLD_MS=40
SH_KEY_MIN_GAP_MS=40

# --- reset / standby --------------------------------------------------------
# Relaunch: kill the simulator, wipe work/, copy the pristine RA81 back in and
# start again. The seed is mode 0444 and bound read-only, so nothing a visitor
# types can corrupt it. The seed was snapshotted from a guest that ran
# `sync; sync; /etc/halt` — a dirty 4.3BSD filesystem is salvaged at boot and
# the guest then reboots itself, which looks exactly like a boot loop.
SH_RESET_MODE=relaunch
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/vax43bsd/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/vax43bsd/bin
SH_IDLE_PAUSE_WARMUP_SECS=90
VAX43BSD_STANDBY_DELAY_S=30
