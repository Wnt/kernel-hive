# mvs38 station.env fixture — appended to the emitted station.env.
#
# IBM OS/VS2 MVS 3.8j on an emulated IBM System/370 under Hercules, packaged as
# the TK5 distribution and staged by scripts/build-guests/tiles/mvs38.sh. No
# QEMU, no MAME, no checkpoint: the exhibit is a mainframe emulator plus one
# 3270 terminal, and reset = relaunch from the pristine TK5 DASD volumes.
#
# CONTAINED (docs/lab/record-wave/HOST-APP-CONTAINER-CONTRACT.md): Hercules,
# Xvfb and the visitor's x3270 all run inside a systemd-nspawn container — own
# PID/mount/net/IPC/UTS/user namespaces, root inside = host uid MVS38_UIDBASE,
# volatile overlay root, the TK5 tree bound READ-ONLY, work/ the only writable
# bind, CAP_SYS_ADMIN dropped, mount syscalls filtered. The host sees the
# display through a symlink /tmp/.X11-unix/X114 -> MVS38_X11_SOCKDIR/X114, so
# capture, XTEST and labctl are unchanged. mame.pid is the Hercules HOST pid
# (idle freezer + reap-by-exe); nspawn.pid is the supervisor.
#
# The inner script is only a prologue: it writes the x3270 keymap, sets the TK5
# environment and execs the lane's shared engine,
# docs/lab/record-wave/shared-terminal-runtime.sh (vax43bsd proved it; mvs38
# measured the readiness finding that shaped it).

# --- the emulated machine ---------------------------------------------------
MVS38_ASSETS=/data/vms/streamhost/assets/mvs38
MVS38_GEOM=1024x768
# Hercules CNSLPORT. Container-private (--private-network), so it needs no host
# port claim and is unreachable from labhost. The first client to reach it
# lands on 00C0 3270, a VTAM local terminal — the MVS operator console is
# device 0009 3215-C (TK5CONS=intcons) and writes to the Hercules log instead,
# so it never competes for this port and never appears on screen.
MVS38_PORT=3270
# 3279-2-E: the colour 24x80 model with extended attributes — what TSO/ISPF on
# MVS 3.8j was written for. A 3278 (monochrome) would lose ISPF's colour
# fields; a -4 or -5 model gives a screen size MVS 3.8j's VTAM does not
# negotiate.
MVS38_MODEL=3279-2-E
MVS38_WINTITLE=MVS 3.8j
# x3270's own bitmap 3270 font, from xfonts-x3270-misc (a Recommends that
# debootstrap --variant=minbase skips — without it x3270 has no 3270 font at
# all and will not start).
MVS38_FONT=3270gt24
# --- container (systemd-nspawn) --------------------------------------------
# rootfs: debootstrap minbase trixie + xvfb/x3270/xfonts-x3270-misc, uid-shifted
# by tiles/mvs38.sh; MVS38_UIDBASE must be a multiple of 65536 and clear of the
# CT subuid range (100000+) and of the other contained stations
# (medley 1966080, indyr4400 2031616, its 2424832, vax43bsd 2490368).
MVS38_ROOTFS=/data/vms/streamhost/assets/mvs38/rootfs
MVS38_UIDBASE=2097152
MVS38_X11_SOCKDIR=/run/streamhost/x11/mvs38
# MEASURED 2026-09-20: Hercules opens CNSLPORT at +8 s and MVS reaches
# `IKT005I TCAS IS INITIALIZED` — the first moment TSO will accept a logon — at
# +47 s on an idle box. The generous ceiling is for a loaded one.
MVS38_READY_TIMEOUT_S=420

# --- input: keyboard only. This is a 3270 exhibit; there is no pointer, and a
# 3270 data stream carries none. Every AID key a visitor needs — Enter, Clear,
# PA1/PA2/PA3, PF1..PF24, Reset, Attn, Erase EOF, Tab/BackTab — reaches the
# guest through the SPA's on-screen keyboard (family `tn3270`), mapped by the
# committed x3270 keymap in nspawn-inner.sh. Never a hidden host shortcut.
SH_X11TEST_KEYS=1
SH_KEY_MIN_HOLD_MS=40
SH_KEY_MIN_GAP_MS=40

# --- reset / standby --------------------------------------------------------
# Relaunch: kill Hercules, wipe work/, rebuild work/tk5 from the read-only TK5
# tree and start again. The DASD copy is the only bulk in it; on this ZFS
# `cp -a` of the 270 MB dasd/ is a block clone — MEASURED ~1.2 s, no space.
SH_RESET_MODE=relaunch
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/mvs38/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/mvs38/tk5/hercules
SH_IDLE_PAUSE_WARMUP_SECS=120
MVS38_STANDBY_DELAY_S=45
