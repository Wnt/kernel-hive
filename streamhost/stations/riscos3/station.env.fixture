# ---- HOST-NATIVE STATION (de-bridged from day one) ----
# MAME 0.289's aa310 (Acorn Archimedes 310, driver status=preliminary) runs
# ON THE HOST — drawshm frames, ctlsock keys through the generated keymap,
# no audio in the first wave. Launcher: shared stations/mame-native/
# x11-runtime.sh. RISC OS 3.11 is entirely ROM-resident (bios=311 on the
# aa310 romset); nothing is installed and there is no disk image.
# aa310's MAME savestate support is listed "unsupported" in -listxml, so
# reset is a cold-boot RELAUNCH, not a checkpoint restore.
SH_RESET_MODE=relaunch
SH_FIXTURE_DESC=RISC OS 3.11 Desktop at power-on -- a mid-grey backdrop with the icon bar along the bottom (floppy icon at :0, the Apps directory viewer, palette and Acorn icons at the right) and the pointer visible, drawn on the published 1024x768 surface by MAME 0.289's aa310 running HOST-NATIVE (drawshm). MEASURED 2026-09-20 with a system MAME 0.264 smoke boot (same driver/romset metadata as the pinned 0.289): reaches the Desktop in roughly 15 s after pressing a key past the preliminary-driver warning panel, which -skip_warnings removes for the exhibit itself. No disk is attached -- RISC OS is entirely ROM-resident on this romset.
MAME_NATIVE_BIN=/data/vms/streamhost/assets/riscos3/mame-native/aa310
MAME_NATIVE_DRIVER=aa310
MAME_NATIVE_ROMS=/data/vms/streamhost/assets/riscos3/mame-native/roms
MAME_NATIVE_GEOM=1024x768
MAME_NATIVE_SKIP_WARNINGS=1
MAME_NATIVE_ARGS=-bios 311
# aa310 has no MACHINE_SUPPORTS_SAVE (listxml savestate="unsupported"), like
# bbcb/zx81/kc85_4/spectrum -- checkpoint restore is OFF; reset is the cold
# boot, which reaches the Desktop in seconds.
MAME_NATIVE_CHECKPOINT=0
SH_MAMECTL_SOCK=/data/vms/streamhost/stations/riscos3/ctl.sock
SH_MAMESOCK_KEYMAP=/data/vms/streamhost/stations/riscos3/riscos3.keymap
# No audio device wired in the first wave (the seed calls for audio off).

# ---- STANDBY (instant-ready: an emulator nobody watches costs ~0 CPU) ----
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/riscos3/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/riscos3/mame-native
MAME_NATIVE_STANDBY_DELAY_S=8

# ---- KEYBOARD (CPU-scanned matrix, ROW.0..ROW.15) ----
# UNMEASURED past the driver's own port list: the keyboard MCU romset
# (acorn_0280,022-01_philips_8051ah-2.bin) scans :keyboard:ROW.0..ROW.15.
# Fleet floor first; exclusive-scan pacing only if characters drop on the
# live rig (matches bbcmicro/atari800xl's own CPU-scanned matrices).
SH_KEY_MIN_HOLD_MS=80
SH_KEY_MIN_GAP_MS=80
MAME_CTL_KEY_EXCL=:keyboard:ROW

# ---- POINTER — NOT WIRED in the first wave ----
# The aa310 driver exposes its own quadrature mouse ports
# (:keyboard:MOUSE.0 = X, 16-bit analog; :keyboard:MOUSE.1 = Y, 16-bit
# analog; :keyboard:MOUSE.2 = buttons) -- NOT an ADB/HLE chain like
# apple2gs, so none of that station's gain/calibration numbers apply here.
# Station ships keyboard-only; stream.pointer.transport stays "none" until
# a two-target Desktop click readback proves a binding on the live rig.
