# ---- HOST-NATIVE STATION (de-bridged from day one) ----
# MAME 0.289's aa310 (Acorn Archimedes 310) runs ON THE HOST — drawshm frames,
# ctlsock keys through the generated keymap, ctlsock CLOSED-LOOP pointer, no
# audio in the first wave. Launcher: shared stations/mame-native/x11-runtime.sh.
# RISC OS 3.11 is entirely ROM-resident (bios=311 on the A310 romset); nothing
# is installed and there is no disk image, so the device set is the romset and
# the binary alone.
SH_RESET_MODE=relaunch
SH_FIXTURE_DESC=RISC OS 3.11 Desktop with the Resources:$.Apps Filer window open in the top left -- !Alarm, !Calc, !Chars, !Configure, !Draw, !Edit, !Help and !Paint one Select-click away -- over the mid-grey Pinboard backdrop, with the icon bar along the bottom (floppy :0, Apps, the palette and the Acorn task-manager icon) and the pointer parked on open backdrop, drawn on the published 1024x768 surface by MAME 0.289's aa310 running HOST-NATIVE (drawshm). MEASURED 2026-09-20: cold power-on reaches the bare Desktop in 21 s, and the golden savestate (137197 B, saved in 1.0 s) restores this scene to a BYTE-IDENTICAL framebuffer with the guest still live afterwards.
MAME_NATIVE_BIN=/data/vms/streamhost/assets/riscos3/mame-native/aa310
MAME_NATIVE_DRIVER=aa310
MAME_NATIVE_ROMS=/data/vms/streamhost/assets/riscos3/mame-native/roms
MAME_NATIVE_GEOM=1024x768
MAME_NATIVE_SKIP_WARNINGS=1
MAME_NATIVE_ARGS=-bios 311
# CHECKPOINT ON, DESPITE -listxml SAYING OTHERWISE. aa310 is listed
# savestate="unsupported", which on bbcb and kc85_4 meant "restores garbage"
# (docs/lab/x11-runtime.sh §checkpoint). It does NOT mean that here, and the
# difference is measured, not assumed: SAVEST/LOADST round-trips this scene to
# a byte-identical framebuffer (0 changed pixels of 786432) and the guest keeps
# running afterwards — a Menu click still drops the Pinboard menu. The 21 s
# cold boot is the fallback if the checkpoint ever stops restoring; delete
# sta/aa310/golden.sta and the same launcher cold-boots to the bare Desktop.
MAME_NATIVE_CHECKPOINT=1
SH_MAMECTL_SOCK=/data/vms/streamhost/stations/riscos3/ctl.sock
SH_MAMESOCK_KEYMAP=/data/vms/streamhost/stations/riscos3/riscos3.keymap
# No audio device wired in the first wave (SH_AUDIO=off in the registry row).

# ---- STANDBY (instant-ready: an emulator nobody watches costs ~0 CPU) ----
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/riscos3/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/riscos3/mame-native
MAME_NATIVE_STANDBY_DELAY_S=8

# ---- KEYBOARD (CPU-scanned matrix behind an 8051 keyboard MCU) ----
# The Archimedes keyboard is its own microcontroller (acorn_0280,022-01,
# a Philips 8051AH-2 running its own ROM) scanning :keyboard:ROW.0..ROW.15 and
# talking to the host over a serial link. That is TWO layers of scanning
# between a ctlsock field write and RISC OS, so this takes the scanned-matrix
# floor, not the fleet's 40/40: 80/80 ms with exclusive scan on the ROW ports,
# the same shape bbcmicro and atari800xl need.
# MEASURED 2026-09-20: a press and its release issued back-to-back come back
# `OK coalesced` and the guest sees NOTHING — the edges have to be separated.
# F12 held for 0.4 s opens the RISC OS command line (45987 changed pixels).
SH_KEY_MIN_HOLD_MS=80
SH_KEY_MIN_GAP_MS=80
MAME_CTL_KEY_EXCL=:keyboard:ROW

# ---- POINTER — 1:1 ABSOLUTE, closed loop on the VIDC cursor registers ----
# RISC OS is a three-button desktop (Select / Menu / Adjust) and all three are
# bound. Tags and names read from the driver's own -listxml and confirmed
# against src/devices/machine/archimedes_keyb.cpp on the pinned tree:
#   PORT_START("MOUSE.0") PORT_BIT(0xffff, IP_ACTIVE_HIGH, IPT_MOUSE_X)
#   PORT_START("MOUSE.1") PORT_BIT(0xffff, IP_ACTIVE_HIGH, IPT_MOUSE_Y)
#   PORT_START("MOUSE.2") 0x20 "Mouse Left" / 0x40 "Mouse Center" /
#                         0x80 "Mouse Right", ALL IP_ACTIVE_LOW
# so PTR_MOD is 65536 (16-bit axes, unlike the ST's 256 or the GS's), and
# BTN_ACTIVE_LOW is set on all three or every click is a button that was
# never pressed (the fmtowns lesson).
#
# MEASURED 2026-09-20 (rig /data/vms/sandbox/riscos3-land/rig1; the full
# derivation is docs/lab/RISCOS3-WAVE.md §Pointer):
#
#  (a) THE MAGNITUDE USED TO BE DISCARDED ON THE WIRE, and that is the whole
#      reason this station carries mame-archimedes-kbd-mouse-carry.patch.
#      archimedes_keyb.cpp's update_mouse runs at 4 kHz and, on any non-zero
#      delta, advances the quadrature phase by exactly ONE step and then
#      assigns `m_mouse_x = x`. A 600-count MOVE therefore moved the guest
#      pointer ZERO pixels while the device's own m_mouse_x went 0 -> 900.
#      The patch advances the recorded position one unit per tick and keeps
#      the remainder, so a whole round's budget is delivered at 4000 counts/s.
#
#  (b) UNPACED `MOVE` IS NOT A MEASUREMENT TOOL HERE, even after (a). MOVE is
#      latest-wins and slams the whole delta into the analog field in one
#      write; MOVEP/MOVEA pace it. Every "the pointer does not move" reading
#      taken during this bring-up was a bare MOVE.
#
#  (c) THE SENSOR IS THE VIDC1a's OWN HARDWARE CURSOR. acorn_vidc.cpp draws
#      the sprite at m_crtc_regs[CRTC_HCSR]-[CRTC_HBSR] and
#      m_crtc_regs[CRTC_VCSR]-[CRTC_VBSR]; CRTC_HCSR is index 6 and CRTC_VCSR
#      index 14 of a save_pointer'd u32[16], i.e. BYTE offsets 24 and 56,
#      width 4. Reading inside a non-byte save item is what
#      mame-ctlsock-item-window-sized.patch adds.
#
#  (d) CALIBRATION, fitted over 8 spread points, max residual 0.29 px X /
#      0.54 px Y: published = -177 + reg*1.23127 (X), -58 + reg*2.65502 (Y).
#      The guest raster is 640x256 LETTERBOXED into the 1024x768 surface, so
#      the reachable published rectangle is roughly x 118..905, y 43..722 —
#      the fleet's usual corner targets (20,20)/(1000,740) are OUTSIDE the
#      guest raster and no pointer can occupy them.
#
#  (e) WHAT IT LANDS. Five targets spread across the raster x two laps, arrow
#      tip located on the framebuffer: (180,120)->(177,120) | (840,120)->
#      (842,120) | (180,660)->(181,662) | (840,660)->(837,662) |
#      (512,390)->(513,388), and lap 2 the same within a pixel.
#      WORST |err| = 3 px X, 2 px Y, giveups=0, learned gain 2.25/2.47
#      published px per count. RESOLUTION BOUND: one count is 1.493 cursor
#      register units = 1.84 px across, 3.96 px down, so the loop lands on
#      count boundaries and cannot do better than about +-1 px X / +-2 px Y.
#
#  (f) ALL THREE BUTTONS REACT. CLICK3 (Menu, middle) on open backdrop drops
#      the Pinboard menu at the pointer (54944 changed pixels); CLICK1
#      (Select, left) on the icon bar's Apps icon opens the Resources:$.Apps
#      Filer window (100743 changed pixels). Adjust is CLICK2.
MAME_CTL_PTR_PORTS=:keyboard
MAME_CTL_PTR_TAGS=:keyboard:MOUSE.2,:keyboard:MOUSE.0,:keyboard:MOUSE.1
MAME_CTL_BTN_NAMES=Mouse Left,Mouse Right,Mouse Center
MAME_CTL_BTN_ACTIVE_LOW=1,1,1
MAME_CTL_PTR_MOD=65536
MAME_CTL_SCREEN=1024x768
# Closed loop (c)+(d): the sensor is the VIDC cursor register, addressed
# inside the m_crtc_regs save item; CAL maps register units -> published px.
MAME_CTL_CURSOR_ITEMS=m_crtc_regs@24:4,m_crtc_regs@56:4
MAME_CTL_CAL_X=-177
MAME_CTL_CAL_SX=1.23127
MAME_CTL_CAL_Y=-58
MAME_CTL_CAL_SY=2.65502
