
# --- GOLDEN TEST FIXTURE (added by golden-fixture bake) ---
# resetMode=loadvm : single standalone qcow2, snapshot "golden" holds live RAM+disk.
# Reset a test to the fixture with:  bash tiles/win95/golden-reset.sh
#   (or: python3 tiles/win95/drive.py tiles/win95/qmp.sock loadvm golden)
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_GOLDEN_DISK=win95-golden.qcow2
SH_GOLDEN_MANIFEST=tiles/win95/golden.json
# Fixture: Win95 OSR2 desktop, Notepad maximized+focused (keyboard-reactive: typed
# chars + caret; File/Edit/Search/Help + Start = mouse targets). Screensaver (None),
# no monitor power-down, taskbar clock HIDDEN, caret blink quieted, no idle animation.
# See GOLDEN.md / golden.env.
