# ---- HOST-NATIVE STATION (de-bridged 2026-08-16, VICE wave) ----
# VICE 3.10.0's xplus4 runs ON THE HOST, headless: no QEMU, no guest Debian, no
# X server, no kiosk. Frames VICE_SHM_PATH -> SH_CAPTURE=shm (the same IFB1
# wire format MAME's drawshm uses); keys the vicectl socket + the ONE shared
# keysym table (VICE resolves keysym -> matrix through PLUS4/gtk3_sym.vkm, the
# same file the bridged kiosk used, so character behaviour — the single shift,
# the C=+C chord, the chord's cosmetic letter leak — is unchanged BY
# CONSTRUCTION); audio -sounddev wav -> named FIFO with the daemon as clock.
# Launcher: the shared stations/vice-native/x11-runtime.sh, VICE_NATIVE_* knobs.
# Build: scripts/build-guests/emulators/build-vice-native.sh plus4.
SH_RESET_MODE=relaunch
SH_FIXTURE_DESC=Commodore Plus/4 (PAL) ROM power-on screen — "COMMODORE BASIC V3.5 60671 BYTES FREE / 3-PLUS-1 ON KEY F1 / READY." in dark text on white paper inside the TED border, drawn double-size (-TEDdsize) with full borders (-TEDborders 0) by host-native VICE 3.10.0 xplus4. PUBLISHED SURFACE 768x576, MEASURED off the shm mapping (1 769 536 B = 64 + 768*576*4) — VICE has no MAME_SHM_SIZE equivalent, the surface IS the emulated screen times TEDDoubleSize, so this geometry follows from VICE_NATIVE_ARGS and nothing else. The scene is the machine's own untouched cold boot: nothing is curated and nothing is typed, and the screen's own "3-PLUS-1 ON KEY F1" is the exhibit's launcher into the ROM office suite. Keyboard-only exhibit; no pointer device; TED sound -> FIFO.
VICE_NATIVE_BIN=/data/vms/streamhost/assets/plus4/vice-native/bin/xplus4
VICE_NATIVE_DATA=/data/vms/streamhost/assets/plus4/vice-native/share/vice
# The ONLY thing that decides the published geometry (see SH_FIXTURE_DESC).
VICE_NATIVE_ARGS=-pal -TEDdsize -TEDborders 0
SH_VICECTL_SOCK=/data/vms/streamhost/stations/plus4/ctl.sock
SH_VICESOCK_KEYMAP=/data/vms/streamhost/stations/plus4/us-layout.keysyms
SH_AUDIO_SOURCE=fifo
SH_AUDIO_FIFO=/data/vms/streamhost/stations/plus4/audio.fifo

# ---- STANDBY (instant-ready: an emulator nobody watches costs ~0 CPU) ----
# The launcher freezes the emulator once the scene has painted; the daemon owns
# it after that (SIGSTOP after the idle grace with zero sessions, unconditional
# SIGCONT the moment a visitor connects). WITHOUT THESE TWO LINES A DE-BRIDGED
# STATION BURNS A FULL CORE AROUND THE CLOCK. _PROC_MATCH is the anti-footgun:
# the signal only ever reaches a pid whose cmdline carries THIS station's own
# asset path. Rollback is one line: SH_IDLE_PAUSE_SECS=0.
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/plus4/vice.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/plus4/vice-native
VICE_NATIVE_STANDBY_DELAY_S=8

# ---- KEYBOARD PACING ----
# 80/80 is the VICE wave's default, established by the vic20 bisect against
# THIS engine (12 trials/step, framebuffer-compared: 20/20 corrupted 12 of 12,
# 40/40 3 of 12, 60/60 and 80/80 clean) and inherited here unchanged — the
# curve is a property of the guest's SCANNED KEYBOARD MATRIX, which every
# machine in this family has, not of the machine's ROM. This station already
# shipped 80/80 on the bridged path, so the number does not move.
# The launcher hands these to the module as VICE_CTL_KEY_HOLD/_GAP.
SH_KEY_MIN_HOLD_MS=80
SH_KEY_MIN_GAP_MS=80
# No SH_KEY_MAP and no per-station keymap file: VICE's own symbolic keymap does
# that job. The SPA's plus4 profile (one-tap Word/Calc/File buttons that send
# the C= + C sequence) is unchanged — it sends the same host keys it always did.
