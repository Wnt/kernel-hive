# a1000 station.env fixture — appended to the emitted station.env.
# Host-native FS-UAE (github.com/Wnt/fs-uae, branch kernel-hive/integrated,
# build-fsuae-native.sh, FSUAE_STATION=a1000 — its own copy, never shared
# with amigaos35/amix) with NO X: shm frames, ctlsock keys/pointer, audio
# FIFO. Shared launcher: stations/fsuae-native/x11-runtime.sh (rule 13 —
# amigaos35/amix stay on Xvfb+XTEST; RTG and the in-guest X pointer are
# separate waves). Converted from the Xvfb+XTEST launcher on 2026-09-09;
# repo-side only until docs/lab/FSUAE-NATIVE-BRIEF.md Part 3's ctlsock
# commits (5-8) are proven on a framebuffer. a3000 converts FIRST; this
# station follows once a3000's conversion is proven on a rig.

# --- emulator ---------------------------------------------------------------
FSUAE_NATIVE_BIN=/data/vms/streamhost/assets/a1000/fsuae-native/bin/fs-uae
# The 256 KB Kickstart 1.2 r33.180 image sits in the ROM slot (proven route,
# 2026-09-09, on the prior Xvfb launcher). The authentic A1000 path — 64 KB
# bootstrap ROM in the slot and the same image loaded from a Kickstart disk
# in DF0 — reset-loops in this build; this launcher does not implement the
# bootstrap-ROM branch (the old FSUAE_NATIVE_A1000_BOOTSTRAP knob is dropped
# with the per-station launcher it lived in). Re-add it only once a runner
# proves the bootstrap path.
FSUAE_NATIVE_KICK=/data/vms/streamhost/assets/a1000/kick12-r33.180.rom
FSUAE_NATIVE_MODEL=A1000
# No statefile: reset is a cold boot from fresh copies of the golden floppies
# (~55 s to the Workbench 1.2 desktop, measured on the prior Xvfb launcher).
# No network plane: pre-web guest.
FSUAE_NATIVE_FLOPPIES=wb12.adf extras12.adf
FSUAE_NATIVE_STANDBY_DELAY_S=70
SH_MAMECTL_SOCK=/data/vms/streamhost/stations/a1000/ctl.sock
SH_MAMESOCK_KEYMAP=/data/vms/streamhost/stations/a1000/amiga.keymap
SH_AUDIO_SOURCE=fifo
SH_AUDIO_FIFO=/data/vms/streamhost/stations/a1000/audio.fifo

# --- input: ctlsock, absolute mouse (mousehack), the shared amiga keymap ---
# Measured 2026-09-09 on the golden proof (XTEST straight to the fs-uae
# window on the PRIOR Xvfb launcher, bypassing the daemon): an instant click
# (press+release with no hold) never registered against FS-UAE's mousehack
# poll — not once across five tries; a 150ms hold DID register, and a
# 150ms-hold/150ms-gap double-click opened the disk window. Carried forward
# as the ctlsock floor (docs/lab/FSUAE-NATIVE-BRIEF.md's 150ms/200ms); UNPROVEN
# against this launcher's mamesock path.
SH_BTN_MIN_HOLD_MS=150
SH_KEY_MIN_HOLD_MS=40
SH_KEY_MIN_GAP_MS=40

# --- reset / standby --------------------------------------------------------
SH_RESET_MODE=relaunch
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/a1000/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/a1000/fsuae-native
SH_IDLE_PAUSE_WARMUP_SECS=120
