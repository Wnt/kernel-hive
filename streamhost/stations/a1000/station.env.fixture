# a1000 station.env fixture — appended to the emitted station.env.
# Host-native FS-UAE 3.2.35 (build-fsuae-native.sh, FSUAE_STATION=a1000 —
# its own copy, never shared with amigaos35/amix) under a pinned Xvfb :88,
# captured with SH_CAPTURE=x11, driven over XTEST (SH_X11TEST_*).

# --- emulator ---------------------------------------------------------------
FSUAE_NATIVE_BIN=/data/vms/streamhost/assets/a1000/fsuae-native/bin/fs-uae
# The 256 KB Kickstart 1.2 r33.180 image sits in the ROM slot (proven route,
# 2026-09-09). The authentic A1000 path — 64 KB bootstrap ROM in the slot and
# the same image loaded from a Kickstart disk in DF0 — reset-loops in this
# build; flip FSUAE_NATIVE_A1000_BOOTSTRAP=1 once a runner proves it.
FSUAE_NATIVE_KICK=/data/vms/streamhost/assets/a1000/kick12-r33.180.rom
FSUAE_NATIVE_A1000_BOOTSTRAP=0
FSUAE_NATIVE_BOOTROM=/data/vms/streamhost/assets/a1000/a1000-bootstrap.rom
FSUAE_NATIVE_GEOM=720x568
# No statefile: reset is a cold boot from fresh copies of the golden floppies
# (~55 s to the Workbench 1.2 desktop). No network plane: pre-web guest.
FSUAE_NATIVE_CHECKPOINT=0
FSUAE_NATIVE_NET=off
FSUAE_NATIVE_STANDBY_DELAY_S=70

# --- input: the x11test backend (same numbers as amigaos35) -----------------
SH_X11TEST_ABS=1
SH_X11TEST_BUTTONS=xtest
SH_X11TEST_KEYS=1
SH_BTN_MIN_HOLD_MS=60
SH_KEY_MIN_HOLD_MS=40
SH_KEY_MIN_GAP_MS=40

# --- reset / standby --------------------------------------------------------
SH_RESET_MODE=relaunch
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/a1000/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/a1000/fsuae-native
SH_IDLE_PAUSE_WARMUP_SECS=120
