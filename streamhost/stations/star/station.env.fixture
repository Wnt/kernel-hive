# ---- GOLDEN FIXTURE (bridge tile) ----
# resetMode=loadvm -> restore the INTERNAL 'golden' snapshot: the bare-X kiosk
# with Darkstar already at the LOGGED-ON ViewPoint 2.0 user desktop. The whole
# first boot runs exactly once, at bake time — 22 minutes of Pilot, the Set Time
# Utility's five carriage returns, one NEXT to wake the logged-off machine, a
# Desktop Creation and a logon. A visitor sees none of it.
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_FIXTURE_DESC=Xerox 8010 "Dandelion" at the logged-on ViewPoint 2.0 user desktop, emulated by Darkstar on mono 6.8 inside a captured Debian 12 bare-X kiosk. 1024x808 one-bit display inside Darkstar's 1088x860 DisplayBox, filling a custom 1088x860 X root edge to edge with the emulator's System Menu and System Status bars moved off-screen. The desk is the ViewPoint grey stipple; the header strip reads "35167 Free Disk Pages" with a Help button, and the Directory icon sits bottom-right and the Star's own cursor is parked in the top-left corner of the raster (which is also the origin the daemon's relative pointer pins to, so a reset re-zeroes any pointer drift) — select it and press OPEN (F7) for a window listing Workstation and Desktop. Pointer is RELATIVE: Darkstar differences the host pointer against the display centre and warps it back, so there is no absolute path to offer. Silent exhibit: the 8010 has no sound hardware.

# ---- IDLE AUTO-PAUSE (QMP stop/cont) ----
# ON since 2026-08-11. Held back at registration for fear of pausing Darkstar's
# emulation thread mid-Pilot-tick (Pilot: real-time, TIME-LOCKED stack). The
# fear was misplaced for a WHOLE-VM freeze: QMP stop halts the kiosk's virtual
# clock together with the emulator, so Darkstar — and Pilot inside it — sees no
# discontinuity at all on cont. This exhibit also already lives on wrong wall
# time by design: every loadvm golden resumes the kiosk's clock from bake day
# (~40 h behind within two days of the bake) with Darkstar's TOD pinned by
# star.cfg at emulator start, and ViewPoint has never noticed. alto — the same
# shape, a C# Xerox emulator in a Debian kiosk — has paused since registration.
# Proven 2026-08-11 on a namespaced /data/vms/soltest clone (same device set,
# loadvm golden): QMP stop soaks of 2 and 20 min; both resumed to the intact
# ViewPoint desktop with the Star cursor still answering stardrv rel nudges
# (framebuffer proof) and the kiosk clock advancing run-time only.
# No warmup: loadvm golden reaches the desktop in seconds and star has no
# health machinery that needs a running unwatched guest.
# Rollback is one line: SH_IDLE_PAUSE_SECS=0.
SH_IDLE_PAUSE_SECS=60

# ---- KEYBOARD PACING ----
# Darkstar wants DWELL, and more of it than anything else in the hall. A ~12 ms
# XTEST-shaped press lands NOTHING in Pilot: four presses across four candidate
# focus windows produced one advance, which reads as flaky focus and is not.
# A 300 ms hold lands every time; the daemon's ceiling is 250 ms and that is
# enough through the QEMU PS/2 path.
#
# The GAP matters as much, and for a reason worth carrying to any old machine:
# the MODIFIER is subject to the same dwell law as the key. Sent in one batch,
# Shift+; produces ';' while Shift+a still produces 'A' — a partially applied
# shift that reads exactly like a keymap gap. Led by its own event and held
# across the key, it produces ':'. Measured here: a 200 ms lead fails, 350 ms
# works. The daemon caps the gap at 250 ms, so the SPA's shift LATCH (which
# holds Shift down across a human-timed pause) is the reliable path for shifted
# punctuation; sustained machine-speed typing of shifted symbols is not.
SH_KEY_MIN_HOLD_MS=250
SH_KEY_MIN_GAP_MS=250

# ---- ALT MUST NOT REACH DARKSTAR ----
# Darkstar takes the mouse only after the display has been clicked, and EITHER
# Alt key RELEASES that capture again ("To release the capture, press either
# Alt key" — Darkstar readme §3.1.1). A visitor who happens to press Alt on a
# physical keyboard would silently lose the pointer until they clicked again.
# The Xerox Level-V keyboard has no Alt key at all, so nothing is lost by
# sending both Alt scancodes somewhere inert (Scroll Lock, which no Darkstar
# mapping uses). Covers the physical keyboard and the SPA on-screen keyboard
# alike; the SPA's xerox-star profile has no Alt button in the first place.
SH_KEY_REMAP=0x38:0x46,0xe038:0x46
