# amigaos35 station.env fixture — appended to the emitted station.env.
# Host-native FS-UAE (github.com/Wnt/fs-uae, branch kernel-hive/integrated,
# build-fsuae-native.sh, FSUAE_STATION=amigaos35 — its own copy, never
# shared with a3000/a1000/amix) with NO X: shm frames, ctlsock keys/pointer,
# audio FIFO. Shared launcher: stations/fsuae-native/x11-runtime.sh.
# Converted from the Xvfb+XTEST launcher on 2026-09-09 (rig-proven headless
# boot at ~10s to desktop, was ~85s under Xvfb+savestate); repo-side only
# until the station is redeployed and re-measured live.

# --- emulator ---------------------------------------------------------------
FSUAE_NATIVE_BIN=/data/vms/streamhost/assets/amigaos35/fsuae-native/bin/fs-uae
FSUAE_NATIVE_KICK=/data/vms/streamhost/assets/amigaos35/kick40068.A4000.rom
FSUAE_NATIVE_MODEL=A4000/040
FSUAE_NATIVE_MEM_ARGS=--chip_memory=2048 --zorro_iii_memory=8192
# No statefile: reset is a cold boot of a fresh work HDF copied from
# disk/amigaos35-system.hdf.golden. UAE savestates were already rejected for
# this station (docs/guests/amigaos35.md) — a state restored with
# bsdsocket_library enabled gurus nondeterministically, and this launcher
# never wires --load_state; a cold boot is now ~10s, not ~85s, so the loss
# of a savestate no longer costs a visit anything.
FSUAE_NATIVE_HDF=amigaos35-system.hdf
# Retronet cage: bsdsocket only inside netns rn-amigaos35 (never bare on
# labhost's own stack). streamhost/stations/amigaos35/rn-netns.sh stays in
# place (deployed fleet-wide by box-sync-pairs-retronet.sh, rule 15).
FSUAE_NATIVE_NET=bsdsocket
FSUAE_NATIVE_NETNS=rn-amigaos35
FSUAE_NATIVE_STANDBY_DELAY_S=30
SH_MAMECTL_SOCK=/data/vms/streamhost/stations/amigaos35/ctl.sock
SH_MAMESOCK_KEYMAP=/data/vms/streamhost/stations/amigaos35/amiga.keymap
SH_AUDIO_SOURCE=fifo
SH_AUDIO_FIFO=/data/vms/streamhost/stations/amigaos35/audio.fifo

# --- input: ctlsock, absolute mouse (mousehack), the shared amiga keymap ---
# Same pacing floor as a3000 (docs/lab/FSUAE-NATIVE-BRIEF.md): mousehack
# never samples an instant press.
SH_BTN_MIN_HOLD_MS=150
SH_KEY_MIN_HOLD_MS=40
SH_KEY_MIN_GAP_MS=40

# --- reset / standby --------------------------------------------------------
SH_RESET_MODE=relaunch
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/amigaos35/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/amigaos35/fsuae-native
SH_IDLE_PAUSE_WARMUP_SECS=60
