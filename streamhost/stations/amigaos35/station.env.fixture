# amigaos35 station.env fixture — appended to the emitted station.env.
# Host-native FS-UAE (build-fsuae-native.sh; patched 3.2.35 — mousehack
# re-arm) under a pinned Xvfb :58, captured with SH_CAPTURE=x11, driven over
# XTEST (SH_X11TEST_* — abs motion, paced buttons, keyboard).

# --- emulator ---------------------------------------------------------------
FSUAE_NATIVE_BIN=/data/vms/streamhost/assets/amigaos35/fsuae-native/bin/fs-uae
FSUAE_NATIVE_KICK=/data/vms/streamhost/assets/amigaos35/kick40068.A4000.rom
FSUAE_NATIVE_GEOM=720x568
FSUAE_NATIVE_CHECKPOINT=1
# Paired with sta/Saved State 1.uss — harvest from the bake log line
# "mousehack registered at <addr>" whenever the golden is re-baked from a
# fresh boot. A stale address = dead absolute mouse after every reset.
FSUAE_NATIVE_MOUSEHACK_ADDR=07803d60
# off until the retronet web-plane join lands (then: bsdsocket, inside the
# station netns — never bare on the host's own stack).
FSUAE_NATIVE_NET=off
FSUAE_NATIVE_STANDBY_DELAY_S=15

# --- input: the completed x11test backend ----------------------------------
SH_X11TEST_ABS=1
SH_X11TEST_BUTTONS=xtest
SH_X11TEST_KEYS=1
# Empirical (2026-08-24 rig): instant press+release inside one 50 Hz frame is
# never sampled; 60 ms = three frames. Keys proven clean at 90 ms/char; 40/40
# is the frame-derived floor with margin.
SH_BTN_MIN_HOLD_MS=60
SH_KEY_MIN_HOLD_MS=40
SH_KEY_MIN_GAP_MS=40

# --- reset / standby --------------------------------------------------------
SH_RESET_MODE=relaunch
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/amigaos35/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/amigaos35/fsuae-native
SH_IDLE_PAUSE_WARMUP_SECS=60
