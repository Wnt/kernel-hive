# ---- HOST-NATIVE STATION (de-bridged 2026-10-04) ----
# MAME 0.289's cpc6128 runs ON THE HOST: drawshm frames, ctlsock keys through
# the generated keymap, AY-3-8912 -> SDL disk -> FIFO with the daemon as clock.
# Launcher: shared stations/mame-native/x11-runtime.sh; reset = relaunch (a
# cold boot; see MAME_NATIVE_CHECKPOINT below). It replaces the Caprice32
# kiosk, whose keys travelled QMP -> guest kernel -> X -> SDL and were lost
# whenever labhost descheduled the kiosk's vCPU (docs/guests/amstradcpc.md).
# The kiosk's launcher and overlay (with its internal `golden`) stay in the
# station dir as *.debridged-bak: the rollback, launcher and disk together.
SH_RESET_MODE=relaunch
SH_FIXTURE_DESC=Amstrad CPC 6128 (1985) at its own untouched power-on screen: "Amstrad 128K Microcomputer (v3)", the 1985 Amstrad Consumer Electronics and Locomotive Software copyright lines, "BASIC 1.1" and the Locomotive BASIC Ready prompt with its block cursor, yellow on the CTM640 colour monitor's blue, drawn by MAME 0.289's cpc6128 running HOST-NATIVE (drawshm) with aspect correction on the published 1024x768 surface. Nothing is curated and nothing is typed. Reset is a cold boot, which reaches Ready in about 1.1 emulated seconds and is pixel-identical every time. Keyboard-only exhibit; no pointer device; AY-3-8912 sound -> FIFO.
MAME_NATIVE_BIN=/data/vms/streamhost/assets/amstradcpc/mame-native/cpc6128
MAME_NATIVE_DRIVER=cpc6128
MAME_NATIVE_ROMS=/data/vms/streamhost/assets/amstradcpc/mame-native/roms
MAME_NATIVE_GEOM=1024x768
# The cpc6128 driver has no MACHINE_SUPPORTS_SAVE, and in 0.289 it registers
# none of its own state (the gate array's pens, mode and ROM/RAM paging live
# in amstrad_state with no save_item). A savestate taken at Ready did restore
# to Ready and type on a rig, but only because those members happen to equal
# their reset values there, which is luck, not a contract. The cold boot is
# deterministic and reaches the scene in about a second, so the checkpoint is
# OFF (the bbcb/spectrum precedent) and there is no golden.sta to keep in step
# with the binary.
MAME_NATIVE_CHECKPOINT=0
# SCANNED-MATRIX KEYBOARD: the CPC firmware scans its ten-row matrix itself, so
# two keys down at once are ambiguous and the browser sends a typed line as ONE
# BURST. Exclusive-scan serializes presses on the :kbrow.0-9 ports; the Shift
# and Control fields are exempt by name, so chords still work.
MAME_CTL_KEY_EXCL=:kbrow.
SH_MAMECTL_SOCK=/data/vms/streamhost/stations/amstradcpc/ctl.sock
# Generated: scripts/dev/mame-keymap.py <ctl.sock> --tags :kbrow
#   --override scripts/build-guests/emulators/native.d/amstradcpc.keymap-override
# (--tags :kbrow keeps the Cheetah 125 joystick, which shares LCONTROL, LALT,
# SPACE and the arrows, out of the match: unfiltered, Space and Ctrl bound to it).
SH_MAMESOCK_KEYMAP=/data/vms/streamhost/stations/amstradcpc/amstradcpc.keymap
SH_AUDIO_SOURCE=fifo
SH_AUDIO_FIFO=/data/vms/streamhost/stations/amstradcpc/audio.fifo

# ---- STANDBY (instant-ready: an emulator nobody watches costs ~0 CPU) ----
# The launcher freezes the emulator once the scene has painted, and the
# daemon owns it from there: SIGSTOP after the idle grace with zero
# sessions, unconditional SIGCONT the moment a visitor connects.
# SH_IDLE_PAUSE_PROC_MATCH scopes the signal to this station's own asset path.
# Rollback is one line: SH_IDLE_PAUSE_SECS=0 restores an always-running exhibit.
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/amstradcpc/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/amstradcpc/mame-native
MAME_NATIVE_STANDBY_DELAY_S=8

# ---- KEYBOARD PACING (the exhibit's only input surface) ----
# The launcher hands these to the ctlsock module as MAME_CTL_KEY_HOLD/_GAP:
# per-field dwells in EMULATED milliseconds, so host load cannot compress them
# (the kiosk's failure). The CPC firmware scans the matrix once per 50 Hz frame,
# 20 ms, so a key held less than a frame can fall between two scans, and a
# repeated key must stay up for a scan to be seen twice. Measured 2026-10-04 on
# a rig of this binary through a sandbox daemon, the editor's own edges, a
# 15-line listing with 251 shifted symbols and 110 capitals, LISTed and read
# back cell by cell against the ROM font:
#
#   hold/gap  10/10: lost nearly every key, Enters included (one garbage line)
#             20/20: exact     30/30: exact (load 63-86)     40/40: exact
#
# 40/40 ships: two scan periods, twice the measured floor, as on sinclairql.
SH_KEY_MIN_HOLD_MS=40
SH_KEY_MIN_GAP_MS=40
# ---- MODIFIER LEAD ----
# A non-modifier press waits this many emulated ms after the last Shift/Ctrl
# edge (MAME_CTL_KEY_MOD_LEAD). At 40/40 the same listing was exact at lead 0,
# 1, 2, 5 and 10: this binary showed no Shift tear at all. 20 is set by
# construction, one full 50 Hz scan, so Shift has been seen by a complete scan
# before its key can be, whatever phase the module's drain has against the
# firmware's scan. It costs a shifted character at most 40 ms; typeIn and the
# demo type at 120 ms per character, above HOLD + max(GAP, LEAD) + LEAD = 100.
SH_KEY_MOD_LEAD_MS=20
# The CPC's own UK-style layout, positionally on a US PC keyboard: the type-in
# editor and labctl send each of these characters through the key that makes it
# on the CPC (registry keyboard.charMap; generated as SH_KEY_MAP for labctl).
SH_KEY_MAP=&:^,":@,':&,(:*,):(,_:),=:_,^:=,@:[,|:{,[:],{:},]:\,}:|,%3A:;,*:%3A,;:',+:",\:`,`:~
