
# ---- GOLDEN FIXTURE ----
# resetMode=loadvm: the internal 'golden' snapshot lives in floppy.qcow2, the
# station's only block device (the 720K floppy as qcow2), so the restore brings
# back BOTH the RAM state and the floppy's directory of programs.
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_GOLDEN_STATE_DISK=/data/vms/streamhost/stations/bootos/floppy.qcow2
SH_FIXTURE_DESC=bootOS (512-byte boot-sector OS) at its `$` prompt after an untouched cold boot from the 720K floppy, 720x400 VGA text mode. Keyboard-only exhibit: bootOS reads the BIOS keyboard, there is no pointer device. Type `dir` to list the 19 one-sector programs, a name to run one. PC speaker audio.

# ---- KEYBOARD PACING ----
# bootOS reads keys through BIOS int 16h, which the PS/2 controller feeds by
# interrupt into a 16-key ring — no frame-sampled matrix. 40/40 is the fleet's
# proven keyboard-only floor (pdp11); TODO(bootos-golden): measure on a clone.
SH_KEY_MIN_HOLD_MS=40
SH_KEY_MIN_GAP_MS=40
