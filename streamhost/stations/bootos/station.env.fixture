
# ---- GOLDEN FIXTURE ----
# resetMode=loadvm: the internal 'golden' snapshot lives in floppy.qcow2, the
# station's only block device (the 360K floppy as qcow2), so the restore brings
# back BOTH the RAM state and the floppy's directory of programs.
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_GOLDEN_STATE_DISK=/data/vms/streamhost/stations/bootos/floppy.qcow2
SH_FIXTURE_DESC=bootOS (512-byte boot-sector OS) at its `$` prompt after an untouched cold boot from the 360K floppy, 720x400 VGA text mode. Keyboard-only exhibit: bootOS reads the BIOS keyboard, there is no pointer device. Type `dir` to list the 19 one-sector programs, a name to run one. PC speaker audio.

# ---- KEYBOARD PACING ----
# bootOS reads keys through BIOS int 16h, which the PS/2 controller feeds by
# interrupt into a 16-key ring — no frame-sampled matrix. Bisected 2026-09-02 on
# a KVM clone with scripts/dev/emu-key-pacing-bisect.py (43-char hex line, 10
# trials per rung): 10/10, 20/20, 30/30 and 40/40 ms all landed every character
# in every trial, so the floor is below 10 ms. Shipped at double the lowest
# proven-clean rung as the host-scheduling margin; demoProgram.perCharMs (80)
# stays above hold+gap.
SH_KEY_MIN_HOLD_MS=20
SH_KEY_MIN_GAP_MS=20
