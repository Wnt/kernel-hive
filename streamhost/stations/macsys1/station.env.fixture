# ---- HOST-NATIVE STATION (macsys1 wave, 2026-09-13) ----
# MAME 0.289's mac128k runs ON THE HOST — drawshm frames, ctlsock keys +
# quadrature mouse, sound -> SDL disk -> FIFO with the daemon as clock.
# Launcher: shared stations/mame-native/x11-runtime.sh; reset = relaunch
# restoring the golden savestate (mac128k is MACHINE_SUPPORTS_SAVE, read from
# src/mame/apple/mac128.cpp:1634 at the fleet pin mame0289).
SH_RESET_MODE=relaunch
SH_FIXTURE_DESC=TODO(macsys1): filled by the golden bake — Macintosh 128K at the Finder 1.0 desktop, System Disk + Write/Paint mounted.
MAME_NATIVE_BIN=/data/vms/streamhost/assets/macsys1/mame-native/mac128
MAME_NATIVE_DRIVER=mac128k
MAME_NATIVE_ROMS=/data/vms/streamhost/assets/macsys1/mame-native/roms
MAME_NATIVE_GEOM=1024x768
# mac128k is status=good, NOT MACHINE_NOT_WORKING: there is no startup warning
# panel to skip, so unlike fmtowns/domainos/atari800xl this station needs no
# skip-warnings patch and no ui.ini knob.
MAME_NATIVE_SKIP_WARNINGS=0
# CHECKPOINT KEPT (=1): mac128k declares MACHINE_SUPPORTS_SAVE. Cold boot to
# the Finder desktop is ~25 s of emulated time (MEASURED on the stock-0.276
# smoke rig 2026-09-13: "Welcome to Macintosh." at 12 s, desktop at 37 s of
# wall time under Xvfb), which is far too slow for a visitor — the savestate
# restore is what makes this station usable.
MAME_NATIVE_CHECKPOINT=1
# The two 400K DiskCopy 4.2 images. mac128k's IWM carries exactly two
# single-sided drives (applefdintf_device::add_35_sd x2 in mac128.cpp), so
# -flop1/-flop2 is the whole storage story: no hard disk existed in 1984.
MAME_NATIVE_ARGS=-flop1 /data/vms/streamhost/assets/macsys1/media/system-disk-1.0.dc42 -flop2 /data/vms/streamhost/assets/macsys1/media/write-paint-1.0.dc42
SH_MAMECTL_SOCK=/data/vms/streamhost/stations/macsys1/ctl.sock
SH_MAMESOCK_KEYMAP=/data/vms/streamhost/stations/macsys1/macsys1.keymap
SH_AUDIO_SOURCE=fifo
SH_AUDIO_FIFO=/data/vms/streamhost/stations/macsys1/audio.fifo

# ---- STANDBY (instant-ready: an emulator nobody watches costs ~0 CPU) ----
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/macsys1/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/macsys1/mame-native
MAME_NATIVE_STANDBY_DELAY_S=8

# ---- KEYBOARD (M0110, an i8021 MCU on a serial line — NOT a CPU-scanned
# matrix) ----
# The Macintosh keyboard is its own emulated device since MAME 0.221
# (romset mackbd_m0110, ip8021h_2173.bin): the MCU debounces and clocks
# keycodes to the VIA over a synchronous serial line, so the SPA's burst does
# not become a chord on a scanned matrix the way mpf2's does. Fleet floor
# 40/40 ms is shipped; MAME_CTL_KEY_EXCL is NOT set. Measured in the golden
# bake — see docs/lab/MACSYS1-WAVE.md.
SH_KEY_MIN_HOLD_MS=40
SH_KEY_MIN_GAP_MS=40

# ---- POINTER (quadrature mouse through the VIA — no ADB on a 128K) ----
# Tags read FROM THE DRIVER SOURCE (src/mame/apple/mac128.cpp:1403-1411, input
# map `macplus`) and confirmed by KEYDUMP on the rig: three TOP-LEVEL ioports,
#   PORT_START("MOUSE0") PORT_BIT(0x01, IP_ACTIVE_HIGH, IPT_BUTTON1) PORT_NAME("Mouse Button")
#   PORT_START("MOUSE1") PORT_BIT(0xff, 0x00, IPT_MOUSE_X)
#   PORT_START("MOUSE2") PORT_BIT(0xff, 0x00, IPT_MOUSE_Y)
# One button, so right/middle are empty on purpose (the ST/apple2e shape).
# MOD=256 because MOUSE1/MOUSE2 are 8-bit fields (0xff mask), NOT the ctlsock
# module's 65536 SGI default — unset, the first homing slam saturates the axis.
# MAME_CTL_SCREEN must match the published surface or every MOVEA clamps
# against the module's 1288x1024 SGI default instead of this station's 1024x768.
MAME_CTL_PTR_TAGS=:MOUSE0,:MOUSE1,:MOUSE2
MAME_CTL_BTN_NAMES=Mouse Button,,
MAME_CTL_PTR_MOD=256
MAME_CTL_SCREEN=1024x768
# Open-loop gain: this machine has no host-readable cursor register, so MOVEA
# cannot learn a gain from a closed loop (the apple2e mechanism). Values
# MEASURED in the golden bake — see docs/lab/MACSYS1-WAVE.md §Pointer.
MAME_CTL_GAIN_X=1.0
MAME_CTL_GAIN_Y=1.0
MAME_CTL_HOME_SETTLE=750
