# aix432 — IBM AIX 4.3.3 with CDE on an emulated RS/6000 7020 (40p), qemu-system-ppc.
# Appended verbatim to the emitted station.env by streamhost-station.sh.

# The exhibit resets by restoring the in-qcow2 vmstate snapshot 'golden'.
# A restore does NOT re-run the firmware POST, and therefore does not need the
# PREP_TB_FREQ override's POST path or the skipfix gdb helper at all — that is
# the whole point of the checkpoint on this station, because a COLD boot has to
# walk the genuine IBM 40p ROM's power-on self test.
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_GOLDEN_DISKS=aix432-golden.qcow2

SH_FIXTURE_DESC=AIX 4.3.3 CDE desktop (IBM RS/6000 7020 40p under TCG) at 1024x768x8: dtwm front panel and an aixterm, with Netscape Communicator 4.08 on the retronet corpus web. loadvm restores the desktop; the guest starts frozen (-S) until the first visitor.

# POINTER: a real closed loop, not a reckoned one. The 40p has PS/2 only — no
# USB, no tablet — but AIX drives the emulated Matrox HARDWARE cursor, so QEMU
# reads the guest's own pointer position out of the DAC's CURPOSX/Y registers
# and the engine in hw/display/mga.c converges on it. The daemon only states
# absolute targets over mgaptr/1; it reckons nothing, so nothing here has to be
# calibrated. Rollback is two lines: SH_INPUT_BACKEND=dbus-rel here, and drop
# `-global mga.ptrctl=ptr0` from the launcher.
SH_INPUT_BACKEND=mgactl
SH_MGACTL_SOCK=/data/vms/streamhost/stations/aix432/ptr.sock
# INERT under this backend: they scale the daemon's own dead-reckoning affine,
# and there is no longer one. Left at identity for the rollback above.
SH_CURSOR_SCALE=1.0
SH_CURSOR_OFF_X=0
SH_CURSOR_OFF_Y=0

# TCG-only: PowerPC has no acceleration path on this host, so the station burns
# a host core whenever the guest runs. Idle-pause matters more here than usual.
SH_IDLE_PAUSE_SECS=60
