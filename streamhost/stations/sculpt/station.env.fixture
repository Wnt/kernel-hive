
# ---- CHECKPOINT FIXTURE (QEMU station, resetMode=loadvm) ----
# Genode Sculpt OS 25.04 Leitzentrale at 1024x768. The scene: the component
# graph (Hardware -> ps2 / vesa fb / usb + usb hid / ahci / nic; Config, Info,
# GUI; ram fs "in use", depot, nic router), the '+' menu open on its Options
# tab (acpi support, audio, black hole, mixer, system clock, touchpad, trace
# logger, vm fs), the Network panel showing Wired 10.99.0.38/24. Baked
# 2026-09-09 21:50Z with savevm on /data/vms/sandbox/sculpt/bake (VM_SIZE 187
# MiB, VM_CLOCK 0:01:40) on the SHIPPED device set: q35, AHCI disk, EHCI
# usb-mouse + usb-kbd, e1000 on tap sculptrn0 (MAC in the vmstate). Restore
# proof: kill by pidfile, relaunch -loadvm golden -S, cont -> framebuffer diff
# bbox None against the bake frame; pointer read back at the same spot and
# still moved 100 px for 100 units afterwards.
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_RESET_MONITOR=/data/vms/streamhost/stations/sculpt/reset-hmp.sock
SH_FIXTURE_DESC="Genode Sculpt 25.04 Leitzentrale: the live component graph with the '+' menu open on Options and the Network panel showing Wired 10.99.0.38/24; ram fs in use; pointer parked at (701,451)"

# ---- POINTER: RELATIVE USB MOUSE (measured 2026-09-09) ----
# Genode's usb_hid never binds QEMU's absolute usb-tablet (six-runner race,
# docs/lab/SCULPT-WAVE.md): on xHCI the sprite exists and never moves, on EHCI
# no sprite at all; HMP mouse_move is dead. A usb-mouse on EHCI moves
# nitpicker's sprite, so the daemon runs its abs->rel bridge with readback.
# Measured with scripts/dev/cursor-locate.py: EXACTLY 1 px per unit on both
# axes, no acceleration, no truncation (1, 20, 100, 200, 300 units -> the same
# number of px; the screen edge clamps). SH_REL_MAX_STEP=127 keeps every send
# inside one int8 HID report.
SH_INPUT_BACKEND=dbus-rel
SH_CURSOR_SCALE=1.0
SH_REL_MAX_STEP=127
SH_REL_QUANTUM=0
# Re-home on a golden restore: the sprite origin is (700,450) in the golden
# frame, hotspot (1,1) (nitpicker's default arrow, boot position 511,383 for
# the 512,384 screen centre), so the pointer sits at (701,451).
SH_REL_HOME_ON=reset
SH_REL_HOME_TO=701,451

# ---- KEYBOARD ----
# QMP input-send-event key events reach Genode on the EHCI usb-kbd (F12 toggles
# the Leitzentrale, proven in the race). Fleet floor pacing; the Leitzentrale
# is mouse-driven so no type-in demo ships.
SH_KEY_PRESS_MS=40
SH_KEY_GAP_MS=40
