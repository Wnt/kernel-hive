
# ---- GOLDEN FIXTURE ----
# resetMode=loadvm: the 'golden' vmstate lives in disk.qcow2, the station's only
# block device (FreeDOS 1.3 FAT16 + C:\ENSEMBLE), so the restore brings back BOTH
# RAM and the filesystem (GEOS state files, documents a visitor saved).
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_GOLDEN_STATE_DISK=/data/vms/streamhost/stations/pcgeos/disk.qcow2
SH_FIXTURE_DESC=PC/GEOS Ensemble desktop right after loader.exe: Computer/Documents/World icons on the Meadows wallpaper, taskbar with the Express button, 800x600 16-bit VESA. PS/2 relative pointer, sb16 audio. Screen blanker disabled in geos.ini.

# ---- KEYBOARD PACING ----
# GEOS reads the PS/2 keyboard through its own kbd.geo driver (interrupt-fed).
# Fleet floor for QEMU keyboard stations (ADD-NEW-OS-PLAYBOOK §0): 40/40.
SH_KEY_MIN_HOLD_MS=40
SH_KEY_MIN_GAP_MS=40

# ---- QEMU BINARY: the kh-ramabs build (BINARY AND GOLDEN ARE ONE UNIT) ----
# The golden is baked under this binary and the pointer address below is bound to
# that golden. Rolling back to the host pve-qemu also means restoring the pre-abs
# golden (disk.qcow2.pre-abs-bak) -- neither half is independently revertible.
PCGEOS_QEMU=/opt/qemu-beos/bin/qemu-system-x86_64

# ---- POINTER: ABSOLUTE BY WRITING CTMOUSE'S OWN COORDINATE ----
# No absolute device DOS's CTMOUSE understands, no hardware cursor on -vga std.
# CTMOUSE keeps the pointer as int16 x,y little-endian in its resident data and
# hands GEOS the absolute CX/DX in its INT 33h callback, so kh-ramabs writes the
# commanded pixel there and injects ONE 1-unit PS/2 nudge to make CTMOUSE
# republish it. Below GEOS's acceleration threshold 1 unit = 1 px (measured:
# 300 units -> 300 px), hotspot (0,0) (measured at 5 targets incl. the edges).
# SH_POINTER=rel is gone: SH_INPUT_BACKEND is the single source of truth.
SH_INPUT_BACKEND=ramabs
SH_RAMABS_SOCK=/data/vms/streamhost/stations/pcgeos/ptr.sock

# THE ADDRESS IS BOUND TO THE GOLDEN (loadvm restores RAM verbatim). Derived
# 2026-09-03 against the golden baked under /opt/qemu-beos (VM_CLOCK
# 0000:00:42.439, VM_SIZE 3.47 MiB — the 2026-09-03 re-bake without truetype.geo)
# with scripts/dev/pcgeos-ramabs-derive.py: 6 addresses tracked the pointer with
# bias (0,0) (0x76e0 0x76e4 0x931e 0x936a 0x4b7d4 0x4e94e); only kh-ramabs'
# connect-time write probe separates the input from the copies, and exactly ONE
# verified. Same address as the first bake: CTMOUSE loads before GEOS. FAIL CLOSED: unset => no device,
# relative pointer; stale => every write refused.
KH_RAMABS_ADDR=0x76e0

# SINGLE INJECTOR (binding): while SH_RAMABS_SOCK is connected the device owns
# the guest pointer. No abs->rel bridge, no QMP input-send-event, no labctl
# pointer helper may push motion or a button edge at this mouse.
SH_RAMABS_TRACE=off
PTR_TRACE=off
# Inert under ramabs (absolute targets are written verbatim); kept for a one-line
# rollback to SH_INPUT_BACKEND=dbus-rel.
SH_CURSOR_SCALE=1.0
