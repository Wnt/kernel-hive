# ---- HOST-NATIVE STATION (de-bridged 2026-08-12, conversion campaign) ----
# MAME 0.289's ql runs ON THE HOST — the apt-0.251 pin dissolves with the
# kiosk, and the FIFO audio path removes the dbus fragility the bridge tile
# carried. drawshm frames, ctlsock keys through the generated keymap.
# Launcher: shared stations/mame-native/x11-runtime.sh; reset = relaunch
# restoring the golden savestate.
SH_RESET_MODE=relaunch
SH_FIXTURE_DESC=Sinclair QL 80-column MONITOR-mode SuperBASIC screen (white window #2, red window #1, empty black command window) drawn by MAME 0.289's `ql` driver running HOST-NATIVE (drawshm) on the published 1024x768 surface; the golden savestate restores it. No post-restore keys. The host-native binary carries mame-irix-skip-warnings.patch, so the imperfect-dump warning the bridge's apt 0.251 had to dismiss with a letter never exists; the one keystroke that reaches the scene — F1 to answer the QL's monitor/TV chooser — happens once, during the bake. hal16l8.ic38 (the undumped PAL) remains the romset's only missing member by design.
MAME_NATIVE_BIN=/data/vms/streamhost/assets/sinclairql/mame-native/ql
MAME_NATIVE_DRIVER=ql
MAME_NATIVE_ROMS=/data/vms/streamhost/assets/sinclairql/mame-native/roms
MAME_NATIVE_GEOM=1024x768
MAME_NATIVE_SKIP_WARNINGS=1
# SCANNED-MATRIX KEYBOARD: the guest's own ROM scans this matrix, so two
# keys down at once are ambiguous (ghosting/interleave) and the browser
# sends a typed line as ONE BURST — the daemon's SH_KEY_MIN_* gate paces
# only the QEMU/dbus path, never this one. Exclusive-scan restores the
# serialized delivery every station's pacing was bisected under (the same
# contract typeDemoProgram and validate_demo_pacing assume). Modifier
# fields (Shift/Ctrl) are exempt by name, so chords still work.
#
# THE PATTERN IS `Y`, NOT `:Y`, AND THAT IS THE WHOLE POINT ON THIS MACHINE.
# The QL wires its joysticks INTO the keyboard matrix, so MAME's `ql` driver
# puts real keys on :JOY0/:JOY1 — SPACE is `:JOY1 | P2 Button 1`, F1..F5 and
# the cursor keys are :JOY0/:JOY1 fields. `:Y` matched only :Y0..:Y7, so the
# space bar was EXEMPT from exclusive-scan: measured, `print 12+34` at a 90 ms
# browser pace applied the space and the preceding `t` in the SAME emulated
# instant and the guest lost BOTH (`prin12+34`, 12/12 trials). `Y` matches
# :Y0..:Y7 AND :JOY0/:JOY1 and nothing else on this driver (the only other
# ports are :config and :qimi:mouse_{buttons,x,y}, and `mouse_y` is lowercase).
MAME_CTL_KEY_EXCL=Y
SH_MAMECTL_SOCK=/data/vms/streamhost/stations/sinclairql/ctl.sock
SH_MAMESOCK_KEYMAP=/data/vms/streamhost/stations/sinclairql/sinclairql.keymap
SH_AUDIO_SOURCE=fifo
SH_AUDIO_FIFO=/data/vms/streamhost/stations/sinclairql/audio.fifo

# ---- STANDBY (instant-ready: an emulator nobody watches costs ~0 CPU) ----
# The launcher freezes the emulator once the scene has painted, and the
# daemon owns it from there: SIGSTOP after the idle grace with zero
# sessions, unconditional SIGCONT the moment a visitor connects. Without
# this a de-bridged station burns a full core around the clock.
# SH_IDLE_PAUSE_PROC_MATCH is the anti-footgun: the signal is only ever
# sent to a pid whose cmdline still carries this station's own asset path
# (bbcmicro and armeval run identically-named `bbcb` binaries).
# Rollback is one line: SH_IDLE_PAUSE_SECS=0 restores an always-running
# exhibit.
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/sinclairql/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/sinclairql/mame-native
MAME_NATIVE_STANDBY_DELAY_S=8

# ---- KEYBOARD PACING (the exhibit's only input surface) ----
SH_KEY_MIN_HOLD_MS=120
SH_KEY_MIN_GAP_MS=120
# THE QL DOES NOT SCAN ITS OWN KEYBOARD. An 8049 IPC scans the matrix and
# hands the result to the 68008 over a slow serial link, so the guest sees the
# matrix through the IPC's sampling window, not the CPU's. A modifier whose
# DOWN edge lands in the SAME sample as its character makes that character
# VANISH — not arrive unshifted, vanish — and the browser sends those two edges
# ~5 ms apart, inside one drain pass. Measured on the rig with the framebuffer
# as judge: at a 450 ms spacing (no overlap at all, so no queue-order hazard
# can apply) `print 12+34` lost the `+` in 7 of 8 trials, and `!"#$%&*()` typed
# slowly lost 4 of 9 shifted characters; the trace showed EVERY dropped
# character applied in the same emulated instant as its Shift and every
# surviving one applied at least one 20 ms guest scan after it. 40 ms is two
# scans — one clear step above the last observed failure, the same margin the
# VICE wave's pacing floors use. 0 (the module default) is the fleet
# behaviour and nothing else changes.
SH_KEY_MOD_SEP_MS=40
