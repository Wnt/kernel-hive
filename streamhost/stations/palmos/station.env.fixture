# ---- HOST-NATIVE STATION (native from day one — palmos wave, 2026-09-20) ----
# MAME 0.289's palmpro driver (mame/palm/palm.cpp) runs ON THE HOST — same
# engine as every other MAME-native station, drawshm frames, ctlsock input,
# no QEMU/QMP, no guest OS filesystem.
SH_RESET_MODE=relaunch
SH_FIXTURE_DESC=PalmPilot Professional, MAME 0.289 palmpro driver, Palm OS 2.0 Professional (English) running HOST-NATIVE (drawshm) on the published 160x220 surface -- the driver's own visarea. The LCD is the top 160x160; rows 160..219 are the printed Graffiti silkscreen, unlit on real hardware too but part of the digitizer, so the Applications/Menu/Calculator/Find buttons down there are tappable. ROM: palmos20-en-pro.rom, byte-exact match (sha1 535bd9548365d300f85f514f318460443a021476) for the 2.0epro BIOS option the driver defines. See docs/lab/PALMOS-WAVE.md for why Palm OS 2.0 and not the Palm III's 3.x (3.x boots but never turns the LCD on).
MAME_NATIVE_BIN=/data/vms/streamhost/assets/palmos/mame-native/palmos
MAME_NATIVE_DRIVER=palmpro
MAME_NATIVE_ROMS=/data/vms/streamhost/assets/palmos/mame-native/roms
MAME_NATIVE_GEOM=160x220
# palmpro carries MACHINE_SUPPORTS_SAVE and no imperfect/not-working flag, so
# there is no modal startup warning to suppress.
MAME_NATIVE_SKIP_WARNINGS=0
# NO CHECKPOINT, DELIBERATELY. Restoring any savestate in a fresh process
# segfaults inside zlib under save_manager::read_file() — heap corruption in
# palmpro's own setup, not savestate bookkeeping, with no contained fix
# (MEASURED 2026-09-20, evidence in docs/lab/PALMOS-WAVE.md). The scene is
# reached by driving the machine instead: palmos-boot.lua below taps through
# Palm OS's unskippable digitizer calibration and opens the Applications
# Launcher, deterministically, on every cold boot. Setting this to 1 would
# make the launcher pass `-state golden` and the station would crash on start.
MAME_NATIVE_CHECKPOINT=0
MAME_NATIVE_ARGS=-bios 2.0epro -plugins -autoboot_script /data/vms/streamhost/stations/palmos/palmos-boot.lua
SH_MAMECTL_SOCK=/data/vms/streamhost/stations/palmos/ctl.sock
SH_MAMESOCK_KEYMAP=/data/vms/streamhost/stations/palmos/palmos.keymap
SH_AUDIO_SOURCE=none

# ---- STANDBY (instant-ready: an emulator nobody watches costs ~0 CPU) ----
# The standby freeze must not land MID-CALIBRATION. This guest is CPU-bound at
# roughly 13% of real time (MEASURED: ~7 CPU-seconds per emulated second; the
# 68328's LCD controller is modelled as a per-pixel serial shift-out), so the
# ~23 emulated seconds palmos-boot.lua needs are minutes of wall clock, and how
# many depends on what else the box is doing. The delay is therefore set well
# past the worst observed case rather than tuned tight: freezing early would
# park the exhibit on the calibration screen until someone connects.
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/palmos/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/palmos/mame-native
MAME_NATIVE_STANDBY_DELAY_S=600

# ---- POINTER (pen digitizer) — ABSOLUTE IOPORT FIELD, no accumulator ----
# Palm's pen is IPT_LIGHTGUN_X/Y (mame/palm/palm.cpp INPUT_PORTS_START(palm_base)),
# a true absolute analog field (PORT_MINMAX(0,0xa0)) latched into a reading by
# the "Pen Button" field's PORT_CHANGED_MEMBER -- not a relative counter like
# every other MAME station's mouse. mame-ctlsock-abs-fields.patch adds
# MAME_CTL_ABS=1: MOVEA writes m_x_field/m_y_field DIRECTLY, scaled from the
# published 160x220 surface into each field's own 0..0xa0 range (read via
# minval()/maxval(), so nothing here is hardcoded per-field) -- no accumulator,
# no cursor readback, because there is no on-screen cursor sprite to converge
# against: the pen either touches or it doesn't. That patch also carries the
# absolute-axis BINDING fallback; without it ptr-tags matches IPT_MOUSE_X/Y
# only, both handles stay null, and every MOVEA acks OK while the pen never
# leaves its 0x50,0x50 power-on centre (MEASURED 2026-09-20).
# Accuracy is self-consistent by construction: palmos-boot.lua calibrates the
# digitizer with the patch's own map, so Palm OS's affine map is its exact
# inverse. MEASURED: six Launcher icons plus the silkscreen Applications
# button, every tap landing on the intended target.
MAME_CTL_ABS=1
MAME_CTL_PTR_TAGS=:PENB,:PENX,:PENY
MAME_CTL_BTN_NAMES=Pen Button,,
MAME_CTL_SCREEN=160x220

# ---- KEYBOARD (device buttons only; Graffiti is handwriting, not typing) ----
# Fleet floor 40/40 ms first; measure only if characters drop.
SH_KEY_MIN_HOLD_MS=40
SH_KEY_MIN_GAP_MS=40
