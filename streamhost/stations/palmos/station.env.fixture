# ---- HOST-NATIVE STATION (native from day one — palmos wave, 2026-09-20) ----
# MAME 0.289's palmiii driver (mame/palm/palm.cpp) runs ON THE HOST — same
# engine as every other MAME-native station, drawshm frames, ctlsock input,
# no QEMU/QMP, no guest OS filesystem. Launcher: shared
# stations/mame-native/x11-runtime.sh; reset = relaunch restoring the golden
# savestate (palmiii carries MACHINE_SUPPORTS_SAVE, no NOT_WORKING flag).
SH_RESET_MODE=relaunch
SH_FIXTURE_DESC=Palm III, MAME 0.289 palmiii driver, Palm OS 3.3 (French) BIOS running HOST-NATIVE (drawshm) on the published 160x220 surface -- the driver's own visarea, no letterbox. ROM: palmos33-fr-iii.rom, byte-exact match (sha1 c7c90df814d4f97958194e0bc28c595e967a4529) for the palmos33-fr-iii.rom BIOS option (mame/palm/palm.cpp:829); sourced from palmdb.net's palm-roms-complete collection as Palm-III-3.3-fr.rom. See docs/lab/PALMOS-WAVE.md for why French (not English) is the first release's locale.
MAME_NATIVE_BIN=/data/vms/streamhost/assets/palmos/mame-native/palmos
MAME_NATIVE_DRIVER=palmiii
MAME_NATIVE_ROMS=/data/vms/streamhost/assets/palmos/mame-native/roms
MAME_NATIVE_GEOM=160x220
MAME_NATIVE_SKIP_WARNINGS=0
MAME_NATIVE_CHECKPOINT=1
MAME_NATIVE_ARGS=-bios 3.3f
SH_MAMECTL_SOCK=/data/vms/streamhost/stations/palmos/ctl.sock
SH_MAMESOCK_KEYMAP=/data/vms/streamhost/stations/palmos/palmos.keymap
SH_AUDIO_SOURCE=fifo
SH_AUDIO_FIFO=/data/vms/streamhost/stations/palmos/audio.fifo

# ---- STANDBY (instant-ready: an emulator nobody watches costs ~0 CPU) ----
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/palmos/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/palmos/mame-native
MAME_NATIVE_STANDBY_DELAY_S=8

# ---- POINTER (pen digitizer) — ABSOLUTE IOPORT FIELD, no accumulator ----
# Palm's pen is IPT_LIGHTGUN_X/Y (mame/palm/palm.cpp INPUT_PORTS_START(palm_base)),
# a true absolute analog field (PORT_MINMAX(0,0xa0)) latched into a reading by
# the "Pen Button" field's PORT_CHANGED_MEMBER -- not a relative counter like
# every other MAME station's mouse. mame-ctlsock-abs-fields.patch (new this
# wave) adds MAME_CTL_ABS=1: MOVEA writes m_x_field/m_y_field DIRECTLY, scaled
# from the published 160x220 surface into each field's own 0..0xa0 range
# (read via minval()/maxval(), so nothing here is hardcoded per-field) -- no
# accumulator, no cursor readback, because there is no on-screen cursor
# sprite to converge against: the pen either touches or it doesn't.
# Tags read from mame/palm/palm.cpp INPUT_PORTS_START(palm_base): PORT_START
# tags PENB/PENX/PENY, field names "Pen Button"/"Pen X"/"Pen Y".
MAME_CTL_ABS=1
MAME_CTL_PTR_TAGS=:PENB,:PENX,:PENY
MAME_CTL_BTN_NAMES=Pen Button,,
MAME_CTL_SCREEN=160x220

# ---- KEYBOARD (device buttons only; no on-screen keyboard for Graffiti) ----
# Fleet floor 40/40 ms first; measure only if characters drop.
SH_KEY_MIN_HOLD_MS=40
SH_KEY_MIN_GAP_MS=40
