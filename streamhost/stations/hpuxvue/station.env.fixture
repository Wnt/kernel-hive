# ---- CHECKPOINT FIXTURE (QEMU station, resetMode=loadvm) ----
# The scene is the HP VUE 3.0 desktop as root on HP-UX 10.20, 1280x1024x8
# over the Artist framebuffer: front panel with six workspaces, the Helpview
# "Welcome to Your HP Workstation!" window and one File Manager on "/".
# Baked 2026-08-18 with savevm into the station-local hpuxvue-golden.qcow2
# (the CD stays attached with the same ISO so the device set is loadvm-exact).
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_FIXTURE_DESC=HP VUE 3.0 desktop (HP-UX 10.20, HP 9000/778 B160L under TCG) at 1280x1024x8: front panel, Helpview welcome, one File Manager. loadvm restores the desktop; the guest starts frozen (-S) until the first visitor.

# ---- POINTER: a real closed loop, not a reckoned one ----
# The B160L still has no absolute pointer path (no USB, no tablet) — the wire
# is the LASI PS/2 mouse — but HP-UX 10.20's X server drives the Artist
# framebuffer's HARDWARE cursor, so the engine in QEMU's hw/display/artist.c
# reads the guest's own pointer position back out of the Artist
# CURSOR_POS/CURSOR_CTRL registers and converges on the daemon's absolute
# target. The daemon only states targets over artistptr/1 on the socket below;
# it reckons nothing, so nothing here has to be calibrated.
#
# SH_CURSOR_SCALE is INERT under this backend: it scaled the daemon's own
# dead-reckoning affine, and there is no longer one. Left at identity for the
# rollback (SH_INPUT_BACKEND=dbus-rel here, and drop `-global
# artist.ptrctl=ptr0` from the launcher) — but note the rollback would NOT get
# the old 1:1 pointer back: measured on the 2026-08-24 re-baked golden, the
# session shows ~1.9x pointer acceleration under injected motion, i.e. the
# `xset m 1 1` the old open-loop scale=1.0 silently depended on is NOT in
# effect on the current golden. The closed loop makes that irrelevant (gain
# only sizes the engine's steps; accuracy comes from the register readback),
# so scale stays 1.0 as a statement about the loop, not about X's mouse
# settings.
SH_INPUT_BACKEND=artistctl
SH_ARTISTCTL_SOCK=/data/vms/streamhost/stations/hpuxvue/ptr.sock
SH_CURSOR_SCALE=1.0

# Daemon-side wire telemetry, off by default: every browser event in, every
# verb out, every ack with its RTT, to journald. Arm it together with the
# engine-side traces when a pointer complaint needs evidence, off after.
SH_ARTISTCTL_TRACE=off

# ---- IDLE AUTO-PAUSE: ON ----
# hppa runs under TCG only, so an idle station burns a host core for nobody.
# Plain QEMU station: the daemon's default QMP stop/cont path applies. The
# launcher starts the guest PAUSED at the checkpoint (-loadvm golden -S), so
# an unvisited station never runs a guest instruction. Warmup 0: there is no
# boot to protect. Rollback: SH_IDLE_PAUSE_SECS=0.
SH_IDLE_PAUSE_SECS=60
