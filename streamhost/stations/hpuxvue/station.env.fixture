# ---- INSTALL PHASE FIXTURE (dark launch, no golden yet) ----
# The station currently shows the HP-UX 10.20 installer booted from the
# Install and Core OS CD on qemu-system-hppa (B160L, TCG). The install disk is
# mutated in place. Once HP-UX is installed, VUE chosen at login and the scene
# quiet, bake `golden` with savevm and switch these to loadvm — the launcher
# already prefers -loadvm golden -S when the snapshot exists.
SH_RESET_MODE=restart
SH_FIXTURE_DESC=INSTALL PHASE: HP-UX 10.20 installer on the Artist framebuffer (HP 9000/778 B160L under TCG); no golden yet, reset only re-runs the launcher when QEMU is not live.

# ---- POINTER: RELATIVE LASI PS/2 ----
# The B160L has no absolute pointer path (no USB, no tablet), so the daemon
# runs its abs->rel bridge. Guest units-to-pixels gain is UNMEASURED; 1.0 is
# a placeholder until the installed desktop exists to measure against
# (macos753 needed 2.7778 for a 0.36 gain — expect a real number here too).
SH_INPUT_BACKEND=dbus-rel
SH_CURSOR_SCALE=1.0

# ---- IDLE AUTO-PAUSE: OFF during the install ----
# A paused guest is a paused installer. Turn on (60) once the golden exists —
# the launcher then starts the TCG guest frozen at the checkpoint anyway.
SH_IDLE_PAUSE_SECS=0
