# ---- CHECKPOINT FIXTURE (QEMU station, resetMode=loadvm) ----
# BAKED 2026-09-20 and restore-proven. SH_FIXTURE_DESC below is the scene the
# golden actually restores to, not an intention; docs/lab/MACOSX-WAVE.md has
# the bring-up account and the two-boot install trap.
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_FIXTURE_DESC=Quiet Mac OS X 10.3 Panther Aqua desktop at 1024x768 (Power Mac G4 mac99 under TCG, 1024 MB): one brushed-metal Finder window open on the 'visitor' home folder in icon view (Desktop, Documents, Library, Movies, Music, Pictures, Public, Send Registration, Sites), Macintosh HD on the desktop top-right, the Dock along the bottom with Terminal added to it, nothing selected, no sheet or dialog, cursor parked dead-centre (512,384). Setup Assistant completed and gone (account 'Visitor'/'visitor', no password, registration skipped). Energy Saver pinned to Never with display sleep and disk sleep both off, and the screen saver delay dragged to Never, so the exhibit never blanks itself. Baked 2026-09-20 and restore-proven in a FRESH QEMU process: the guest's own menu-bar clock advanced across 70 s and pointer motion was consumed to two new targets afterwards.

# ---- POINTER: TRUE ABSOLUTE via -device usb-tablet (MEASURED) ----
# This is the difference from macos9, and it is measured, not assumed. Mac OS 9
# has no driver for QEMU's usb-tablet, so that station runs the daemon's
# abs->rel bridge at SH_CURSOR_SCALE=5.5556. Mac OS X 10.3 drives the tablet
# natively: on the Panther installer's framebuffer, QMP `abs` events addressed
# to (200,150) and (800,600) put the guest arrow on those pixels, and clicks at
# button coordinates activated those buttons (Continue, Agree, the Installer
# menu, Disk Utility's Partition tab and its popup menus).
# Therefore: default absolute backend, unity scale, no re-home bridge.
SH_CURSOR_SCALE=1.0
# The five-target sweep IS now measured, on the installed Aqua desktop:
# QMP abs to (120,120), (900,140), (512,384), (140,640) and (900,660) put the
# arrow sprite's origin on exactly those pixels in all five frames
# (scripts/dev/cursor-locate.py, exact-match). The Aqua arrow's hotspot is its
# own top-left tip, so sprite origin == pointer: error 0 px at every target,
# unity scale, zero offset. Clicks, a slider drag and a Dock drag-and-drop all
# landed where they were aimed.

# ---- IDLE AUTO-PAUSE: ON from day one ----
# ppc runs under TCG - no KVM path - so an idle station burns a real host core
# for nobody, and Mac OS X is a hungrier guest than Mac OS 9. Plain QEMU
# station: the daemon's default QMP stop/cont applies, and the launcher
# additionally starts PAUSED at the checkpoint (-loadvm golden -S).
SH_IDLE_PAUSE_SECS=60
