# Panasonic FS-A1GT, openMSX 21.0 with native IFB1/matrix/mouse/PCM outputs.
SH_RESET_MODE=relaunch
SH_FIXTURE_DESC=Panasonic FS-A1GT with MSX View and its original system disk 3; a fresh disk/SRAM/CMOS copy on every launch.
SH_CAPTURE=shm
SH_INPUT_BACKEND=mamesock
SH_MAMECTL_SOCK=/data/vms/streamhost/stations/msxturbor/ctl.sock
SH_MAMESOCK_KEYMAP=/data/vms/streamhost/stations/msxturbor/msxturbor.keymap
SH_AUDIO_SOURCE=fifo
SH_AUDIO_FIFO=/data/vms/streamhost/stations/msxturbor/audio.fifo
SH_KEY_MIN_HOLD_MS=40
SH_KEY_MIN_GAP_MS=40
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/msxturbor/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=msxturbor/openmsx
MSX_PROFILE=view
# keyboard.charMap for labctl (scripts/labctl.d/keys.py reads SH_KEY_MAP from
# station.env): registry keyboard.charMap is the source, the validator pins this
# copy to it. It must live HERE: runtime.stationEnv is a record, never emitted.
SH_KEY_MAP=&:^,':&,(:*,):(,%3A:',*:",+:%3A,=:_,@:[,[:],]:\,^:=,`:{,\:`,|:~,{:},}:|,~:+,":@
