# a3000 station.env fixture — appended to the emitted station.env.
# Host-native FS-UAE (github.com/Wnt/fs-uae, branch kernel-hive/integrated,
# build-fsuae-native.sh, FSUAE_STATION=a3000 — its own copy, never shared
# with amigaos35/amix) with NO X: shm frames, ctlsock keys/pointer, audio
# FIFO. Shared launcher: stations/fsuae-native/x11-runtime.sh (rule 13 —
# amigaos35/amix stay on Xvfb+XTEST; RTG and the in-guest X pointer are
# separate waves). Converted from the Xvfb+XTEST launcher on 2026-09-09;
# repo-side only until docs/lab/FSUAE-NATIVE-BRIEF.md Part 3's ctlsock
# commits (5-8) are proven on a framebuffer.

# --- emulator ---------------------------------------------------------------
FSUAE_NATIVE_BIN=/data/vms/streamhost/assets/a3000/fsuae-native/bin/fs-uae
# Kickstart 2.04 r37.175, the A3000 ROM (same dump amix stages, own copy).
FSUAE_NATIVE_KICK=/data/vms/streamhost/assets/a3000/kick37175.A3000.rom
FSUAE_NATIVE_MODEL=A3000
FSUAE_NATIVE_MEM_ARGS=--chip_memory=2048 --fast_memory=8192
# No statefile: reset is a cold boot of a fresh work HDF copied from
# disk/a3000-system.hdf.golden. No network plane: pre-web guest.
# MEASURED 2026-09-09 (golden stream, prior Xvfb station launcher on :85): the
# Workbench 2.04 desktop is present at the FIRST 5s capture after launch and
# byte-identical through 30s — boot-to-desktop is <=5s cold. Relaunch after
# kill -TERM on mame.pid returns the same pristine desktop within 8s. Not yet
# re-measured on this shm/ctlsock launcher.
FSUAE_NATIVE_HDF=a3000-system.hdf
FSUAE_NATIVE_STANDBY_DELAY_S=70
SH_MAMECTL_SOCK=/data/vms/streamhost/stations/a3000/ctl.sock
SH_MAMESOCK_KEYMAP=/data/vms/streamhost/stations/a3000/amiga.keymap
SH_AUDIO_SOURCE=fifo
SH_AUDIO_FIFO=/data/vms/streamhost/stations/a3000/audio.fifo

# --- input: ctlsock, absolute mouse (mousehack), the shared amiga keymap ---
# FS-UAE's mousehack never samples an instant press: 150 ms hold proven on
# the fork's rig today (docs/lab/FSUAE-NATIVE-BRIEF.md), 200 ms between
# double-click presses. Key pacing starts at the fleet floor 40/40; retune
# from a real ctlsock trace if characters drop.
SH_BTN_MIN_HOLD_MS=150
SH_KEY_MIN_HOLD_MS=40
SH_KEY_MIN_GAP_MS=40

# --- reset / standby --------------------------------------------------------
SH_RESET_MODE=relaunch
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/a3000/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/a3000/fsuae-native
SH_IDLE_PAUSE_WARMUP_SECS=120
