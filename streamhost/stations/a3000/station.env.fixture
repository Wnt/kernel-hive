# a3000 station.env fixture — appended to the emitted station.env.
# Host-native FS-UAE 3.2.35 (build-fsuae-native.sh, FSUAE_STATION=a3000 —
# its own copy, never shared with amigaos35/amix) under a pinned Xvfb :89,
# captured with SH_CAPTURE=x11, driven over XTEST (SH_X11TEST_*).

# --- emulator ---------------------------------------------------------------
FSUAE_NATIVE_BIN=/data/vms/streamhost/assets/a3000/fsuae-native/bin/fs-uae
# Kickstart 2.04 r37.175, the A3000 ROM (same dump amix stages, own copy).
FSUAE_NATIVE_KICK=/data/vms/streamhost/assets/a3000/kick37175.A3000.rom
FSUAE_NATIVE_GEOM=720x568
# No statefile: reset is a cold boot of a fresh work HDF copied from
# disk/a3000-system.hdf.golden. No network plane: pre-web guest.
FSUAE_NATIVE_CHECKPOINT=0
FSUAE_NATIVE_NET=off
FSUAE_NATIVE_STANDBY_DELAY_S=70

# --- input: the x11test backend (same numbers as amigaos35) -----------------
SH_X11TEST_ABS=1
SH_X11TEST_BUTTONS=xtest
SH_X11TEST_KEYS=1
SH_BTN_MIN_HOLD_MS=60
SH_KEY_MIN_HOLD_MS=40
SH_KEY_MIN_GAP_MS=40

# --- reset / standby --------------------------------------------------------
SH_RESET_MODE=relaunch
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/a3000/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/a3000/fsuae-native
SH_IDLE_PAUSE_WARMUP_SECS=120
