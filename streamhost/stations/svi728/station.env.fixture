# Stock Spectravideo, host-native MAME 0.289; keyboard-only, no network.
SH_RESET_MODE=relaunch
MAME_NATIVE_BIN=/data/vms/streamhost/assets/svi728/mame-native/svi728
MAME_NATIVE_DRIVER=svi728
MAME_NATIVE_ROMS=/data/vms/streamhost/assets/svi728/mame-native/roms
MAME_NATIVE_GEOM=1024x768
MAME_NATIVE_SKIP_WARNINGS=0
MAME_NATIVE_CHECKPOINT=0
SH_MAMECTL_SOCK=/data/vms/streamhost/stations/svi728/ctl.sock
SH_MAMESOCK_KEYMAP=/data/vms/streamhost/stations/svi728/svi728.keymap
SH_AUDIO_SOURCE=fifo
SH_AUDIO_FIFO=/data/vms/streamhost/stations/svi728/audio.fifo
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/svi728/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/svi728/mame-native
SH_KEY_MIN_HOLD_MS=150
SH_KEY_MIN_GAP_MS=100
MAME_CTL_KEY_EXCL=:KEY
SH_FIXTURE_DESC=SVI-728 International, MSX BASIC 1.0 at Ok, 28815 bytes free.
MAME_NATIVE_ARGS=-view "Screen 0 Standard (4:3)"
MAME_NATIVE_STANDBY_DELAY_S=8
# ---- MODIFIER LEAD (2026-10-04) ----
# typeText() sends Shift and the key back to back, and the ctlsock module used
# to apply both in ONE drain pass, so a keyboard scan that straddles that
# instant can read the key without its Shift (sinclairql lost every shifted
# character, oricatmos about one in 300). The launcher hands this to the module
# as MAME_CTL_KEY_MOD_LEAD: a non-modifier press waits this many EMULATED ms
# after the last Shift/Ctrl edge. This machine lost no shifted
# character on the old engine in the stress listing typed through the daemon. It gets
# 10 ms: five times the largest threshold measured on a MAME machine (between 1
# and 2 ms on both the QL and the Oric), and at most 10 ms more per shifted
# character. Needs a binary built with the knob (an older one ignores it).
# docs/TYPE-IN-EDITOR.md "Shifted characters".
SH_KEY_MOD_LEAD_MS=10
