
# ---- GOLDEN FIXTURE ----
# resetMode=loadvm: the 'golden' vmstate lives in disk.qcow2, the station's only
# writable block device (Slackware 3.4 rev-0 ext2 root), so the restore brings back
# BOTH RAM and the filesystem. The GRUB2 boot ISO is attached read-only and is part
# of the device set the vmstate was baked with.
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_GOLDEN_STATE_DISK=/data/vms/streamhost/stations/slackware/disk.qcow2
SH_FIXTURE_DESC=Slackware 3.4 fvwm95 desktop at 1024x768x16: xterm 'darkstar' with a bash# prompt top-left, xclock top-right, FvwmButtons dock bottom-right, Start button + taskbar bottom, pointer parked bottom-right. Root logged in (X autostarts from rc.local). Pointer motion absolute through the guest X server (x11warp), buttons + keys over serial mouse / PS/2 keyboard.

# ---- KEYBOARD PACING ----
# XFree86 3.3.1 reads the PS/2 keyboard through the kernel console driver.
# Fleet floor for QEMU keyboard stations (ADD-NEW-OS-PLAYBOOK §0): 40/40.
SH_KEY_MIN_HOLD_MS=40
SH_KEY_MIN_GAP_MS=40

# ---- POINTER: ABSOLUTE via x11warp (motion) + Microsoft serial mouse (buttons) ----
# XFree86 3.3.1 offers no absolute device, so the daemon warps the pointer inside the
# guest's own X server over TCP: slirp hostfwd 127.0.0.1:6084 -> 10.0.2.15:6000 (NE2000
# ISA ne.o at io 0x300 loaded by rc.modules, rc.inet1 sets 10.0.2.15, the session runs
# `xhost +10.0.2.2`), then XQueryPointer readback. Proven 2026-09-03 on a sandbox clone
# with scripts/build-guests/tiles/slackware/xwarp.py: warp (100,700) and (900,100) read
# back exact, before and after `loadvm golden`. The golden was baked with the pointer
# parked at (1020,760) so the ready frame is not confused with a pointer proof.
SH_INPUT_BACKEND=x11warp
SH_X11WARP_DISPLAY=127.0.0.1:84
SH_X11WARP_TRACE=off
SH_CURSOR_SCALE=1.0
SH_IDLE_PAUSE_SECS=60

# ---- BAKE MEASUREMENTS (golden stream, 2026-09-03, slackware-golden branch) ----
# Bake dir /data/vms/sandbox/slackware-golden/bake/, launch.sh = station launcher
# with paths rewritten (same device set: KVM/-cpu host/32MB/pc-i440fx-11.0
# acpi=off/-vga cirrus/sb16/msmouse serial/IDE disk+GRUB2 ISO cdrom).
# Cold boot: fb-wait --settle 10 --timeout 150 -> settled after 31.9s (last
# change at 21.6s); frame /data/vms/sandbox/slackware-golden/bake/fb-cold.png
# matches the reference desktop (xterm 'darkstar' bash# prompt, xclock, dock,
# Start bar) -- same content as /data/vms/sandbox/slackware/smoke/fb10.png.
# savevm golden: VM_SIZE 16.7 MiB, VM_CLOCK 0000:00:42.223.
# Restore proof: relaunch -> loadvm golden -S detected, QMP cont, screendump
# /data/vms/sandbox/slackware-golden/bake/fb-restore1.png = pristine desktop
# (not a cold boot). PASS.
# Keyboard proof: qmp-type 'uname -a\n' into the xterm, screendump
# /data/vms/sandbox/slackware-golden/bake/fb-kbd.png echoes
# "Linux darkstar 2.0.30 #3 Tue Jun 24 03:49:52 CDT 1997 i686 unknown". PASS.
# Pointer proof (golden stream's pixel diff missed it; coordinator re-measured on the
# smoke rig, same device set): the X pointer starts at the screen centre as the 'X'
# root cursor (512,384) and mouse_move carries it 2 px per unit. PASS.
# Reset-is-golden proof: QMP loadvm golden after the keyboard proof ->
# screendump /data/vms/sandbox/slackware-golden/bake/fb-reset.png shows the
# uname output GONE, clock back to bake time -- the restore is the reset.
# PASS.
