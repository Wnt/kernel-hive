
# ---- GOLDEN FIXTURE ----
# resetMode=loadvm: the 'golden' vmstate lives in disk.qcow2, the station's only
# writable block device (Slackware 3.4 rev-0 ext2 root), so the restore brings back
# BOTH RAM and the filesystem. The GRUB2 boot ISO is attached read-only and is part
# of the device set the vmstate was baked with.
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_GOLDEN_STATE_DISK=/data/vms/streamhost/stations/slackware/disk.qcow2
SH_FIXTURE_DESC=Slackware 3.4 fvwm95 desktop at 1024x768x16: xterm 'darkstar' with a bash# prompt top-left, xclock top-right, FvwmButtons dock bottom-right, Start button + taskbar bottom. Root logged in (X autostarts from rc.local). Screensaver and DPMS off in .xinitrc.

# ---- KEYBOARD PACING ----
# XFree86 3.3.1 reads the PS/2 keyboard through the kernel console driver.
# Fleet floor for QEMU keyboard stations (ADD-NEW-OS-PLAYBOOK §0): 40/40.
SH_KEY_MIN_HOLD_MS=40
SH_KEY_MIN_GAP_MS=40

# ---- POINTER: RELATIVE (Microsoft serial mouse on ttyS0 = QEMU msmouse chardev) ----
# XFree86 3.3.1 knows no absolute device QEMU can offer (no usb-tablet, no evdev);
# x11warp (the fleet's XWarpPointer route for old X servers) needs guest TCP/IP and
# the bare.i kernel has no NIC driver — see docs/lab/SLACKWARE-WAVE.md for the net.i
# follow-up. X runs `xset m 1 1` (no acceleration) so 1 mouse unit = 1 px.
SH_INPUT_BACKEND=dbus-rel
SH_CURSOR_SCALE=1.0
SH_REL_HOME_ON=reset
SH_REL_HOME_TO=1023,767
SH_IDLE_PAUSE_SECS=60
