# multics station.env fixture — appended to the emitted station.env.
#
# Multics MR12.8 (Honeywell/Bull, the final release) on an emulated DPS-8/M
# under the DPS8M simulator R3.1.0, staged by
# scripts/build-guests/tiles/multics.sh from the MR12.8 QuickStart release.
# No QEMU, no MAME, no checkpoint: the exhibit is a simulator process plus one
# terminal, and reset = relaunch from the pristine baked root.dsk.
#
# CONTAINED (docs/lab/record-wave/HOST-APP-CONTAINER-CONTRACT.md): DPS8M, Xvfb
# and the visitor's xterm all run inside a systemd-nspawn container — own
# PID/mount/net/IPC/UTS/user namespaces, root inside = host uid
# MULTICS_UIDBASE, volatile overlay root, bin/ and media/ bound READ-ONLY,
# work/ the only writable bind, CAP_SYS_ADMIN dropped, mount syscalls filtered.
# The host sees the display through a symlink /tmp/.X11-unix/X117 ->
# MULTICS_X11_SOCKDIR/X117, so capture, XTEST and labctl are unchanged.
# mame.pid is the `dps8` HOST pid (idle freezer + reap-by-exe);
# nspawn.pid is the supervisor.
#
# The inner script is only a prologue: it stages work/, writes the DPS8M ini
# and execs the lane's shared engine,
# docs/lab/record-wave/shared-terminal-runtime.sh (proven by vax43bsd; this
# station contributed findings 1, 2 and 4 to it).

# --- the emulated machine ---------------------------------------------------
MULTICS_ASSETS=/data/vms/streamhost/assets/multics
MULTICS_GEOM=1024x768
# FNP D, channel d.h000 — the visitor terminal. Container-private
# (--private-network), so it needs no host port claim and is unreachable from
# labhost. 6180 is the DPS8M default and is also the Multics community's own
# joke about the GE-645's successor; other channels exist in the CDT but only
# d.h000 is published.
MULTICS_PORT=6180
MULTICS_COLS=80
MULTICS_ROWS=24
MULTICS_FONTSIZE=14
MULTICS_XOFF=+32+96
# FINDING 1 of the shared runtime, and this station is its sharpest case:
# MEASURED 2026-09-20T08:58:32Z, TCP/6180 opened at +4 s and the answering
# service came up at +52 s. A second run on a loaded box took 111 s, so the
# readiness timeout is generous — the gate that matters is the `as_init_` line
# in the simulator's own console stream, not this number.
MULTICS_READY_TIMEOUT_S=420

# --- container (systemd-nspawn) --------------------------------------------
# rootfs: debootstrap minbase trixie + xvfb/xterm/telnet/netcat, uid-shifted by
# tiles/multics.sh; MULTICS_UIDBASE must be a multiple of 65536 and clear of
# the CT subuid range (100000+) and of the other contained stations
# (medley 1966080, mvs38 2031616, vision 2162688, perq 2359296, its 2424832,
# vax43bsd 2490368).
MULTICS_ROOTFS=/data/vms/streamhost/assets/multics/rootfs
MULTICS_UIDBASE=2555904
MULTICS_X11_SOCKDIR=/run/streamhost/x11/multics

# --- input: keyboard only. This is a terminal exhibit; Multics' FNP line
# carries keystrokes and nothing else, and a 1969 timesharing system has no
# pointing device to give one to. The control characters a Multics tty
# actually needs must reach the guest through the SPA's on-screen keyboard and
# never as a host shortcut: ^C and BREAK (the quit signal that gets you the
# QUIT handler), ^D (end of file), ^S/^Q (flow control), and ESC — Multics'
# own erase and kill characters are `#` and `@`, which are ordinary printable
# keys and need nothing special.
SH_X11TEST_KEYS=1
SH_KEY_MIN_HOLD_MS=40
SH_KEY_MIN_GAP_MS=40

# --- reset / standby --------------------------------------------------------
# Relaunch: kill the simulator, wipe work/, reflink-copy the pristine baked
# root.dsk back in and start again. MEASURED 0.126 s for the 594 MB copy on
# labhost's ZFS — free, which is why this station has no checkpoint at all.
# The seed is mode 0444 and bound read-only, so nothing a visitor types can
# corrupt it. The seed was baked to `shutdown complete` at the operator
# console; a simulator killed mid-run leaves the RPV inconsistent and the next
# boot stops in BCE asking questions the autoinput sheet does not answer.
SH_RESET_MODE=relaunch
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/multics/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/multics/bin
SH_IDLE_PAUSE_WARMUP_SECS=120
MULTICS_STANDBY_DELAY_S=30
