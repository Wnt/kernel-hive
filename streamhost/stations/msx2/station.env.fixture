# ---- HOST-NATIVE STATION (native from day one — msx2 record wave, 2026-09-20) ----
# MAME 0.289's nms8250 (Philips NMS 8250, ordinary MSX2) runs ON THE HOST —
# same engine as samcoupe/apple2e/atari800xl, drawshm frames, ctlsock keys
# through the generated keymap, sound -> SDL disk -> FIFO with the daemon
# as clock. Launcher: shared stations/mame-native/x11-runtime.sh; reset =
# relaunch (checkpoint verdict TBD — nms8250/msx2.cpp save-state support not
# yet measured on this build, see MAME_NATIVE_CHECKPOINT below).
SH_RESET_MODE=relaunch
# MEASURED 2026-09-20 (smoke stream, sandbox rig): cold boot with the
# MSX-DOS 2 (English) disk already in -flop1 lands on MSX-BASIC's "Ok"
# prompt ("MSX BASIC version 2.1 / Copyright 1986 by Microsoft / Disk BASIC
# version 1.0 / Ok"), NOT an auto-boot into MSX-DOS 2 -- real MSX hardware
# auto-boots a bootable floppy, so either this disk's boot sector needs a
# different trigger (a typed command, not yet identified) or MAME's
# nms8250 diskrom does not attempt the auto-boot this build was expected
# to. DOS2 access from this prompt is OUT OF SCOPE for this wave (operator
# decision — the machine's built-in disk ROM is DOS1, "Disk BASIC version
# 1.0" on the frame; MSX-DOS 2 needs its own cartridge ROM this wave never
# staged); the shipped rest scene is MSX-BASIC 2.1 with the disk present.
# Keyboard input MEASURED 2026-09-20 (landing stream) on the PRODUCTION
# path: SH_INPUT_BACKEND=mamesock, the generated msx2.keymap (below), 40/40
# ms pacing and MAME_CTL_KEY_EXCL=:KEY (the 8255 PPI matrix IS CPU-scanned,
# like the SAM Coupé's) -- proven from the REAL BROWSER through the real
# SPA (dark-launched /os/msx2 rig): `PRINT 1+1` typed byte-perfect, Enter
# executed it, "2" printed, fresh "Ok" returned. Daemon counters over the
# whole run: mamesock accepted=35 dropped=0 overflow=0 unmapped=0.
SH_FIXTURE_DESC=Philips NMS 8250 (MSX2) cold boot to MSX-BASIC "Ok" prompt, MSX-DOS 2 boot disk present but not auto-booted (out of scope, see docs/lab/MSX2-WAVE.md).
MAME_NATIVE_BIN=/data/vms/streamhost/assets/msx2/mame-native/msx2
MAME_NATIVE_DRIVER=nms8250
MAME_NATIVE_ROMS=/data/vms/streamhost/assets/msx2/mame-native/roms
MAME_NATIVE_GEOM=1024x768
MAME_NATIVE_SKIP_WARNINGS=0
# TODO(golden stream): 0/1 decision once MACHINE_SUPPORTS_SAVE is confirmed
# for msx/msx2.cpp on this build (docs/lab/research/vom-reference.md has no
# MSX entry — check directly with -listxml | grep -i state, or a SAVEST
# probe on the sandbox rig, before flipping this to 1).
MAME_NATIVE_CHECKPOINT=0
# Device set CONFIRMED on this 0.289 build (2026-09-20, native stream):
# -listmedia/-listslots nms8250 show ONE internal floppy drive (-flop1,
# WD2793 FDC, 3.5" DSDD) and two EMPTY cartridge slots (this exhibit is
# disk-based, not cartridge-based — no cartridge ROM is loaded). No
# mouseport option is attached anywhere in the device tree — keyboard-only
# exhibit, stream.pointer.transport stays "none". -flop1 points at the
# staged MSX-DOS 2 (English) system disk (sha256 recorded in
# docs/lab/MSX2-WAVE.md); on a cold boot with a disk present the machine
# auto-boots the disk's own boot sector into MSX-DOS 2 rather than stopping
# at MSX-BASIC — TODO(golden stream): confirm which scene the fleet ships
# as the rest scene and whether any keying is needed to reach it.
MAME_NATIVE_ARGS=-flop1 /data/vms/streamhost/assets/msx2/media/msxdos2-english.dsk
SH_MAMECTL_SOCK=/data/vms/streamhost/stations/msx2/ctl.sock
SH_MAMESOCK_KEYMAP=/data/vms/streamhost/stations/msx2/msx2.keymap
SH_AUDIO_SOURCE=fifo
SH_AUDIO_FIFO=/data/vms/streamhost/stations/msx2/audio.fifo

SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/msx2/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/msx2/mame-native
MAME_NATIVE_STANDBY_DELAY_S=8

# Fleet floor for MAME keyboard stations (playbook §0): measure only if
# characters drop. 40/40 fleet default — msx2 has not shown a dropped-char
# symptom yet (no golden/type-in stream run), so this stays at the floor
# until proven otherwise.
SH_KEY_MIN_HOLD_MS=40
SH_KEY_MIN_GAP_MS=40
# MEASURED 2026-09-20 (landing stream, dark-launch rig, real browser): the
# 8255 PPI keyboard matrix on MSX/MSX2 IS host-CPU-scanned like the SAM
# Coupé's — a raw KEY burst without this set is a chord hazard on a
# CPU-scanned matrix (the samcoupe lesson, AGENTS.md). Set from the start
# rather than bisected: `PRINT 1+1` typed through the real SPA at
# SH_KEY_MIN_HOLD_MS/GAP_MS=40/40 with this set landed byte-perfect,
# mamesock accepted=35 dropped=0 overflow=0.
MAME_CTL_KEY_EXCL=:KEY
