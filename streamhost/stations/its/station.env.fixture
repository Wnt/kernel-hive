# its station.env fixture — appended to the emitted station.env.
#
# MIT ITS (Incompatible Timesharing System) on an emulated DEC PDP-10 (KS10)
# under SIMH, built from source by scripts/build-guests/tiles/its.sh from the
# maintained github.com/PDP-10/its tree. No QEMU, no MAME, no checkpoint: the
# exhibit is a simulator process plus one terminal, and reset = relaunch from
# the pristine built disk.
#
# CONTAINED (docs/lab/record-wave/HOST-APP-CONTAINER-CONTRACT.md): SIMH, Xvfb
# and the visitor's xterm all run inside a systemd-nspawn container — own
# PID/mount/net/IPC/UTS/user namespaces, root inside = host uid ITS_UIDBASE,
# volatile overlay root, the built ITS tree bound READ-ONLY, work/ the only
# writable bind, CAP_SYS_ADMIN dropped, mount syscalls filtered. The host sees
# the display through a symlink /tmp/.X11-unix/X116 -> ITS_X11_SOCKDIR/X116,
# so capture, XTEST and labctl are unchanged. mame.pid is the SIMH pdp10 HOST
# pid (idle freezer + reap-by-exe); nspawn.pid is the supervisor.
#
# The inner script is only a prologue: it stages the writable RP06, writes the
# simulator ini and execs stations/its/shared-terminal-runtime.sh, the lane's
# shared engine that vax43bsd proved end to end. Two of its findings are load
# bearing here: a TCP port probe is NOT readiness (SIMH's `att dz` binds while
# the ini file is still being read, long before ITS is up — so the gate is the
# port AND ITS_READY_LOG_RE in the simulator's own console stream), and the
# hidden emulator never gets a pipe or FIFO on stdin.

# --- the emulated machine ---------------------------------------------------
ITS_ASSETS=/data/vms/streamhost/assets/its
ITS_TREE=/data/vms/streamhost/assets/its/tree
ITS_GEOM=1024x768
# DZ11 line 0 — the ITS user terminal. Container-private (--private-network),
# so it needs no host port claim and is unreachable from labhost.
ITS_PORT=10004
ITS_COLS=80
ITS_ROWS=30
ITS_FONTSIZE=21
ITS_XOFF=+0+0
# Readiness, finding 1 of the shared runtime. ITS_READY_CONSOLE_RE is the text
# SIMH waits for on the PDP-10's OWN console before it echoes the token below;
# ITS_READY_LOG_RE is what the shared runtime greps for in work/emulator.log.
ITS_READY_CONSOLE_RE=
ITS_READY_LOG_RE=KHBOOTREADY
ITS_READY_TIMEOUT_S=300
# --- container (systemd-nspawn) --------------------------------------------
# rootfs: debootstrap minbase trixie + xvfb/xterm/telnet, built and uid-shifted
# by tiles/its.sh; ITS_UIDBASE must be a multiple of 65536 and clear of the
# CT subuid range (100000+) and of the other contained stations.
ITS_ROOTFS=/data/vms/streamhost/assets/its/rootfs
ITS_UIDBASE=2424832
ITS_X11_SOCKDIR=/run/streamhost/x11/its

# --- input: keyboard only. ITS is a terminal exhibit; there is no pointer.
# The historically necessary keys (Ctrl-Z to log in, ESC as altmode, Ctrl-\)
# must reach the guest through the on-screen keyboard, never a host shortcut.
SH_X11TEST_KEYS=1
SH_KEY_MIN_HOLD_MS=40
SH_KEY_MIN_GAP_MS=40

# --- reset / standby --------------------------------------------------------
# Relaunch: kill the simulator, wipe work/, copy the pristine rp0.dsk back in
# and start again. The seed disk is read-only, so nothing a visitor types can
# corrupt it.
SH_RESET_MODE=relaunch
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/its/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/its/tree/tools/simh
SH_IDLE_PAUSE_WARMUP_SECS=60
ITS_STANDBY_DELAY_S=30
