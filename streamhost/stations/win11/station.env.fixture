
# --- GOLDEN TEST FIXTURE (added by golden-fixture bake) ---
# resetMode=loadvm : disk is a standalone qcow2, snapshot "golden" holds live RAM+disk.
# Reset a test to the fixture with:
#   python3 /data/vms/streamhost/stations/win11/drive.py \
#           /data/vms/streamhost/stations/win11/qmp.sock loadvm golden
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_GOLDEN_DISKS=win11-golden.qcow2 OVMF_VARS.qcow2
# Fixture: Windows 11 Pro 25H2 (build 26200) desktop, auto-logged in as WIN11\lab,
# empty desktop (Recycle Bin + Edge), taskbar centered, no dialogs. The UEFI variable
# store is snapshotted alongside the system disk, so a reset restores the boot entry
# and Secure Boot state with the desktop. Screen blank / standby / hibernate / disk
# timeouts all 0 (never), lock screen off (NoLockScreen), screensaver off. Windows
# Update disabled (wuauserv + UsoSvc Disabled, NoAutoUpdate=1) because the guest has
# no route out and would otherwise retry forever. Network is SLIRP restrict=on:
# 10.0.2.15/24 with NO default route and no DNS, so the adapter is up but nothing
# reaches the internet. Restore measured at ~9 s to an answering guest agent.
SH_BUFSIZE_RATIO=0.5
SH_ABS_PACE_MS=30
