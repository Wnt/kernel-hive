# medley station.env fixture — appended to the emitted station.env.
# Interlisp Medley (github.com/Interlisp/medley, MIT), host-native: the maiko
# Lisp VM is a stock X client under a pinned Xvfb, captured with
# SH_CAPTURE=x11 and driven over XTEST. Not an emulated machine — there is no
# ROM, no disk image and no checkpoint; the "golden" is the release sysout.
#
# CONTAINED (2026-09-09, docs/guests/medley.md §Security): maiko AND its Xvfb
# run inside a systemd-nspawn container — own PID/mount/net/IPC/UTS/user
# namespaces, root inside = host uid MEDLEY_UIDBASE, volatile overlay root,
# Medley tree bound read-only, work/ the only writable bind, CAP_SYS_ADMIN
# dropped, mount syscalls filtered. The host sees the display through a
# symlink /tmp/.X11-unix/X91 -> MEDLEY_X11_SOCKDIR/X91, so capture, XTEST and
# labctl are unchanged. mame.pid is maiko's HOST pid (the idle freezer and
# the reap-by-exe path work as before); nspawn.pid is the supervisor.

# --- Lisp VM ----------------------------------------------------------------
# Release medley-260826-3a14c9aa_260319-9259716e (full linux x86_64 tgz,
# 185512952 bytes, sha256 9e163aaf87a30f0e14e721826172d22c680153bab597c57ef20f39bea3736f76)
# unpacked by scripts/build-guests/tiles/medley.sh into assets/medley/{medley,maiko}.
MEDLEY_ASSETS=/data/vms/streamhost/assets/medley
MEDLEY_GEOM=1024x768
MEDLEY_SYSOUT=/data/vms/streamhost/assets/medley/medley/loadups/full.sysout
MEDLEY_GREET=/data/vms/streamhost/assets/medley/medley/greetfiles/MEDLEYDIR-INIT
MEDLEY_MEM=256
# --- container (systemd-nspawn) --------------------------------------------
# rootfs: debootstrap minbase trixie + xvfb, built and uid-shifted by
# tiles/medley.sh; MEDLEY_UIDBASE must be a multiple of 65536 and clear of the
# CT subuid range (100000+).
MEDLEY_ROOTFS=/data/vms/streamhost/assets/medley/rootfs
MEDLEY_UIDBASE=1966080
MEDLEY_X11_SOCKDIR=/run/streamhost/x11/medley
# MEASURED 2026-09-09 (smoke rig on :91): the Exec window and the Medley logo
# are drawn at the FIRST 2 s capture after exec and stay byte-identical apart
# from the caret blink through 60 s — boot-to-desktop is <=2 s.

# --- input: true absolute XTEST, buttons and keys over XTEST ----------------
# X owns the pointer, so XTEST motion in root coordinates lands exactly where
# it is sent (xdotool readback 200,300 / 900,700 exact on the smoke rig).
SH_X11TEST_MOTION=xtest
SH_X11TEST_ABS=1
SH_X11TEST_BUTTONS=xtest
SH_X11TEST_KEYS=1
SH_BTN_MIN_HOLD_MS=60
SH_KEY_MIN_HOLD_MS=40
SH_KEY_MIN_GAP_MS=40

# --- reset / standby --------------------------------------------------------
# Relaunch from the pristine sysout (~2 s). The standby freeze keeps visits
# instant and the Lisp VM off the cores between visitors.
SH_RESET_MODE=relaunch
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/medley/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/medley/maiko
SH_IDLE_PAUSE_WARMUP_SECS=60
MEDLEY_STANDBY_DELAY_S=30
