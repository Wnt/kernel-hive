# ---- HOST-NATIVE STATION (native from day one — cpm22 wave, 2026-09-20) ----
# MAME 0.289's kayproii driver runs ON THE HOST — drawshm frames, ctlsock
# keys through the generated keymap, no audio, no network. Launcher: shared
# stations/mame-native/x11-runtime.sh; reset = relaunch restoring the golden
# savestate (kayproii has MACHINE_SUPPORTS_SAVE).
#
# CORRECTION vs the integration seed: the driver is `kayproii`, not
# `kaypro2` (that string is only formats/kaypro_dsk.cpp's floppy-format
# name) — confirmed with -listxml on a stock MAME 0.276 system package,
# 2026-09-20.
SH_RESET_MODE=relaunch
SH_FIXTURE_DESC=Kaypro II CP/M 2.2 (GMv2.72) boot floppy -- the A> prompt with the disk's own STANDARD/PRINTER software directory already visible (ASM/BAUD/DDT/DUMP/ED/LOAD/MOVCPM/PIP/STAT/SUBMIT/SYSGEN/...), drawn at the station's published 1024x768 drawshm surface by MAME 0.289's kayproii running HOST-NATIVE (drawshm). MEASURED 2026-09-20 against the ACTUAL fleet-pinned mame0289 native binary (not just the earlier stock-0.276 smoke test): cold boot reaches the A> prompt in ~6 emulated seconds with no automation needed (the CP/M boot floppy prints its own directory at boot); a `DIR` via POST + CODE {ENTER} re-ran the listing cleanly with no dropped/duplicated characters. Keyboard is HLE'd via an Intel i8048 MCU (device kayproiikbd, devices/bus/keytronic/keytronic_l2207.cpp, its own separate ROM set kaypro_ii-ins8048.bin) rather than a CPU-scanned matrix the driver polls directly -- unlike samcoupe/zxspectrum/mpf2/bbcmicro/dragon32. No pointer: the Kaypro II has no mouse port. No audio: MAME_NATIVE_ARGS carries none and SH_AUDIO is off.
MAME_NATIVE_BIN=/data/vms/streamhost/assets/cpm22/mame-native/kayproii
MAME_NATIVE_DRIVER=kayproii
MAME_NATIVE_ROMS=/data/vms/streamhost/assets/cpm22/mame-native/roms
MAME_NATIVE_GEOM=1024x768
# REQUIRED (not optional) — see native.d/cpm22.sh's 2026-09-20 correction:
# without mame-irix-skip-warnings.patch + this =1, the driver's "imperfect
# sound" flag shows a MODAL warnings panel that MAME_NO_UI renders as solid
# black and blocks the machine from ever reaching RUNNING (the live-station
# incident this fixed).
MAME_NATIVE_SKIP_WARNINGS=1
# Golden stream: CAPTURED and restore-proven 2026-09-20 on the fleet-pinned
# 0.289 native binary (sandbox rig, PIL ImageChops.difference bbox None
# against the captured A> frame) -- see docs/lab/CPM22-WAVE.md.
MAME_NATIVE_CHECKPOINT=1
# Device set CONFIRMED against the ACTUAL fleet-pinned mame0289 binary
# (2026-09-20): bios 149c (the default bios "149"/81-149.u47 has no
# surviving dump on any mirror checked), flop1 the CP/M boot disk, flop2
# WordStar 3.3. Both media files are TOSEC preservation images (.td0/.imd)
# fed to MAME UNCONVERTED -- see scripts/build-guests/tiles/cpm22.sh for why
# a raw .kay conversion of the same boot disk fails (logical sector order).
MAME_NATIVE_ARGS=-bios 149c -flop1 /data/vms/streamhost/assets/cpm22/media/cpm22-boot.td0 -flop2 /data/vms/streamhost/assets/cpm22/media/wordstar33.imd
SH_MAMECTL_SOCK=/data/vms/streamhost/stations/cpm22/ctl.sock
SH_MAMESOCK_KEYMAP=/data/vms/streamhost/stations/cpm22/cpm22.keymap

# ---- STANDBY (instant-ready: an emulator nobody watches costs ~0 CPU) ----
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/cpm22/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/cpm22/mame-native
MAME_NATIVE_STANDBY_DELAY_S=8

# ---- KEYBOARD (Intel i8048 MCU HLE, device kayproiikbd) ----
# 80/80 ms shipped per the fleet's MAME-keyboard rule (docs/lab/ -- ctlsock
# paces per FIELD, SPA key bursts become chords on CPU-scanned matrices).
# MAME_CTL_KEY_EXCL NOT set: this driver's keyboard is HLE'd through a
# separate MCU device, not a matrix the driver's CPU polls directly (unlike
# samcoupe/zxspectrum/mpf2/bbcmicro/dragon32) -- measure from the real
# browser before assuming this holds under a fast production burst.
SH_KEY_MIN_HOLD_MS=80
SH_KEY_MIN_GAP_MS=80

# ---- POINTER: none. The Kaypro II has no mouse port on this machine. ----
