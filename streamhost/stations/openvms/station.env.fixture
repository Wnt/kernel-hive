# OpenVMS V9.2-3 DECwindows Motif desktop through the lean Xorg bridge.
# Reset must cold-restart the service: warm loadvm restores dead X sockets.
SH_RESET_MODE=restart
SH_GOLDEN_SNAPSHOT=leanx-preconnect
SH_GOLDEN_DISKS=openvms-community.qcow2 OVMF_VARS.qcow2 openvms-decwindows-bridge.qcow2
SH_FIXTURE_DESC=OpenVMS DECwindows Motif at 1024x768; DECterm DCL prompt, FileView, Clock, Calculator; cold service restart replays fresh X connections
