
# --- GOLDEN TEST FIXTURE (2026-09-13) ---
# resetMode=loadvm: reset the guest between tests with QMP 'loadvm golden'.
# Fixture = SCO Xenix 386 2.3.4 at a logged-in root shell on Multiscreen tty01;
# keyboard-reactive caret; no screensaver / DPMS / monitor-blank.
# Device set the golden was baked with (a checkpoint + binary + device set are
# ONE combination — AGENTS.md rule 6): qemu-system-i386 -machine isapc -cpu 486
# -m 16 -vga std, single IDE disk with an explicit CHS geometry, TCG (no KVM).
# Pointer: none (text console). Keyboard pacing: the fleet floor 40/40.
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_FIXTURE_DESC=xenix-root-shell
