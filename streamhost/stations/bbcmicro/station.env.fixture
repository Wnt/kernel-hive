# ---- HOST-NATIVE STATION (de-bridged 2026-08-12, conversion campaign) ----
# MAME 0.289's bbcb runs ON THE HOST: drawshm frames, ctlsock keys through
# the generated keymap, SN76489 sound -> SDL disk -> FIFO with the daemon as
# clock. Launcher: shared stations/mame-native/x11-runtime.sh. Reset =
# relaunch restoring the golden savestate.
SH_RESET_MODE=relaunch
SH_FIXTURE_DESC=Acorn BBC Micro Model B (1981) at its own untouched power-on screen: "BBC Computer 32K / Acorn DFS / BASIC / >" in white MODE 7 teletext on black, drawn with aspect correction on the published 1024x768 surface by MAME 0.289's bbcb running HOST-NATIVE (drawshm). Nothing is curated and nothing is typed. MOS 1.20, BBC BASIC II, Acorn 8271 disc interface with DNFS 1.20 (the "Acorn DFS" line). -artwork_crop removes the driver's LED strip so the exhibit is the picture and nothing else. CAPS LOCK is on at reset (the MOS switches it on), so unshifted letters arrive upper case, which is what BASIC's tokeniser needs; thirteen characters sit on different keys from a US PC and are translated by SH_KEY_MAP. Keyboard-only exhibit; no pointer device; SN76489 sound -> FIFO.
MAME_NATIVE_BIN=/data/vms/streamhost/assets/bbcmicro/mame-native/bbcb
MAME_NATIVE_DRIVER=bbcb
MAME_NATIVE_ROMS=/data/vms/streamhost/assets/bbcmicro/mame-native/roms
MAME_NATIVE_GEOM=1024x768
MAME_NATIVE_ARGS=-artwork_crop
MAME_NATIVE_SKIP_WARNINGS=1
# The bbcb/zx81/kc85_4/spectrum drivers have NO MACHINE_SUPPORTS_SAVE, so
# checkpoint restore is OFF (it restored garbage — 2026-08-12); reset is
# the cold boot, which reaches this scene in seconds.
MAME_NATIVE_CHECKPOINT=0
# SCANNED-MATRIX KEYBOARD: the guest's own ROM scans this matrix, so two
# keys down at once are ambiguous (ghosting/interleave) and the browser
# sends a typed line as ONE BURST — the daemon's SH_KEY_MIN_* gate paces
# only the QEMU/dbus path, never this one. Exclusive-scan restores the
# serialized delivery every station's pacing was bisected under (the same
# contract typeDemoProgram and validate_demo_pacing assume). Modifier
# fields (Shift/Ctrl) are exempt by name, so chords still work.
MAME_CTL_KEY_EXCL=:kbd:COL
SH_MAMECTL_SOCK=/data/vms/streamhost/stations/bbcmicro/ctl.sock
SH_MAMESOCK_KEYMAP=/data/vms/streamhost/stations/bbcmicro/bbcmicro.keymap
SH_AUDIO_SOURCE=fifo
SH_AUDIO_FIFO=/data/vms/streamhost/stations/bbcmicro/audio.fifo

# ---- STANDBY (instant-ready: an emulator nobody watches costs ~0 CPU) ----
# The launcher freezes the emulator once the scene has painted, and the
# daemon owns it from there: SIGSTOP after the idle grace with zero
# sessions, unconditional SIGCONT the moment a visitor connects. Without
# this a de-bridged station burns a full core around the clock.
# SH_IDLE_PAUSE_PROC_MATCH is the anti-footgun: the signal is only ever
# sent to a pid whose cmdline still carries this station's own asset path
# (bbcmicro and armeval run identically-named `bbcb` binaries).
# Rollback is one line: SH_IDLE_PAUSE_SECS=0 restores an always-running
# exhibit.
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/bbcmicro/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/bbcmicro/mame-native
MAME_NATIVE_STANDBY_DELAY_S=8

# ---- KEYBOARD PACING (the exhibit's only input surface) ----
SH_KEY_MIN_HOLD_MS=80
SH_KEY_MIN_GAP_MS=80
SH_KEY_MAP=":@,':&,&:^,(:*,):(,=:_,@:\,+:%3A,^:=,~:+,_:`,%3A:',*:"
