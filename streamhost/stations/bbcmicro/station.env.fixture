# ---- GOLDEN FIXTURE (bridge tile) ----
# resetMode=loadvm -> restore the INTERNAL 'golden' snapshot: X (-nocursor) +
# MAME 0.289 `bbcb` at the BBC Micro Model B's own UNTOUCHED power-on screen.
# Nothing is curated into the fixture and nothing is typed after the restore.
# The Plus/4 shipped a golden baked inside an application and had to be
# re-baked; here the machine's first screen is also the exhibit's invitation.
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_FIXTURE_DESC=Acorn BBC Micro Model B (1981) at its own untouched power-on screen: "BBC Computer 32K / Acorn DFS / BASIC / >" in white MODE 7 teletext on black, drawn fullscreen with aspect correction by a purpose-built MAME 0.289 `bbcb` on the bridge base's stock 1024x768 X root. Nothing is curated and nothing is typed. The machine is MAME's own default configuration — MOS 1.20, BBC BASIC II, and the Acorn 8271 disc interface with DNFS 1.20, which is what prints the "Acorn DFS" line. -artwork_crop removes the driver's LED strip so the exhibit is the picture and nothing else. CAPS LOCK is on at reset (the MOS switches it on), so unshifted letters arrive upper case, which is what BASIC's tokeniser needs; thirteen characters sit on different keys from a US PC and are translated by SH_KEY_MAP. Keyboard-only exhibit; no pointer device; SN76489 sound -> ALSA -> AC97.

# ---- KEYBOARD PACING (the exhibit's only input surface) ----
# The BBC is a 50 Hz machine, so playbook 5.1's two-frame floor is 40/40. Two
# frames is a FLOOR, not an answer: the vic20 shipped at its derived 40/40 and
# still lost a character every couple of dozen lines to host scheduling stalls,
# which are a property of this box (30+ emulators) and not of the emulated
# machine. Bisected on a namespaced clone with
# scripts/dev/emu-key-pacing-bisect.py and shipped at the same 80/80 margin as
# the other bridge tiles. Re-bisect if dropped characters ever reappear.
SH_KEY_MIN_HOLD_MS=80
SH_KEY_MIN_GAP_MS=80
# THIRTEEN CHARACTERS SIT ON DIFFERENT KEYS THAN ON A US PC. Derived from the
# driver's own PORT_CHAR table (src/mame/acorn/bbc_kbd.cpp, port `bbc_keyboard`)
# with scripts/dev/mame-keymap.py, not guessed. The ones a BASIC listing hits
# are `=` (BBC: Shift+`-`), `"` (Shift+2), `(`/`)` (Shift+8/9), `:` and `+`.
# Untranslated they land one key over and the listing is quietly corrupt, which
# reads exactly like dropped keystrokes. Value format: guest:host pairs; kept in
# lockstep with keyboard.charMap in registry/tiles/bbcmicro.json.
SH_KEY_MAP=":@,':&,&:^,(:*,):(,=:_,@:\,+:%3A,^:=,~:+,_:`,%3A:',*:"
