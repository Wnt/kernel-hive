# ---- GOLDEN FIXTURE (host-native LisaEm, x11 runtime shape) ----
# resetMode=relaunch -> `systemctl restart streamhost@lisa`, whose ExecStartPre
# re-runs x11-runtime.sh: it kills LisaEm, copies the golden ProFile image
# fresh and cold-boots Lisa Office System 3.1 (desktop ~150 s after the ROM's
# boot click at the emulated 5 MHz). LisaEm has no save state. The station dir
# holds disk/lisa-profile.dc42.golden (the 10 350 676-byte DC42 ProFile image
# with LOS 3.1 + the seven Lisa tools; docs/lab/LISA-WAVE.md names the origin).
SH_RESET_MODE=relaunch
SH_FIXTURE_DESC=Apple Lisa 2 (Motorola 68000 at 5 MHz, 1 MB, boot ROM rev H, 5 MB ProFile) running Lisa Office System 3.1 in LisaEm 2.0, host-native under a pinned 720x498 Xvfb whose root IS the aspect-corrected Lisa screen. Desktop at rest: the Office System desktop with Preferences, Wastebasket, Clipboard and the ProFile icon, the Lisa's document-centric filing on the disk. Pointer is ABSOLUTE: LisaEm follows the host X pointer 1:1, so an XTEST root coordinate is the Lisa pixel the arrow lands on.

# ---- EMULATOR (read by x11-runtime.sh, not by the daemon) ----
LISA_ASSETS=/data/vms/streamhost/assets/lisa
LISA_GEOM=720x498
LISA_BOOT_CLICK=1
LISA_STANDBY_DELAY_S=200

# ---- POINTER/KEY INPUT (x11test, absolute) ----
# Motion is TRUE ABSOLUTE XTEST in root coordinates (the root is the Lisa video),
# buttons and keys ride XTEST into the same display. NOT the amix warp mode:
# there is no guest X server here.
SH_X11TEST_ABS=1
SH_X11TEST_BUTTONS=xtest
SH_X11TEST_KEYS=1
# LisaEm samples the mouse per emulated frame: xdotool's instant press/release
# never registered on the rig, a 150 ms hold did every time (2026-09-09).
SH_BTN_MIN_HOLD_MS=150
SH_KEY_MIN_HOLD_MS=40
SH_KEY_MIN_GAP_MS=40

# ---- STANDBY ----
# Without a pidfile the daemon cannot pause a non-QEMU station; the proc match
# is scoped to this station's own asset path.
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/lisa/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/lisa/lisaem
SH_IDLE_PAUSE_WARMUP_SECS=240
