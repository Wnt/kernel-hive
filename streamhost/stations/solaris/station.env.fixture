
# --- GOLDEN TEST FIXTURE (added by golden-fixture bake) ---
# resetMode=loadvm : single standalone qcow2, snapshot "golden" holds live RAM+device+disk.
# Reset a test to the fixture with:  bash tiles/solaris/golden-reset.sh
#   (or: python3 tiles/solaris/drive.py tiles/solaris/qmp.sock loadvm golden)
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_GOLDEN_DISK=solariscde-golden.qcow2
SH_GOLDEN_MANIFEST=tiles/solaris/golden.json
# Fixture (RETRONET ICQ, 2026-08-20): Solaris 10 CDE desktop with a dtterm titled
# "ICQ" running climm (the OSCAR client), auto-logged-in as UIN 30000 to the
# retronet gateway 10.99.0.2:5190 over the vmbr-rn tap, HiveBot (10000) in its
# contact list. Screen never blanks (X screensaver 0 + DPMS disabled + dtsession
# saver/lock/cycle 0); front-panel Clock removed, perf-meter killed. On wake
# climm's keepalive drops the stale golden socket and it reconnects, so the bot
# re-greets. See golden.env / golden.json / docs/lab/retronet/ICQ-STATION-solaris.md.
SH_WARPD_ADDR=10.99.0.14:7777
# Native hardware-input socket. The manifest emits the unified
# SH_INPUT_BACKEND=gallery-hid selection; the warpd agent is rollback/exec only
# (now reached over the bridge at the guest IP, not a slirp hostfwd).
SH_GHID_SOCKET=/data/vms/streamhost/stations/solaris/gallery-hid.sock
