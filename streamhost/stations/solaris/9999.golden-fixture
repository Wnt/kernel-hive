#!/bin/sh
# solaris GOLDEN FIXTURE (sourced by /usr/dt/bin/Xsession via Xsession.d).
# Makes each CDE login animation-free and opens the retronet ICQ surface:
# Pidgin 2.10.4 (the GTK2 desktop client Oracle ships in the base install as
# SUNWgnome-im-client), auto-signed-in as UIN 30000 to the gateway
# (10.99.0.2:5190) from /.purple/accounts.xml, showing the whole fleet in its
# Buddy List — downloaded from the server-side SSI/feedbag roster, no local
# adds. libpurple's always-compiled-in `autorecon` core plugin reconnects on
# wake, so it recovers with no host-side nudge. See ICQ-STATION-solaris.md.
#
# Window placement is NOT set here: Pidgin restores the Buddy List geometry
# from /.purple/prefs.xml (/pidgin/blist x=1470 y=90 380x560 — right-docked on
# the 1920x1200 CDE desktop, clear of the front panel), which is baked into the
# golden's disk. A -geometry flag would not survive Pidgin's own save-on-exit.
#
# This replaced the climm dtterm on 2026-08-22. climm 0.6.4 and /.climm/ are
# LEFT INSTALLED on the disk: rollback is this one file plus /.purple, and the
# climm binary + its SSI patch stay put as the documented fallback.
# Backgrounded so it never blocks login.
(
  sleep 14
  /usr/openwin/bin/xset s off
  /usr/openwin/bin/xset s noblank
  /usr/openwin/bin/xset -dpms
  /usr/bin/pkill -x sdtperfmeter
  /usr/bin/pkill dtperfmeter
  /usr/bin/pkill dtclock
  /usr/bin/pkill dtfile
  /usr/bin/pkill dthelpview
  sleep 1
  /usr/bin/pidgin &
) &
