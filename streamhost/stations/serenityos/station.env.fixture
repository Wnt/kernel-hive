
# --- GOLDEN TEST FIXTURE (serenityos) ---------------------------------------
# Curated golden fixture baked into the golden raw disk. See GOLDEN.md.
GOLDEN_RESET_MODE=restart
# reset = re-run the launcher: it kills by pidfile and recreates a FRESH qcow2
# overlay over the read-only golden raw, so every boot is byte-identical.
GOLDEN_RESET_CMD=bash /data/vms/streamhost/stations/serenityos/qemu-streamhost.sh
GOLDEN_DISK=/data/gallery-guests/SerenityOS/_disk_image
GOLDEN_FIXTURE=SerenityOS desktop; autostarted focused Terminal (anon@courage) with clean prompt and steady non-blinking block cursor; resource-graph applets removed; taskbar clock date-only; idle screen 100 percent static.
