# ---- CHECKPOINT FIXTURE (QEMU station, resetMode=loadvm) ----
# The scene is the OpenWindows 3 desktop on SunOS 4.1.4, logged in as the
# UNPRIVILEGED `guest` user (csh prompt `sunos414%`, File Manager on
# /export/home/guest): the cmdtool console, a File Manager, and the
# "Introducing Your Sun Desktop" Help Viewer over the cg3 framebuffer at
# 1024x768x8. Baked 2026-08-18 with savevm into the station-local
# sunos414-golden.qcow2 (the CD stays attached with the same ISO so the device
# set is loadvm-exact). loadvm restores the logged-in desktop; the guest starts
# frozen (-S) until the first visitor.
#
# The desktop only reaches working keyboard+mouse when OpenWindows owns the
# console tty, so guest logs in ON THE CONSOLE (getty -> login -> ~/.login ->
# gallery-session) and xnews runs with TT=console. ~/.Xdefaults also sets
# OpenWindows.SetInput: select (click-to-focus) so the KEYBOARD reaches a window
# with the pointer anywhere (the default followmouse reads as a dead keyboard).
# That logged-in state is what the golden captures, so no cold boot at runtime.
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_GOLDEN_DISK=sunos414-golden.qcow2

# ---- POINTER: RELATIVE SUN SERIAL MOUSE ----
# The SS-5 has no absolute pointer path (Sun serial mouse), so the daemon runs
# its abs->rel bridge. Scale 1.0 until measured against the desktop.
SH_INPUT_BACKEND=dbus-rel
SH_CURSOR_SCALE=1.0

# ---- IDLE AUTO-PAUSE: ON ----
# sparc runs under TCG only, so an idle station burns a host core for nobody.
# The launcher starts the guest PAUSED at the checkpoint (-loadvm golden -S),
# so an unvisited station never runs a guest instruction. Warmup 0: no boot to
# protect. Rollback: SH_IDLE_PAUSE_SECS=0.
SH_IDLE_PAUSE_SECS=60
