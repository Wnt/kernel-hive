# ---- CHECKPOINT FIXTURE (QEMU station, resetMode=loadvm) ----
# The scene is the OpenWindows 3 desktop on SunOS 4.1.4, logged in as the
# UNPRIVILEGED `guest` user (csh prompt `sunos414%`, File Manager on
# /export/home/guest): the cmdtool console, a File Manager, and the
# "Introducing Your Sun Desktop" Help Viewer over the cg3 framebuffer at
# 1024x768x8. Baked 2026-08-18 with savevm into the station-local
# sunos414-golden.qcow2 (the CD stays attached with the same ISO so the device
# set is loadvm-exact). loadvm restores the logged-in desktop; the guest starts
# frozen (-S) until the first visitor.
#
# The desktop only reaches working keyboard+mouse when OpenWindows owns the
# console tty, so guest logs in ON THE CONSOLE (getty -> login -> ~/.login ->
# gallery-session) and xnews runs with TT=console. ~/.Xdefaults also sets
# OpenWindows.SetInput: select (click-to-focus) so the KEYBOARD reaches a window
# with the pointer anywhere (the default followmouse reads as a dead keyboard).
# That logged-in state is what the golden captures, so no cold boot at runtime.
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_GOLDEN_DISK=sunos414-golden.qcow2

# ---- POINTER: ABSOLUTE THROUGH THE GUEST'S OWN X SERVER ----
# The SS-5 has no absolute input device and cg3 has no hardware cursor, so there
# is neither a tablet to read nor a register to close a loop on. What there IS:
# xnews runs `-noauth` and listens on TCP :6000, and the launcher publishes it on
# a loopback-only SLIRP forward (127.0.0.1:6047 -> 10.0.2.15:6000). The daemon
# then drives XWarpPointer (actuator) and XQueryPointer (sensor), so `absolute`
# here is EARNED BY READING THE GUEST'S OWN ANSWER BACK, not asserted by a device.
#
# This server has NO XTEST extension (ListExtensions: MIT-SHM, Multi-Buffering,
# SHAPE, SUN_ALLPLANES, SUN_DGA, SunWindowGrabber, XInputDeviceEvents), so
# buttons and keys cannot be injected through X and keep riding the QEMU D-Bus
# PS/2 path. Two channels with independent latency is exactly the hazard that
# turns a click into a DRAG, so the sink CONFIRMS each warp with XQueryPointer
# before an edge is allowed through -- a verified restate, not a sequenced one.
#
# CAVEAT, and it is sharper than a fallback: this channel exists only while the
# guest's X server does. At the console, during boot, at a login prompt or after
# X restarts, the sink reports BackendDown -- and the move is DROPPED, not
# rerouted. apply_move_abs returns as soon as a router exists, so the D-Bus
# relative path is never reached on this station and the pointer simply stops
# until X is back. Loud (BackendDown, counted), but not degraded-and-working.
#
# SH_CURSOR_SCALE/OFF_X/OFF_Y are INERT under this backend (the warp carries
# guest pixels), and are left at identity.
SH_INPUT_BACKEND=x11warp
SH_X11WARP_DISPLAY=127.0.0.1:47
SH_CURSOR_SCALE=1.0

# Pointer telemetry, all off. SH_X11WARP_TRACE logs every warp + readback pair;
# turn it on only while debugging and turn it off again.
SH_X11WARP_TRACE=off

# Where the launcher's check drops a marker if it had to REPAIR the X access
# state instead of finding it in the checkpoint. The daemon reads it and reports
# `golden-state=baked|REPAIRED-AT-RUNTIME` in STAT, so the transitional state is
# QUERYABLE and not merely a line in x11warp-bootstrap.log -- a station repaired
# on every restore has a working pointer and therefore hides indefinitely.
SH_X11WARP_REPAIR_MARKER=/data/vms/streamhost/stations/sunos414/x11warp-repaired

# ---- IDLE AUTO-PAUSE: ON ----
# sparc runs under TCG only, so an idle station burns a host core for nobody.
# The launcher starts the guest PAUSED at the checkpoint (-loadvm golden -S),
# so an unvisited station never runs a guest instruction. Warmup 0: no boot to
# protect. Rollback: SH_IDLE_PAUSE_SECS=0.
SH_IDLE_PAUSE_SECS=60
