# ---- INSTALL PHASE FIXTURE (dark launch, no golden yet) ----
# The station currently shows SunOS 4.1.4 being installed (suninstall from the
# sun4m install CD) on qemu-system-sparc (SS-5, TCG). The install disk is
# mutated in place. Once SunOS is installed and OpenWindows autostarts at the
# console, bake `golden` with savevm and switch these to loadvm — the launcher
# already prefers -loadvm golden -S when the snapshot exists.
SH_RESET_MODE=restart
SH_FIXTURE_DESC=INSTALL PHASE: SunOS 4.1.4 suninstall on the cg3 framebuffer (SPARCstation 5 under TCG); no golden yet, reset only re-runs the launcher when QEMU is not live.

# ---- POINTER: RELATIVE SUN SERIAL MOUSE ----
# The SS-5 has no absolute pointer path, so the daemon runs its abs->rel
# bridge. Guest units-to-pixels gain is UNMEASURED; 1.0 is a placeholder until
# the OpenWindows desktop exists to measure against (hpuxvue's 2x was X
# acceleration, fixed with `xset m 1 1`; expect the same here).
SH_INPUT_BACKEND=dbus-rel
SH_CURSOR_SCALE=1.0

# ---- IDLE AUTO-PAUSE: OFF during the install ----
# A paused guest is a paused installer. Turn on (60) once the golden exists —
# the launcher then starts the TCG guest frozen at the checkpoint anyway.
SH_IDLE_PAUSE_SECS=0
