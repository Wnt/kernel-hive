# Native PAL Spectravideo SV-328; offline keyboard exhibit.
SH_RESET_MODE=relaunch
SH_FIXTURE_DESC=Spectravideo CP/M-80 version 2.24 for SV-605B, A> on the SV-806 80-column display.
MAME_NATIVE_BIN=/data/vms/streamhost/assets/svi328cpm/mame-native/svi328
MAME_NATIVE_DRIVER=svi328
MAME_NATIVE_ROMS=/data/vms/streamhost/assets/svi328cpm/mame-native/roms
MAME_NATIVE_GEOM=1024x768
MAME_NATIVE_SKIP_WARNINGS=0
MAME_NATIVE_CHECKPOINT=0
MAME_NATIVE_ARGS=-bios v111 -exp sv601 -exp:sv601:6 sv801 -exp:sv601:0 sv806 -numscreens 1 -view0 "Screen 0" -flop1 /data/vms/streamhost/stations/svi328cpm/session.imd
MAME_NATIVE_DISK_TEMPLATE=/data/vms/streamhost/assets/svi328cpm/media/hive-cpm.imd:session.imd
SH_MAMECTL_SOCK=/data/vms/streamhost/stations/svi328cpm/ctl.sock
SH_MAMESOCK_KEYMAP=/data/vms/streamhost/stations/svi328cpm/svi328cpm.keymap
SH_AUDIO_SOURCE=fifo
SH_AUDIO_FIFO=/data/vms/streamhost/stations/svi328cpm/audio.fifo
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/svi328cpm/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/svi328cpm/mame-native
# Standby on the finished scene, in EMULATED seconds (2026-10-04): a cold boot
# reaches A> at 4.3 s every time (ctlsock PING, two boots), however loaded
# the box is; a Restore reports done once this freeze has landed
# (scene.state, stations/mame-native/x11-runtime.sh). docs/TYPE-IN-EDITOR.md
# "Typing right after a Restore".
MAME_NATIVE_STANDBY_DELAY_S=7
MAME_NATIVE_STANDBY_CLOCK=emulated
SH_KEY_MIN_HOLD_MS=100
SH_KEY_MIN_GAP_MS=100
MAME_CTL_KEY_EXCL=:KEY
# ---- MODIFIER LEAD (2026-10-04) ----
# typeText() and a visitor's browser send Shift and the key back to back, and
# the ctlsock module used to apply both in ONE drain pass, so a keyboard scan
# that straddles that instant can read the key without its Shift (sinclairql
# lost every shifted character, oricatmos about one in 300). The launcher
# hands this to the module as MAME_CTL_KEY_MOD_LEAD: a non-modifier press waits
# this many EMULATED ms after the last Shift/Ctrl edge. This machine lost no
# shifted character on the old engine (its demo and a 10-line MBASIC stress
# listing, 2026-10-04).
# 10 ms is five times the largest threshold measured on a MAME machine (between
# 1 and 2 ms on both the QL and the Oric), at most 10 ms more per shifted
# character; the demo's perCharMs 500 covers it. Needs a binary built with the knob (an older one ignores it).
# docs/TYPE-IN-EDITOR.md "Shifted characters".
SH_KEY_MOD_LEAD_MS=10
