# ---- CHECKPOINT FIXTURE (QEMU station, resetMode=loadvm) ----
# The scene is a quiet Mac OS 9.2.2 Finder desktop at 1024x768, millions of
# colors: Macintosh HD top-right, Trash bottom-right, no window open, nothing
# selected. Platinum appearance, default Mac OS 9 purple backdrop. Energy Saver
# sleep is pinned to Never (a slept guest is a black exhibit), the Setup
# Assistant was quit and does not return, and the first-boot state is baked in.
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_FIXTURE_DESC=Quiet Mac OS 9.2.2 Finder desktop at 1024x768 (PowerPC G4 mac99 under TCG): Macintosh HD top-right, empty Trash bottom-right, no window open, nothing selected.

# ---- POINTER: RELATIVE USB HID, and why the scale is not 1.0 ----
# No absolute path exists in this guest: Mac OS 9 has no driver for QEMU's
# usb-tablet (abs events proven inert on the framebuffer), so the daemon runs
# its abs->rel bridge. Every Mouse tracking setting except the slowest is an
# acceleration curve under which 1:1 is unreachable; the checkpoint pins
# "Very Slow", which is DEAD LINEAR at a measured 0.18 px per delta unit
# (600 units -> 108 px, identical at every send chunk size 1..32).
# SH_CURSOR_SCALE is that factor's reciprocal.
SH_INPUT_BACKEND=dbus-rel
SH_CURSOR_SCALE=5.5556
# ---- RE-HOME BRIDGE (rel_bridge.rs) ----
# Re-home on exactly one event: a loadvm restore teleports the guest cursor to
# the checkpoint position behind the model's back (reset-tile.sh -> SIGUSR2).
SH_REL_HOME_ON=reset
# The guest cursor's baked position in the golden checkpoint (arrow-tip
# hotspot): dead-centre of the 1024x768 desktop.
SH_REL_HOME_TO=512,384

# ---- IDLE AUTO-PAUSE: ON from day one ----
# ppc runs under TCG - no KVM path - so an idle station burns a real host core
# for nobody. Plain QEMU station: the daemon's default QMP stop/cont applies.
# The launcher additionally starts PAUSED at the checkpoint (-loadvm golden -S).
SH_IDLE_PAUSE_SECS=60
