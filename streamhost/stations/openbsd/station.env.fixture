
# ---- GOLDEN FIXTURE ----
# resetMode=loadvm: the 'golden' vmstate lives in disk.qcow2, the station's only
# block device (OpenBSD 7.9 FFS2 root, whole-disk auto layout), so the restore
# brings back BOTH RAM and the filesystem.
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_GOLDEN_STATE_DISK=/data/vms/streamhost/stations/openbsd/disk.qcow2
SH_FIXTURE_DESC=OpenBSD 7.9 fvwm desktop (Xorg vesa 1024x768x24 on the bochs stdvga): root xterm top-left, xclock and xeyes top-right, xcalc bottom-right; click the desktop for the fvwm applications menu. Screen saver and DPMS off (xset). Absolute pointer via usb-tablet, AC97 audio.

# ---- KEYBOARD PACING ----
# Fleet floor for QEMU keyboard stations (ADD-NEW-OS-PLAYBOOK §0): 40/40.
SH_KEY_MIN_HOLD_MS=40
SH_KEY_MIN_GAP_MS=40

# ---- POINTER: ABSOLUTE usb-tablet -> ums0 -> wsmouse0 -> xf86-input-ws ----
# TODO(golden): calibration measured on the bake (MinX/MaxX InputClass if the ws
# driver treats the 0..32767 tablet range as raw pixels — smoke rig 2026-09-03).
SH_CURSOR_SCALE=1.0
SH_CURSOR_OFF_X=0
SH_CURSOR_OFF_Y=0
