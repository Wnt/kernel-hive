
# ---- GOLDEN FIXTURE ----
# resetMode=loadvm: the 'golden' vmstate lives in disk.qcow2, the station's only
# block device (OpenBSD 7.9 FFS2 root, whole-disk auto layout), so the restore
# brings back BOTH RAM and the filesystem.
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_GOLDEN_STATE_DISK=/data/vms/streamhost/stations/openbsd/disk.qcow2
SH_FIXTURE_DESC=OpenBSD 7.9 fvwm desktop (Xorg vesa 1024x768x24 on the bochs stdvga): root xterm top-left, xclock and xeyes top-right, xcalc bottom-right; click the desktop for the fvwm applications menu. Screen saver and DPMS off (xset). Absolute pointer via usb-tablet, AC97 audio.

# ---- KEYBOARD PACING ----
# OPEN (2026-09-03 bake): under X, keys typed over QMP input-send-event at 40/40
# AND at 200/200 arrive only partially (a,b,f of "abcdef") and a lost release
# leaves the last key autorepeating; the text console types cleanly, and a
# usb-kbd clone showed the same loss, so it is in the guest (wskbd raw mode / X
# kbd driver), not the emulated controller. Not yet reproduced through the
# daemon's own D-Bus key path. Pace conservatively until measured.
SH_KEY_MIN_HOLD_MS=100
SH_KEY_MIN_GAP_MS=100

# ---- POINTER: ABSOLUTE usb-tablet -> ums0 -> wsmouse1 -> /dev/wsmouse mux -> xf86-input-ws ----
# Measured on the bake (2026-09-03): with /etc/X11/xorg.conf.d/10-kh-tablet.conf
# (Ignore /dev/wsmouse[0-9]*, MinX/MaxX/MinY/MaxY 0..32767 on the mux) a QMP abs
# 16383,16383 lands on the exact centre pixel and 4096,24575 / 28000,4000 post the
# fvwm menu under the arrow. 1:1, hotspot (0,0). NOTE: HMP `mouse_move` is
# RELATIVE and goes to the PS/2 mouse — probe the tablet only with input-send-event.
SH_CURSOR_SCALE=1.0
SH_CURSOR_OFF_X=0
SH_CURSOR_OFF_Y=0
