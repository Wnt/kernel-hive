# SH_MAMESOCK_KEYMAP for any FS-UAE station driven through the fork's
# mamectl/1 ctlsock (FSUAE_NATIVE_CTL_SOCK).
#
# Format is the daemon's: <XT scancode hex><TAB><port><TAB><field>, parsed by
# streamhost/streamhost/src/mame_input.rs KeyMap::load. Unlike a MAME station's
# map this one is NOT generated from a KEYDUMP: FS-UAE takes an Amiga RAW
# KEYCODE straight into inputdevice_do_keyboard(), and the Amiga keyboard
# matrix is fixed by the hardware, so the table is static. Port is always
# `amiga`; the field is the raw code the ctlsock parses with strtol(.., 0).
#
# Left column: browser/XT set-1 scancode as the daemon's input router emits it.
# Right column: Amiga raw key code (Amiga Hardware Reference Manual, appendix F).
#
# UNPROVEN as of this commit: only the socket wire and the pointer verbs were
# framebuffer-proven on the a3000 rig. Typing has NOT been proven end to end;
# treat every row below as derived-from-the-manual, not measured.
0x01	amiga	0x45	# Esc
0x02	amiga	0x01	# 1
0x03	amiga	0x02	# 2
0x04	amiga	0x03	# 3
0x05	amiga	0x04	# 4
0x06	amiga	0x05	# 5
0x07	amiga	0x06	# 6
0x08	amiga	0x07	# 7
0x09	amiga	0x08	# 8
0x0a	amiga	0x09	# 9
0x0b	amiga	0x0a	# 0
0x0c	amiga	0x0b	# - _
0x0d	amiga	0x0c	# = +
0x0e	amiga	0x41	# Backspace
0x0f	amiga	0x42	# Tab
0x10	amiga	0x10	# q
0x11	amiga	0x11	# w
0x12	amiga	0x12	# e
0x13	amiga	0x13	# r
0x14	amiga	0x14	# t
0x15	amiga	0x15	# y
0x16	amiga	0x16	# u
0x17	amiga	0x17	# i
0x18	amiga	0x18	# o
0x19	amiga	0x19	# p
0x1a	amiga	0x1a	# [ {
0x1b	amiga	0x1b	# ] }
0x1c	amiga	0x44	# Return
0x1d	amiga	0x63	# Left Ctrl
0x1e	amiga	0x20	# a
0x1f	amiga	0x21	# s
0x20	amiga	0x22	# d
0x21	amiga	0x23	# f
0x22	amiga	0x24	# g
0x23	amiga	0x25	# h
0x24	amiga	0x26	# j
0x25	amiga	0x27	# k
0x26	amiga	0x28	# l
0x27	amiga	0x29	# ; :
0x28	amiga	0x2a	# ' "
0x29	amiga	0x00	# ` ~
0x2a	amiga	0x60	# Left Shift
0x2b	amiga	0x0d	# \ |
0x2c	amiga	0x31	# z
0x2d	amiga	0x32	# x
0x2e	amiga	0x33	# c
0x2f	amiga	0x34	# v
0x30	amiga	0x35	# b
0x31	amiga	0x36	# n
0x32	amiga	0x37	# m
0x33	amiga	0x38	# , <
0x34	amiga	0x39	# . >
0x35	amiga	0x3a	# / ?
0x36	amiga	0x61	# Right Shift
0x37	amiga	0x5d	# Keypad *
0x38	amiga	0x64	# Left Alt
0x39	amiga	0x40	# Space
0x3a	amiga	0x62	# Caps Lock
0x3b	amiga	0x50	# F1
0x3c	amiga	0x51	# F2
0x3d	amiga	0x52	# F3
0x3e	amiga	0x53	# F4
0x3f	amiga	0x54	# F5
0x40	amiga	0x55	# F6
0x41	amiga	0x56	# F7
0x42	amiga	0x57	# F8
0x43	amiga	0x58	# F9
0x44	amiga	0x59	# F10
0x47	amiga	0x3d	# Keypad 7
0x48	amiga	0x3e	# Keypad 8
0x49	amiga	0x3f	# Keypad 9
0x4a	amiga	0x4a	# Keypad -
0x4b	amiga	0x2d	# Keypad 4
0x4c	amiga	0x2e	# Keypad 5
0x4d	amiga	0x2f	# Keypad 6
0x4e	amiga	0x5e	# Keypad +
0x4f	amiga	0x1d	# Keypad 1
0x50	amiga	0x1e	# Keypad 2
0x51	amiga	0x1f	# Keypad 3
0x52	amiga	0x0f	# Keypad 0
0x53	amiga	0x3c	# Keypad .
0x9c	amiga	0x43	# Keypad Enter
0x9d	amiga	0x63	# Right Ctrl -> Ctrl
0xb5	amiga	0x5c	# Keypad /
0xb8	amiga	0x65	# Right Alt
0xc7	amiga	0x5f	# Home -> Help
0xc8	amiga	0x4c	# Up
0xcb	amiga	0x4f	# Left
0xcd	amiga	0x4e	# Right
0xd0	amiga	0x4d	# Down
0xd3	amiga	0x46	# Delete
0xdb	amiga	0x66	# Left Meta -> Left Amiga
0xdc	amiga	0x67	# Right Meta -> Right Amiga
