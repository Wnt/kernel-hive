# ---- GOLDEN FIXTURE (bridge tile) ----
# resetMode=loadvm -> restore the INTERNAL 'golden' snapshot: the bare-X kiosk
# with Dwarf/Draco already at the LOGGED-IN ViewPoint 2.0.5 desktop. Logon runs
# exactly once, at bake time. A visitor never meets the logged-off bouncing
# keyboard, never has to discover that Ctrl+N is the Xerox NEXT key, and never
# sees the "the Clearinghouse is down" temporary-desktop dialogue.
#
# The bake also carries the two focus acts the kiosk performs at cold boot (X
# input focus on the Dwarf frame, one synthetic click inside the Mesa screen).
# Without BOTH, Swing never receives a key and every keystroke is silently
# dropped — the failure that was first misread as an "MP 8000 hang".
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_FIXTURE_DESC=Xerox 6085 "Daybreak" (Mesa processor) at the logged-in ViewPoint 2.0.5 desktop, emulated by Dwarf/Draco on OpenJDK 17 inside a captured Debian 12 bare-X kiosk. 1152x861 black-and-white Pilot screen inside Dwarf's 1152x913 frame, filling a custom 1152x914 X root edge to edge. The desk is the ViewPoint 50%-dither grey; the message area reads "91198 Free Disk Pages"; a single Directory icon sits bottom-right and is the exhibit's launcher. Product factoring on this disk is unlocked but BOUND to processor id 10-00-FE-31-AB-21 — changing it re-locks every ViewPoint application. Silent exhibit: Dwarf emulates no Xerox sound hardware.

# cold-boot: never QMP-freeze the kiosk out from under the watcher
SH_IDLE_PAUSE_SECS=0

# ---- KEYBOARD PACING ----
# Measured on this tile, and NOT the usual two-frame rule: Dwarf is a Java/Swing
# app that coalesces input rather than sampling once per emulated frame, so what
# matters is the HOLD. A zero-length send-key chord (press+release in one QMP
# event) lands nothing at all; 400 ms hold with a 150 ms gap landed 5/5 typed
# characters and actuated Ctrl+N first try. Mouse clicks need the same dwell.
SH_KEY_MIN_HOLD_MS=400
SH_KEY_MIN_GAP_MS=150
# No SH_KEY_MAP: the guest X layout is US and the tile ships its own Dwarf
# keyboard map (keyboard-maps/kbd_linux_en_US.map, written by
# scripts/build-guests/tiles/daybreak.sh). Dwarf ships ONLY a German map, and a
# loaded map has no defaults — every key absent from it is dead.
