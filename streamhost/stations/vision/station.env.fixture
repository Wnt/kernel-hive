# ---- GOLDEN FIXTURE (host-native PCE, x11 runtime shape, sandboxed) ----
# resetMode=relaunch -> `systemctl restart streamhost@vision`, whose ExecStartPre
# re-runs x11-runtime.sh: it kills the container, copies hd0.pbi + VOAPP1.psi +
# VOAPP2.psi fresh from assets/vision/disk and cold-boots the IBM 5160 again.
# PCE's ibmpc has NO save state, so there is no checkpoint to recapture — the
# pristine disk set IS the golden, and the launcher + pce.cfg + that disk set are
# ONE combination (rule 6). VOAPP1 is the copy-protection key disk: Visi On
# refuses to start unless it is in A:, so it is copied every launch too.
# Boot to the C:\> prompt is a few seconds at the emulated 4.77 MHz; vision-inner.sh
# waits for the screen to SETTLE (not a fixed sleep) and then types VISION.
SH_RESET_MODE=relaunch
SH_FIXTURE_DESC=IBM PC XT 5160 (Intel 8088 at 4.77 MHz, 640 KB, CGA, 10 MB fixed disk, Mouse Systems serial mouse on COM1) running VisiCorp Visi On 1.0 on PC-DOS 2.00, emulated by PCE host-native inside a systemd-nspawn sandbox, under a pinned 1280x800 Xvfb whose root IS the PCE window (CGA 640x200 at scale 2 with PCE's 4/3 aspect correction is exactly 1280x800). Desktop at rest: the stippled Visi On desktop with the Services window open on Archives, its start/install/remove/Printing menu line, and the command strip along the bottom - HELP CLOSE OPEN FULL FRAME OPTIONS TRANSFER STOP.

# ---- EMULATOR (read by x11-runtime.sh, not by the daemon) ----
VISION_ASSETS=/data/vms/streamhost/assets/vision
VISION_GEOM=1280x800
VISION_AUTOSTART=1
VISION_UID_BASE=2162688
VISION_STANDBY_DELAY_S=120

# ---- POINTER/KEY INPUT (x11test) ----
# Motion is XTEST into the sandboxed display, and it is 1:1 ABSOLUTE: five
# targets, two laps, 0 px error on all ten (docs/lab/VISION-WAVE.md §Pointer).
# PCE's x11 terminal converts host pointer movement into Mouse Systems packets on
# the emulated 8250, and THREE things have to be true for that to be absolute:
#   1. patches/vision/pce-x11-nograb.patch — stock PCE forwards motion only while
#      it holds an X pointer grab, which a headless Xvfb station cannot hold;
#   2. patches/vision/pce-msys-sync-alias.patch — a dx of -127..-121 (or a wire dy
#      of 121..127) is byte-identical to the protocol's own sync byte 0x80..0x87
#      and Visi On drops the packet, so large LEFTWARD moves used to vanish and
#      the arrow ratcheted into the right edge and wedged there;
#   3. vision-inner.sh's home_pointer() — Visi On owns its own cursor and sees
#      only DELTAS, so guest and host pointer keep a constant offset (measured
#      (0,+40) px) that no delta can remove. One corner slam, (w-1,h-1) then
#      (0,0), clamps them together at (0,0) and zeros it for the session.
# pce.cfg's mouse_div_x=2 / mouse_div_y=4 cancels PCE's own fx=2/fy=4 aspect fit,
# giving scale 1.000 px per XTEST px on both axes.
SH_X11TEST_ABS=1
SH_X11TEST_BUTTONS=xtest
SH_X11TEST_KEYS=1
SH_BTN_MIN_HOLD_MS=150
# 120/120 is the pacing xdotool typed cleanly at on the race rig; it is NOT a
# measured floor - nobody has bisected downward (docs/lab/VISION-WAVE.md §Keyboard).
SH_KEY_MIN_HOLD_MS=120
SH_KEY_MIN_GAP_MS=120

# ---- STANDBY ----
# Without a pidfile the daemon cannot pause a non-QEMU station; the proc match is
# scoped to this station's own asset path, so it can never match another station's
# PCE (or a race rig's).
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/vision/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=/opt/pce/bin/pce-ibmpc
SH_IDLE_PAUSE_WARMUP_SECS=180
