
# ---- CHECKPOINT FIXTURE (QEMU station, resetMode=loadvm) ----
# ETH Oberon System 3 / PC Native 2.3.6 Gadgets desktop at 1280x1024x8: the
# System.Log viewer (top right, "ETH Oberon System 3 / PC Native 2.3.6 (13 May
# 1999)") over the System.Tool viewer (bottom right), the user track on the
# left empty grey, arrow pointer parked at (640,512). Boots in 3.3 s under KVM.
# Restore proof + bake facts: docs/lab/OBERON-WAVE.md §Proofs.
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_FIXTURE_DESC="ETH Oberon System 3 / PC Native 2.3.6 Gadgets desktop at 1280x1024: System.Log over System.Tool in the right track, empty user track, pointer at (640,512)"

# ---- POINTER: RELATIVE PS/2 (measured 2026-09-13 on the smoke rig) ----
# Native Oberon's PS/2 mouse driver takes deltas only (no absolute path of any
# kind on this guest: no USB, no vmmouse), so the daemon runs its abs->rel
# bridge. Measured on the framebuffer with QMP input-send-event rel + diff:
# EXACTLY 1.5 px per unit on both axes, no acceleration (100 -> 150, 50 -> 75,
# 30 -> 45, 200 -> 298, 300 -> 449 px: the guest truncates x1.5 per PS/2
# report, so an EVEN step lands on an integer pixel). SH_CURSOR_SCALE is the
# reciprocal; SH_REL_MAX_STEP=126 keeps every send one even int8 report.
SH_INPUT_BACKEND=dbus-rel
SH_CURSOR_SCALE=0.6667
SH_REL_MAX_STEP=126
SH_REL_QUANTUM=0
# Re-home on a golden restore: the arrow sprite's origin is (640,512) in the
# golden frame, hotspot (0,0) (Oberon's arrow points up-left from its corner).
SH_REL_HOME_ON=reset
SH_REL_HOME_TO=640,512

# ---- KEYBOARD ----
# QMP key events reach the PS/2 keyboard; typed text lands at the caret (set
# by a LEFT click in a text viewer). Fleet floor pacing; "Kernel Hive types
# here" landed in System.Log on the smoke rig (docs/lab/OBERON-WAVE.md).
SH_KEY_PRESS_MS=40
SH_KEY_GAP_MS=40
