
# ---- CHECKPOINT FIXTURE (QEMU station, resetMode=loadvm) ----
# ETH Oberon System 3 / PC Native 2.3.6 Gadgets desktop at 1280x1024x8: the
# System.Log viewer (top right, "ETH Oberon System 3 / PC Native 2.3.6 (13 May
# 1999)") over the System.Tool viewer (bottom right), the user track on the
# left empty grey, arrow pointer parked at (600,510). RE-BAKED 2026-09-13 under
# /opt/qemu-oberon (the kh-ramabs build -- binary and golden are one unit):
# savevm 0.152 s / 3.54 MiB vmstate.
# Restore proof + bake facts: docs/lab/OBERON-WAVE.md §Proofs.
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_FIXTURE_DESC="ETH Oberon System 3 / PC Native 2.3.6 Gadgets desktop at 1280x1024: System.Log over System.Tool in the right track, empty user track, pointer at (600,510)"

# ---- QEMU BINARY: the kh-ramabs build (BINARY AND GOLDEN ARE ONE UNIT) ----
# The golden is baked under this binary and the pointer address below is bound
# to that golden. /opt/qemu-oberon is fork c5449c80 + the `point32le_yx` and
# `point16le_yup*` layouts added to the shared kh-ramabs device patch (0007).
# It is this station's OWN build on purpose: /opt/qemu-beos carries beos' and
# pcgeos' goldens, and a per-station binary has a blast radius of one station.
OBERON_QEMU=/opt/qemu-oberon/bin/qemu-system-x86_64

# ---- POINTER: ABSOLUTE BY WRITING OBERON'S OWN COORDINATE (2026-09-13) ----
# Native Oberon reads a plain PS/2 mouse -- no USB, no vmmouse, no hardware
# cursor on -vga std -- but its Input module keeps the pointer as TWO LONGINTs
# at KH_RAMABS_ADDR in the order (y, x), y counted UP from the bottom of the
# screen. That is layout `point32le_yx`: transposed AND flipped relative to
# every other ramabs guest. kh-ramabs writes the commanded pixel there and
# injects ONE 1-unit PS/2 nudge to make Oberon republish it.
#
# THE NUDGE MUST STAY BELOW OBERON'S ACCELERATION THRESHOLD. Measured on the
# golden: 1,2,3,4 units move exactly 1,2,3,4 px; 6 units and up move 1.5 px per
# unit. A 2-unit/3-px nudge therefore FAILED the connect probe by 1 px on both
# axes before this was found -- and it is also why the old dead-reckoning
# fixture (SH_CURSOR_SCALE=0.6667) was right only for large steps and drifted
# on small ones.
SH_INPUT_BACKEND=ramabs
SH_RAMABS_SOCK=/data/vms/streamhost/stations/oberon/ptr.sock

# THE ADDRESS IS BOUND TO THE GOLDEN (loadvm restores RAM verbatim). Derived
# 2026-09-13 against the golden baked under /opt/qemu-oberon with
# scripts/dev/oberon-ramabs-derive.py: four words tracked the pointer exactly --
# 0x0011fff8 and 0x00120572 as (x, y-up) int16, 0x0011ffbc as (y-up, x) int16,
# and 0x00140160 as (y, x) int32. Only kh-ramabs' connect-time write probe
# separates the input from the read-only copies, and exactly ONE verified.
# FAIL CLOSED: unset => no device, relative pointer; stale => every write
# refused rather than scribbling on whatever now lives there.
KH_RAMABS_ADDR=0x140160

# SINGLE INJECTOR (binding): while SH_RAMABS_SOCK is connected the device owns
# the guest pointer. No abs->rel bridge, no QMP input-send-event, no labctl
# pointer helper may push motion or a button edge at this mouse.
SH_RAMABS_TRACE=off
PTR_TRACE=off

# Inert under ramabs (absolute targets are written verbatim); kept for a
# one-line rollback to SH_INPUT_BACKEND=dbus-rel, which also needs the
# pre-abs golden and the host pve-qemu binary back (see ROLLBACK.md).
SH_CURSOR_SCALE=0.6667
SH_REL_MAX_STEP=126
SH_REL_QUANTUM=0
SH_REL_HOME_ON=reset
SH_REL_HOME_TO=600,510

# ---- KEYBOARD ----
# QMP key events reach the PS/2 keyboard; typed text lands at the caret (set
# by a LEFT click in a text viewer). Fleet floor pacing; "Opus typed this"
# landed in System.Log clean on the bake rig (docs/lab/OBERON-WAVE.md).
SH_KEY_PRESS_MS=40
SH_KEY_GAP_MS=40
