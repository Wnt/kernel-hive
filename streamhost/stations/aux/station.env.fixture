# ---- CHECKPOINT FIXTURE (QEMU station, resetMode=loadvm) ----
# The scene is the A/UX 3.0.1 desktop at 1152x870x8, logged in as root: a
# CommandShell window top-left showing the "WELCOME TO A/UX" banner, `ls` of /
# and a `localhost.root #` prompt; the Unix root "/" and "MacPartition" as
# volumes top-right; Trash bottom-right. Baked 2026-08-18 with savevm into the
# station-local pair (the vmstate lives in pram-golden.qcow2, as on macos753).
# Device set at bake: A/UX disk at SCSI 0 only — no helper disk, no CD.
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_FIXTURE_DESC=A/UX 3.0.1 desktop (Quadra 800, 68040 under TCG) at 1152x870x8: CommandShell with the WELCOME TO A/UX banner and a root prompt, the Unix root and MacPartition volumes top-right, Trash bottom-right. loadvm restores it framebuffer-identical.

# ---- POINTER: RELATIVE ADB, made EXACT (measured 2026-08-18) ----
# No absolute pointer path on a q800 (no USB, no tablet, no PCI): the daemon
# runs its abs->rel homing bridge. A/UX's Toolbox at Mouse tracking "Very
# Slow" (baked into the checkpoint) moves EXACTLY trunc(0.75 * units) px per
# event for events up to 32 units (measured on both axes and diagonals: 4->3,
# 8->6, 16->12, 32->24, 400 units in 8-unit steps -> 300 px) and ACCELERATES
# above that (64->63, 200->192, 500->442). Two knobs make the bridge land on
# the model every time: chunks are capped at 32 units so no send crosses into
# the accelerated range, and every send is a multiple of 4 units (= 3 px
# exactly, no truncation loss) with the sub-quantum remainder kept pending in
# the model. Residual < 3 px, no drift; corner-pinned on the first sample.
# SH_CURSOR_SCALE is 1/0.75. Re-measure with the rig's mouse_move sweep in
# docs/guests/aux.md if the tracking setting is ever changed.
SH_INPUT_BACKEND=dbus-rel
SH_CURSOR_SCALE=1.3333
SH_REL_MAX_STEP=32
SH_REL_QUANTUM=4
# Open-loop cursor system (docs/lab/research/rel-pointer-rehome-and-rate-cap.md):
# re-home on a golden restore, seeding the model to the cursor's baked position
# (measured (899,649) with scripts/dev/measure-golden-cursor.py) so it snaps under
# the visitor's pointer with no corner pin. Same q800/adb-mouse fork binary as
# macos753 (button-barrier FIFO + 5ms autopoll); QUANTUM/MAX_STEP stay -- they keep
# each send inside one 63-count report AND on the A/UX per-event truncation model.
SH_REL_HOME_ON=reset
SH_REL_HOME_TO=899,649

# ---- IDLE AUTO-PAUSE: ON ----
# m68k is TCG-only; an idle station burns a host core for nobody. Plain QEMU
# station: the daemon's QMP stop/cont path applies; the launcher starts the
# guest PAUSED at the checkpoint (-loadvm golden -S). Rollback: 0.
SH_IDLE_PAUSE_SECS=60
