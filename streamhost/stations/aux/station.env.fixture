# ---- INSTALL PHASE (dark launch) — no checkpoint yet ----
# A/UX 3.0.1 is being installed live on this station: the launcher boots a
# helper System 7.5.3 disk (SCSI 5) with the A/UX install CD at SCSI 3 and the
# 1000M A/UX target at SCSI 6. resetMode=restart re-runs the launcher only when
# QEMU is not live (ensure-station-qemu), so a browser "reset" cannot reboot
# the installer. Switch to loadvm + SH_GOLDEN_SNAPSHOT=golden when the desktop
# is baked.
SH_RESET_MODE=restart

# ---- POINTER: RELATIVE ADB ----
# No absolute pointer path on a q800 (no USB, no tablet): the daemon runs its
# abs->rel bridge. Scale 1.0 UNMEASURED — Mac OS "Very Slow" tracking is 0.36
# px/unit on macos753, and A/UX's X11 layer adds its own acceleration; measure
# against the installed desktop (adb_pointer.py gain) before listing.
SH_INPUT_BACKEND=dbus-rel
SH_CURSOR_SCALE=1.0

# ---- IDLE AUTO-PAUSE: OFF during the install ----
# A paused guest is a paused installer, and an operator who watches for two
# minutes and leaves would freeze it. Set to 60 with the golden (TCG station).
SH_IDLE_PAUSE_SECS=0
