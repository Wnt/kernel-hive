# ---- GOLDEN FIXTURE (x11 runtime tile) ----
# resetMode=relaunch -> kill-by-pidfile + fresh es40; the launcher reflink-
# copies the golden nt.img on EVERY launch AND restores the golden.axp
# savestate baked from that same image (ES40_RESTORE), so a reset lands on the
# pristine desktop ~3 s after exec instead of an ~80 s cold boot. The
# post-restore partial-paint that kept restore off until 2026-08-16 was the
# 8514/A accelerator state missing from the state file (es40 fork a09816d);
# rollback is removing assets/w2kalpha/golden.axp — the launcher cold-boots.
SH_RESET_MODE=relaunch
SH_FIXTURE_DESC=Windows 2000 RC2 (build 2128, Alpha AXP) 1280x1024 desktop in es40 (AlphaServer ES40, EV68); SH_CAPTURE=shm (headless SDL dummy, no X server) + mamesock ctlsock input; relaunch restores the golden checkpoint in ~3 s.

# ---- POINTER/KEY INPUT (SH_* read by the daemon; the socket served by es40) --
# mamesock = the daemon speaks mamectl/1 straight to the ctlsock the es40 fork
# serves (src/gui/ctlsock.h, armed by the launcher via ES40_CTL_SOCK). Keyboard
# is verified end to end (framebuffer proof: Start menu opened headless).
# Pointer is open-loop absolute: the guest still runs default Windows pointer
# acceleration, so clicks are NOT yet pixel-exact — the golden-polish pass
# (guest Mouse control panel -> acceleration None, then re-capture the golden)
# is what makes MOVEA land 1:1. Until then reset.mouse stays UNVERIFIED.
SH_INPUT_BACKEND=mamesock
SH_MAMECTL_SOCK=/data/vms/streamhost/stations/w2kalpha/ctl.sock

# ---- IDLE AUTO-PAUSE (SIGSTOP arm) ----
# ON since 2026-08-11: es40 anchors every guest-visible clock (RPCC, Cchip
# interval timer, TOY/RTC, ACPI PM timer) to host wall clock, so a bare
# SIGSTOP/SIGCONT used to hand the guest the whole pause as a clock jump —
# that is why this stanza was held back at registration. Fork commit fc82f05
# (host_freeze_reanchor) closes it: a wall-clock gap >= 5 s at a cc sync point
# is recognized as a host-side freeze and every clock re-anchors, so the guest
# resumes exactly where it stopped — QMP-stop/cont semantics, proven by a
# scratch-clone SIGSTOP/SIGCONT soak with apps open (incl. one > 20 min to
# cross the ACPI PM-timer wrap). The binary staged as assets/w2kalpha/es40
# must be at or after fc82f05 or every pause is a wedge risk again.
#
# The pidfile name mame.pid is the shared x11-runtime contract name — the pid
# in it is es40's. SH_IDLE_PAUSE_PROC_MATCH is the anti-footgun: the signal is
# only sent while the pid's cmdline still carries the production es40 path, so
# a recycled pid can never be frozen by mistake.
#
# WARMUP covers whatever the launch still has to finish before a freeze is
# safe. With the golden-checkpoint restore that is ~3 s, not the ~80 s cold
# boot the old 120 s was sized for; 30 s keeps a wide margin (and still covers
# a cold-boot fallback's first phase — a mid-boot freeze there is slow, not
# fatal, since the freeze is absorbed on thaw, but if the station is ever
# rolled back to cold boot for good, put this back to 120). Rollback of the
# pause itself is one line: SH_IDLE_PAUSE_SECS=0.
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/w2kalpha/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/w2kalpha/es40
SH_IDLE_PAUSE_WARMUP_SECS=30
