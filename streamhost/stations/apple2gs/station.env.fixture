# ---- HOST-NATIVE STATION (de-bridged from day one — apple2gs wave, 2026-09-13) ----
# MAME 0.289's apple2gs runs ON THE HOST — same engine and same apple/ family as
# the //e sibling apple2e, drawshm frames, ctlsock keys through the generated
# keymap, sound -> SDL disk -> FIFO with the daemon as clock. Launcher: shared
# stations/mame-native/x11-runtime.sh; reset = relaunch restoring the golden
# savestate (apple2gs has MACHINE_SUPPORTS_SAVE).
SH_RESET_MODE=relaunch
SH_FIXTURE_DESC=Apple IIGS (ROM 3) GS/OS System 6.0.1 Finder desktop -- the HARDDISK volume and the Trash on the 640x200 super-hi-res desktop with the Finder's File/Edit/Windows/View/Disk/Special/Colors/Extras menu bar, drawn with aspect correction on the published 1024x768 surface by MAME 0.289's apple2gs running HOST-NATIVE (drawshm). MEASURED 2026-09-13: a pre-installed 32 MB ProDOS volume on the CFFA 2.0 in slot 7 (MAME reads the .2mg's 64-byte header itself -- no dd strip needed), cold boot reaches the Finder desktop in 33.8 s, and the golden savestate restores it to a BYTE-IDENTICAL framebuffer (474700 B, saved in 152 ms). The GS's ADB keyboard and mouse are the macadb HLE on the motherboard, so there is no //e mouse card and no Disk II controller in the device set. Pointer is 1:1 ABSOLUTE since 2026-09-13 (closed loop on the guest's own cursor words at $E1/00E9 -- see the POINTER block).
MAME_NATIVE_BIN=/data/vms/streamhost/assets/apple2gs/mame-native/apple2gs
MAME_NATIVE_DRIVER=apple2gs
MAME_NATIVE_ROMS=/data/vms/streamhost/assets/apple2gs/mame-native/roms
MAME_NATIVE_GEOM=1024x768
MAME_NATIVE_SKIP_WARNINGS=0
MAME_NATIVE_CHECKPOINT=1
MAME_NATIVE_ARGS=-sl7 cffa2 -hard1 /data/vms/streamhost/assets/apple2gs/media/hive.hdv
SH_MAMECTL_SOCK=/data/vms/streamhost/stations/apple2gs/ctl.sock
SH_MAMESOCK_KEYMAP=/data/vms/streamhost/stations/apple2gs/apple2gs.keymap
SH_AUDIO_SOURCE=fifo
SH_AUDIO_FIFO=/data/vms/streamhost/stations/apple2gs/audio.fifo

# ---- STANDBY (instant-ready: an emulator nobody watches costs ~0 CPU) ----
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/apple2gs/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/apple2gs/mame-native
MAME_NATIVE_STANDBY_DELAY_S=8

# ---- KEYBOARD (ADB, HLE via macadb) ----
# The GS's keyboard is the Apple Extended ADB keyboard emulated by MAME's
# macadb HLE device (src/mame/apple/macadb.cpp, ports :macadb:KEY0..KEY7) —
# NOT the //e's own hardware encoder and NOT a CPU-scanned matrix. Fleet floor
# 40/40 ms first; MAME_CTL_KEY_EXCL only if characters drop (docs/lab/APPLE2GS-WAVE.md).
SH_KEY_MIN_HOLD_MS=40
SH_KEY_MIN_GAP_MS=40

# ---- POINTER (ADB mouse, HLE via macadb) — 1:1 ABSOLUTE, closed loop ----
# Tags read from MAME's -listxml and confirmed against src/mame/apple/macadb.cpp
# on the pinned tree: PORT_START("MOUSE0") carries PORT_NAME("Mouse Button 0")/
# ("Mouse Button 1"); MOUSE1/MOUSE2 are the X/Y axes, 8-bit analog fields
# (mask 0xff) exactly like the //e mouse card's a2mse_x/_y — so
# MAME_CTL_PTR_MOD=256, not the module's 65536 SGI default.
#
# MEASURED 2026-09-13 (pointer stream, rig /data/vms/sandbox/apple2gs-ptr/rig1
# restored from the golden; docs/lab/APPLE2GS-WAVE.md §Pointer + §11):
#
#  (a) `ctlsock: setup btns=1 axes=1` is NOT a count. Both numbers are C++
#      bools in the setup printf — (m_btn_field[0] != nullptr) and
#      (m_x_field && m_y_field). btns=1 axes=1 means "button 0 bound AND both
#      axes bound", which is the wanted state. Nothing was ever unbound.
#
#  (b) THE ADB WIRE IS 7-BIT SIGNED. macadb_device::adb_talk() packs the
#      accumulated delta as `m_buffer[1] = (button << 7) | (mouseX & 0x7f)`,
#      so any per-poll delta outside -64..+63 arrives SIGN-FLIPPED at the
#      guest — a step of 100 counts lands as -28 and the arrow walks the
#      wrong way. MAME_CTL_MOVE_STEP=48 is MANDATORY here; the module's
#      inherited default of 120 is always wrong on this machine.
#
#  (c) GAIN: one ADB count is exactly ONE SHR PIXEL. The 640x200 raster is
#      drawn aspect-corrected into published x 47..976 (930 px) and
#      y 53..717 (665 px), so a count is worth 1.4531 published px across and
#      3.325 down. Those are GAIN_X/GAIN_Y — the loop's step sizing only.
#
#  (d) THE CURSOR POSITION IS IN GUEST RAM, AND IT IS AN OUTPUT. $E1/00E9 (X)
#      and $E1/00EB (Y) are 16-bit little-endian GUEST pixels and track the
#      arrow exactly — but POKEing them sticks WITHOUT a redraw, and the next
#      ADB poll republishes them from an accumulator that is in neither banks
#      $00/$01/$E0/$E1 nor the ADB micro's 256 bytes of internal RAM. So the
#      macsys1 absolute-WRITE route (MAME_CTL_ABS_RAM) does NOT work on the
#      GS. The READ loop does.
#
#  (e) THE CLOSED LOOP, and how it addresses guest RAM.
#      mame-ctlsock-ram-cursor.patch (last in this station's patch chain)
#      lets a MAME_CTL_CURSOR_ITEMS entry be `suffix@offset[:width]` — a
#      little-endian integer INSIDE a byte-sized save item. `m_megaii_ram` is
#      size=1 count=131072 covering banks $E0/$E1, so $E1/00E9 is byte
#      0x100E9. MAME_CTL_CAL_SX/SY (new, beside CAL_X/CAL_Y) turn that
#      GUEST-pixel reading into a PUBLISHED one: published = CAL + guest*CAL_S.
#      MOVEA then runs the same closed loop irix runs.
#
#  (f) WHAT IT LANDS. Five targets x two laps, arrow tip located on the
#      framebuffer (median of 9 frames — the GS cursor is XORed in per VBL, so
#      no single frame is evidence): (50,56)->(51,57) | (973,56)->(972,57) |
#      (50,714)->(51,715) | (973,714)->(972,715) | (512,384)->(513,386).
#      WORST |err| = 1 px X, 2 px Y; lap 2 byte-identical to lap 1. The raster
#      is LETTERBOXED, so the fleet's usual corner targets (20,20)/(1000,740)
#      are SHR border no guest cursor can occupy — these five are the
#      reachable set. RESOLUTION BOUND: one count is one guest pixel, so the
#      loop lands on guest-pixel centres — +-0.73 px X, +-1.66 px Y.
#      A click reacts: MOVEA (105,60) + DOWN1 dropped the Finder's File menu
#      (41769 changed pixels), UP1 closed it.
#
#  (g) RAW `MOVE` IS NOT A MEASUREMENT TOOL HERE. The home-drain branch walks
#      the accumulator back to zero once the queue is quiet, and macadb
#      consumes each delta once (it does not net like the //e's mouse card),
#      so that drain physically walks the arrow back. Measure with MOVEA.
MAME_CTL_PTR_TAGS=:macadb:MOUSE0,:macadb:MOUSE1,:macadb:MOUSE2
MAME_CTL_BTN_NAMES=Mouse Button 0,Mouse Button 1,
MAME_CTL_PTR_MOD=256
MAME_CTL_SCREEN=1024x768
MAME_CTL_GAIN_X=1.4531
MAME_CTL_GAIN_Y=3.325
# 7-bit ADB wire (b): never issue more than 63 counts between two ADB polls.
MAME_CTL_MOVE_STEP=48
MAME_CTL_MOVE_WINDOW=40
# Closed loop (d)+(e): the sensor is the guest's own cursor words, read
# through a save-item window; CAL maps guest px -> published px.
MAME_CTL_CURSOR_ITEMS=m_megaii_ram@0x100E9:2,m_megaii_ram@0x100EB:2
MAME_CTL_CAL_X=47
MAME_CTL_CAL_SX=1.4531
MAME_CTL_CAL_Y=53
MAME_CTL_CAL_SY=3.325
# No homing: a closed loop reads where it is, it never slams a corner.
MAME_CTL_HOME_SETTLE=0
