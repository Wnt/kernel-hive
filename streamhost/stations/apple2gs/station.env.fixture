# ---- HOST-NATIVE STATION (de-bridged from day one — apple2gs wave, 2026-09-13) ----
# MAME 0.289's apple2gs runs ON THE HOST — same engine and same apple/ family as
# the //e sibling apple2e, drawshm frames, ctlsock keys through the generated
# keymap, sound -> SDL disk -> FIFO with the daemon as clock. Launcher: shared
# stations/mame-native/x11-runtime.sh; reset = relaunch restoring the golden
# savestate (apple2gs has MACHINE_SUPPORTS_SAVE).
SH_RESET_MODE=relaunch
SH_FIXTURE_DESC=TODO(apple2gs): GS/OS 6.0.1 Finder desktop on the Apple IIGS (ROM 3) -- fill with the MEASURED scene once the golden bake reports.
MAME_NATIVE_BIN=/data/vms/streamhost/assets/apple2gs/mame-native/apple2gs
MAME_NATIVE_DRIVER=apple2gs
MAME_NATIVE_ROMS=/data/vms/streamhost/assets/apple2gs/mame-native/roms
MAME_NATIVE_GEOM=1024x768
MAME_NATIVE_SKIP_WARNINGS=0
MAME_NATIVE_CHECKPOINT=1
MAME_NATIVE_ARGS=-sl7 cffa2 -hard1 /data/vms/streamhost/assets/apple2gs/media/hive.hdv
SH_MAMECTL_SOCK=/data/vms/streamhost/stations/apple2gs/ctl.sock
SH_MAMESOCK_KEYMAP=/data/vms/streamhost/stations/apple2gs/apple2gs.keymap
SH_AUDIO_SOURCE=fifo
SH_AUDIO_FIFO=/data/vms/streamhost/stations/apple2gs/audio.fifo

# ---- STANDBY (instant-ready: an emulator nobody watches costs ~0 CPU) ----
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/apple2gs/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/apple2gs/mame-native
MAME_NATIVE_STANDBY_DELAY_S=8

# ---- KEYBOARD (ADB, HLE via macadb) ----
# The GS's keyboard is the Apple Extended ADB keyboard emulated by MAME's
# macadb HLE device (src/mame/apple/macadb.cpp, ports :macadb:KEY0..KEY7) —
# NOT the //e's own hardware encoder and NOT a CPU-scanned matrix. Fleet floor
# 40/40 ms first; MAME_CTL_KEY_EXCL only if characters drop (docs/lab/APPLE2GS-WAVE.md).
SH_KEY_MIN_HOLD_MS=40
SH_KEY_MIN_GAP_MS=40

# ---- POINTER (ADB mouse, HLE via macadb) — OPEN, station ships keyboard-only ----
# Tags read from MAME 0.276's -listxml and confirmed against
# src/mame/apple/macadb.cpp on the pinned tree: PORT_START("MOUSE0") carries
# PORT_NAME("Mouse Button 0")/("Mouse Button 1"); MOUSE1/MOUSE2 are the X/Y
# axes, 8-bit analog fields (mask 0xff) exactly like the //e mouse card's
# a2mse_x/_y — so MAME_CTL_PTR_MOD=256, not the module's 65536 SGI default.
# MAME_CTL_SCREEN must match the published surface or every MOVEA target
# clamps against the module's 1288x1024 SGI default.
# The GS has no readable cursor register either, so MOVEA runs OPEN LOOP and
# the whole apple2e correction stack applies (ptr-tags, move-step-cap,
# open-loop-gain, home-drain, count-carry — see native.d/apple2gs.sh).
# GAINS ARE NOT MEASURED YET on this machine: the values below are the
# module's neutral 1.0, NOT apple2e's 1.547/1.674 (a copied gain is a guess,
# and this is a different ADB path with a different sensitivity). The golden
# stream measures counts->px on the Finder desktop and replaces them.
MAME_CTL_PTR_TAGS=:macadb:MOUSE0,:macadb:MOUSE1,:macadb:MOUSE2
MAME_CTL_BTN_NAMES=Mouse Button 0,Mouse Button 1,
MAME_CTL_PTR_MOD=256
MAME_CTL_SCREEN=1024x768
MAME_CTL_GAIN_X=1.0
MAME_CTL_GAIN_Y=1.0
MAME_CTL_HOME_SETTLE=750
