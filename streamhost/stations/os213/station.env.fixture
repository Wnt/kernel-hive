# --- GOLDEN TEST FIXTURE (os213 — IBM OS/2 1.30.2 SE, Presentation Manager) ---
# resetMode=loadvm : the disk is a standalone qcow2; snapshot "golden" holds
# live RAM + disk, baked on the EXACT device set in qemu-streamhost.sh
# (isapc / 486 / 16 MB / isa-vga / KVM / ide-hd with AUTO geometry). Checkpoint,
# binary and device set are ONE combination — rule 6.
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_GOLDEN_DISKS=disk.qcow2
# Pointer: ABSOLUTE via kh-ramabs (2026-09-13 cutover) — see the launcher's
# POINTER comment and docs/guests/os213.md §Pointer. isapc has NO USB, so
# usb-tablet is unavailable; kh-ramabs writes PM's own pointer variable in
# guest RAM instead. Proof: five targets, two laps, sensor-exact 10/10
# (`STAT` converged=22 gaveup=0), plus a click on a Group-Main icon that
# selects it (changed=3542).
# Keyboard: fleet floor 40/40 (QEMU) — not bisected, per playbook §0.
# Network: none. OS/2 1.3 ships no TCP/IP stack, so this station is off the
# retronet and has no rn-tapnet.sh (rule 15).
# Fixture: the OS/2 1.3 Presentation Manager Desktop Manager at VGA 640x480x16
# with its group windows open; no modal dialog, no screensaver. RE-BAKED
# 2026-09-13 under /opt/qemu-os213 (the kh-ramabs build — binary and golden
# are one unit).
# Keyboard PROVEN: two Down keys move the Group-Main selection, 5270 px changed.
# Pointer PROVEN absolute 1:1: `-device kh-ramabs,addr=0x253ca,layout=point16le_yx`
# lands all five targets sensor-exact in two laps; a click on the "OS/2 Window"
# icon at the commanded pixel selects it (changed=3542, bbox 256,205-479,254).
# DO NOT SET SH_CURSOR_SCALE HERE. It is inert under kh-ramabs (absolute
# targets are written verbatim) and kept only for the one-line rollback to
# SH_INPUT_BACKEND=dbus-rel — OS/2 1.3's driver uses the classic 2:1
# horizontal:vertical mickey ratio (1.02 px/unit x, 0.50 px/unit y) and the
# daemon has only ONE scalar, so no single value fixes both axes; see
# ROLLBACK.md.
SH_INPUT_BACKEND=ramabs
SH_RAMABS_SOCK=/data/vms/streamhost/stations/os213/ptr.sock
KH_RAMABS_ADDR=0x253ca
SH_RAMABS_TRACE=off
PTR_TRACE=off
SH_CURSOR_SCALE=1.0
SH_FIXTURE_DESC=os2-13-pm-desktop-manager
