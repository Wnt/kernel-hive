# SH_MAMESOCK_KEYMAP for the host-native `nextstep` station (Previous).
#
# Columns: browser XT set 1 scancode <TAB> port <TAB> field.
#
# This map is NOT machine-generated: Previous has no KEYDUMP, because a NeXT
# keyboard is not a matrix. It is a serial KMS device whose modifiers are a MASK
# carried with every edge (kms_keydown(modmask, keycode)), so the fork's ctlsock
# defines two ports rather than one:
#
#   kms  field = NeXT scancode in hex        (previous/src/includes/kms.h)
#   mod  field = one modifier bit by name    meta lshift rshift lctrl rctrl
#                                            lalt ralt, plus the aliases printed
#                                            on the keyboard: control=meta,
#                                            l/rcommand=l/rctrl,
#                                            l/ralternate=l/ralt
#
# MODIFIER PLACEMENT follows Previous's own SDL convention (sdlkeymap.c
# Keymap_GetModifiers) so a visitor's muscle memory matches what the emulator
# does anywhere else: PC Ctrl -> NeXT Control, PC Win -> NeXT Command,
# PC Alt -> NeXT Alternate.
#
# DELIBERATELY ABSENT, because a scancode with no row is REJECTED rather than
# guessed: Caps Lock, Num Lock, Scroll Lock, Print Screen, Menu, Insert, Delete,
# Home, End, Page Up/Down and F1-F12 have no NeXT scancode. NEXTKEY_POWER (0x58)
# is left out on purpose - it asks the machine to power down.

# --- row 1
# Esc
01	kms	0x49
# 1
02	kms	0x4a
# 2
03	kms	0x4b
# 3
04	kms	0x4c
# 4
05	kms	0x4d
# 5
06	kms	0x50
# 6
07	kms	0x4f
# 7
08	kms	0x4e
# 8
09	kms	0x1e
# 9
0a	kms	0x1f
# 0
0b	kms	0x20
# -
0c	kms	0x1d
# =
0d	kms	0x1c
# Backspace -> NeXT Delete
0e	kms	0x1b
# --- row 2
# Tab
0f	kms	0x41
# q
10	kms	0x42
# w
11	kms	0x43
# e
12	kms	0x44
# r
13	kms	0x45
# t
14	kms	0x48
# y
15	kms	0x47
# u
16	kms	0x46
# i
17	kms	0x06
# o
18	kms	0x07
# p
19	kms	0x08
# [
1a	kms	0x05
# ]
1b	kms	0x04
# Return
1c	kms	0x2a
# --- row 3
# a
1e	kms	0x39
# s
1f	kms	0x3a
# d
20	kms	0x3b
# f
21	kms	0x3c
# g
22	kms	0x3d
# h
23	kms	0x40
# j
24	kms	0x3f
# k
25	kms	0x3e
# l
26	kms	0x2d
# ;
27	kms	0x2c
# '
28	kms	0x2b
# `
29	kms	0x26
# backslash
2b	kms	0x03
# --- row 4
# z
2c	kms	0x31
# x
2d	kms	0x32
# c
2e	kms	0x33
# v
2f	kms	0x34
# b
30	kms	0x35
# n
31	kms	0x37
# m
32	kms	0x36
# ,
33	kms	0x2e
# .
34	kms	0x2f
# /
35	kms	0x30
# Space
39	kms	0x38
# --- modifiers (mask bits, not keycodes)
1d	mod	meta
e01d	mod	meta
2a	mod	lshift
36	mod	rshift
# Left Win   -> NeXT Command
e05b	mod	lcommand
# Right Win  -> NeXT Command
e05c	mod	rcommand
38	mod	lalt
e038	mod	ralt
# --- arrows
# Up
e048	kms	0x16
# Down
e050	kms	0x0f
# Left
e04b	kms	0x09
# Right
e04d	kms	0x10
# --- keypad
# Keypad 7
47	kms	0x21
# Keypad 8
48	kms	0x22
# Keypad 9
49	kms	0x23
# Keypad 4
4b	kms	0x12
# Keypad 5
4c	kms	0x18
# Keypad 6
4d	kms	0x13
# Keypad 1
4f	kms	0x11
# Keypad 2
50	kms	0x17
# Keypad 3
51	kms	0x14
# Keypad 0
52	kms	0x0b
# Keypad .
53	kms	0x0c
# Keypad *
37	kms	0x25
# Keypad -
4a	kms	0x24
# Keypad +
4e	kms	0x15
# Keypad /
e035	kms	0x28
# Keypad Enter
e01c	kms	0x0d
