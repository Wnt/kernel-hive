# ---- GOLDEN FIXTURE (host-native Previous, x11 runtime shape, no X and no QEMU) ----
# resetMode=relaunch -> `systemctl restart streamhost@nextstep`, whose
# ExecStartPre re-runs x11-runtime.sh. For this station a launch is a CRIU
# RESTORE of the golden against the disk image reflinked inside the very freeze
# window the memory image was written in: ~3 s, framebuffer md5-identical,
# against a ~135 s cold boot that also comes up with a DEGRADED (dead-reckoned)
# pointer. NeXTSTEP's root is UFS and a hard-killed one is not to be trusted,
# so there is no "just reboot it" path here; the restore IS the reset.
SH_RESET_MODE=relaunch
SH_FIXTURE_DESC=NeXTstation Color (Motorola 68040, 25 MHz, 32 MB, ROM Rev 2.5 v66) running NeXTSTEP 3.3 for m68k under the museum's fork of Previous, host-native: no captured Linux, no X server, no window. The scene is the colour Workspace on its blue-grey #555577 root, the File Viewer open on the home directory, OmniWeb 2.7b3 in the Dock and its window open on the 8 May 1998 www.apple.com from the retronet corpus, fetched over the guest's own veth at 10.99.0.25. 1120x832 MegaPixel display, published pixel-exact through the emulator's IFB1 shm export. Pointer is ABSOLUTE: NeXTSTEP's own SummaGraphics tablet driver is attached AND STREAMING inside the checkpoint, so a commanded pixel is the pixel the NeXT arrow lands on; the guest draws that arrow itself.

# ---- FRAMES (SH_* read by the daemon; the mapping written by the emulator) ----
# The fork publishes each CHANGED frame into $SH_SHM_PATH in the museum's IFB1
# wire format with a REAL dirty rect, so the daemon must not re-derive one:
# SH_SHM_DAMAGE=0. Measured on an idle Workspace: 10,200 repaints, 646
# published, 27 MB copied — publishing every repaint would have moved 38 GB.
# SH_CAPTURE and SH_SHM_PATH are EMITTED (--capture shm), so they are not
# repeated here: the emit is the single source for the keys it writes.
SH_SHM_DAMAGE=0

# ---- POINTER/KEY INPUT ----
# The emulator's control socket speaks mamectl/1 VERBATIM — the same wire the
# daemon's mamesock sink already drives MAME's ctlsock module with — so this
# station needed zero streamhost code. What the daemon never interprets is the
# KEY verb's (port, field) pair, and this fork defines it as the NeXT KMS space:
# port `kms` with a hex NeXT scancode, port `mod` with a modifier by name,
# because a NeXT keyboard's modifiers are a MASK carried with every edge rather
# than keycodes. nextstep.keymap is that map, 80 rows, every one driven live.
# Leave SH_MAMESOCK_PTR_GRID unset: this server states targets in screen pixels.
# SH_INPUT_BACKEND is emitted (--input-backend mamesock).
SH_MAMECTL_SOCK=/data/vms/streamhost/stations/nextstep/run/ctl.sock
SH_MAMESOCK_KEYMAP=/data/vms/streamhost/stations/nextstep/nextstep.keymap

# Key dwell floors, in ms, read by x11-runtime.sh and passed to the emulator as
# PREVIOUS_CTL_KEY_HOLD / PREVIOUS_CTL_KEY_GAP. The NeXT KMS is a serial device
# behind a ONE-REPORT register: a second report landing before the guest has read
# the first raises KM_OVERRUN and NeXTSTEP discards the pair. A phone's soft
# keyboard stamps a press and its release with the SAME millisecond (seen in
# serve/clientlog.jsonl) and the daemon's mamesock writer drains its queue
# without waiting for acks, so both edges are applied in ONE drain pass and the
# press is lost -- about one character in ten reached the guest. The daemon's own
# gate runs on the QEMU/dbus path only, so the floor belongs at the injector, and
# these are the keys it reads. Measured on a rig: 0 ms lost every character of a
# 19-character line, 3 ms landed 14, 12 ms and up landed all 19, in BOTH dwells.
# 40/40 is the daemon's own default with 3x margin; it costs a real typist
# nothing, because a held key has already met both floors.
SH_KEY_MIN_HOLD_MS=40
SH_KEY_MIN_GAP_MS=40

# ---- AUDIO ----
# 48 kHz s16le stereo on a named pipe, the daemon's fixed fifo contract. The
# emulator opens it O_RDWR|O_NONBLOCK and DROPS what does not fit: nothing
# drains a station's audio pipe until a visitor connects, and a blocking write
# parks the emulator inside write() servicing no frames, no input and no
# checkpoint restore. NeXTSTEP only makes sound when something makes sound, so
# the pipe is silent most of the time and the daemon's own silence gate mutes.
# SH_AUDIO is emitted (--audio on).
SH_AUDIO_SOURCE=fifo
SH_AUDIO_FIFO=/data/vms/streamhost/stations/nextstep/audio.fifo

# ---- STANDBY ----
# Without a pidfile the daemon CANNOT pause a non-QEMU station at all (idle.rs
# never infers a signalling freezer), and an unwatched Previous burns 150% of a
# core for nobody — the nine-MAME lesson. The proc match is scoped to this
# station's OWN asset path so a stale pidfile can never SIGSTOP something else.
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/nextstep/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/nextstep/previous

# ---- EMULATOR + GOLDEN (read by x11-runtime.sh, not by the daemon) ----
NEXTSTEP_ASSETS=/data/vms/streamhost/assets/nextstep
NEXTSTEP_STATE=golden
# The retronet web plane. `off` retires the join and falls back to a machine
# with no network at all; there is no SLIRP arm, because a SLIRP guest cannot
# carry this station's static 10.99.0.25 addressing.
NEXTSTEP_NET=on
# Minimum time a mouse button stays down at the injector. A ~12 ms press on this
# hardware is sampled away entirely (a menu item highlights and never fires); the
# fork's own 400 ms default is safe for single clicks but makes a DOUBLE click
# take over half a second, which NeXTSTEP no longer scores as one — a visitor
# then cannot open anything from the File Viewer. 200 ms is the measured middle.
PREVIOUS_CTL_BTN_HOLD=200
# …and the minimum time between two button REPORTS, which is what makes a double
# click possible at all. Without it the first click's release and the second
# click's press are applied in ONE CtlSock_Drain() pass, the release's packet is
# overwritten before a byte of it leaves the emulated device, and the guest sees
# one long press: a select, never an open. The two floors add up press to press,
# and NeXTSTEP's own double-click threshold is between 440 and 450 ms (swept
# against the guest's verdict), so 200 + 40 keeps 200 ms of margin.
PREVIOUS_CTL_BTN_GAP=40
