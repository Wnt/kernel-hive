# ---- GOLDEN FIXTURE ----
# resetMode=loadvm: one standalone qcow2 (rhapsody-golden.qcow2) holds the
# volume and the internal `golden` snapshot (RAM + device state). The launcher
# starts -loadvm golden -S; the daemon resumes it. Fixture (re-baked COLD
# 2026-08-23 when the station joined the retronet): the Rhapsody DR2 Platinum
# desktop with **OmniWeb 3.0 open on the 1996 Space Jam corpus page**, served by
# the retronet gateway's :80 origin door with no proxy. Behind it the guest home
# window (holding the OmniWeb.app icon a visitor relaunches from), the OmniWeb
# bookmarks panel at the left edge, disk / home / Applications icons down the
# right, Trash bottom right. 1024x768 RGB:555/16 on Cirrus GD5446.
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_GOLDEN_DISKS=rhapsody-golden.qcow2
SH_FIXTURE_DESC=Rhapsody 5.1 DR2 for Intel with OmniWeb 3.0 open on the 1996 Space Jam page from the retronet corpus (gateway :80 origin, no proxy) - the guest home window with the OmniWeb.app icon behind it, bookmarks panel at the left edge, disk/home/Applications icons on the right, Trash bottom right; 1024x768 RGB:555/16 on Cirrus GD5446 under TCG on /opt/qemu-rhapsody. Pointer ABSOLUTE - the kh-ramabs control object writes the guest's own pointer coordinate and publishes it with one small PS/2 nudge.

# ---- POINTER: ABSOLUTE BY WRITING THE GUEST'S OWN COORDINATE ----
# Not a closed loop and not an absolute device. Rhapsody DR2 keeps its own
# pointer coordinate as a Point{int16 x, int16 y} at guest-physical 0x0050fdac;
# the launcher's `-device kh-ramabs` writes the commanded pixel there and
# injects one 2-unit relative PS/2 nudge, because a write alone repaints
# nothing -- the window server redraws on an event. The nudge is ~0.478 px/unit
# through a fractional accumulator, so 2 units is 1 px on 38 of 40 measured
# trials and 0 px on the other 2; the device reads the coordinate back after
# every write and re-issues the miss. The hotspot is never in the path.
#
# The guest-physical address is bound to the golden it was derived against.
# kh-ramabs verifies it at connect (plausible on-screen point, then a probe
# publish that must land) and REFUSES EVERY WRITE otherwise, so a stale address
# degrades this station to the relative path rather than corrupting guest
# memory. Re-baking the golden means re-deriving the address --
# docs/guests/rhapsody.md has the four-position pmemsave recipe.
#
# SINGLE INJECTOR (binding): while SH_RAMABS_SOCK is connected the device owns
# the guest pointer. No abs->rel bridge, no QMP input-send-event, no labctl
# pointer helper may push motion or a button edge at this mouse.
SH_INPUT_BACKEND=ramabs
SH_RAMABS_SOCK=/data/vms/streamhost/stations/rhapsody/ptr.sock

# ---- TELEMETRY (off; arm the pair together when debugging) ----
# SH_RAMABS_TRACE traces the daemon's side of the wire; PTR_TRACE is read by the
# launcher and turns on the device's own per-issue/read-back lines. Both are
# chatty at pointer rates -- turn them off again.
SH_RAMABS_TRACE=off
PTR_TRACE=off

# ---- INERT UNDER THIS BACKEND ----
# SH_CURSOR_SCALE / SH_CURSOR_OFF_* only ever fed the abs->rel dead-reckoning
# bridge. Absolute targets are written verbatim, so these stay identity and
# change nothing; they are kept so a rollback to dbus-rel is a one-line edit
# (put SH_CURSOR_SCALE back to 2.09 with SH_INPUT_BACKEND=dbus-rel).
SH_CURSOR_SCALE=1.0

# ---- IDLE AUTO-PAUSE ----
# The launcher restores the checkpoint frozen (-S) and the daemon wakes it, so
# no warm-up is needed; a cold boot only happens when the golden is missing.
SH_IDLE_PAUSE_SECS=60

# ---- INSTALLED BINARY / LAUNCHER PAIRING - DO NOT SPLIT ----
# READ THIS FIRST IF QEMU REFUSES TO START ON THIS STATION.
# /opt/qemu-rhapsody/bin/qemu-system-i386 carries the absolute-pointer patches
# (fork c5449c80 + qemu-patches 0006 + the merged 0007), sha256 754e762d1e61...
# The previous binary is kept beside it as <same path>.pre-abs-bak, which does
# NOT support `-device kh-ramabs` (verified against the binaries: kh-ramabs=1 on
# the installed one, 0 on the backup). The deployed launcher passes that device
# UNCONDITIONALLY, so restoring .pre-abs-bak while this launcher stays installed
# makes QEMU refuse to start outright. A rollback to the old binary must restore
# the OLD LAUNCHER TOO, in the same pass. Both new or both old. Never mixed.
#
# ROLLING BACK THE POINTER ONLY is a separate, safe axis and is the two-line
# path proven by use on 2026-08-30: set SH_INPUT_BACKEND=dbus-rel here and put
# SH_CURSOR_SCALE back to 2.09. The device stays armed in the launcher with
# nothing connected to ptr.sock, which is inert. Flip the registry's
# stream.pointer / spa.pointerRel / operator.labctl.pointer_mode / reset.pointer /
# runtime.qemu.emitArgs / deviceSetSummary / operator.labctl.notes /
# operator.actionMap.value.note in the SAME commit -- a station's declaration and
# its runtime must move together.
