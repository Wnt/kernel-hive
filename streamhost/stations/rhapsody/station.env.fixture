# ---- INSTALL PHASE FIXTURE (dark launch, no golden yet) ----
# Rhapsody 5.1 DR2 for Intel is being installed on camera. Once the Platinum
# Finder desktop is up and quiet, bake `golden` with savevm and switch these to
# loadvm — the launcher already prefers -loadvm golden -S when the snapshot
# exists.
SH_RESET_MODE=restart
SH_FIXTURE_DESC=INSTALL PHASE: Rhapsody 5.1 DR2 installer / first boot on qemu-system-i386 (/opt/qemu-rhapsody, TCG); no golden yet, reset only re-runs the launcher when QEMU is not live.

# ---- POINTER: RELATIVE SERIAL MICROSOFT MOUSE ----
# The only pointer Rhapsody DR2 x86 supports (no PS/2 option, no tablet), so
# the daemon runs its abs->rel bridge. Guest units-to-pixels gain is
# UNMEASURED; 1.0 is a placeholder until the installed desktop exists.
SH_INPUT_BACKEND=dbus-rel
SH_CURSOR_SCALE=1.0

# ---- IDLE AUTO-PAUSE: OFF during the install ----
# A paused guest is a paused installer. Turn on (60) once the golden exists.
SH_IDLE_PAUSE_SECS=0
