# ---- GOLDEN FIXTURE ----
# resetMode=loadvm: one standalone qcow2 (rhapsody-golden.qcow2) holds the
# volume and the internal `golden` snapshot (RAM + device state). The launcher
# starts -loadvm golden -S; the daemon resumes it. Fixture: the Rhapsody DR2
# Platinum desktop as the machine brings it up for itself after the guest
# autologin — Workspace Manager menu bar, the guest home folder window open at
# /Local/Users/guest, disk / home / Applications icons down the right edge,
# Trash at the bottom right. 800x600 RGB:555/16 on Cirrus GD5446.
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_GOLDEN_DISKS=rhapsody-golden.qcow2
SH_FIXTURE_DESC=Rhapsody 5.1 DR2 for Intel resting on its own Platinum desktop after autologin as guest - Workspace Manager menu bar, the guest home window open, disk/home/Applications icons on the right, Trash bottom right; 800x600 RGB:555/16 on Cirrus GD5446 under TCG on /opt/qemu-rhapsody. Pointer RELATIVE - PS/2 mouse through the daemon abs->rel bridge, guest units-to-pixels gain 0.478.

# ---- POINTER: RELATIVE PS/2 MOUSE ----
# DR2's Configure.app defaults to "PS/2 Mouse" (no absolute option), so the
# daemon runs its abs->rel bridge. Measured with QMP mouse_move on the
# 800x600 desktop: 1 unit -> 0.478 px, so scale = 1/0.478.
SH_INPUT_BACKEND=dbus-rel
SH_CURSOR_SCALE=2.09

# ---- IDLE AUTO-PAUSE ----
# The launcher restores the checkpoint frozen (-S) and the daemon wakes it, so
# no warm-up is needed; a cold boot only happens when the golden is missing.
SH_IDLE_PAUSE_SECS=60
