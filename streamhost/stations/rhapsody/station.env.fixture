# ---- INSTALL PHASE FIXTURE (dark launch, no golden yet) ----
# Rhapsody 5.1 DR2 for Intel is being installed on camera. Once the Platinum
# Finder desktop is up and quiet, bake `golden` with savevm and switch these to
# loadvm — the launcher already prefers -loadvm golden -S when the snapshot
# exists.
SH_RESET_MODE=restart
SH_FIXTURE_DESC=INSTALL PHASE - Rhapsody 5.1 DR2 first boot on /opt/qemu-rhapsody under TCG; no golden yet, reset only re-runs the launcher when QEMU is not live.

# ---- POINTER: RELATIVE PS/2 MOUSE ----
# DR2's Configure.app defaults to "PS/2 Mouse" (no absolute option), so the
# daemon runs its abs->rel bridge. Measured with QMP mouse_move on the
# 800x600 desktop: 1 unit -> 0.478 px, so scale = 1/0.478.
SH_INPUT_BACKEND=dbus-rel
SH_CURSOR_SCALE=2.09

# ---- IDLE AUTO-PAUSE: OFF during the install ----
# A paused guest is a paused installer. Turn on (60) once the golden exists.
SH_IDLE_PAUSE_SECS=0
