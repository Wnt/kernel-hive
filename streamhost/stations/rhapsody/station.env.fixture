# ---- POINTER: HELD AT dbus-rel PENDING A ramabs/artistctl SINK FIX ----
# The absolute pointer for this station is BUILT AND PROVEN AT THE DEVICE
# LEVEL but is NOT cut over. On 2026-08-30 rhapsody was cut over to
# SH_INPUT_BACKEND=ramabs and its FIRST browser session drove the whole
# path correctly -- the guest's own coordinate read back the commanded
# pixel exactly -- but EVERY SESSION AFTER THE FIRST timed out
# negotiating the tile stream. 40 SESSION_ACCEPTED, zero completed, with
# the router counters frozen at the first session's numbers: per-session
# sink state that is not released at teardown. Reverting the backend to
# dbus-rel restored the station immediately, with the QEMU device and the
# new binary still in place -- so QEMU and the launcher are NOT at fault.
#
# TO COMPLETE THIS CUTOVER once the sink is fixed, together: set
# SH_INPUT_BACKEND=ramabs here AND flip the registry's
# stream.pointer / spa.pointerRel / operator.labctl.pointer_mode / reset.pointer /
# runtime.qemu.emitArgs, and SH_CURSOR_SCALE 2.09 -> 1.0.
# The QEMU binary and launcher are already installed and need no change.

# ---- GOLDEN FIXTURE ----
# resetMode=loadvm: one standalone qcow2 (rhapsody-golden.qcow2) holds the
# volume and the internal `golden` snapshot (RAM + device state). The launcher
# starts -loadvm golden -S; the daemon resumes it. Fixture (re-baked COLD
# 2026-08-23 when the station joined the retronet): the Rhapsody DR2 Platinum
# desktop with **OmniWeb 3.0 open on the 1996 Space Jam corpus page**, served by
# the retronet gateway's :80 origin door with no proxy. Behind it the guest home
# window (holding the OmniWeb.app icon a visitor relaunches from), the OmniWeb
# bookmarks panel at the left edge, disk / home / Applications icons down the
# right, Trash bottom right. 1024x768 RGB:555/16 on Cirrus GD5446.
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_GOLDEN_DISKS=rhapsody-golden.qcow2
SH_FIXTURE_DESC=Rhapsody 5.1 DR2 for Intel with OmniWeb 3.0 open on the 1996 Space Jam page from the retronet corpus (gateway :80 origin, no proxy) - the guest home window with the OmniWeb.app icon behind it, bookmarks panel at the left edge, disk/home/Applications icons on the right, Trash bottom right; 1024x768 RGB:555/16 on Cirrus GD5446 under TCG on /opt/qemu-rhapsody. Pointer RELATIVE - PS/2 mouse through the daemon abs->rel bridge, guest units-to-pixels gain 0.478.

# ---- POINTER: RELATIVE PS/2 MOUSE ----
# DR2's Configure.app defaults to "PS/2 Mouse" (no absolute option), so the
# daemon runs its abs->rel bridge. Measured with QMP mouse_move on the
# 1024x768 desktop: 1 unit -> 0.478 px, so scale = 1/0.478.
SH_INPUT_BACKEND=dbus-rel
SH_CURSOR_SCALE=2.09

# ---- IDLE AUTO-PAUSE ----
# The launcher restores the checkpoint frozen (-S) and the daemon wakes it, so
# no warm-up is needed; a cold boot only happens when the golden is missing.
SH_IDLE_PAUSE_SECS=60

# ---- PS/2 SINGLE-PACKET CAP ----
# Rhapsody DR2's PS/2 mouse driver takes only the FIRST packet of a chained
# relative move and desyncs above ~30 units/send at any pace (measured on the
# 1024x768 desktop with QMP mouse_move + framebuffer diffs). Cap each send at
# 24 units so a fast browser drag is delivered as many small packets the guest
# keeps in phase; the daemon paces them SH_REL_STEP_PACE_MS apart.
SH_REL_MAX_STEP=24
SH_REL_STEP_PACE_MS=16
