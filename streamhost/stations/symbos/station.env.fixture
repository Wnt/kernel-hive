# SymbOS 4.0 (2025), later enthusiast software on a Philips NMS 8250 MSX2.
SH_RESET_MODE=relaunch
SH_FIXTURE_DESC=SymbOS 4.0 desktop on NMS 8250 with a 512 KiB mapper and MSX mouse; Notepad, Pocket Calculator and Game of Life on a fresh writable 720K floppy copy.
MAME_NATIVE_BIN=/data/vms/streamhost/assets/symbos/mame-native/msx2
MAME_NATIVE_DRIVER=nms8250
MAME_NATIVE_ROMS=/data/vms/streamhost/assets/symbos/mame-native/roms
MAME_NATIVE_GEOM=1024x768
MAME_NATIVE_SKIP_WARNINGS=0
# nms8250 has no supported save-state contract. Every reset cold boots.
MAME_NATIVE_CHECKPOINT=0
MAME_NATIVE_DISK_TEMPLATE=/data/vms/streamhost/assets/symbos/media/symbos4.dsk:runtime.dsk
MAME_NATIVE_ARGS=-cartslot1 mm512k -gen1 mouse -flop1 /data/vms/streamhost/stations/symbos/runtime.dsk -view 'Screen 0 Standard (4:3)'
SH_MAMECTL_SOCK=/data/vms/streamhost/stations/symbos/ctl.sock
SH_MAMESOCK_KEYMAP=/data/vms/streamhost/stations/symbos/symbos.keymap
SH_IDLE_PAUSE_SECS=60
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/symbos/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/symbos/mame-native
# Do not freeze in DOS. Standby on the finished scene, in EMULATED seconds
# (2026-10-04): a cold boot reaches the SymbOS desktop at 33.5 s every time
# (ctlsock PING, two boots), however loaded the box is (40 s+ of wall clock
# under load); a Restore reports done once this freeze has landed (scene.state,
# stations/mame-native/x11-runtime.sh). docs/TYPE-IN-EDITOR.md "Typing right
# after a Restore".
MAME_NATIVE_STANDBY_DELAY_S=36
MAME_NATIVE_STANDBY_CLOCK=emulated
# The daemon's own first pause (zero sessions, SH_IDLE_PAUSE_SECS after it
# starts) counts WALL seconds; at the ~0.45x a loaded box ran this machine, 60 s
# of wall clock is still mid-boot. Withhold that first pause so the launcher's
# freeze above lands on the scene (newsos and armeval have the same trap).
SH_IDLE_PAUSE_WARMUP_SECS=120
# SymbOS scans the MSX matrix itself; these guest dwell times type complete text.
SH_KEY_MIN_HOLD_MS=120
SH_KEY_MIN_GAP_MS=80
MAME_CTL_KEY_EXCL=:KEY
# KEYDUMP and framebuffer-proven joystick-port-1 MSX mouse. Narrow signed deltas.
MAME_CTL_PTR_TAGS=:gen1:mouse:BUTTONS,:gen1:mouse:MOUSE_X,:gen1:mouse:MOUSE_Y
MAME_CTL_BTN_NAMES=P1 Button 1,P1 Button 2,
MAME_CTL_PTR_MOD=256
# Active desktop raster inside the 4:3 published surface; measured from frames.
MAME_CTL_SCREEN=964x572+30+103
MAME_CTL_GAIN_X=1.8828125
MAME_CTL_GAIN_Y=2.6981132
MAME_CTL_MOVE_STEP=30
MAME_CTL_MOVE_WINDOW=80
MAME_CTL_HOME_SETTLE=0

# Read the actual V9938 sprite-0 cursor; closed-loop MOVEA corrects lost counts.
MAME_CTL_MSX_CURSOR=:v9938
MAME_CTL_CAL_X=0
MAME_CTL_CAL_Y=0

MAME_CTL_MOVEA_TRIES=200
