# ---- HOST-NATIVE STATION: Sony NEWS-OS 4.1R on MAME nws3260 (2026-08-18) ----
# MAME 0.289's nws3260 (news_r3k.cpp) runs ON THE HOST: no QEMU, no guest
# Debian, no X. Frames: drawshm (the 1120x780 mono LCD) -> SH_CAPTURE=shm.
# Keys: ctlsock + the GENERATED keymap (scripts/dev/mame-keymap.py, KEYDUMP
# of the :hid: keyboard). No audio (driver: MACHINE_NO_SOUND). Launcher: the
# shared stations/mame-native/x11-runtime.sh; MAME_NATIVE_* are its knobs.
# The driver has NO save state, so reset = relaunch COLD-BOOTS the installed
# disk (Automatic Boot DIP on): ROM monitor -> NEWS-OS 4.1R -> sxdm.
SH_RESET_MODE=relaunch
SH_FIXTURE_DESC=NEWS-OS 4.1R on the NWS-3260's 1120x780 monochrome LCD (host-native MAME 0.289 nws3260, drawshm): the sxdm login / X11 desktop of Sony's BSD workstation Unix. Cold power-on to the login in ~90 s (Automatic Boot DIP + /fastboot).
MAME_NATIVE_BIN=/data/vms/streamhost/assets/newsos/mame-native/newsos
MAME_NATIVE_DRIVER=nws3260
MAME_NATIVE_ROMS=/data/vms/streamhost/assets/newsos/mame-native/roms
MAME_NATIVE_GEOM=1120x780
# The installed system disk: a WRITABLE raw image (like a real workstation's
# disk — it persists across relaunches; reset=relaunch is a power-cycle).
# The driver has no save state, so there is nothing to preserve BUT the disk,
# and a dirty stop is repaired by NEWS-OS's own boot-time `fsck -p`, never
# corrupted (unlike a CHD diff killed mid-write, which was — 2026-08-18).
# The shipped cfg carries the SW2:5 "Automatic Boot" DIP (cfg is the only
# place MAME keeps DIPs): power-on -> NEWS-OS 4.1R -> sxdm without a typed
# `bo`. Its -cfg_directory comes AFTER the launcher's own, and MAME lets the
# later option win.
MAME_NATIVE_ARGS=-hard1 /data/vms/streamhost/assets/newsos/newsos-disk.img -cfg_directory /data/vms/streamhost/assets/newsos/cfg
# Pointer: the NEWS HLE mouse lives at :hid:mouse_{buttons,x_axis,y_axis}
# with MAME's default button names, so the base ctlsock module binds it by
# port suffix (no ptr-tags patch). No hardware cursor -> MOVEA degrades to
# open-loop dead reckoning; the X server runs -a 1 -t 1 (Xservers) so one
# count is one pixel and the reckoning holds. Device delta is 8-bit: paced
# MOVEP only (the daemon's path).
MAME_CTL_PTR_PORTS=:hid
# idrom.bin is a BAD_DUMP in MAME (machine-specific): the "NEEDS REDUMP" nag
# is a MODAL wait, so the binary carries mame-irix-skip-warnings.patch and
# the launcher writes ui.ini skip_warnings.
MAME_NATIVE_SKIP_WARNINGS=1
MAME_CTL_KEY_EXCL=:row
# SCAN-SETTLE: news_hid is MAME's device_matrix_keyboard_interface — it scans
# the 8 rows in FIXED order (1200 Hz, a 6.7 ms sweep) and emits make/break
# scancodes in ROW order; the guest's X server rebuilds Shift LEVEL from that
# order. Shift sits on ROW3/ROW4 but most characters on ROW0-ROW3, so when the
# browser's Shift-down and character-down land in the same ctlsock drain pass
# (typeText sends them at ~0 gap), the character's lower row is scanned first
# and it types UNSHIFTED (`$HOME`->`$hOME`, `&`->`7`, `The`->`the`). SCAN_MS
# makes drain_keys apply at most ONE matrix transition per full sweep so every
# edge is scanned in isolation and in browser order. 8 ms >= one 6.7 ms sweep.
MAME_CTL_KEY_SCAN_MS=8
SH_MAMECTL_SOCK=/data/vms/streamhost/stations/newsos/ctl.sock
SH_MAMESOCK_KEYMAP=/data/vms/streamhost/stations/newsos/newsos.keymap

# ---- STANDBY (OFF during dark launch / eyeball) --------------------------
# No save state in the driver, so "the golden" is the installed disk plus
# Automatic Boot + /fastboot: a cold power-on to the sxdm login is ~90-120 s
# of emulated boot. The launcher's SIGSTOP is UNCONDITIONAL after
# MAME_NATIVE_STANDBY_DELAY_S — it does not wait for the scene — so a delay
# shorter than the boot freezes a half-painted boot console (seen 2026-08-18,
# state=T mid-boot). While the station is dark-launched and being eyeballed,
# keep standby OFF so /os/newsos always shows the live login. When it is
# listed, turn it on with a delay comfortably past boot (>=200 s) so the
# freeze lands on the login screen, not mid-boot.
SH_IDLE_PAUSE_SECS=0
SH_IDLE_PAUSE_PIDFILE=/data/vms/streamhost/stations/newsos/mame.pid
SH_IDLE_PAUSE_PROC_MATCH=assets/newsos/mame-native
MAME_NATIVE_STANDBY_DELAY_S=200

# ---- KEYBOARD PACING ----------------------------------------------------
# news_hid is MAME's HLE device_matrix_keyboard_interface: a real 8-row scanned
# matrix (make/break scancodes, not a cooked serial byte stream). 80/80 is the
# fleet floor for the per-key dwell; ORDER correctness across a Shift chord is
# handled separately by MAME_CTL_KEY_SCAN_MS above (the dwell alone does not fix
# it — Shift-down and char-down still land together without the scan-settle).
# The raw installer TUI tolerated the reorder because a text console cares less
# about Shift edge order than the X server does; xterm/sxdm did not. Byte-exact
# under the scan-settle at 80/80 across mixed case + every shifted symbol
# (validated 2026-08-18: `!@#$%^&*()_+`, `&` vs bare `7`, `HUP`, `$`).
SH_KEY_MIN_HOLD_MS=80
SH_KEY_MIN_GAP_MS=80
