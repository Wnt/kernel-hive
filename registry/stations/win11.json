  "render": {
    "signalOrder": 35,
    "stationsManifestOrder": 33,
    "stationsManifestPrelude": "\n# ---------------------------------------------------------------------------\n# GROUP H — UEFI Windows. Secure Boot + virtio-scsi + HD Audio; nothing here is\n#           shared with the legacy Windows tiles above.\n# ---------------------------------------------------------------------------\n\n# win11 (VMID 123) — Windows 11 Pro 25H2, the only q35/OVMF Windows tile. The\n#   launcher is the device-set ledger and its header explains three things that\n#   look wrong but are not: the system disk is declared BEFORE the pflash pair\n#   (savevm picks its vmstate device by -drive order, so this keeps the RAM\n#   image out of the 528 KiB variable store), the variable store is qcow2 and\n#   WRITABLE (read-only hangs OVMF before display init), and there is no vTPM\n#   (Win11 needs one to install, not to run; BitLocker verified off first).\n#   restrict=on isolates the guest: adapter up, no default route, no DNS.\n#   VERBATIM LAUNCHER: boots the tile-LOCAL win11-golden.qcow2 (the pristine\n#   install stays at /data/gallery-guests/Win11/win11.qcow2) with a golden\n#   snapshot inside (resetMode=loadvm).\n",
    "bringUpGroup": 3,
    "bindingOrder": 30,
    "bindingPrelude": "",
    "goldenOrder": 33,
    "actionMapOrder": 4
  },
  "stationDir": "win11",
  "lifecycle": "production",
