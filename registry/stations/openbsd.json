      "envFixture": "streamhost/stations/openbsd/station.env.fixture",
      "binary": "qemu-system-x86_64",
      "accel": "kvm",
      "cpu": "host",
      "memoryMB": 1024,
      "smp": 1,
      "vga": "none",
      "deviceSetSummary": [
        "-name streamhost-openbsd",
        "-enable-kvm -m 1024 -smp 1",
        "-machine pc-i440fx-11.0 -cpu host",
        "-rtc base=localtime",
        "-boot c",
        "-drive file=/data/vms/streamhost/stations/openbsd/disk.qcow2,format=qcow2,if=virtio",
        "-vga none -device VGA,edid=on,xres=1024,yres=768",
        "-display dbus,p2p=on,audiodev=snd0",
        "-audiodev dbus,id=snd0,out.frequency=48000,out.channels=2,out.format=s16 -device AC97,audiodev=snd0",
        "-usb -device usb-tablet",
        "-netdev user,id=n0 -device virtio-net-pci,netdev=n0",
        "-qmp unix:/data/vms/streamhost/stations/openbsd/qmp.sock,server=on,wait=off",
        "-pidfile /data/vms/streamhost/stations/openbsd/qemu.pid"
      ],
      "launcherParity": {
        "status": "semantic-identical",
        "reason": "pc-i440fx-11.0 under KVM; bochs stdvga as -device VGA with a 1024x768 EDID (Xorg vesa), one virtio disk carrying the golden vmstate, usb-tablet, AC97, virtio-net on SLIRP; -smp 1 on purpose (2 vCPUs lose keyboard interrupts under X)"
      },
      "machine": "pc-i440fx-11.0"
    },
    "bringUpOrder": 84
  },
