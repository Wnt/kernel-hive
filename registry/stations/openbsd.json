    "id": "openbsd",
    "displayName": "OpenBSD 7.9",
    "year": 2026,
    "lineage": "4.4BSD-Lite → NetBSD 1.0 → OpenBSD 1.2 (1996, Theo de Raadt) → 7.9 (2026)",
    "arch": "amd64, Xorg (Xenocara) vesa server",
