    "stationsManifestOrder": 19,
    "stationsManifestPrelude": "\n# ---------------------------------------------------------------------------\n# GROUP F — SPECIAL tiles (non-standard boot/firmware/overlay). Read the notes.\n# ---------------------------------------------------------------------------\n\n# qnx (VMID 112) — QNX 6.5 LiveCD, Cirrus VGA, AC97, TABLET-FREE (PS/2 relative).\n#   VERBATIM LAUNCHER: golden.qcow2 (ide, the savevm store — the LiveCD still\n#   boots via -boot d) + the legacy HMP monitor on tcp 7112 (bring-up guest\n#   keystrokes). Re-baked 2026-07-15 (docs/guests/qnx.md \"LIVE PROMOTION\"): the\n#   usb-tablet made qemu_input_is_absolute() true and dbus RelMotion refuse,\n#   freezing the pointer; the tablet-free golden is 1024x768 Photon with\n#   SH_POINTER=rel driving the built-in i8042 PS/2 mouse 1:1 (SPA pointer-lock\n#   type=4 direct-rel). loadvm needs exactly this device set: NO usb, NO tablet.\n",
    "bringUpGroup": 5,
    "bindingOrder": 24,
    "bindingPrelude": "",
    "goldenOrder": 22
  },
