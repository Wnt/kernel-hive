    "stationsManifestOrder": 4,
    "stationsManifestPrelude": "\n# haiku (VMID 107) — persistent disk boot. GENERIC. --vga none: --extra supplies\n#   a VGA device forced to 1920x1200 via EDID (the built-in -vga would ignore the\n#   EDID). intel-hda + usb-tablet.\n# SSH GUEST SHELL: ssh -i /root/.ssh/gallery_guest_key -p 5807 user@127.0.0.1\n#   (login user 'user', uid 0; guest 10.0.2.15:22). hostfwd=...5807-:22 is baked\n#   onto the EXISTING -netdev user below (a netdev backend property, NOT a\n#   -device => -loadvm golden still matches exactly). sshd autostart + keys live\n#   on the persistent disk AND in savevm golden (see the fixture stanza). The\n#   tile boots haiku-persist.qcow2 (-boot c, ide — via --disk-raw so it lands in\n#   the media slot exactly as baked); loadvm needs exactly this device set.\n",
    "bringUpGroup": 0,
    "bindingOrder": 21,
    "bindingPrelude": "",
    "goldenOrder": 19,
    "actionMapOrder": 22,
    "bindingComment": "ideal: BeBox"
  },
