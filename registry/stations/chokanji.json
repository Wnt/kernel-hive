  "render": {
    "signalOrder": 66,
    "stationsManifestOrder": 64,
    "stationsManifestPrelude": "\n# ---------------------------------------------------------------------------\n# GROUP H — TRON / BTRON (Cirrus VGA, PS/2 relative mouse), rel pointer.\n# ---------------------------------------------------------------------------\n\n# chokanji (VMID 149) — 超漢字 / B-right/V, BTRON3 (Ken Sakamura's TRON project).\n#   Cirrus GD5446 800x600, PS/2 relative mouse. VERBATIM LAUNCHER.\n#   -machine pc-i440fx-11.0,vmport=off is LOAD-BEARING: the disk is an ex-VMware\n#   guest, so QEMU's default vmmouse becomes the current pointer and swallows all\n#   injected motion; vmport=off removes it and the default i8042 PS/2 mouse takes over (BTRON\n#   has no absolute/tablet driver -> relative pointer). qcow2 runs WITHOUT\n#   -snapshot so savevm 'golden' persists inside it (resetMode=loadvm). No NIC.\n",
    "bringUpGroup": 8,
    "bindingOrder": 71,
