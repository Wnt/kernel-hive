  "render": {
    "signalOrder": 16,
    "stationsManifestOrder": 10,
    "stationsManifestPrelude": "\n# solaris (VMID 100) — Solaris 10 CDE on the standalone\n# gallery-hid QEMU. The launcher requires -loadvm golden (never cold-boots), uses\n# the VMState golden's two-socket CPU identity, and wires gallery-hid-pci at 0x1e.\n# SH_INPUT_BACKEND=gallery-hid names the native absolute-pointer path directly.\n# SH_GHID_SOCKET selects its chardev. RETRONET: net0 is a tap on vmbr-rn (NOT\n# slirp) via rn-tapnet.sh; guest static 10.99.0.14/24 no default route; the guest\n# warpd agent is reached directly at 10.99.0.14:7777 for rollback/exec only.\n",
    "bringUpGroup": 2,
    "bindingOrder": 12,
    "bindingPrelude": "",
    "goldenOrder": 13,
    "actionMapOrder": 15
  },
