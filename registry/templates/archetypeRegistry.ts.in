// DO NOT EDIT — generated by scripts/stations-registry.py generate from
// registry/tiles/*.json + registry/registry-v1.json; run `make station-registry-generate`.
import type { RuntimeVMManifestEntry } from '../types';

// ============================================================================
//  ARCHETYPE + TRANSPORT REGISTRY
//  ---------------------------------------------------------------------------
//  Generated view (source of truth: registry/tiles/*.json) mapping every OS to:
//    - archetypeId : which era-accurate model renders it
//    - transport   : how its LIVE framebuffer texture is obtained (@@STREAMED_COUNT@@ of the @@LINEUP_COUNT@@
//                    bindings are streamhost — WebTransport + WebCodecs against
//                    the Rust daemon, signaled same-origin via /signal/<osId>.json)
//    - accentColor : OS accent
//    - eraLabel    : placard line
//
// ============================================================================

export type ArchetypeId =
  | 'beige-ibm-pc'      // boxy DOS-era CRT + IBM-PC (Win3.11, FreeDOS, DOS)
  | 'beige-tower-crt'   // mid/late-90s tower + curvy CRT (Win95/98/2000, Serenity, Kolibri)
  | 'putty-lcd'         // early-2000s putty/graphite PC + flat CRT/LCD (WinXP, Toaru, Alpine, TinyCore)
  | 'sparc-pizzabox'    // Sun SPARCstation pizza-box + CRT (Solaris CDE)
  | 'mono-terminal'     // monochrome Bell-Labs/DEC terminal (9front, HelenOS)
  | 'touch-phone'       // era touchscreen smartphone (Android, postmarketOS, Sailfish)
  | 'apple-studio';     // modern Apple all-in-one / Studio Display (macOS)

export type Transport =
  | 'streamhost'    // from-scratch WebTransport+WebCodecs client (~6x lower latency)
  | 'showcase';     // poster/placard only — no connection attempt

export interface OSBinding {
  osId: string;
  displayName?: string;
  archetypeId: ArchetypeId;
  transport: Transport;
  /** Optional manifest-provided endpoint retained for forward-compatible transports. */
  endpoint?: string;
  accentColor: string;
  eraLabel: string;
  /**
   * OPTIONAL streamhost signaling endpoint (HTTP GET → { url, certHashB64,
   * wireVersion?, audio? } or a bare base64 hash). Only consulted when this tile
   * is on the `streamhost` transport; when omitted the client falls back to the
   * SAME-ORIGIN `/signal/<osId>.json` served by the HTTPS SPA server (see
   * streamSignal.streamhostSignalFor) — which is what every live tile uses.
   */
  signalEndpoint?: string;
  /**
   * COLD-BOOT-ON-VISIT flag — the SPA↔tile CONTRACT for the power-on experience.
   * ---------------------------------------------------------------------------
   * When TRUE, this tile does NOT resume an already-booted golden — the host
   * launcher powers the guest ON FROM POST on each visit (fresh ephemeral overlay,
   * BIOS/POST → boot menu → OS splash + startup sounds → desktop) and powers it
   * OFF when the last visitor leaves. The SPA reads this flag to swap the generic
   * "Connecting…" spinner for the dramatic CRT power-on treatment (PowerOnOverlay
   * in StreamView) so the visitor SEES + HEARS the machine warming up, framing the
   * incoming live POST frames as a real vintage boot. Boot AUDIO rides the normal
   * path (setAudioEnabled(true) on control-connect → Opus uni-stream, un-gated;
   * the click that opened the tile is the autoplay gesture).
   *
   * OWNERSHIP: the per-tile BACKEND agent that converts a tile to cold-boot-on-
   * visit sets this to `true` here for that tile id (single source of truth the
   * SPA reads synchronously at mount — no signal round-trip, so the warm-up shows
   * the instant the tile opens). Omitted / false ⇒ the tile behaves exactly as
   * today (instant resume + plain spinner); the power-on treatment is strictly
   * additive and flag-gated, so non-cold-boot tiles are never affected.
   */
  coldBoot?: boolean;
  /**
   * RELATIVE-POINTER flag — mirrors the daemon's per-tile `SH_POINTER=rel`
   * (tiles.json `pointer_mode: "rel"`). These guests own a PS/2-style relative
   * mouse with NO absolute-position API, so the daemon cannot SetAbsPosition —
   * it must feed Mouse.RelMotion deltas. When TRUE and the SPA holds Pointer
   * Lock, the locked-move handler sends the raw per-event movementX/Y as a
   * type=4 DIRECT RelMotion datagram (client.sendMoveRel → input.rs case 4 →
   * rel_motion), giving real 1:1 tracking with the guest rendering its own
   * cursor. This BYPASSES the old abs→rel homing bridge (send abs point → daemon
   * diffs against last position → RelMotion of the difference), which emitted
   * huge deltas on the first move / after any warp that QEMU's PS/2 accel
   * clamped, leaving the cursor stuck (the QNX frozen-cursor bug). Omitted /
   * false ⇒ ABSOLUTE tiles keep the accumulated-virtual-cursor + sendMoveAbs
   * path unchanged. Only meaningful for streamhost tiles under pointer lock.
   */
  pointerRel?: boolean;
  /** Show the grid's hardware-input badge for a native guest input device. */
  hardwareInput?: boolean;
  /** Show the grid's relative-pointer warning badge: the exhibit is graphical
   *  and takes a pointer, but only a RELATIVE one, so the cursor cannot track
   *  the visitor 1:1. Derived from stream.pointer, not from spa.pointerRel. */
  relativePointerOnly?: boolean;
  /**
   * BOOT-VIDEO REPLAY — same-origin URL of this tile's recorded power-on clip
   * (`/boot/<osId>/boot.mp4`, baked out-of-band; NOT bundled/committed). When
   * set, the SPA plays it in a scrubbable `<video>` (BootVideoOverlay) while the
   * live golden readies behind it, then swaps invisibly on the first live frame
   * (the clip's last frame === golden first frame — the seamless-handoff
   * invariant). This flag is BOTH the grid "▶ Boot" badge signal AND the mount
   * selector + the `<video src>` in StreamView. Sibling assets (poster.jpg,
   * sprite.jpg, thumbs.vtt) are resolved by convention from this path. Omitted
   * ⇒ today's behaviour (PowerOnOverlay when coldBoot, else the plain spinner);
   * the boot-video treatment is strictly additive and flag-gated. Paths/durations
   * may also arrive at runtime via /boot/index.json (VMManifestEntry.bootVideo).
   */
  bootVideo?: string;
}

// One entry per OS. @@STREAMED_COUNT@@ rows are streamhost; @@SHOWCASE_COUNT@@ are showcase posters.
export const OS_BINDINGS: Record<string, OSBinding> = {
@@OS_BINDINGS@@
};

/** Adapt one validated runtime manifest row to the existing streaming seam. */
export function bindingFromManifest(vm: RuntimeVMManifestEntry): OSBinding {
  return {
    osId: vm.id,
    displayName: vm.displayName,
    archetypeId: vm.archetypeId,
    transport: vm.transport,
    endpoint: vm.endpoint,
    accentColor: vm.accent ?? '#8891a6',
    eraLabel: vm.eraLabel,
    signalEndpoint: vm.signalEndpoint ?? undefined,
    coldBoot: vm.coldBoot,
    pointerRel: vm.pointerRel,
    hardwareInput: vm.hardwareInput,
    relativePointerOnly: vm.relativePointerOnly,
    bootVideo: vm.bootVideo?.mp4,
  };
}
