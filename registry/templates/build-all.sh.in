#!/usr/bin/env bash
# DO NOT EDIT — generated by scripts/tiles-registry.py generate from
# registry/tiles/*.json + registry/registry-v1.json; run `make tile-registry-generate`.
# =============================================================================
# build-guests/build-all.sh  —  orchestrator for the Kernel Hive from-source builds
#
# GOAL: rebuild the ENTIRE Kernel Hive guest set from source on a fresh Proxmox
# host, by running each per-guest build script in a sensible order. This is the
# PRIMARY, reproducible path (MASTER-REPRODUCE.md Phase 4): every selected guest
# is rebuilt END TO END from upstream or explicitly supplied source media — no
# image backups. The old zfs-send image-restore path is now the optional shortcut.
#
# Each per-guest script (freedos.sh, 9front.sh, ...) is fully self-contained:
# it re-downloads its source ISO/image, creates the disk, drives the install
# automation, injects era software, lands the bootable artifact under
# /data/gallery-guests/<DIR>/, and framebuffer-verifies it reaches the GUI.
# This wrapper only sequences them, filters, times, and reports.
#
# USAGE:
#   ./build-all.sh                     # build everything that needs no staged media
#   ./build-all.sh --list              # print the manifest table and exit
#   ./build-all.sh --only 9front       # build just one guest (any class)
#   ./build-all.sh --only kolibrios --only toaruos   # build a subset
#   ./build-all.sh --class fast        # build only the fast live-ISO guests
#   ./build-all.sh --with-media        # include Sailfish (needs SDK emulator media)
#   ./build-all.sh --include-licensed  # also build guests needing a supplied ISO
#   ./build-all.sh --check-assets      # preflight staged media/env first (check-assets.sh)
#   ./build-all.sh --fail-fast         # stop at the first failing guest
#   ./build-all.sh --skip-verify       # pass VERIFY=0/DO_VERIFY=0 to each guest
#   ./build-all.sh --dry-run           # show what WOULD run, run nothing
#
# Env overrides are passed straight through to the per-guest scripts, e.g.:
#   FORCE=1 ./build-all.sh --only win95            # force a rebuild
#   SOL10_ISO=/isos/sol10.iso ./build-all.sh --only solaris-cde
#   XP_ISO_LOCAL=/isos/xp.iso ./build-all.sh --only winxp
#
# HYGIENE: this wrapper never kills anything and never touches other guests,
# CT 110 or the deleted Win11/macOS VMIDs. Each per-guest script owns its own
# cleanup (pidfile/monitor-quit only, namespaced sockets/dirs).
# =============================================================================
set -u
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GALLERY_ROOT="${GALLERY_ROOT:-/data/gallery-guests}"

# ---------------------------------------------------------------------------
# Guest manifest.  Columns (pipe-separated):
#   KEY | SCRIPT | OUTPUT_DIR | CLASS | EST_TIME | AUTOMATION | PRODUCES [| FLAGS]
#
# CLASS:
#   fast      cheap live-ISO / prebuilt-disk exotics — no OS install, seconds-to-GUI
#   retro     prebuilt Win/DOS base image + era-software injection (mid-weight download)
#   heavy     from-source compile or full unattended OS install (slow)
#   licensed  needs a user-supplied source (copyright / SSO-gated) — SKIPPED by default
#
# AUTOMATION:
#   full      build reaches the GUI hands-off, zero human input
#   full*     build hands-off; a ONE-TIME footnote applies at RUNTIME (documented)
#   1-click   build needs (worst case) a single one-time interactive click/calibration
#   supplied  fully scripted once you supply the required source media
#
# FLAGS:
#   media     needs staged, account-gated source media; skipped unless selected
#             by --with-media or an explicit --only
#
# ---------------------------------------------------------------------------
MANIFEST=(
@@BUILD_MANIFEST@@
)

# Full build order (cheap wins first, heavy last). The default selection filters
# the two Sailfish stages because Stage 1 needs account-gated SDK media. Add
# --with-media after staging it. The licensed pair is appended only by
# --include-licensed. An explicit --only always opts that key in.
@@BUILD_DEFAULT_ORDER@@

# ---------------------------------------------------------------------------
c_reset=$'\e[0m'
c_bold=$'\e[1m'
c_red=$'\e[31m'
c_grn=$'\e[32m'
c_yel=$'\e[33m'
c_cyn=$'\e[36m'
log() { printf '%s[build-all]%s %s\n' "$c_cyn" "$c_reset" "$*"; }
warn() { printf '%s[build-all] WARN:%s %s\n' "$c_yel" "$c_reset" "$*" >&2; }
err() { printf '%s[build-all] ERROR:%s %s\n' "$c_red" "$c_reset" "$*" >&2; }

field() { # field <manifest-row> <1-based index>
  echo "$1" | awk -F'|' -v n="$2" '{gsub(/^[ \t]+|[ \t]+$/,"",$n); print $n}'
}
row_for() { # row_for <key>  -> the manifest row, or empty
  local k="$1" r
  for r in "${MANIFEST[@]}"; do
    [ "$(field "$r" 1)" = "$k" ] && {
      echo "$r"
      return 0
    }
  done
  return 1
}
has_flag() { # has_flag <manifest-row> <flag>
  local flags flag
  flags="$(field "$1" 8)"
  flag="$2"
  case ",${flags// /}," in *",$flag,"*) return 0 ;; *) return 1 ;; esac
}

print_manifest() {
  printf '%s%-13s %-16s %-13s %-9s %-8s %-8s %s%s\n' "$c_bold" \
    KEY SCRIPT OUTPUT-DIR CLASS EST AUTO PRODUCES "$c_reset"
  local r
  for r in "${MANIFEST[@]}"; do
    printf '%-13s %-16s %-13s %-9s %-8s %-8s %s\n' \
      "$(field "$r" 1)" "$(field "$r" 2)" "$(field "$r" 3)" \
      "$(field "$r" 4)" "$(field "$r" 5)" "$(field "$r" 6)" "$(field "$r" 7)"
  done
  cat <<'EOF'

CLASS:  fast=live-ISO/prebuilt exotic  retro=prebuilt Win/DOS base+injection
        heavy=from-source compile or full unattended install  licensed=needs a supplied ISO
AUTO:   full=hands-off to GUI  full*=hands-off build, 1 runtime footnote
        1-click=one one-time interactive click/calibration  supplied=scripted once you supply source media
EOF
}

# ---------------------------------------------------------------------------
usage() { sed -n '/^# USAGE:/,/^# ====/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

ONLY=()
CLASS_FILTER=""
INCLUDE_LICENSED=0
WITH_MEDIA=0
FAIL_FAST=0
DRY_RUN=0
SKIP_VERIFY=0
CHECK_ASSETS=0
while [ $# -gt 0 ]; do
  case "$1" in
    --list)
      print_manifest
      exit 0
      ;;
    --only)
      [ $# -ge 2 ] || {
        err "--only requires a guest key"
        exit 2
      }
      ONLY+=("$2")
      shift 2
      ;;
    --only=*)
      ONLY+=("${1#*=}")
      shift
      ;;
    --class)
      [ $# -ge 2 ] || {
        err "--class requires a class"
        exit 2
      }
      CLASS_FILTER="$2"
      shift 2
      ;;
    --class=*)
      CLASS_FILTER="${1#*=}"
      shift
      ;;
    --with-media)
      WITH_MEDIA=1
      shift
      ;;
    --include-licensed)
      INCLUDE_LICENSED=1
      shift
      ;;
    --check-assets)
      CHECK_ASSETS=1
      shift
      ;;
    --fail-fast)
      FAIL_FAST=1
      shift
      ;;
    --skip-verify)
      SKIP_VERIFY=1
      shift
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      err "unknown arg: $1"
      usage
      exit 2
      ;;
  esac
done

# Resolve the list of guests to build and retain every media-gated omission for
# the notices and final summary.
BUILD_LIST=()
S_KEY=()
S_REASON=()
record_skip() {
  S_KEY+=("$1")
  S_REASON+=("$2")
}
if [ "${#ONLY[@]}" -gt 0 ]; then
  # explicit --only wins and can pull in any class (incl. licensed)
  for k in "${ONLY[@]}"; do
    if row_for "$k" >/dev/null; then BUILD_LIST+=("$k"); else
      err "no such guest: $k (see --list)"
      exit 2
    fi
  done
else
  for k in "${DEFAULT_ORDER[@]}"; do
    r="$(row_for "$k")"
    [ -z "$CLASS_FILTER" ] || [ "$(field "$r" 4)" = "$CLASS_FILTER" ] || continue
    if has_flag "$r" media && [ "$WITH_MEDIA" = 0 ]; then
      record_skip "$k" "Sailfish SDK emulator media required (use --with-media)"
    else
      BUILD_LIST+=("$k")
    fi
  done
  # Licensed guests are outside DEFAULT_ORDER and have their own explicit opt-in.
  for r in "${MANIFEST[@]}"; do
    [ "$(field "$r" 4)" = licensed ] || continue
    [ -z "$CLASS_FILTER" ] || [ "$CLASS_FILTER" = licensed ] || continue
    k="$(field "$r" 1)"
    if [ "$INCLUDE_LICENSED" = 1 ]; then
      BUILD_LIST+=("$k")
    else
      record_skip "$k" "user-supplied licensed ISO required (use --include-licensed)"
    fi
  done
fi

if [ "${#BUILD_LIST[@]}" -eq 0 ]; then
  for i in "${!S_KEY[@]}"; do warn "skipping ${S_KEY[$i]}: ${S_REASON[$i]}"; done
  err "nothing selected to build (check --class and media opt-in flags)"
  exit 2
fi

# Verify-skip pass-through: the per-guest scripts read either VERIFY or DO_VERIFY.
if [ "$SKIP_VERIFY" = 1 ]; then export VERIFY=0 DO_VERIFY=0; fi

# Optional asset preflight (docs/lab/ASSETS-MANIFEST.md): verify staged licensed
# media + repo assets + env vars for the selected guests BEFORE building anything.
if [ "$CHECK_ASSETS" = 1 ]; then
  ca_args=()
  for k in "${BUILD_LIST[@]}"; do ca_args+=(--only "$k"); done
  if ! "$SCRIPT_DIR/check-assets.sh" "${ca_args[@]}"; then
    err "asset preflight failed — stage the missing inputs (see docs/lab/ASSETS-MANIFEST.md)"
    exit 3
  fi
fi

log "gallery root : $GALLERY_ROOT"
log "build order  : ${BUILD_LIST[*]}"
[ "$DRY_RUN" = 1 ] && log "(dry-run: no guest scripts will be executed)"
for i in "${!S_KEY[@]}"; do warn "skipping ${S_KEY[$i]}: ${S_REASON[$i]}"; done
echo

# ---------------------------------------------------------------------------
declare -a R_KEY R_STATUS R_SECS
overall_rc=0
for key in "${BUILD_LIST[@]}"; do
  row="$(row_for "$key")"
  script="$SCRIPT_DIR/$(field "$row" 2)"
  dir="$GALLERY_ROOT/$(field "$row" 3)"
  est="$(field "$row" 5)"

  printf '%s============================================================%s\n' "$c_bold" "$c_reset"
  log "GUEST $c_bold$key$c_reset  (script=$(basename "$script"), est=$est, -> $dir)"

  if [ ! -x "$script" ] && [ ! -f "$script" ]; then
    err "missing build script: $script"
    R_KEY+=("$key")
    R_STATUS+=("MISSING")
    R_SECS+=("0")
    overall_rc=1
    if [ "$FAIL_FAST" = 1 ]; then break; else continue; fi
  fi

  if [ "$DRY_RUN" = 1 ]; then
    log "would run: bash $script"
    R_KEY+=("$key")
    R_STATUS+=("DRY")
    R_SECS+=("0")
    continue
  fi

  start=$(date +%s)
  # Run the guest build in its own process so env + set -e inside it are isolated.
  # stdout/stderr stream live; we only capture the exit code.
  if bash "$script"; then st="OK"; else
    st="FAIL"
    overall_rc=1
  fi
  secs=$(($(date +%s) - start))

  R_KEY+=("$key")
  R_STATUS+=("$st")
  R_SECS+=("$secs")
  if [ "$st" = OK ]; then log "$c_grn$key OK$c_reset in ${secs}s"; else err "$key FAILED after ${secs}s"; fi
  if [ "$st" = FAIL ] && [ "$FAIL_FAST" = 1 ]; then
    err "--fail-fast: stopping"
    break
  fi
  echo
done

# ---------------------------------------------------------------------------
echo
printf '%s================= build-all summary =================%s\n' "$c_bold" "$c_reset"
printf '%s%-16s %-8s %8s%s\n' "$c_bold" GUEST STATUS TIME "$c_reset"
for i in "${!R_KEY[@]}"; do
  s="${R_STATUS[$i]}"
  col="$c_reset"
  case "$s" in OK) col="$c_grn" ;; FAIL | MISSING) col="$c_red" ;; DRY | SKIP) col="$c_yel" ;; esac
  printf '%-16s %s%-8s%s %7ss\n' "${R_KEY[$i]}" "$col" "$s" "$c_reset" "${R_SECS[$i]}"
done
for i in "${!S_KEY[@]}"; do
  printf '%-16s %s%-8s%s %s\n' "${S_KEY[$i]}" "$c_yel" SKIPPED "$c_reset" "${S_REASON[$i]}"
done
echo
if [ "$overall_rc" = 0 ]; then
  if [ "$DRY_RUN" = 1 ]; then
    log "dry-run complete: ${#R_KEY[@]} guest command(s) shown; nothing was built."
  else
    log "${c_grn}all ${#R_KEY[@]} selected guest builds completed.$c_reset  Next: wire tiles via streamhost/tiles-manifest.sh + bring-up-all.sh."
  fi
  [ "${#S_KEY[@]}" -eq 0 ] || log "${#S_KEY[@]} media-gated builder(s) skipped; see the summary and opt-in flags above."
else
  if [ "$DRY_RUN" = 1 ]; then
    warn "dry-run found one or more missing guest scripts."
  else
    warn "one or more guests did not complete — re-run just those with --only <key> (add FORCE=1 to rebuild)."
  fi
fi
exit "$overall_rc"
