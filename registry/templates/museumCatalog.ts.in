// DO NOT EDIT — generated by scripts/tiles-registry.py generate from
// registry/tiles/*.json + registry/registry-v1.json; run `make tile-registry-generate`.
import type { VMManifestEntry } from '../types';
import { OS_BINDINGS } from '../three/archetypeRegistry';

// ============================================================================
//  MUSEUM CATALOG — placard metadata for the full OS lineup (@@LINEUP_COUNT@@ bindings)
//  ---------------------------------------------------------------------------
//  TODAY'S ARCHITECTURE: @@STREAMED_COUNT@@ of the museum's exhibits are streamhost tiles —
//  QEMU (or emulator-bridge) guests streamed by the Rust streamhost daemon over
//  WebTransport + WebCodecs. @@STREAMED_MUSEUM_ENTRY_COUNT@@ of those @@STREAMED_COUNT@@ have their placard entries in this
//  file; the trio (freedos/kolibrios/toaruos) come from the bundled base
//  manifest + data/catalog.ts. The three non-streamhost bindings are all
//  showcase posters (art + placard, no live connection attempt):
//    - win11  — its backing VM was deleted along with the legacy neko host
//      that fronted it over RDP,
//    - macos  — VM 925 and its VNC->WebSocket bridge were destroyed 2026-07-14,
//    - riscos — RISC OS is ARM/RPCEmu, so it has had no QEMU streamhost tile
//      since the neko plane was retired.
//  This file provides rich, period-accurate placard metadata for its @@MUSEUM_ENTRY_COUNT@@ entries
//  so all @@LINEUP_COUNT@@ exhibits render, each with an era-accurate archetype + accent.
//
//  mergeCatalog() overlays the bundled base manifest (the trio's core rows) on
//  top of these entries, so every osId in OS_BINDINGS becomes an exhibit.
// ============================================================================

// Curated, period-accurate metadata for every non-trio exhibit. The trio
// (freedos/kolibrios/toaruos) come from the bundled base manifest + data/catalog.ts.
const ENTRIES: VMManifestEntry[] = [
@@MUSEUM_ENTRIES@@
];

// Fast lookup.
const BY_ID: Record<string, VMManifestEntry> = Object.fromEntries(
  ENTRIES.map((e) => [e.id, e]),
);

/**
 * Merge the bundled base manifest (the freedos/kolibrios/toaruos rows, passed
 * in by useManifest) with this catalog, so EVERY osId in OS_BINDINGS becomes an
 * exhibit. Base entries win on any field they define — the catalog fills the
 * rest and supplies all the non-trio exhibits.
 */
export function mergeCatalog(base: VMManifestEntry[]): VMManifestEntry[] {
  const baseById: Record<string, VMManifestEntry> = Object.fromEntries(
    base.map((e) => [e.id, e]),
  );

  // One exhibit per osId declared in the binding registry (the source of truth
  // for the lineup), deduped. Prefer base-manifest data, then catalog, then a
  // minimal stub so an unmapped binding still renders rather than vanishing.
  return Object.keys(OS_BINDINGS).map((osId) => {
    const baseEntry = baseById[osId];
    const catalogEntry = BY_ID[osId];
    if (baseEntry && catalogEntry) return { ...catalogEntry, ...baseEntry };
    if (baseEntry) return baseEntry;
    if (catalogEntry) return catalogEntry;
    const b = OS_BINDINGS[osId];
    return {
      id: osId,
      displayName: osId,
      year: parseInt(b.eraLabel, 10) || 2000,
      lineage: b.eraLabel,
      arch: 'unknown',
      accent: b.accentColor,
    } satisfies VMManifestEntry;
  });
}

export const CATALOG_ENTRIES = ENTRIES;
