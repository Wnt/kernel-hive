# --- GOLDEN FIXTURE (scaffolded for @@OS_ID@@, tier @@TIER@@) ---
# resetMode=loadvm: reset the guest between visitors with QMP 'loadvm golden'.
# The 'golden' savevm snapshot lives INSIDE the state disk below; recapture only via
# `ssh lab 'checkpoint-guard recapture @@OS_ID@@'`.
SH_RESET_MODE=loadvm
SH_GOLDEN_SNAPSHOT=golden
SH_GOLDEN_STATE_DISK=/data/vms/streamhost/stations/@@OS_ID@@/state.qcow2
SH_FIXTURE_DESC=TODO-describe-the-curated-@@OS_ID@@-fixture
