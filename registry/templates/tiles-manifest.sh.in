#!/bin/bash
# DO NOT EDIT — generated by scripts/tiles-registry.py generate from
# registry/tiles/*.json + registry/registry-v1.json; run `make tile-registry-generate`.
# tiles-manifest.sh — registry-generated recipe for all @@PRODUCTION_COUNT@@ production
# gallery tiles. Each `emit` line re-emits one tile's per-tile files (tile.env,
# ROLLBACK.md, and for local modes qemu-streamhost.sh) under the tile runtime
# directory by invoking scripts/streamhost-tile.sh.
#
# Run ON the host (root@192.0.2.10) after an NVMe rebuild, once
# scripts/streamhost-tile.sh + deploy/streamhost@.service are in place:
#     bash tiles-manifest.sh                 # emits all @@PRODUCTION_COUNT@@ production tiles' files
#     bash tiles-manifest.sh --install       # also drops the systemd unit (once)
#     bash tiles-manifest.sh --pin-machine   # versioned machine types (NVMe rebuild;
#                                            # see streamhost-tile.sh header)
#     bash tiles-manifest.sh --out-root /tmp/x   # scratch emit (verify-emit.sh)
#
# It does NOT start QEMU or the daemons — bring-up-all.sh does the full ordered
# boot. This file is purely the "what reproduces each tile" ledger.
#
# THREE QEMU MODES (see scripts/streamhost-tile.sh):
#   * GENERIC tiles pass the full media/machine/audio/input flag set and the
#     launcher is generated from the standard template.
#   * VERBATIM tiles pass --launcher-file tiles/<tile>/qemu-streamhost.sh — a
#     tracked, byte-exact launcher carrying that tile's bespoke logic (golden
#     state-qcow2 create-if-missing, conditional/unconditional -loadvm golden,
#     per-boot overlays, post-boot QMP hostfwd_add, serial chardevs, reset
#     monitors). For those tiles the launcher FILE is the device-set ledger;
#     the emit line only carries the tile.env-relevant flags.
#   * PVE tiles pass --pve-vmid. PVE owns QEMU; the emitter writes its SH_PVE_*
#     environment and deliberately generates no qemu-streamhost.sh. `qm config`
#     captured in the registry is the device-set ledger.
#   Golden-fixture tile.env stanzas are tracked per tile in
#   tiles/<tile>/tile.env.fixture and appended verbatim (--env-append-file).
#
# PARITY GATE: scripts/dev/verify-emit.sh (repo) emits all @@PRODUCTION_COUNT@@ production tiles into a
# scratch dir on the box and byte-diffs against the live tiles. Keep it green
# (PASS or whitelisted-with-justification) after ANY change here.
#
# osId vs tile-dir note: osId "solaris" == tile dir "solariscde"; every other osId
# equals its tile dir name. streamhost-tile.sh keys everything on the TILE DIR
# name (--tile), and tiles.json maps osId->tile.
set -e
HERE="$(cd "$(dirname "$0")" && pwd)"
SH="$HERE/scripts/streamhost-tile.sh"
T="$HERE/tiles"                        # tracked verbatim launchers + env fixtures
RUNTIME_T="/data/vms/streamhost/tiles" # runtime tile root (referenced in args)

FWD=()
OUT_ROOT="$RUNTIME_T"
while [ $# -gt 0 ]; do
  case "$1" in
    --install)
      FWD+=(--install)
      shift
      ;;
    --pin-machine)
      FWD+=(--pin-machine)
      shift
      ;;
    --out-root)
      OUT_ROOT="$2"
      FWD+=(--out-root "$2")
      shift 2
      ;;
    *)
      echo "unknown arg: $1" >&2
      exit 2
      ;;
  esac
done

# ---------------------------------------------------------------------------
# PREFLIGHT — every tile.env fixture referenced below must exist BEFORE we emit
# anything. A single missing --env-append-file used to kill the run mid-fleet
# (set -e inside emit), leaving every later tile unemitted and unchecked while
# the truncated output still read as progress. That is the silent-cap failure
# mode: validate the whole set up front, name EVERY missing file, emit nothing.
# Fixtures are repo-tracked build inputs (streamhost/tiles/<tile>/tile.env.fixture);
# if they are missing here, this copy of the kit is incomplete — run the sweep
# from a full checkout (scripts/dev/verify-emit.sh) or sync the named files in.
# ---------------------------------------------------------------------------
FIXTURES=()
MISSING_FIXTURES=()
# shellcheck disable=SC2016 # the grep/sed patterns match the LITERAL "$T/…" text of this file
while IFS= read -r fx; do
  [ -n "$fx" ] || continue
  FIXTURES+=("$fx")
  [ -f "$T/$fx" ] || MISSING_FIXTURES+=("$fx")
done < <(grep -oE -- '--env-append-file "\$T/[^"]+"' "$0" | sed 's|.*\$T/||; s|"$||' | sort -u)
if [ "${#MISSING_FIXTURES[@]}" -gt 0 ]; then
  echo "FATAL: ${#MISSING_FIXTURES[@]} of ${#FIXTURES[@]} tile.env fixtures are missing under $T —" >&2
  printf '  MISSING FIXTURE: %s\n' "${MISSING_FIXTURES[@]}" >&2
  echo "NOTHING WAS EMITTED. This manifest refuses to run a partial sweep." >&2
  exit 1
fi
echo "=== preflight: ${#FIXTURES[@]}/${#FIXTURES[@]} tile.env fixtures present under $T"

EMITTED=0
emit() {
  echo "=== emit: $1"
  shift
  bash "$SH" "$@" ${FWD[@]+"${FWD[@]}"}
  EMITTED=$((EMITTED + 1))
}

# ---------------------------------------------------------------------------
# GROUP A — modern Linux / hobby-OS LiveCDs & disks, USB-tablet abs pointer,
#           intel-hda or AC97 audio, KVM.
@@TILE_EMITS@@

# ---------------------------------------------------------------------------
# Pre-seed steps the manifest performs (documented per tile above)
# ---------------------------------------------------------------------------
# postmarketos: writable qcow2 UEFI varstore (the verbatim launcher expects it;
# seed ONCE — never clobber an existing one, phosh's boot entry lives in it).
PMOS_VARS="$OUT_ROOT/postmarketos/OVMF_VARS.qcow2"
PMOS_SRC=/usr/share/pve-edk2-firmware/OVMF_VARS_4M.fd
if [ ! -f "$PMOS_VARS" ]; then
  if command -v qemu-img >/dev/null 2>&1 && [ -f "$PMOS_SRC" ]; then
    qemu-img convert -f raw -O qcow2 "$PMOS_SRC" "$PMOS_VARS"
    echo "=== pre-seed: postmarketos OVMF_VARS.qcow2 created from $PMOS_SRC"
  else
    echo "WARN: cannot pre-seed $PMOS_VARS (qemu-img or $PMOS_SRC missing) — do it before first boot" >&2
  fi
fi

# Truncation guard: a sweep that covered fewer tiles than the roster must never
# exit 0 — a short run is a failed run, not an "all clear".
if [ "$EMITTED" -ne @@PRODUCTION_COUNT@@ ]; then
  echo "FATAL: emitted $EMITTED tiles but the production roster is @@PRODUCTION_COUNT@@ — the sweep was truncated." >&2
  exit 1
fi
echo "=== all @@PRODUCTION_COUNT@@ production tiles emitted ==="
