# registry/local.env.example — deployment-local operator values.
#
# Copy this file to registry/local.env (gitignored, never committed) and fill
# in the box's real values. streamhost/scripts/streamhost-tile.sh sources it
# automatically when emitting tile.env for a tile, UNLESS the caller passed an
# explicit --host-ip flag (which always wins).
#
# This file is deploy-time only. It has NO effect on `scripts/tiles-registry.py
# generate` / `make tile-registry-generate`: registry/index.json (and every
# other generated artifact CI checks via `make tile-registry-check`) keeps the
# repo placeholder 192.0.2.10 regardless of what this file contains, so the
# generated-file drift check stays deterministic for everyone.

# The box's real LAN IPv4 address, advertised to browsers in each tile's
# signaling.json as the host to dial for the WebTransport session. Falls back
# to the placeholder 192.0.2.10 (unroutable, RFC 5737 TEST-NET-1) when this
# file is absent or this key is unset.
SH_HOST_IP=192.0.2.10
