# registry/local.env.example — deployment-local operator values.
#
# Copy this file to registry/local.env (gitignored, never committed) and fill
# in the box's real values. Every tool below sources it automatically (via the
# shared helper scripts/lib/local-env.sh — see registry/README.md), UNLESS the
# caller already set the same variable (an explicit CLI flag or a pre-set
# environment variable always wins over this file).
#
# This file is deploy/run-time only. It has NO effect on
# `scripts/tiles-registry.py generate` / `make tile-registry-generate`:
# registry/index.json (and every other generated artifact CI checks via
# `make tile-registry-check`) keeps the repo's scrubbed placeholders regardless
# of what this file contains, so the generated-file drift check stays
# deterministic for everyone, including a fresh clone with no local.env.

# The box's real LAN IPv4 address. Advertised to browsers in each tile's
# signaling.json as the host to dial for the WebTransport session, and reused
# as the default HOST/LAN_IP/SIGNAL_HOST/BASE_URL by scripts/serve-https-spa.sh,
# scripts/serve/restart-https.sh, scripts/serve/gen-local-ca.sh,
# scripts/dev/verify-tile.sh, scripts/dev/mobile-netem.sh,
# streamhost/run/serve_client.sh, and streamhost/bring-up-all.sh. If wrong,
# the SPA/signal/cert endpoints get minted for an address the browser cannot
# reach and every one of those tools fails or serves the wrong origin. Falls
# back to the placeholder 192.0.2.10 (unroutable, RFC 5737 TEST-NET-1) when
# this file is absent or this key is unset.
SH_HOST_IP=192.0.2.10

# The forwarder VPS's public hostname that the box dials OUT to for the
# cloud-agent SSH door and (optionally) the public gallery tunnel. Used as the
# default FORWARDER_HOST/CA_CONTROL_HOST/LAB_SSH_HOST by the scripts under
# scripts/cloud-agents/. If wrong, `ssh lab` from a cloud agent VM and the
# public gallery tunnel dial the wrong (or no) host. Falls back to the
# placeholder tunnel.example.com when this file is absent or this key is
# unset.
SH_TUNNEL_HOST=tunnel.example.com

# The public gallery's own hostname, published through the forwarder edge. Used
# as the default GALLERY_HOST by scripts/cloud-agents/box-endpoint-setup.sh. If
# wrong, the public gallery tunnel publishes under the wrong name. Falls back to
# the placeholder gallery.example.com when this file is absent or this key is
# unset. Leave SH_GALLERY_HOST unset (or export GALLERY_HOST=) to keep the
# gallery unpublished, same as upstream GALLERY_HOST semantics.
SH_GALLERY_HOST=gallery.example.com
