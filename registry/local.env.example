# registry/local.env.example — deployment-local operator values.
#
# Copy this file to registry/local.env (gitignored, never committed) and fill
# in the box's real values. Every tool below sources it automatically (via the
# shared helper scripts/lib/local-env.sh — see registry/README.md), UNLESS the
# caller already set the same variable (an explicit CLI flag or a pre-set
# environment variable always wins over this file).
#
# This file is deploy/run-time only. It has NO effect on
# `scripts/stations-registry.py generate` / `make station-registry-generate`:
# registry/index.json (and every other generated artifact CI checks via
# `make station-registry-check`) keeps the repo's scrubbed placeholders regardless
# of what this file contains, so the generated-file drift check stays
# deterministic for everyone, including a fresh clone with no local.env.

# The box's real LAN IPv4 address. Advertised to browsers in each tile's
# signaling.json as the host to dial for the WebTransport session, and reused
# as the default HOST/LAN_IP/SIGNAL_HOST/BASE_URL by scripts/serve-https-spa.sh,
# scripts/serve/restart-https.sh, scripts/serve/gen-local-ca.sh,
# scripts/dev/verify-tile.sh, scripts/dev/mobile-netem.sh,
# streamhost/run/serve_client.sh, and streamhost/bring-up-all.sh. If wrong,
# the SPA/signal/cert endpoints get minted for an address the browser cannot
# reach and every one of those tools fails or serves the wrong origin. Falls
# back to the placeholder 192.0.2.10 (unroutable, RFC 5737 TEST-NET-1) when
# this file is absent or this key is unset.
SH_HOST_IP=192.0.2.10

# The forwarder VPS's public hostname that the box dials OUT to for the
# cloud-agent SSH door and (optionally) the public gallery tunnel. Used as the
# default FORWARDER_HOST/CA_CONTROL_HOST/LAB_SSH_HOST by the scripts under
# scripts/cloud-agents/. If wrong, `ssh lab` from a cloud agent VM and the
# public gallery tunnel dial the wrong (or no) host. Falls back to the
# placeholder tunnel.example.com when this file is absent or this key is
# unset.
SH_TUNNEL_HOST=tunnel.example.com

# The public gallery's own hostname, published through the forwarder edge. Used
# as the default GALLERY_HOST by scripts/cloud-agents/box-endpoint-setup.sh. If
# wrong, the public gallery tunnel publishes under the wrong name. Falls back to
# the placeholder gallery.example.com when this file is absent or this key is
# unset. Leave SH_GALLERY_HOST unset (or export GALLERY_HOST=) to keep the
# gallery unpublished, same as upstream GALLERY_HOST semantics.
SH_GALLERY_HOST=gallery.example.com

# --- retronet ICQ gateway (docs/lab/retronet/GATEWAY.md) --------------------
#
# WRITTEN, NOT COPIED. scripts/retronet/gateway/provision-gateway-ct.sh
# generates the two passwords on the first provisioning run and writes all six
# keys into registry/local.env itself; the same values also live in the gateway
# CT's own /etc/ras/accounts.env. You only fill these in by hand if you are
# pointing lab tooling at a gateway somebody else built. Re-running the
# provisioner READS the recorded passwords back and converges the server on
# them, so a rebuilt CT keeps the credentials the bot and the station hold —
# which is also why deleting the two _PASS lines is how you rotate them.
#
# The greeter bot (a labhost systemd unit) is the main consumer: it signs in as
# the bot UIN against RETRONET_ICQ_HOST:RETRONET_ICQ_PORT. That address is the
# LABHOST-side OSCAR door; a station behind slirp reaches a different one. Never
# hand a guest these values — see GATEWAY.md §Two doors.
#
# The UINs are ICQ UINs and must be >= 10000: Mirabilis reserved everything
# below that and the server rejects it outright.
RETRONET_ICQ_HOST=10.99.0.2
RETRONET_ICQ_PORT=5190
RETRONET_ICQ_BOT_UIN=10000
RETRONET_ICQ_BOT_PASS=changeme
RETRONET_ICQ_PERSONA_UIN=98980
RETRONET_ICQ_PERSONA_PASS=changeme

# retronet-dhcp per-station reservations: space/comma-separated mac=ip, so a known
# station keeps a STABLE IP (exec-over-bridge targets <ip>:7788). install-dhcp.sh
# renders these into the CT. REAL guest MACs are box-local — never commit them;
# these are placeholders. Each reservation needs a UNIQUE guest MAC (see
# WEB-PROXY.md, "The fleet-shared-MAC caveat").
RETRONET_DHCP_RESERVATIONS="02:00:00:00:00:10=10.99.0.10 02:00:00:00:00:11=10.99.0.11"

# --- Instana forwarding (scripts/observability/instana-forward.py) -----------
# OFF unless INSTANA_ENDPOINT is set. This is the ONLY thing in this repo that
# sends data to a third party, so it is opt-in, has a --dry-run that prints the
# exact bytes before any of them leave, and is not wired into any timer.
#
# There is no universal Instana host: the OTLP acceptor is per-tenant and
# per-region, so this must come from your own Instana account. It must be https
# — the forwarder refuses anything else rather than downgrading a credential
# plus behavioural data to cleartext on a config typo.
# The otlp-acceptor for your REGION, which is NOT the word in your tenant name:
# resolve the tenant host and read the CNAME (ours is a CNAME to blue.instana.io,
# despite a tenant called teal-…). Documented forms, port 443:
#   https://otlp-http-<colour>-saas.instana.io:443   (OTLP/HTTP, what we use)
#   otlp-grpc-<colour>-saas.instana.io:443           (OTLP/gRPC)
# Colours seen in the docs: blue, red, green, orange, coral.
INSTANA_ENDPOINT=https://otlp-http-<colour>-saas.instana.io:443
#
# TWO DIFFERENT CREDENTIALS, and they are not interchangeable:
#   agent-key  Instana's DATA INGESTION key. This is what an OTLP acceptor
#              wants, and it is sent as `x-instana-key`.
#   api-token  the REST/configuration credential, sent as `Authorization:
#              apiToken ...`. It CANNOT ingest spans. Using it for ingestion
#              produces a 401 that reads like a network fault for an afternoon.
INSTANA_AUTH_MODE=agent-key
# TWO SEPARATE FILES, not one — losing track of which credential is which cost
# a debugging afternoon once (see INSTANA_AUTH_MODE's comment above), so the
# filenames themselves now say what each one is FOR:
#   instana-agent.key   the ingestion key (INSTANA_TOKEN_FILE, used above by
#                        instana-forward.py — `x-instana-key`)
#   instana.token        the personal API token (INSTANA_API_TOKEN_FILE, used
#                        by any Web REST / config call this repo makes —
#                        `Authorization: apiToken ...` — e.g. creating the EUM
#                        website config below, and
#                        scripts/serve-https-spa.sh's publish_instana_
#                        sourcemaps). Create one under your account: Instana UI
#                        -> your user menu -> "My settings" -> API Tokens.
# Neither is ever put here directly — both live in files, and
# scripts/serve/pki/ is gitignored wholesale (`**/pki/`) on top of the global
# `*.token` rule.
INSTANA_TOKEN_FILE=scripts/serve/pki/instana-agent.key
INSTANA_API_TOKEN_FILE=scripts/serve/pki/instana.token
# Your tenant unit's own URL (Web REST / config API base — a DIFFERENT host
# family again from both INSTANA_ENDPOINT's otlp-http-<colour>-saas and EUM's
# eum-<colour>-saas below: this one is the same host the Instana UI itself
# loads at). Find it in your browser's address bar while signed into Instana.
INSTANA_API_BASE=https://<unit>-<tenant>.instana.io
# Which client classes to forward. Everything, by default, because the point of
# forwarding is comparing the same population in two UIs — but this lab's own
# browser probes are class `probe`, so narrow it to `human` if you want Instana
# to see only real visitors.
# Instana REQUIRES a host identity — a `host.id` resource attribute or the
# `x-instana-host` header — and uses it to link OTel entities to a host.
# Without one, data is refused or orphaned, which looks like a broken exporter.
# Defaults to the box's hostname.
# INSTANA_HOST_ID=labhost
INSTANA_CLASSES=human,probe,unknown

# --- Instana EUM (browser-side End User Monitoring) -------------------------
# A SECOND, SEPARATE Instana integration from the OTLP forwarder above, and
# opt-in the same way: unset means unconfigured, and spa/index.html's bootstrap
# guarantees that means nothing loads and nothing is sent (see its comment,
# and spa/src/analytics/instana.ts). Where the forwarder above re-ships OUR
# OWN already-collected telemetry, this makes each visitor's BROWSER talk to
# Instana directly — beacons for page loads, API calls, sessions and errors
# leave the browser for IBM's SaaS on every visit this is armed for. Read
# spa/src/analytics/instana.ts before turning this on for anyone but yourself.
#
# The website id from Instana's EUM setup (Websites & Mobile Apps -> your
# website -> Setup). Despite the name this is NOT a secret in the credential
# sense (it is baked into a public HTML bootstrap the same way a Google
# Analytics id is), but it still identifies YOUR tenant, so it stays out of
# the committed placeholders like every other value in this file.
INSTANA_WEBSITE_KEY=
# Your EUM SaaS unit's reporting endpoint — same colour-per-tenant caveat as
# INSTANA_ENDPOINT above (resolve the tenant host, read the CNAME); the EUM
# acceptor is a DIFFERENT hostname family (eum-<colour>-saas.instana.io) from
# the OTLP one (otlp-http-<colour>-saas.instana.io).
INSTANA_EUM_REPORTING_URL=https://eum-<colour>-saas.instana.io
# Where scripts/serve-https-spa.sh's publish_instana_agent fetches the pinned
# agent build from, at DEPLOY time — never committed, never bundled by Vite.
# Pin an exact version path from Instana's EUM setup page rather than a bare
# "latest" alias, the same reasoning as pinning any other third-party script.
INSTANA_EUM_SCRIPT_URL=https://eum.instana.io/eum.min.js

# JavaScript source-map upload — lets Instana turn a minified stack-trace
# frame back into a real file/line ("JS Stack Trace Translation" in the UI).
# scripts/serve-https-spa.sh's publish_instana_sourcemaps runs at deploy time,
# reads the .map files vite.config.ts's `sourcemap: true` build already
# produced, and PUTs each one to Instana keyed by that build's asset URL. The
# same maps are ALSO served publicly (deploy() ships them beside the JS, and
# `sourceMappingURL` points at them) — the built bundle is already
# unauthenticated (only the app shell at '/' is passkey-gated) and the source
# is the openly-public kernel-hive GitHub repo, so a public map reveals
# nothing new. This upload is kept anyway: it's deterministic and doesn't
# depend on Instana's crawler reaching us or on timing, where public serving
# is for a human with devtools open. See vite.config.ts and
# serve-https-spa.sh's deploy()/publish_instana_sourcemaps for the full
# reasoning.
#
# The id of an Instana "File Upload Configuration" for this website. IBM's own
# docs only show this created BY HAND in the UI (website's Configuration tab
# -> JS Stack Trace Translation -> File Download Configurations -> Add
# Configuration) — but the SAME config REST endpoint that creates the website
# above (INSTANA_WEBSITE_KEY) also accepts a POST here, undocumented but
# confirmed working 2026-08-31:
#   curl -X POST -H "authorization: apiToken $(cat scripts/serve/pki/instana.token)" \
#     -H 'Content-Type: application/json' -d '{"description":"kernel-hive-spa"}' \
#     "$INSTANA_API_BASE/api/website-monitoring/config/$INSTANA_WEBSITE_KEY/sourcemap-upload"
# The response's "id" is this value. One-time setup; the same config id is
# reused (overwritten in place) on every deploy.
INSTANA_SOURCEMAP_UPLOAD_CONFIG_ID=

# Since 2026-08-31 labhost also runs an Instana HOST AGENT, which exposes its
# own OTLP receivers on 127.0.0.1:4317 (gRPC) and 127.0.0.1:4318 (HTTP) —
# LOOPBACK ONLY. The forwarder prefers this leg when it is reachable (probed
# with a plain TCP connect, no OTLP traffic): it keeps egress on the box and
# gets host correlation for free, because the agent supplies host identity
# itself — unlike the direct-to-SaaS leg above, this one does NOT need
# INSTANA_HOST_ID and does NOT send the x-instana-key/api-token credential
# (confirmed empirically 2026-08-31: the local receiver accepts an OTLP POST
# with no key and with a bogus one identically — it is not checking one).
# Not a secret and not per-tenant, so it has a real default
# (http://127.0.0.1:4318) and does not need to be set here at all; override
# only for a non-standard agent install. Plain http is accepted ONLY because
# this is loopback — the forwarder still refuses http to anything else.
# INSTANA_OTLP_AGENT_ENDPOINT=http://127.0.0.1:4318
#
# Force one leg instead of auto-detecting: --via-agent or --via-saas on the
# command line (see scripts/observability/instana-forward.py --help).
