10 REM ROMAN NUMERALS
20 INPUT "Number from 1 to 3999";N
30 IF N<1 OR N>3999 THEN 20
40 N=INT(N):R$="":RESTORE
50 FOR I=1 TO 13:READ V,S$
60 WHILE N>=V:R$=R$+S$:N=N-V:WEND
70 NEXT
80 PRINT "In Roman numerals: ";R$
90 PRINT:GOTO 20
100 DATA 1000,M,900,CM,500,D,400,CD
110 DATA 100,C,90,XC,50,L,40,XL
120 DATA 10,X,9,IX,5,V,4,IV,1,I
