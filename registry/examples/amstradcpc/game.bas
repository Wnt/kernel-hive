10 REM SQUASH - Z LEFT, X RIGHT
20 MODE 1:S=0:B=18:X=20:Y=2:DX=1:DY=1
30 LOCATE X,Y:PRINT " ";
40 X=X+DX:Y=Y+DY
50 IF X=2 OR X=39 THEN DX=-DX
60 IF Y=1 THEN DY=1
70 IF INKEY(71)=0 AND B>2 THEN B=B-1
80 IF INKEY(63)=0 AND B<36 THEN B=B+1
90 LOCATE B-1,24:PRINT " ==== ";
100 LOCATE X,Y:PRINT "O";:FRAME:FRAME:FRAME
110 IF Y<23 THEN 30
120 IF X<B OR X>B+3 THEN 140
130 DY=-1:S=S+1:SOUND 1,100,5:LOCATE 1,25:PRINT "Score";S;:GOTO 30
140 LOCATE 13,12:PRINT "Missed! Score";S
150 LOCATE 10,14:PRINT "Press SPACE to play"
160 WHILE INKEY$<>" ":WEND:RUN
