10 HOME : PRINT "PRIME CHECKER - TYPE 0 TO STOP"
20 PRINT : INPUT "A WHOLE NUMBER? ";N
30 IF N = 0 THEN END
40 IF N < 2 OR N <> INT (N) THEN PRINT "TRY 2 OR MORE.": GOTO 20
50 IF N < 4 THEN 90
60 FOR D = 2 TO SQR (N)
70 IF N / D = INT (N / D) THEN PRINT N;" = ";D;" X ";N / D: GOTO 20
80 NEXT D
90 PRINT N;" IS PRIME."
100 GOTO 20
