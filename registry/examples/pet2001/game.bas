10 REM GUESS THE NUMBER
20 X=RND(-TI):N=INT(RND(1)*100)+1:T=0
30 PRINT CHR$(147);"GUESS MY NUMBER FROM 1 TO 100."
40 PRINT:INPUT "YOUR GUESS";G:T=T+1
50 IF G<N THEN PRINT "HIGHER...":GOTO 40
60 IF G>N THEN PRINT "LOWER...":GOTO 40
70 PRINT "YES! YOU FOUND IT IN";T;"GUESSES."
80 PRINT:INPUT "PLAY AGAIN (Y/N)";A$
90 IF A$="Y" THEN 20
