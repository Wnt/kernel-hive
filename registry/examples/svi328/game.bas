NEW
10 REM GUESS MY NUMBER, 1 TO 100
20 CLS:R=RND(-TIME):N=INT(RND(1)*100)+1:T=0
30 PRINT "I AM THINKING OF A NUMBER."
40 INPUT "YOUR GUESS";G:T=T+1
50 IF G<N THEN PRINT "HIGHER!":GOTO 40
60 IF G>N THEN PRINT "LOWER!":GOTO 40
70 PRINT "RIGHT! NUMBER OF GUESSES:";T
80 PLAY "O4CEGO5C"
90 PRINT "PRESS SPACE TO PLAY AGAIN."
100 IF INKEY$<>" " THEN 100 ELSE RUN
