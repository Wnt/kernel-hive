10 REM SKI RUN - Z LEFT, X RIGHT
20 CLS:PAPER 7:INK 4:X=20:S=0
30 PRINT SPC(RND(1)*36);"*"
40 K$=KEY$
50 IF K$="Z" AND X>2 THEN X=X-1
60 IF K$="X" AND X<37 THEN X=X+1
70 IF SCRN(X,8)=42 THEN 100
80 PLOT X,8,"V":S=S+1
90 GOTO 30
100 EXPLODE:PRINT "CRASH! YOU SKIED";S;"METRES"
110 PRINT "PRESS SPACE TO SKI AGAIN"
120 GET K$:IF K$<>" " THEN 120
130 GOTO 20
