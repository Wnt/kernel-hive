10 REM LETTER HUNT
20 SCNCLR:X=RND(-TI):M=0
30 PRINT "TYPE EACH LETTER AS SOON AS YOU SEE IT - TEN OF THEM."
40 T=TI:FOR I=1 TO 10:L$=CHR$(65+INT(RND(1)*26))
50 X=INT(RND(1)*78):Y=3+INT(RND(1)*19):CHAR 1,X,Y,L$
60 GETKEY K$:IF K$<>L$ THEN M=M+1:SOUND 1,2000,5:GOTO 60
70 CHAR 1,X,Y," ":SOUND 1,30000,2:NEXT I
80 PRINT CHR$(19);CHR$(17);"TIME";INT((TI-T)/6)/10;"SECONDS, MISSES";M
90 PRINT "PLAY AGAIN (Y/N)?":GETKEY A$:IF A$="Y" THEN RUN
