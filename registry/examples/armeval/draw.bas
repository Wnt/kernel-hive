10 REM MANDELBROT ON A 1986 ARM
20 MODE 2:T%=TIME
30 FOR Y%=0 TO 127:B=Y%/106-1.2
40 FOR X%=0 TO 159:A=X%/50-2.3
50 U=0:V=0:N%=0
60 REPEAT P=U*U:Q=V*V:V=(U+U)*V+B
70 U=P-Q+A:N%=N%+1:UNTIL N%=16 OR P+Q>4
80 IF N%=16 THEN 110
90 GCOL 0,N% MOD 7+1:PLOT 69,X%*8,Y%*4
100 PLOT 69,X%*8,1020-Y%*4
110 NEXT:NEXT
120 PRINT TAB(0,0);(TIME-T%)/100;" SECONDS"
