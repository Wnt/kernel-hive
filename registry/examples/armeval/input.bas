10 REM COUNT THE PRIMES
20 INPUT "COUNT PRIMES BELOW",N%
30 IF N%<3 OR N%>500000 THEN 20
40 T%=TIME:DIM S%(N%):C%=0:R%=SQR(N%)
50 FOR I%=2 TO N%-1
60 IF S%(I%) THEN 90
70 C%=C%+1:IF I%>R% THEN 90
80 FOR J%=I%*I% TO N%-1 STEP I%:S%(J%)=1:NEXT
90 NEXT
100 PRINT C%;" PRIMES BELOW ";N%
110 PRINT "FOUND IN ";(TIME-T%)/100;" SECONDS"
120 PRINT:RUN
