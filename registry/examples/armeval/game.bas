10 REM REACTION TIMER
20 B=99
30 MODE 7:VDU 23,1,0;0;0;0;
40 PRINT TAB(4,4);"PRESS SPACE WHEN THE STAR SHOWS"
50 T%=TIME+150+RND(300):E%=0
60 REPEAT E%=INKEY(-99):UNTIL TIME>T% OR E%
70 IF E% THEN PRINT TAB(15,12);"TOO SOON!":GOTO 130
80 PRINT TAB(19,10);"*":T%=TIME
90 REPEAT UNTIL INKEY(-99)
100 R=(TIME-T%)/100:IF R<B THEN B=R
110 PRINT TAB(10,12);"YOUR TIME: ";R;" S"
120 PRINT TAB(10,14);"BEST TIME: ";B;" S"
130 PRINT TAB(7,18);"PRESS RETURN TO GO AGAIN"
140 REPEAT UNTIL GET=13:GOTO 30
