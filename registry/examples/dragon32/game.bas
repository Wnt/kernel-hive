10 REM ROAD RACE - ARROW KEYS STEER
20 CLS:X=15:R=10:S=0:P=111
30 PRINT@480,STRING$(R," ");STRING$(12,128)
40 S=S+1:IF S>16 AND PEEK(1120+X)<>128 THEN 90
50 PRINT@P-32,CHR$(128);:P=96+X:PRINT@P,"V";
60 IF RND(3)=1 THEN R=R+RND(3)-2
70 IF R<0 THEN R=0 ELSE IF R>19 THEN R=19
80 K$=INKEY$:X=X-(K$=CHR$(9))+(K$=CHR$(8)):GOTO 30
90 PRINT@196,"CRASH! DISTANCE";S;:SOUND 40,4
100 K$=INKEY$:IF K$=" " THEN RUN ELSE IF K$<>CHR$(3) THEN 100
