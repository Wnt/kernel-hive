NEW
10 REM I WILL GUESS YOUR NUMBER
20 TEXT : HOME : L=1 : H=100 : T=0
30 PRINT "THINK OF A NUMBER, 1-100."
40 PRINT "H=HIGHER, L=LOWER, Y=YES"
50 G=INT((L+H)/2) : T=T+1
60 PRINT "IS IT ";G;"? ";
70 GET K$ : PRINT K$
80 IF K$="H" THEN L=G+1
90 IF K$="L" THEN H=G-1
100 IF K$="Y" THEN 130
110 IF L<=H THEN 50
120 PRINT "THAT CANNOT BE!" : GOTO 140
130 PRINT "GOT IT! GUESSES: ";T
140 PRINT "ANY KEY = AGAIN, Q = QUIT"
150 GET K$ : IF K$<>"Q" THEN RUN
