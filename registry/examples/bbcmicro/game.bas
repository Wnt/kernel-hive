10 REM CATCH - Z LEFT, X RIGHT
20 MODE 7:VDU 23,1,0;0;0;0;
30 S%=0:B%=19
40 PRINT TAB(0,0);"SCORE ";S%
50 X%=RND(34)+2:FOR Y%=2 TO 22
60 IF INKEY(-98) AND B%>3 THEN B%=B%-2
70 IF INKEY(-67) AND B%<35 THEN B%=B%+2
80 PRINT TAB(X%,Y%-1);" ";TAB(X%,Y%);"*";
90 PRINT TAB(B%-3,23);"  ===  ";
100 T%=TIME:REPEAT UNTIL TIME>T%+12-S%/2
110 NEXT:PRINT TAB(X%,22);" ";
120 IF ABS(X%-B%)<2 THEN S%=S%+1:SOUND 1,-15,150,2:GOTO 40
130 PRINT TAB(11,10);"MISSED! SCORE ";S%
140 PRINT TAB(9,12);"PRESS SPACE TO PLAY"
150 REPEAT UNTIL GET=32:RUN
