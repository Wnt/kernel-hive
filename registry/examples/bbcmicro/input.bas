10 REM WHAT DAY WAS IT?
20 PRINT "TYPE A DAY, A MONTH AND A YEAR"
30 INPUT "DAY",D%,"MONTH",M%,"YEAR",Y%
40 IF M%<3 THEN M%=M%+12:Y%=Y%-1
50 K%=Y% MOD 100:J%=Y% DIV 100
60 H%=D%+13*(M%+1) DIV 5+K%+K% DIV 4
70 H%=(H%+J% DIV 4+5*J%) MOD 7
80 RESTORE:FOR I%=0 TO H%:READ W$:NEXT
90 PRINT "THAT WAS A ";W$:PRINT
100 GOTO 20
110 DATA SATURDAY,SUNDAY,MONDAY,TUESDAY
120 DATA WEDNESDAY,THURSDAY,FRIDAY
