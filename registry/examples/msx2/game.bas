NEW
10 REM CATCH THE STAR - CURSOR KEYS MOVE
20 SCREEN 1:WIDTH 32:KEY OFF:CLS
30 X=15:S=0:M=0:R=RND(-TIME)
40 LOCATE 0,0:PRINT "CAUGHT";S;" MISSED";M
50 IF M=3 THEN 140
60 A=INT(RND(1)*30)+1
70 FOR Y=2 TO 20 STEP .5:B=INT(Y)
80 IF TIME<2 THEN 80 ELSE TIME=0:D=STICK(0)
90 X=X+(D=3)*(X<29)-(D=7)*(X>2)
100 LOCATE A,B-1:PRINT " ";:LOCATE A,B:PRINT "*";
110 LOCATE X-2,21:PRINT " [_] ";:NEXT Y
120 LOCATE A,20:PRINT " ";:IF ABS(A-X)<2 THEN S=S+1 ELSE M=M+1:BEEP
130 GOTO 40
140 LOCATE 3,10:PRINT "GAME OVER - SPACE TO PLAY"
150 IF INKEY$<>" " THEN 150 ELSE RUN
