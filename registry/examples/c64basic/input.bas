10 REM BORDER COLOURS
20 DIM N$(15)
30 FOR I=0 TO 15
40 READ N$(I)
50 NEXT
60 PRINT CHR$(147);"PICK A COLOUR 0-15, OR -1 TO STOP"
70 INPUT C
80 IF C<0 OR C>15 THEN POKE 53280,14:END
90 C=INT(C)
100 POKE 53280,C
110 PRINT "THE BORDER IS ";N$(C)
120 GOTO 70
130 DATA BLACK,WHITE,RED,CYAN,PURPLE,GREEN,BLUE,YELLOW,ORANGE
140 DATA BROWN,LIGHT RED,DARK GREY,GREY,LIGHT GREEN,LIGHT BLUE,LIGHT GREY
