10 REM QUICK DRAW
20 PRINT CHR$(147);"WHEN THE SCREEN TURNS RED, PRESS A KEY!"
30 X=RND(-TI):POKE 198,0
40 T=TI+60+RND(1)*180
50 GET K$
60 IF K$<>"" THEN PRINT "TOO SOON - FALSE START!":GOTO 120
70 IF TI<T THEN 50
80 POKE 53281,2
90 S=TI
100 GET K$:IF K$="" THEN 100
110 POKE 53281,6:PRINT "YOU TOOK";INT((TI-S)/.6)/100;"SECONDS"
120 PRINT "PRESS Y TO PLAY AGAIN"
130 GET K$:IF K$="" THEN 130
140 IF K$="Y" THEN RUN
