10 REM STOP THE DOT
20 CLS:T=5+INT(RND(1)*30):LOCATE 12,T:PRINT "^"
30 FOR X=0 TO 37
40 LOCATE 11,X:PRINT " O ";
50 IF INKEY$<>"" THEN 70
60 NEXT X:LOCATE 11,38:PRINT " ":GOTO 30
70 LOCATE 14,0:PRINT "OFF BY";ABS(X+1-T)
80 PRINT "N TO STOP, ANY KEY TO REPLAY"
90 A$=INKEY$:IF A$="" THEN 90
100 IF A$="N" OR A$="n" THEN END
110 GOTO 20
