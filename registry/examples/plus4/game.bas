10 REM WHACK-A-MOLE
20 SCNCLR:X=RND(-TI):S=0
30 PRINT "PRESS THE NUMBER UNDER THE MOLE!"
40 CHAR 1,5,14,"1  2  3  4  5  6  7  8  9"
50 FOR R=1 TO 15:DO:GET K$:LOOP UNTIL K$=""
60 M=INT(RND(1)*9)+1:CHAR 1,2+M*3,12,"@"
70 T=TI+75:DO:GET K$:LOOP UNTIL K$<>"" OR TI>T
80 CHAR 1,2+M*3,12," "
90 IF K$=CHR$(48+M) THEN S=S+1:SOUND 1,900,6
100 CHAR 1,5,16,"SCORE"+STR$(S):T=TI+30:DO:LOOP UNTIL TI>T
110 NEXT R
120 CHAR 1,2,18,"YOU HIT"+STR$(S)+" OF 15 - AGAIN? (Y/N)"
130 GETKEY A$:IF A$="Y" THEN RUN
