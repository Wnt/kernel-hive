    "tilesManifestOrder": 17,
    "tilesManifestPrelude": "\n# msdoswin1 (VMID 113) — MS-DOS 6.22 + Windows 1.01, tiny 16MB, PS/2, ide disk.\n#   VERBATIM LAUNCHER: golden fixture — no -snapshot; post-boot `loadvm golden`\n#   + `cont` via the tile-local qmpc.py helper (installed via --aux-file).\n#   2026-07-13/14 streamhost fixes (docs/guests/msdos-win1.md):\n#   - SOUND: PC-speaker only — `-machine pc,pcspk-audiodev=snd0` (backend-only).\n#   - KEYBOARD: SH_LEGACY_KBD=1 — input.rs remaps the cursor cluster to bare\n#     keypad scancodes for this pre-1986 guest.\n#   - MOUSE: genuine Win 1.01 re-SETUP with the Windows 2.03 MOUSE.DRV (PS/2)\n#     + SETVER entries baked into the golden (\"Option B — PROMOTED LIVE\").\n",
    "tilesManifestInvocation": "emit msdoswin1 \\\n  --tile msdoswin1 --vmid 113 --udp 54113 --pointer rel --legacy-kbd 1 \\\n  --abs-pace-ms 30 --audio on --fps 60 \\\n  --launcher-file \"$T/msdoswin1/qemu-streamhost.sh\" \\\n  --aux-file \"$T/msdoswin1/qmpc.py\"\n",
    "bringUpGroup": 4,
