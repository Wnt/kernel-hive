    "tilesManifestOrder": 9,
    "tilesManifestPrelude": "\n# ---------------------------------------------------------------------------\n# GROUP C — disk-image Linux/Unix guests, USB-tablet abs pointer.\n# ---------------------------------------------------------------------------\n\n# android (VMID 101) — Android-x86 qcow2 on q35, virtio-blk + virtio-net,\n#   usb-tablet, intel-hda. VERBATIM LAUNCHER: golden fixture — runs WITHOUT\n#   -snapshot, boots -loadvm golden unconditionally, and exposes a dedicated\n#   HMP reset socket (reset-hmp.sock) for live loadvm resets.\n",
    "bringUpGroup": 2,
    "bindingOrder": 16,
    "bindingPrelude": "",
    "goldenOrder": 14,
    "actionMapOrder": 16
  },
