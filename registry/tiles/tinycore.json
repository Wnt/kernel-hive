  "render": {
    "signalOrder": 4,
    "tilesManifestOrder": 1,
    "tilesManifestPrelude": "\n# tinycore (VMID 82) — TinyCore LiveCD + golden fixture. VERBATIM LAUNCHER:\n#   state.qcow2 (3G virtio) for the golden snapshot; conditional -loadvm golden;\n#   post-boot QMP hostfwd_add 127.0.0.1:5882 -> guest :22 (user 'tc').\n#   ISO at /data/isos/TinyCore.iso (canonical; old /data/vms/spikeA path\n#   whitelisted). Resolution 1600x1200x32 (4:3, under the 1920x1200 cap; set in\n#   the guest .xsession Xvesa -screen). Cursor calibration (2026-07): TinyCore's\n#   Xvesa reads a RELATIVE PS/2 mouse (/dev/input/mice), so the daemon-abs path\n#   is relative tracking with edge re-homing (clamp at screen edges). The single\n#   cursor_scale sets the 1:1 GAIN (measured transfer A~1.28 per axis, equal at\n#   4:3); the offset is a neutral origin. scale=0.783 off=(0,0) tracks 1:1 within\n#   ~1-2px after any edge touch (live-client + framebuffer verified). Re-verify\n#   after any TinyCore major bump or resolution change.\n",
    "tilesManifestInvocation": "emit tinycore \\\n  --tile tinycore --vmid 82 --udp 54082 --pointer abs \\\n  --cursor-scale 0.783 --cursor-off-x 0 --cursor-off-y 0 --audio on --fps 60 \\\n  --launcher-file \"$T/tinycore/qemu-streamhost.sh\" \\\n  --env-append-file \"$T/tinycore/tile.env.fixture\"\n",
    "bringUpGroup": 0,
    "bindingOrder": 9,
    "bindingPrelude": "",
    "bindingLine": "  tinycore:    { osId: 'tinycore',    archetypeId: 'putty-lcd',       transport: 'streamhost',  accentColor: '#4a9fd6', eraLabel: '2009 · Tiny Core' },\n",
    "museumOrder": 7,
    "museumPrelude": "",
    "museumBlock": "  {\n    id: 'tinycore', displayName: 'Tiny Core Linux', year: 2009,\n    lineage: 'BusyBox Linux', arch: 'i386', ramMB: 128,    era: '2000s', accent: '#4a9fd6',\n    eraSoftware: ['FLTK/FLWM desktop', 'tce-load', 'BusyBox'],\n    periodBrowser: 'dillo / Firefox extension',\n    iconicApps: ['App Browser', 'Terminal', 'Text editor'],\n    blurb: 'A complete graphical Linux in ~16 MB — the whole OS lives in RAM.',\n  },\n",
    "goldenOrder": 1,
    "actionMapOrder": 3
  },
