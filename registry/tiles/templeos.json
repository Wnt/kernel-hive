    "tilesManifestOrder": 21,
    "tilesManifestPrelude": "\n# templeos (VMID 105) — LiveCD (TempleOS.ISO), audio OFF, PS/2, plain std VGA.\n#   VERBATIM LAUNCHER: state.qcow2 (create-if-missing) holds the savevm\n#   'golden' snapshot (TempleOS is ISO/RAM-only); conditional -loadvm golden;\n#   COM1 serial chardev (serial.sock) for the in-guest agent.\n# POINTER=warpd (2026-07-13): TempleOS has NO USB stack and its PS/2 mouse is\n# relative. Fix (guest-agents/templeos/warpd.HC): an in-guest HolyC task WS()\n# polls the 16550 UART directly (ring-0, no serial driver needed), parses the\n# warpd M/P/R/B protocol, and writes motion straight to the global mouse state\n# ms.pos.x/y + clicks to ms.lb/ms.rb (framebuffer-verified). The agent is\n# Spawn()ed at the T:/Home> REPL and BAKED into the golden RAM snapshot.\n",
    "tilesManifestInvocation": "emit templeos \\\n  --tile templeos --vmid 105 --udp 54105 --pointer warpd \\\n  --warpd-addr unix:/data/vms/streamhost/tiles/templeos/serial.sock \\\n  --warpd-pace-ms 30 --audio off --fps 30 \\\n  --launcher-file \"$T/templeos/qemu-streamhost.sh\" \\\n  --env-append-file \"$T/templeos/tile.env.fixture\"\n",
    "bringUpGroup": 5,
    "bindingOrder": 19,
    "bindingPrelude": "",
    "bindingLine": "  templeos:    { osId: 'templeos',    archetypeId: 'beige-ibm-pc',    transport: 'streamhost',  accentColor: '#f2c14e', eraLabel: '2013 · TempleOS' },\n",
    "museumOrder": 15,
    "museumPrelude": "",
    "museumBlock": "  {\n    id: 'templeos', displayName: 'TempleOS', year: 2013,\n    lineage: 'Terry A. Davis / from-scratch', arch: 'x86_64', ramMB: 1024,    era: '2010s', accent: '#f2c14e',\n    eraSoftware: ['HolyC', 'The Oracle', 'After Egypt', 'built-in editor'],\n    periodBrowser: 'none — no networking by design',\n    iconicApps: ['HolyC REPL', 'The Oracle', 'After Egypt'],\n    blurb: 'Terry Davis’ divine 640x480 16-colour temple — a ring-0, single-address-space OS written from scratch in HolyC.',\n    notes: 'Live streamhost tile. PS/2 input only — TempleOS has no USB stack. Ring-0, single-address-space, no networking by design; CD-only ephemeral live boot.',\n  },\n",
